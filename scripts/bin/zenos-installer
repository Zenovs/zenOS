SOURCES_PREFIXES = ("/etc/apt/sources.list.d/", "/etc/apt/trusted.gpg.d/", "/etc/apt/keyrings/")
KERNEL_RE = re.compile(r"/(?:usr/)?lib/modules/.+\.ko(?:\.(?:xz|zst|gz))?|/usr/src/[^/]+/dkms\.conf")
SCRIPTS = ("preinst", "postinst", "prerm", "postrm", "config")
# dpkg-Zustände: installiert (auch mit ausstehenden Triggern) und nur halb installiert (ein Skript scheiterte)
