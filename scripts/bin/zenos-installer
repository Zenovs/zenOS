# Geschützt (nie entfernen, nie ersetzen): dieselbe Liste wie _aufraeumen_geschuetzt in scripts/lib/aufraeumen.sh und
# PROTECTED in zenos-basis (ein Einheitentest hält alle gleich); dazu kommen die zenOS-Pakete
PROTECTED = ("ubuntu-minimal", "ubuntu-standard", "ubuntu-server", "ubuntu-server-raspi", "ubuntu-pro-client",
             "lsb-release", "distro-info-data", "python3-distro-info", "update-notifier-common",
             "ubuntu-release-upgrader-core", "motd-news-config", "apport", "fonts-ubuntu-console", "lxd-installer",
             "ubuntu-keyring", "base-files")

PACKAGE_RE = re.compile(r"[a-z0-9][a-z0-9+.-]{0,127}")
VERSION_RE = re.compile(r"(?:[0-9]{1,9}:)?[A-Za-z0-9][A-Za-z0-9.+~:-]{0,127}")
ARCH_RE = re.compile(r"[a-z0-9][a-z0-9-]{0,31}")
SHA_RE = re.compile(r"[0-9a-f]{64}")
PLAN_RE = re.compile(r"[0-9a-f]{40}")
FIELD_RE = re.compile(r"[A-Za-z0-9][A-Za-z0-9-]{0,63}")
TIME_RE = re.compile(r"[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z")
# Webseite: nur druckbares ASCII ohne Leerzeichen und ohne <>"' (kein ESC, keine Richtungszeichen; zen install druckt
# sie im Terminal)
URL_RE = re.compile(r"https?://[\x21\x23-\x26\x28-\x3b\x3d\x3f-\x7e]{1,300}")
# Ein Teil eines Felds wie Replaces («a (<< 1.0)», «b:any», «c»): Name, Vergleich, Version
RELATION_RE = re.compile(r"\s*(?P<name>[A-Za-z0-9][A-Za-z0-9+.-]{0,127})(?::[A-Za-z0-9-]{1,32})?\s*"
                         r"(?:\(\s*(?P<op><<|<=|>=|>>|=|<|>)\s*(?P<version>[^\s()]{1,128})\s*\))?")
# «Inst NAME[:ARCH] [ALT] (NEU QUELLE … [ARCH]) […]», «Remv NAME[:ARCH] [ALT] […]»
INST_RE = re.compile(r"Inst (?P<name>[a-z0-9][a-z0-9+.-]*(?::[a-z0-9-]+)?) (?:\[(?P<old>[^\]\s]+)\] )?"
                     r"\((?P<new>[^\s()]+)(?: [^()]*)?\)(?: \[[^\]]*\])?")
REMV_RE = re.compile(r"(?:Remv|Purg) (?P<name>[a-z0-9][a-z0-9+.-]*(?::[a-z0-9-]+)?)(?: \[(?P<old>[^\]\s]+)\])?"
                     r"(?: \[[^\]]*\])?")

# Merged /usr: /lib, /bin … zeigen auf /usr; Dateien dort zählen wie /usr
USR_TOPS = ("usr", "opt", "lib", "lib32", "lib64", "libx32", "bin", "sbin")
