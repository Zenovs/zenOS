class Failure(Exception):
    """Fehler mit einer Meldung für Menschen."""


class Refusal(Exception):
    """Ablehnung beim Lesen des Pakets: (Art, Grund)."""

    def __init__(self, kind, reason):
        super().__init__(reason)
        self.kind = kind
        self.reason = reason


class TarLimit(tarfile.TarError):
