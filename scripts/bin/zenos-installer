# Grenzen
MAX_DEB = 2 << 30
MAX_CONTROL_MEMBER = 1 << 20
MAX_DESKTOP = 64 << 10
MAX_DESKTOPS = 50
MAX_IMAGE = 1 << 20
MAX_IMAGES_TOTAL = 24 << 20
MAX_SMALL_FILE = 4 << 20
MAX_PATH = 4096
# Im Archiv: Pfade (Byte, wie PATH_MAX) und ihre Teile (Byte, wie NAME_MAX), Einträge im Datenteil und im Steuerteil,
# Köpfe für lange Namen (GNU) und pax. tarfile läse einen solchen Kopf sonst in voller angegebener Grösse in den
# Speicher: Eine .deb von wenigen hundert kB verlangte so Gigabytes.
MAX_NAME_PART = 255
