# Kernel, Firmware und Bootloader: nie automatisch, nur mit Zustimmung (fnmatch auf den Paketnamen ohne Architektur).
# grub* und shim* sicherheitshalber (Bürorechner); linux-libc-dev (Header zum Kompilieren) zählt nicht.
HEIKEL = ("linux-raspi", "linux-raspi-*", "linux-image-*", "linux-modules-*", "linux-headers-*-raspi", "linux-generic*",
