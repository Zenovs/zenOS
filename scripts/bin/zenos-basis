# policy-rc.d für die Dauer von apt-get full-upgrade (Markierung in der zweiten Zeile). Aufruf durch invoke-rc.d und
# deb-systemd-invoke: policy-rc.d [--quiet] DIENST "AKTION …" [RUNLEVEL] → 0 erlaubt, 101 verboten.
POLICY_MARK = "# zenOS-Basis: temporär während apt-get full-upgrade, hält nur greetd ab (scripts/bin/zenos-basis)"
POLICY_TEXT = (
    "#!/bin/sh\n"
    f"{POLICY_MARK}\n"
    "# greetd neu starten beendete die laufende Sitzung; alles andere wie ohne Richtlinie\n"
    '[ "${1:-}" = --quiet ] && shift\n'
    "case ${1:-} in greetd | greetd.service) exit 101 ;; esac\n"
    "exit 0\n"
)
