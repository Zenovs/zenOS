# Ausserdem voraussichtlich ein Neustart nötig (laufende Bibliothek, PID 1, Bus, Login)
RESTART_PACKAGES = ("libc6", "systemd", "dbus", "dbus-daemon", "dbus-broker", "greetd")
# Geschützt (nie entfernen): dieselbe Liste wie _aufraeumen_geschuetzt in scripts/lib/aufraeumen.sh (ein Einheitentest
