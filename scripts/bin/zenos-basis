# gleichzeitig (der Kanal-Schritt von zen update gibt sie frei, bevor der Basis-Schritt sie nimmt)
UI_LOCK_FILE = "/run/zenos-sperre/bedienung.lock"
# Gemeinsamer Notschalter der Automatik (sudo zen kanal automatik aus) und das Programm des Kanals, das sagt, ob die
# Automatik jetzt installieren darf (Zeitpunkt, Akku; eine Quelle für beide)
AUTOMATIC_OFF_FILE = "/etc/xdg/zenos/kanal-automatik-aus"
