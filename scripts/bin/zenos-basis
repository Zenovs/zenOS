# Laufzeitordner von zenos-basis-installieren.service (RuntimeDirectory): Es gibt ihn, solange die Unit läuft
# (zenos-argon schaltet dann nicht aus); darin der Übernahme-Marker und die policy-rc.d dieses Laufs
RUNTIME_DIR = "/run/zenos-basis"
# Gemeinsame Sperre mit dem Kanal (nur root, /run/zenos-sperre 0700) und Vermerk eines install.sh von Hand
LOCK_FILE = "/run/zenos-sperre/kanal.lock"
