# «Inst NAME[:ARCH] [ALT] (NEU QUELLE, QUELLE … [ARCH]) […]», «Remv NAME[:ARCH] [ALT] […]»
INST_RE = re.compile(r"Inst (?P<name>[a-z0-9][a-z0-9+.-]*(?::[a-z0-9]+)?) (?:\[(?P<old>[^\]\s]+)\] )?"
                     r"\((?P<new>[^\s()]+) (?P<rest>[^()]*)\)(?: \[[^\]]*\])?")
REMV_RE = re.compile(r"(?:Remv|Purg) (?P<name>[a-z0-9][a-z0-9+.-]*(?::[a-z0-9]+)?)(?: \[(?P<old>[^\]\s]+)\])?"
                     r"(?: \[[^\]]*\])?")
