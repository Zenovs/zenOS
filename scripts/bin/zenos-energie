#!/usr/bin/env bash
# zenos-energie – Ausschalten nach langer Sperre, am Login-Bildschirm und die Ein/Aus-Taste (als Benutzer).
#
#   zenos-energie darf-ausschalten   «ja» (Exit 0) oder «nein: <Grund>» (Exit 1), mit Eintrag im Journal. Prüft die
#                                    Einstellung (ausschalten: nie | akku | immer, bei «akku» den Akkubetrieb) und die
#                                    Wächter. Bei «ja» beginnt die Vorwarnung: Der Marker $XDG_RUNTIME_DIR/zenos/
#                                    vorwarnung entsteht (Start-ID und Laufzeit seit dem Start, nicht die Uhrzeit).
#   zenos-energie status             prüft dasselbe ohne Journal und ohne Marker (Seite «Energie», «zen energie»)
#   zenos-energie ausschalten        nach der Vorwarnung: prüft Vorwarnung, Sperre, Einstellung und Wächter erneut,
#                                    verbraucht dann den Marker und schaltet aus (systemctl poweroff --check-inhibitors)
#   zenos-energie darf-ausschalten-login, ausschalten-login
#                                    dasselbe am Login-Bildschirm (Greeter, Benutzer _greetd): fest «im Akkubetrieb»
#                                    (Zenos Entscheid, die Einstellungen der Sitzung sind dort nicht lesbar), ohne
#                                    Sperre, dafür darf keine andere Sitzung offen sein
#   zenos-energie taste              Ein/Aus-Taste kurz gedrückt (labwc: XF86PowerOff, auch gesperrt)
#   zenos-energie hemmer-login       am Login-Bildschirm (nur als _greetd): hält den logind-Hemmer «handle-power-key»,
#                                    solange der aufrufende Prozess (die Oberfläche des Logins) läuft; ein kurzer
#                                    Druck weckt dort nur. Sonst «kein Login-Bildschirm …» und Exit 0
#   zenos-energie meldung           nach einem automatischen Aus: Titel und Text der Mitteilung (je eine Zeile),
#                                    einmal, beim ersten Aufruf nach dem nächsten Start
#
# Leitplanken (Code, nicht abschaltbar):
# - Ausgeschaltet wird nur nach einer sichtbaren Vorwarnung: Den Marker legt «darf-ausschalten» zu Beginn der
#   Vorwarnung an. Er muss 60 s bis 5 Min. alt sein, gemessen an der Laufzeit seit dem Start (ein Sprung der Uhr
#   verkürzt die Vorwarnung nie), und gilt nur einmal. Verbraucht wird er erst unmittelbar vor dem Ausschalten: Löscht
#   die Oberfläche ihn vorher (eine Eingabe bricht ab), schaltet nichts aus.
# - Nur gesperrt (am Login-Bildschirm: keine andere Sitzung), nur wenn die Einstellung es erlaubt, und nie während
#   einer SSH-Sitzung oder -Verbindung, eines tmux- oder screen-Servers, einer Installation (install.sh, zen update,
#   zen rollback, eine Unit zenos-kanal-* des Kanals oder zenos-basis-* der Basis-Updates), apt oder dpkg,
#   automatischer Updates, wenn ein Programm das Ausschalten blockiert (logind-Hemmer «shutdown», Modus block) oder
#   wenn logind es nicht ohne Passwort erlaubt (CanPowerOff). Was sich nicht prüfen lässt, gilt als blockiert.
# - Nur «systemctl poweroff --check-inhibitors=yes»: nie neu starten, nie Hemmer übergehen (kein -i, kein --force).
# - Prozesse nur mit Argumentlisten, keine Shell. Jeder Entscheid steht mit Grund im Journal (logger -t zenos-energie).
# Exit 0 ja bzw. erledigt · 1 nein bzw. blockiert (Grund auf stdout) · 2 falscher Aufruf · 3 systemctl poweroff
# abgelehnt (die Oberfläche versucht es dann erst nach der nächsten Eingabe wieder) · 4 Vorwarnung noch keine 60 s alt
# (der Marker bleibt, die Oberfläche fragt im nächsten Takt erneut). hemmer-login endet erst mit dem Hemmer, mit dem
# Exit von systemd-inhibit (1: polkit oder logind lehnt ab).

set -uo pipefail

selbst=$(readlink -f -- "${BASH_SOURCE[0]}")
bin=$(dirname -- "$selbst")
zen=$(dirname -- "$bin")/zen
idle=$bin/zenos-idle
ipc=$bin/zenos-ipc
bildschirm=$bin/zenos-bildschirm

# Gespiegelt aus shell/modi/zustandslogik.js (vorwarnungSekunden, loginAusschaltenMinuten) und shell/dienste/energie.js
# (VORWARNUNG_MAX_MS), test/einheiten/energie.test.py gleicht ab
readonly VORWARNUNG_MIN=60 VORWARNUNG_MAX=300 LOGIN_MINUTEN=30

# Nur für Tests: legt die festen Pfade unter /run unter diesen Ordner (wie ZENOS_ARGON_TESTWURZEL)
testwurzel=${ZENOS_ENERGIE_TESTWURZEL:-}
testwurzel=${testwurzel%/}
geraet_datei=$testwurzel/run/zenos/geraet.json
install_sperre=$testwurzel/run/lock/zenos-install.lock
# Laufzeit seit dem Start; in Tests eingefroren, damit die Grenze bei 60 s nicht an einer verstrichenen Sekunde hängt
uptime_datei=/proc/uptime
if [[ -n "$testwurzel" && -r "$testwurzel/proc/uptime" ]]; then uptime_datei=$testwurzel/proc/uptime; fi

laufzeit=${XDG_RUNTIME_DIR:-/run/user/$EUID}
vorwarnung=$laufzeit/zenos/vorwarnung
gesperrt_marker=$laufzeit/zenos/gesperrt
# Am Login-Bildschirm (Benutzer _greetd) ungenutzt; HOME kann dort fehlen
zustand=${HOME:-/nonexistent}/.local/state/zenos/energie.json

meldung() { printf 'zenos-energie: %s\n' "$*" >&2; }
journal() { logger -t zenos-energie -- "$*" 2>/dev/null || true; }

# --- Einstellungen ---------------------------------------------------------------

# Setzt wenn (nie|akku|immer), minuten und taste aus «zenos-idle energie» (dort gelesen, geprüft und begrenzt, genau
# wie in der Oberfläche). 1, wenn sich nichts lesen lässt (dann gelten die Standards).
werte_lesen() {
  local zeilen name wert
  wenn=akku minuten=60 taste=sperren
  [[ -x "$idle" ]] || return 1
  zeilen=$("$idle" energie 2>/dev/null) || return 1
  while read -r name wert _; do
    case "$name:$wert" in
      ausschaltenwenn:nie | ausschaltenwenn:akku | ausschaltenwenn:immer) wenn=$wert ;;
      taste:sperren | taste:menue | taste:ausschalten) taste=$wert ;;
      ausschalten:*) if [[ "$wert" =~ ^[0-9]{1,3}$ ]]; then minuten=$wert; fi ;;
    esac
  done <<< "$zeilen"
}

# Sicher im Akkubetrieb? Wie shell/dienste/geraet.js und energie.js: /run/zenos/geraet.json (zenos-argon) höchstens
# 60 s alt, Akku vorhanden, Zustand «ok» mit gültigem Ladestand und sicher «lädt nicht». Alles andere gilt als Netzteil.
im_akkubetrieb() {
  python3 - "$geraet_datei" <<'PY'
import datetime
import json
import sys

try:
    with open(sys.argv[1], encoding="utf-8") as f:
        daten = json.load(f)
    zeit = datetime.datetime.fromisoformat(daten["zeit"])
    alter = (datetime.datetime.now(datetime.timezone.utc) - zeit).total_seconds()
    akku = daten["akku"]
    prozent = akku.get("prozent")
    sicher = (daten.get("version") == 1 and zeit.tzinfo is not None and abs(alter) <= 60
              and akku.get("vorhanden") is True and akku.get("zustand") == "ok"
              and isinstance(prozent, int) and not isinstance(prozent, bool) and 0 <= prozent <= 100
              and akku.get("laedt") is False)
except (OSError, ValueError, TypeError, KeyError, AttributeError):
    sicher = False
sys.exit(0 if sicher else 1)
PY
}

pruefe_einstellung() {
  if ! werte_lesen; then
    grund="Einstellungen nicht lesbar (zenos-idle energie)"
    return 1
  fi
  case "$wenn" in
    immer) return 0 ;;
    akku)
      im_akkubetrieb && return 0
      grund="nicht im Akkubetrieb (Netzteil oder Akku unbekannt)"
      ;;
    *) grund="Ausschalten ist auf «Nie» gestellt" ;;
  esac
  return 1
}

# --- Wächter -----------------------------------------------------------------------
# Jeder Wächter: 0 frei, 1 blockiert (Grund in $grund). Was sich nicht prüfen lässt, gilt als blockiert.

# pgrep ARGUMENTE…: 0 läuft, 1 läuft nicht, 2 nicht prüfbar
laeuft() {
  local rc=0
  pgrep "$@" >/dev/null 2>&1 || rc=$?
  case "$rc" in
    0) return 0 ;;
    1) return 1 ;;
    *) return 2 ;;
  esac
}

# laeuft_nicht GRUND ARGUMENTE…: 0, wenn kein solcher Prozess läuft
laeuft_nicht() {
  local text=$1 rc=0
  shift
  laeuft "$@" || rc=$?
  case "$rc" in
    1) return 0 ;;
    0) grund=$text ;;
    *) grund="Prozesse nicht prüfbar (pgrep)" ;;
  esac
  return 1
}

# Fern-Sitzungen (logind: Remote=yes, z. B. SSH) und offene SSH-Verbindungen (auch ohne Sitzung)
pruefe_sitzungen() {
  local liste id remote
  if ! liste=$(loginctl list-sessions --no-legend --no-pager 2>/dev/null); then
    grund="Sitzungen nicht prüfbar (loginctl)"
    return 1
  fi
  while read -r id _; do
    [[ -n "$id" ]] || continue
    if [[ ! "$id" =~ ^[A-Za-z0-9_-]{1,64}$ ]] || ! remote=$(loginctl show-session "$id" -p Remote --value 2>/dev/null); then
      grund="Sitzungen nicht prüfbar (loginctl)"
      return 1
    fi
    if [[ "$remote" == yes ]]; then
      grund="SSH-Sitzung offen"
      return 1
    fi
  done <<< "$liste"
  laeuft_nicht "SSH-Verbindung offen" -x sshd-session
}

# tmux- und screen-Server (z. B. eine Claude-Code-Sitzung) laufen weiter, wenn niemand hinschaut
pruefe_terminals() {
  laeuft_nicht "tmux läuft" '^tmux' && laeuft_nicht "screen läuft" -i -x screen
}

# install.sh hält /run/lock/zenos-install.lock exklusiv. Nur lesend öffnen (ohne anzulegen: eine fremde Datei in
# /run/lock lehnte fs.protected_regular sonst ab) und kurz geteilt sperren.
pruefe_installation() {
  local fd
  if [[ -e "$install_sperre" ]]; then
    if ! { exec {fd}<"$install_sperre"; } 2>/dev/null; then
      grund="Installation nicht prüfbar (Sperrdatei nicht lesbar)"
      return 1
    fi
    if ! flock -n -s "$fd"; then
      exec {fd}<&-
      grund="Installation läuft (install.sh)"
      return 1
    fi
    exec {fd}<&-
  fi
  # zen update holt zuerst den neuen Stand (git), bevor install.sh die Sperre nimmt
  laeuft_nicht "Update läuft (zen update)" -f '(^|[ /])zen (update|rollback)( |$)' || return 1
  pruefe_kanal
}

# Der Kanal und die Basis-Updates (zenos-basis) arbeiten in systemd-Units (holen, prüfen, installieren, Automatik,
# Bestätigung nach dem Start). Ihre Sperren in /run/zenos-sperre und die von install.sh als root sieht ein Benutzer
# nicht, und der Block-Hemmer gilt nur, solange apt bzw. install.sh läuft (nicht beim Bereitstellen, bei der
# Gesundheitsprüfung, beim Rückweg). systemd gibt den Zustand jedem Benutzer: Läuft eine Unit zenos-kanal-* oder
# zenos-basis-*, schaltet zenos-energie nicht aus.
pruefe_kanal() {
  local einheiten
  if ! einheiten=$(systemctl list-units --type=service --state=activating,active,deactivating,reloading \
    --no-legend --plain --no-pager 'zenos-kanal-*.service' 'zenos-basis-*.service' 2>/dev/null); then
    grund="Updates nicht prüfbar (systemctl)"
    return 1
  fi
  einheiten=${einheiten%%$'\n'*}
  if [[ -n "${einheiten// /}" ]]; then
    grund="Update läuft (${einheiten%% *})"
    return 1
  fi
}

# Paketverwaltung und automatische Updates. unattended-upgrade-shutdown wartet ständig auf das Ende des Systems
# und zählt nicht (nur unattended-upgrade selbst).
pruefe_pakete() {
  local zeile
  laeuft_nicht "Paketverwaltung läuft (apt, dpkg)" -x 'apt|apt-get|aptitude|dpkg' || return 1
  laeuft_nicht "Automatische Updates laufen" -f 'unattended-upgrade( |$)' || return 1
  while read -r zeile; do
    case "$zeile" in
      active | activating | deactivating | reloading | refreshing)
        grund="Automatische Updates laufen (apt-daily)"
        return 1
        ;;
    esac
  done < <(systemctl is-active apt-daily.service apt-daily-upgrade.service 2>/dev/null)
  return 0
}

# Ein Programm blockiert das Ausschalten (logind-Hemmer «shutdown», Modus block). Hemmer im Modus delay (z. B.
# unattended-upgrade-shutdown) verzögern nur und zählen nicht.
pruefe_hemmer() {
  local ausgabe wer
  if ! ausgabe=$(timeout 10 busctl --system --json=short call org.freedesktop.login1 /org/freedesktop/login1 \
    org.freedesktop.login1.Manager ListInhibitors 2>/dev/null); then
    grund="Hemmer nicht prüfbar (logind)"
    return 1
  fi
  if ! wer=$(python3 -c '
import json, sys
daten = json.loads(sys.argv[1])
for eintrag in daten["data"][0]:
    was, wer, _, modus = eintrag[0], eintrag[1], eintrag[2], eintrag[3]
    if modus == "block" and "shutdown" in str(was).split(":"):
        name = "".join(z for z in str(wer) if z.isprintable())[:40].strip()
        print(name or "Ein Programm")
        break
' "$ausgabe" 2>/dev/null); then
    grund="Hemmer nicht prüfbar (logind)"
    return 1
  fi
  if [[ -n "$wer" ]]; then
    grund="«$wer» verhindert das Ausschalten"
    return 1
  fi
}

# logind erlaubt das Ausschalten ohne Passwort (CanPowerOff «yes»). Sonst («challenge», z. B. eine andere Sitzung,
# oder «no») lehnte «systemctl --no-ask-password poweroff» erst nach der Vorwarnung ab.
pruefe_kann_ausschalten() {
  local ausgabe
  if ! ausgabe=$(timeout 10 busctl --system call org.freedesktop.login1 /org/freedesktop/login1 \
    org.freedesktop.login1.Manager CanPowerOff 2>/dev/null); then
    grund="Ausschalten nicht prüfbar (logind)"
    return 1
  fi
  case "$ausgabe" in
    's "yes"') return 0 ;;
    's "challenge"') grund="Ausschalten bräuchte ein Passwort (logind)" ;;
    *) grund="Ausschalten nicht erlaubt (logind)" ;;
  esac
  return 1
}

# Einstellung und alle Wächter, der erste Grund gilt
pruefe_alles() {
  grund=""
  pruefe_einstellung && pruefe_sitzungen && pruefe_terminals && pruefe_installation && pruefe_pakete &&
    pruefe_hemmer && pruefe_kann_ausschalten
}

# --- Login-Bildschirm ----------------------------------------------------------------
# Fest im Akkubetrieb nach LOGIN_MINUTEN ohne Eingabe (die Oberfläche des Greeters zählt). Die Einstellungen der
# Sitzung sind dort nicht lesbar, und ohne offene Sitzung geht nichts verloren.

pruefe_einstellung_login() {
  wenn=akku minuten=$LOGIN_MINUTEN
  im_akkubetrieb && return 0
  grund="nicht im Akkubetrieb (Netzteil oder Akku unbekannt)"
  return 1
}

# Keine Fern-Sitzung und keine andere Sitzung (eine Anmeldung an der Konsole, ein Cron-Job): Erlaubt sind nur
# Greeter und die Benutzerdienste von systemd (Klasse manager)
pruefe_sitzungen_login() {
  local liste id klasse
  pruefe_sitzungen || return 1
  liste=$(loginctl list-sessions --no-legend --no-pager 2>/dev/null) || { grund="Sitzungen nicht prüfbar (loginctl)"; return 1; }
  while read -r id _; do
    [[ -n "$id" ]] || continue
    if [[ ! "$id" =~ ^[A-Za-z0-9_-]{1,64}$ ]] || ! klasse=$(loginctl show-session "$id" -p Class --value 2>/dev/null); then
      grund="Sitzungen nicht prüfbar (loginctl)"
      return 1
    fi
    case "$klasse" in
      greeter | manager | manager-early) ;;
      *)
        grund="eine andere Sitzung ist offen"
        return 1
        ;;
    esac
  done <<< "$liste"
}

pruefe_alles_login() {
  grund=""
  pruefe_einstellung_login && pruefe_sitzungen_login && pruefe_terminals && pruefe_installation && pruefe_pakete &&
    pruefe_hemmer && pruefe_kann_ausschalten
}

# --- Vorwarnung --------------------------------------------------------------------------
# Marker: eine Zeile «zenos-vorwarnung 1 <Start-ID> <Sekunden seit dem Start>». Die Laufzeit (/proc/uptime) springt nie,
# anders als die Uhr (NTP nach langer Zeit offline, ohne RTC-Batterie).

# Liest boot (Start-ID) und laufzeit (ganze Sekunden seit dem Start)
start_lesen() {
  local rest
  boot="" laufzeit_s=""
  read -r boot < /proc/sys/kernel/random/boot_id 2>/dev/null || true
  read -r laufzeit_s rest < "$uptime_datei" 2>/dev/null || true
  laufzeit_s=${laufzeit_s%%.*}
  [[ "$boot" =~ ^[0-9a-f-]{36}$ && "$laufzeit_s" =~ ^[0-9]{1,12}$ ]]
}

vorwarnung_anlegen() {
  local ordner=${vorwarnung%/*} neu
  start_lesen || return 1
  [[ -d "$ordner" ]] || (umask 077 && mkdir -p -- "$ordner") 2>/dev/null || return 1
  neu=$vorwarnung.neu.$$
  printf 'zenos-vorwarnung 1 %s %s\n' "$boot" "$laufzeit_s" > "$neu" 2>/dev/null && mv -f -- "$neu" "$vorwarnung" 2>/dev/null &&
    return 0
  rm -f -- "$neu" 2>/dev/null
  return 1
}

vorwarnung_weg() { rm -f -- "$vorwarnung" 2>/dev/null || true; }

# Vorwarnung: Marker vorhanden, eigene Datei, aus diesem Start und 60 s bis 5 Min. alt (nur prüfen, nicht löschen)
pruefe_vorwarnung() {
  local kennung="" version="" seit_boot="" seit="" rest="" alter
  if [[ -L "$vorwarnung" || ! -f "$vorwarnung" || ! -O "$vorwarnung" ]]; then
    grund="keine Vorwarnung"
    return 1
  fi
  read -r kennung version seit_boot seit rest < "$vorwarnung" 2>/dev/null || true
  if ! start_lesen || [[ "$kennung $version" != "zenos-vorwarnung 1" || "$seit_boot" != "$boot" || -n "$rest" ||
    ! "$seit" =~ ^[0-9]{1,12}$ ]]; then
    grund="Vorwarnung nicht lesbar"
    return 1
  fi
  alter=$((laufzeit_s - seit))
  if (( alter < VORWARNUNG_MIN )); then
    grund="Vorwarnung erst ${alter} s alt (mindestens ${VORWARNUNG_MIN} s)"
    (( alter < 0 )) || zu_frueh=1
    return 1
  fi
  if (( alter > VORWARNUNG_MAX )); then
    grund="Vorwarnung zu alt (${alter} s)"
    return 1
  fi
}

# Zuletzt, unmittelbar vor dem Ausschalten: den Marker verbrauchen. Fehlt er jetzt, hat die Oberfläche abgebrochen.
vorwarnung_verbrauchen() {
  if ! mv -f -- "$vorwarnung" "$vorwarnung.verbraucht" 2>/dev/null; then
    grund="Vorwarnung abgebrochen"
    return 1
  fi
  rm -f -- "$vorwarnung.verbraucht" 2>/dev/null || true
}

# ~/.local/state/zenos/energie.json: wann und warum zenOS ausgeschaltet hat (für die Mitteilung danach)
zustand_schreiben() {
  python3 - "$zustand" "$minuten" "$wenn" <<'PY'
import datetime
import json
import os
import sys

pfad, minuten, wenn = sys.argv[1], int(sys.argv[2]), sys.argv[3]
with open("/proc/sys/kernel/random/boot_id", encoding="utf-8") as f:
    boot = f.read().strip()
daten = {"version": 1, "ausgeschaltet": datetime.datetime.now().astimezone().isoformat(timespec="seconds"),
         "boot": boot, "minuten": minuten, "wenn": wenn}
os.makedirs(os.path.dirname(pfad), mode=0o700, exist_ok=True)
neu = pfad + ".neu"
with open(neu, "w", encoding="utf-8") as f:
    json.dump(daten, f)
    f.write("\n")
os.replace(neu, pfad)
PY
}

# Nicht ausgeschaltet: Der Marker gilt einmal und ist danach weg
nein() {
  vorwarnung_weg
  journal "Nicht ausgeschaltet${ort}: $grund"
  printf 'nein: %s\n' "$grund"
  return 1
}

# ausschalten (sitzung) bzw. ausschalten-login (login)
befehl_ausschalten() {
  local modus=$1 ausgabe rc=0
  grund="" zu_frueh=0
  if ! pruefe_vorwarnung; then
    # Der Takt der Oberfläche kann etwas schneller laufen als die Laufzeit (QML-Timer feuern bis zu einigen ms zu
    # früh): noch nicht, der Marker bleibt, die Oberfläche fragt im nächsten Takt erneut (Exit 4, ohne Journal)
    if (( zu_frueh )); then
      printf 'nein: %s\n' "$grund"
      return 4
    fi
    nein
    return 1
  fi
  if [[ "$modus" == sitzung ]]; then
    if [[ ! -e "$gesperrt_marker" ]]; then
      grund="nicht gesperrt"
      nein
      return 1
    fi
    pruefe_alles || { nein; return 1; }
  else
    pruefe_alles_login || { nein; return 1; }
  fi
  vorwarnung_verbrauchen || { nein; return 1; }
  if [[ "$modus" == sitzung ]]; then
    zustand_schreiben 2>/dev/null || meldung "$zustand nicht geschrieben (keine Mitteilung beim nächsten Start)"
    journal "Schalte aus: $minuten Min. gesperrt ohne Eingabe (Einstellung «$wenn»), nach 60 s Vorwarnung"
  else
    journal "Schalte aus: $minuten Min. ohne Eingabe am Login-Bildschirm im Akkubetrieb, nach 60 s Vorwarnung"
  fi
  # Nur mit Hemmern im Blick, ohne Passwortabfrage (polkit: power-off ist in der aktiven Sitzung erlaubt)
  ausgabe=$(systemctl --no-ask-password poweroff --check-inhibitors=yes 2>&1) || rc=$?
  if (( rc != 0 )); then
    rm -f -- "$zustand" 2>/dev/null
    grund="systemctl poweroff abgelehnt (Exit $rc): ${ausgabe//$'\n'/ }"
    nein
    return 3
  fi
  printf 'ausgeschaltet\n'
}

# darf-ausschalten (sitzung) bzw. darf-ausschalten-login (login): bei «ja» beginnt die Vorwarnung (Marker)
befehl_darf_ausschalten() {
  local modus=$1 frei=1
  if [[ "$modus" == login ]]; then
    pruefe_alles_login || frei=0
  else
    pruefe_alles || frei=0
  fi
  if (( frei )); then
    if ! vorwarnung_anlegen; then
      grund="Marker der Vorwarnung nicht anlegbar ($vorwarnung)"
      journal "Ausschalten blockiert${ort}: $grund"
      printf 'nein: %s\n' "$grund"
      return 1
    fi
    journal "Ausschalten erlaubt${ort}: Vorwarnung beginnt"
    printf 'ja\n'
    return 0
  fi
  vorwarnung_weg
  journal "Ausschalten blockiert${ort}: $grund"
  printf 'nein: %s\n' "$grund"
  return 1
}

befehl_status() {
  if pruefe_alles; then
    printf 'ja\n'
    return 0
  fi
  printf 'nein: %s\n' "$grund"
  return 1
}

# --- Ein/Aus-Taste -------------------------------------------------------------------
# Gesperrt: Bildschirm an oder aus (die Sperre weiss, ob er dunkel ist oder eben geweckt wurde). Sonst bei «sperren»
# sperren und Bildschirm aus (wie Super+Shift+L), bei «menue» das System-Menü. Bei «ausschalten» nichts: zenos-idle
# hält dann keinen Hemmer, und logind schaltet aus.

befehl_taste() {
  local antwort=""
  werte_lesen || true
  if [[ "$taste" == ausschalten ]]; then
    journal "Ein/Aus-Taste: ausschalten übernimmt logind"
    return 0
  fi
  if [[ -e "$gesperrt_marker" ]]; then
    # Die letzte Zeile ist die Antwort (davor kann Quickshell Hinweise ausgeben, z. B. zur Locale)
    antwort=$(timeout 5 "$ipc" sperre taste 2>/dev/null | tail -n 1) || antwort=""
    case "$antwort" in
      an | aus) return 0 ;;
      offen) ;;
      *)
        # Ohne Oberfläche (Notfall-Sperre): nach dem Zustand der Bildschirme
        if [[ "$(timeout 5 "$bildschirm" status 2>/dev/null)" == aus ]]; then
          "$bildschirm" an
        else
          "$zen" energie aus
        fi
        return
        ;;
    esac
  fi
  if [[ "$taste" == menue ]] && timeout 5 "$ipc" leiste menue system >/dev/null 2>&1; then
    return 0
  fi
  "$zen" energie aus
}

# --- Ein/Aus-Taste am Login-Bildschirm -------------------------------------------------
# Zenos Entscheid vom 08.10.2026: Am Login-Bildschirm weckt ein kurzer Druck nur (shell/greeter/EinAusTaste.qml); die
# Taste kommt als XF86PowerOff beim Login an und ist dort die Wecktaste. Damit logind nicht selbst ausschaltet
# (HandlePowerKey), hält dieser Aufruf den logind-Hemmer «handle-power-key», solange der aufrufende Prozess läuft (die
# Oberfläche des Logins, Quickshell): systemd-inhibit … tail --pid=<Eltern>. Endet sie (Anmeldung, Absturz, SIGKILL),
# endet tail spätestens 1 s danach, mit ihm systemd-inhibit und der Hemmer. polkit erlaubt «inhibit-handle-power-key»
# einer aktiven Sitzung am Gerät ohne eigene Regel (allow_active yes); greetd führt den Login in einer eigenen Sitzung
# der Klasse «greeter» auf seat0. Nur als _greetd (Benutzer des Logins in /etc/greetd/config.toml): Im Start-Test von
# pruefen.sh oder in einer Sitzung nimmt er nichts. Ausfallsicher: Bekommt er den Hemmer nicht, endet er mit dem Exit
# von systemd-inhibit, und logind schaltet wie bisher aus. Gedrückt halten schaltet immer hart aus (Hardware).

befehl_hemmer_login() {
  local benutzer
  benutzer=$(id -un 2>/dev/null) || benutzer=""
  if [[ "$benutzer" != _greetd ]]; then
    printf 'kein Login-Bildschirm unter greetd (Benutzer %s), kein Hemmer\n' "${benutzer:-unbekannt}"
    return 0
  fi
  if (( PPID <= 1 )); then
    meldung "hemmer-login: ohne Elternprozess kein Hemmer (ein kurzer Druck schaltet aus)"
    return 1
  fi
  if ! command -v systemd-inhibit >/dev/null 2>&1; then
    meldung "systemd-inhibit fehlt: ein kurzer Druck auf die Ein/Aus-Taste schaltet aus (logind)"
    return 1
  fi
  exec systemd-inhibit --what=handle-power-key --mode=block --who=zenOS \
    --why="Ein/Aus-Taste am Login-Bildschirm: kurzer Druck weckt nur" tail --pid="$PPID" -f /dev/null
}

# --- Mitteilung nach einem automatischen Aus ---------------------------------------------
# Gibt Titel und Text aus, wenn zenOS vor dem jetzigen Start selbst ausgeschaltet hat, und löscht die Datei. Im selben
# Start (das Ausschalten läuft gerade) bleibt sie liegen. Eine ungültige Datei wird ohne Ausgabe gelöscht.
befehl_meldung() {
  [[ -f "$zustand" ]] || return 0
  python3 - "$zustand" <<'PY'
import datetime
import json
import os
import sys

pfad = sys.argv[1]
with open("/proc/sys/kernel/random/boot_id", encoding="utf-8") as f:
    jetzt_boot = f.read().strip()
try:
    with open(pfad, encoding="utf-8") as f:
        daten = json.load(f)
    zeit = datetime.datetime.fromisoformat(daten["ausgeschaltet"]).astimezone()
    boot, minuten, wenn = daten["boot"], daten["minuten"], daten["wenn"]
    gueltig = (daten.get("version") == 1 and isinstance(boot, str) and isinstance(minuten, int)
               and not isinstance(minuten, bool) and 30 <= minuten <= 240 and wenn in ("akku", "immer"))
except (OSError, ValueError, TypeError, KeyError, AttributeError):
    gueltig = False
if gueltig and boot == jetzt_boot:
    sys.exit(0)
os.remove(pfad)
if gueltig:
    print("zenOS hat ausgeschaltet")
    print(f"Am {zeit.day}.{zeit.month}. um {zeit:%H:%M}, nach {minuten} Min. gesperrt"
          + (" im Akkubetrieb." if wenn == "akku" else "."))
PY
}

# --- Aufruf ----------------------------------------------------------------------------

erlaubt="darf-ausschalten, status, ausschalten, darf-ausschalten-login, ausschalten-login, taste, hemmer-login, meldung"
if (( $# != 1 )); then
  meldung "Aufruf: zenos-energie ${erlaubt//, /|}"
  exit 2
fi
case "$1" in
  darf-ausschalten | status | ausschalten | darf-ausschalten-login | ausschalten-login | taste | hemmer-login | meldung) ;;
  -h | --hilfe | --help) sed -n '2,37p' "$selbst" | sed 's/^# \{0,1\}//'; exit 0 ;;
  *) meldung "unbekannter Befehl «$1» (erlaubt: $erlaubt)"; exit 2 ;;
esac
if (( EUID == 0 )); then
  meldung "läuft als normaler Benutzer in der Sitzung, nicht als root"
  exit 2
fi
# Für das Journal: wo entschieden wurde
case "$1" in
  *-login) ort=" (Login-Bildschirm)" ;;
  *) ort="" ;;
esac
case "$1" in
  darf-ausschalten) befehl_darf_ausschalten sitzung ;;
  status) befehl_status ;;
  ausschalten) befehl_ausschalten sitzung ;;
  darf-ausschalten-login) befehl_darf_ausschalten login ;;
  ausschalten-login) befehl_ausschalten login ;;
  taste) befehl_taste ;;
  hemmer-login) befehl_hemmer_login ;;
  meldung) befehl_meldung ;;
esac
