#!/usr/bin/env python3
"""zenos-webapp: Web-Apps von zenOS verwalten und ihre Starter erzeugen.

Aufruf:
  zenos-webapp liste [--json]                          Web-Apps aus ~/.config/zenos/webapps.json
  zenos-webapp anlegen --name NAME --url URL [--profil PROFIL]
                                                       neue Web-App; gibt die ID aus
  zenos-webapp loeschen ID                             Web-App und ihren Starter entfernen
  zenos-webapp pruefen URL                             Adresse prüfen; gibt sie bereinigt aus
  zenos-webapp synchronisieren [--melden]              Starter an webapps.json angleichen

Eine Web-App öffnet eine Website in einem eigenen Chrome-Fenster. Ihr Starter liegt unter
~/.local/share/applications/zenos-webapp-<id>.desktop und startet
  <code>/scripts/bin/zenos-chrome [--zenos-profil PROFIL] --app=URL
als Argumentliste, gequotet nach der Desktop Entry Specification (1.5). Ohne Profil nimmt
zenos-chrome das Chrome-Profil des aktiven Modus.

Adressen: nur https, ohne Zugangsdaten, ohne Leerzeichen, Steuerzeichen, Anführungszeichen und
Backslashes. Umlaute im Rechnernamen werden in Punycode, im Pfad in %-Kodierung übertragen.

synchronisieren gleicht auch den Chrome-Starter an: Ist Google Chrome installiert, liegen Kopien
von google-chrome.desktop (und com.google.Chrome.desktop) unter ~/.local/share/applications, die
Chrome über zenos-chrome starten (Profil des aktiven Modus). --melden gibt pro Änderung eine
Zeile aus (für install.sh).

Exit: 0 in Ordnung · 1 ungültig oder nicht gefunden · 2 Aufruf- oder Systemfehler.
"""

import fcntl
import json
import os
import re
import sys
import tempfile
import unicodedata
import urllib.parse

CODE = os.path.dirname(os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
CHROME_STARTER = os.path.join(CODE, "scripts", "bin", "zenos-chrome")
SCHEMA = os.path.join(CODE, "config", "schema", "webapps.schema.json")
HOME = os.path.expanduser("~")
KONFIG = os.path.join(HOME, ".config", "zenos")
ZUSTAND = os.path.join(HOME, ".local", "state", "zenos")
DATEI = os.path.join(KONFIG, "webapps.json")
_DATA_HOME = os.environ.get("XDG_DATA_HOME", "")
ANWENDUNGEN = os.path.join(_DATA_HOME if os.path.isabs(_DATA_HOME) else os.path.join(HOME, ".local", "share"),
                           "applications")
PRAEFIX = "zenos-webapp-"
MARKE_WEBAPP = "X-zenOS-WebApp"
MARKE_CHROME = "X-zenOS-Starter"
CHROME_DATEIEN = ("google-chrome.desktop", "com.google.Chrome.desktop")
SYSTEM_ANWENDUNGEN = ("/usr/share/applications", "/usr/local/share/applications")

ID_MUSTER = re.compile(r"^[a-z0-9]+(-[a-z0-9]+)*$")
# Wie config/schema/webapps.schema.json; zusätzlich prüft url_bereinigen jeden Teil einzeln.
URL_MUSTER = re.compile(r"^https://[A-Za-z0-9.-]+(:[0-9]{1,5})?(/[^\s\"'<>\\`]*)?$")
# Zeichen, die in Pfad, Abfrage und Anker stehen bleiben dürfen (RFC 3986 ohne «'»)
URL_ZEICHEN = re.compile(r"^[A-Za-z0-9\-._~!$&()*+,;=:@/?#\[\]%]*$")
LABEL = re.compile(r"^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$")
FELDCODE = re.compile(r"^%[fFuUdDnNickvm]$")
# Zeichen, die ein Argument in Exec in Anführungszeichen setzen (Desktop Entry Specification)
RESERVIERT = set(" \t\n\"'\\><~|&;$*?#()`")


class Fehler(Exception):
    """Meldung für stderr; code 1 = ungültig/nicht gefunden, 2 = Aufruf/System."""

    def __init__(self, text, code=1):
        super().__init__(text)
        self.code = code


def meldung(text):
    print(f"zenos-webapp: {text}", file=sys.stderr)


# ---------------------------------------------------------------- Prüfen

def _steuerzeichen(text):
    return any(unicodedata.category(c)[0] in ("C", "Z") and c != " " for c in text)


def name_bereinigen(name):
    name = (name or "").strip()
    if not name:
        raise Fehler("Name fehlt")
    if len(name) > 60:
        raise Fehler("Name zu lang (höchstens 60 Zeichen)")
    if _steuerzeichen(name) or "\\" in name:
        raise Fehler("Name enthält unerlaubte Zeichen (Steuerzeichen oder Backslash)")
    return name


def profil_bereinigen(profil):
    profil = (profil or "").strip()
    if len(profil) > 100:
        raise Fehler("Chrome-Profil zu lang (höchstens 100 Zeichen)")
    if _steuerzeichen(profil) or any(c in profil for c in "\"'\\`"):
        raise Fehler("Chrome-Profil enthält unerlaubte Zeichen (Anführungszeichen, Backslash, Steuerzeichen)")
    return profil


def _host(netloc):
    if "@" in netloc:
        raise Fehler("Adresse mit Zugangsdaten (…@) ist nicht erlaubt")
    host, _, port = netloc.rpartition(":") if re.search(r":[0-9]*$", netloc) else (netloc, "", "")
    if not host:
        raise Fehler("Rechnername fehlt")
    if host.startswith("["):
        raise Fehler("IPv6-Adressen werden nicht unterstützt")
    host = host.rstrip(".")
    try:
        host = host.encode("idna").decode("ascii").lower()
    except UnicodeError:
        raise Fehler("Rechnername ist ungültig") from None
    if len(host) > 253 or not all(LABEL.match(teil) for teil in host.split(".")):
        raise Fehler("Rechnername ist ungültig")
    if port:
        if not port.isdigit() or not 1 <= int(port) <= 65535:
            raise Fehler("Port ist ungültig")
        port = str(int(port))
        if port == "443":
            port = ""
    return host + (":" + port if port else "")


def _teil_kodieren(teil):
    """%-kodiert Zeichen ausserhalb von ASCII; alles andere muss schon erlaubt sein."""
    ergebnis = []
    for c in teil:
        if ord(c) > 127:
            ergebnis.append(urllib.parse.quote(c, safe=""))
        else:
            ergebnis.append(c)
    return "".join(ergebnis)


def url_bereinigen(roh):
    url = (roh or "").strip()
    if not url:
        raise Fehler("Adresse fehlt")
    if len(url) > 2048:
        raise Fehler("Adresse zu lang (höchstens 2048 Zeichen)")
    if _steuerzeichen(url) or " " in url:
        raise Fehler("Adresse enthält Leerzeichen oder Steuerzeichen")
    if any(c in url for c in "\"'`\\<>"):
        raise Fehler("Adresse enthält Anführungszeichen, Backslash oder spitze Klammern")
    if "://" not in url:
        if re.match(r"^[A-Za-z][A-Za-z0-9+.-]*:", url) and not re.match(r"^[^:/]+:[0-9]", url):
            raise Fehler("Nur https-Adressen sind erlaubt")
        url = "https://" + url
    try:
        teile = urllib.parse.urlsplit(url)
    except ValueError:
        raise Fehler("Adresse ist ungültig") from None
    if teile.scheme.lower() != "https":
        raise Fehler("Nur https-Adressen sind erlaubt")
    netloc = _host(teile.netloc)
    pfad = _teil_kodieren(teile.path) or "/"
    abfrage = _teil_kodieren(teile.query)
    anker = _teil_kodieren(teile.fragment)
    for teil in (pfad, abfrage, anker):
        if not URL_ZEICHEN.match(teil):
            raise Fehler("Adresse enthält unerlaubte Zeichen")
        if re.search(r"%(?![0-9A-Fa-f]{2})", teil):
            raise Fehler("Adresse enthält ein «%» ohne zwei Hex-Ziffern")
    if not pfad.startswith("/"):
        raise Fehler("Adresse ist ungültig")
    ergebnis = "https://" + netloc + pfad
    if teile.query or url.split("#", 1)[0].endswith("?"):
        ergebnis += "?" + abfrage
    if anker or "#" in url:
        ergebnis += "#" + anker
    if len(ergebnis) > 2048 or not URL_MUSTER.match(ergebnis):
        raise Fehler("Adresse ist ungültig")
    return ergebnis


def slug(name, vorhanden):
    text = name.lower()
    for alt, neu in (("ä", "ae"), ("ö", "oe"), ("ü", "ue"), ("ß", "ss")):
        text = text.replace(alt, neu)
    text = unicodedata.normalize("NFKD", text).encode("ascii", "ignore").decode("ascii")
    text = re.sub(r"[^a-z0-9]+", "-", text).strip("-")[:40].strip("-") or "webapp"
    kandidat, n = text, 2
    while kandidat in vorhanden:
        kandidat = f"{text}-{n}"
        n += 1
    return kandidat


# ---------------------------------------------------------------- webapps.json

class Sperre:
    """Dieselbe Sperre wie zenos-konfig: schreibende Aufrufe laufen nacheinander."""

    def __enter__(self):
        laufzeit = os.environ.get("XDG_RUNTIME_DIR", "")
        if laufzeit and os.path.isdir(laufzeit):
            ordner, name = os.path.join(laufzeit, "zenos"), "konfig.lock"
        else:
            ordner, name = ZUSTAND, ".konfig.lock"
        os.makedirs(ordner, mode=0o700, exist_ok=True)
        self.datei = open(os.path.join(ordner, name), "a", encoding="utf-8")  # noqa: SIM115
        fcntl.flock(self.datei, fcntl.LOCK_EX)
        return self

    def __exit__(self, *_):
        fcntl.flock(self.datei, fcntl.LOCK_UN)
        self.datei.close()


def laden():
    """Liste der Web-Apps; fehlt die Datei, ist sie leer."""
    try:
        with open(DATEI, encoding="utf-8") as f:
            daten = json.load(f)
    except FileNotFoundError:
        return []
    except (OSError, ValueError, UnicodeDecodeError):
        raise Fehler("webapps.json ist nicht lesbar oder kein gültiges JSON") from None
    if not isinstance(daten, dict) or not isinstance(daten.get("webapps"), list):
        raise Fehler("webapps.json hat nicht die erwartete Form")
    return [w for w in daten["webapps"] if isinstance(w, dict) and isinstance(w.get("id"), str)]


def _schema_pruefen(daten):
    try:
        import jsonschema  # noqa: PLC0415 – nur zum Schreiben nötig
    except ImportError:
        return
    try:
        with open(SCHEMA, encoding="utf-8") as f:
            schema = json.load(f)
    except (OSError, ValueError):
        return
    fehler = next(jsonschema.validators.validator_for(schema)(schema).iter_errors(daten), None)
    if fehler is not None:
        ort = "/".join(str(p) for p in fehler.absolute_path) or "(Wurzel)"
        raise Fehler(f"webapps.json: {ort} passt nicht zum Schema, nicht gespeichert")


def speichern(liste):
    daten = {"webapps": liste}
    _schema_pruefen(daten)
    text = json.dumps(daten, ensure_ascii=False, indent=2) + "\n"
    os.makedirs(KONFIG, mode=0o700, exist_ok=True)
    try:
        modus = os.stat(DATEI).st_mode & 0o777
    except OSError:
        modus = 0o600
    fd, tmp = tempfile.mkstemp(dir=KONFIG, prefix=".zenos-webapp.", suffix=".tmp")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
            f.flush()
            os.fsync(f.fileno())
        os.chmod(tmp, modus)
        os.replace(tmp, DATEI)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


# ---------------------------------------------------------------- Desktop-Dateien

def exec_argument(arg):
    """Ein Argument für Exec: in Anführungszeichen, wenn nötig; «%» wird zu «%%»."""
    if FELDCODE.match(arg):
        return arg
    if arg == "" or any(c in RESERVIERT for c in arg):
        arg = '"' + "".join("\\" + c if c in '"`$\\' else c for c in arg) + '"'
    return arg.replace("%", "%%")


def exec_wert(argumente):
    """Exec-Wert aus einer Argumentliste. Danach gilt die Escape-Regel für Strings (\\ → \\\\)."""
    return " ".join(exec_argument(a) for a in argumente).replace("\\", "\\\\")


def exec_zerlegen(wert):
    """Exec-Wert in Argumente zerlegen (Feldcodes bleiben als eigene Argumente stehen)."""
    text, i = [], 0
    while i < len(wert):  # Escape-Regel für Strings
        c = wert[i]
        if c == "\\" and i + 1 < len(wert):
            folgend = wert[i + 1]
            text.append({"s": " ", "n": "\n", "t": "\t", "r": "\r", "\\": "\\"}.get(folgend, "\\" + folgend))
            i += 2
            continue
        text.append(c)
        i += 1
    text = "".join(text)
    argumente, aktuell, in_zitat, hat_arg, i = [], [], False, False, 0
    while i < len(text):
        c = text[i]
        if in_zitat:
            if c == "\\" and i + 1 < len(text) and text[i + 1] in '"`$\\':
                aktuell.append(text[i + 1])
                i += 2
                continue
            if c == '"':
                in_zitat = False
            else:
                aktuell.append(c)
        elif c == '"':
            in_zitat, hat_arg = True, True
        elif c == " ":
            if aktuell or hat_arg:
                argumente.append("".join(aktuell))
            aktuell, hat_arg = [], False
        elif c == "%" and i + 1 < len(text) and text[i + 1] == "%":
            aktuell.append("%")
            i += 1
        else:
            aktuell.append(c)
        i += 1
    if in_zitat:
        raise ValueError("offenes Anführungszeichen")
    if aktuell or hat_arg:
        argumente.append("".join(aktuell))
    return argumente


def _string_wert(text):
    return text.replace("\\", "\\\\")


def webapp_desktop(webapp):
    """Inhalt des Starters einer Web-App."""
    url = url_bereinigen(webapp["url"])
    name = name_bereinigen(webapp["name"])
    profil = profil_bereinigen(webapp.get("chromeProfil", ""))
    argumente = [CHROME_STARTER]
    if profil:
        argumente += ["--zenos-profil", profil]
    argumente.append("--app=" + url)
    host = urllib.parse.urlsplit(url).hostname or ""
    zeilen = [
        "[Desktop Entry]",
        "Type=Application",
        "Version=1.5",
        "Name=" + _string_wert(name),
        "GenericName=Web-App",
        "Comment=" + _string_wert("Web-App · " + host),
        "Exec=" + exec_wert(argumente),
        "Terminal=false",
        "StartupNotify=true",
        "Categories=Network;",
        "Keywords=web;webapp;" + host.replace(";", "") + ";",
    ]
    symbol = webapp.get("symbol")
    if isinstance(symbol, str) and (re.match(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$", symbol)
                                    or (os.path.isabs(symbol) and not _steuerzeichen(symbol))):
        zeilen.append("Icon=" + _string_wert(symbol))
    zeilen.append(f"{MARKE_WEBAPP}={webapp['id']}")
    return "\n".join(zeilen) + "\n"


def _marke(pfad, schluessel):
    """Wert von schluessel in der Gruppe [Desktop Entry] oder None."""
    try:
        with open(pfad, encoding="utf-8") as f:
            for zeile in f:
                if zeile.startswith(schluessel + "="):
                    return zeile.split("=", 1)[1].strip()
    except (OSError, UnicodeDecodeError):
        return None
    return None


def _datei_schreiben(pfad, inhalt, melden, aenderungen):
    try:
        with open(pfad, encoding="utf-8") as f:
            if f.read() == inhalt:
                return
    except (OSError, UnicodeDecodeError):
        pass
    os.makedirs(os.path.dirname(pfad), exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(pfad), prefix=".zenos-webapp.", suffix=".tmp")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(inhalt)
        os.chmod(tmp, 0o644)
        os.replace(tmp, pfad)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise
    aenderungen.append(pfad)
    if melden:
        print(pfad.replace(HOME, "~", 1))


def _datei_entfernen(pfad, melden, aenderungen):
    try:
        os.unlink(pfad)
    except FileNotFoundError:
        return
    aenderungen.append(pfad)
    if melden:
        print("entfernt: " + pfad.replace(HOME, "~", 1))


def chrome_desktop(quelle):
    """Kopie eines Chrome-Starters, deren Exec-Zeilen zenos-chrome aufrufen."""
    with open(quelle, encoding="utf-8") as f:
        zeilen = f.read().splitlines()
    ergebnis = []
    for zeile in zeilen:
        if zeile.startswith("Exec="):
            try:
                argumente = exec_zerlegen(zeile[5:])
            except ValueError:
                argumente = []
            if argumente and os.path.basename(argumente[0]).startswith("google-chrome"):
                zeile = "Exec=" + exec_wert([CHROME_STARTER] + argumente[1:])
        elif zeile.startswith("TryExec="):
            continue
        ergebnis.append(zeile)
        if zeile.strip() == "[Desktop Entry]":
            ergebnis.append(f"{MARKE_CHROME}=chrome")
    return "\n".join(ergebnis) + "\n"


def chrome_synchronisieren(melden, aenderungen):
    for name in CHROME_DATEIEN:
        ziel = os.path.join(ANWENDUNGEN, name)
        quelle = next((os.path.join(o, name) for o in SYSTEM_ANWENDUNGEN if os.path.isfile(os.path.join(o, name))), None)
        eigene = os.path.isfile(ziel) and _marke(ziel, MARKE_CHROME) == "chrome"
        if quelle is None:
            if eigene:
                _datei_entfernen(ziel, melden, aenderungen)
            continue
        if os.path.exists(ziel) and not eigene:
            # Eine eigene Anpassung von dir bleibt unangetastet
            continue
        try:
            inhalt = chrome_desktop(quelle)
        except (OSError, UnicodeDecodeError):
            meldung(f"{quelle} ist nicht lesbar, Chrome-Starter unverändert")
            continue
        _datei_schreiben(ziel, inhalt, melden, aenderungen)


def synchronisieren(melden=False):
    aenderungen = []
    try:
        liste = laden()
    except Fehler as e:
        # Mit einer kaputten Datei nichts löschen
        meldung(str(e))
        liste = None
    if liste is not None:
        gewollt = set()
        for webapp in liste:
            if not ID_MUSTER.match(webapp["id"]) or len(webapp["id"]) > 64:
                continue
            try:
                inhalt = webapp_desktop(webapp)
            except (Fehler, KeyError, TypeError) as e:
                meldung(f"Web-App {webapp['id']} übersprungen: {e}")
                continue
            gewollt.add(PRAEFIX + webapp["id"] + ".desktop")
            _datei_schreiben(os.path.join(ANWENDUNGEN, PRAEFIX + webapp["id"] + ".desktop"), inhalt, melden, aenderungen)
        try:
            vorhanden = os.listdir(ANWENDUNGEN)
        except FileNotFoundError:
            vorhanden = []
        for name in vorhanden:
            pfad = os.path.join(ANWENDUNGEN, name)
            if name.startswith(PRAEFIX) and name.endswith(".desktop") and name not in gewollt \
                    and _marke(pfad, MARKE_WEBAPP) is not None:
                _datei_entfernen(pfad, melden, aenderungen)
    chrome_synchronisieren(melden, aenderungen)
    return aenderungen


# ---------------------------------------------------------------- Befehle

def _optionen(args, erlaubt):
    werte, rest, i = {}, [], 0
    while i < len(args):
        a = args[i]
        schluessel, gleich, wert = a.partition("=")
        if schluessel in erlaubt:
            if not gleich:
                if i + 1 >= len(args):
                    raise Fehler(f"{a} braucht einen Wert", 2)
                wert = args[i + 1]
                i += 1
            werte[schluessel] = wert
        elif a.startswith("--"):
            raise Fehler(f"unbekannte Option «{a}»", 2)
        else:
            rest.append(a)
        i += 1
    return werte, rest


def befehl_liste(args):
    als_json = "--json" in args
    if any(a != "--json" for a in args):
        raise Fehler("Aufruf: zenos-webapp liste [--json]", 2)
    liste = laden()
    if als_json:
        json.dump(liste, sys.stdout, ensure_ascii=False)
        sys.stdout.write("\n")
        return 0
    if not liste:
        print("Keine Web-Apps.")
    for w in liste:
        profil = w.get("chromeProfil") or ""
        print(f"{w['id']}\t{w.get('name', '')}\t{w.get('url', '')}" + (f"\t{profil}" if profil else ""))
    return 0


def befehl_anlegen(args):
    werte, rest = _optionen(args, ("--name", "--url", "--profil"))
    if rest or "--name" not in werte or "--url" not in werte:
        raise Fehler("Aufruf: zenos-webapp anlegen --name NAME --url URL [--profil PROFIL]", 2)
    name = name_bereinigen(werte["--name"])
    url = url_bereinigen(werte["--url"])
    profil = profil_bereinigen(werte.get("--profil", ""))
    with Sperre():
        liste = laden()
        neu_id = slug(name, {w["id"] for w in liste})
        eintrag = {"id": neu_id, "name": name, "url": url}
        if profil:
            eintrag["chromeProfil"] = profil
        liste.append(eintrag)
        speichern(liste)
        synchronisieren()
    print(neu_id)
    return 0


def befehl_loeschen(args):
    if len(args) != 1 or not ID_MUSTER.match(args[0]) or len(args[0]) > 64:
        raise Fehler("Aufruf: zenos-webapp loeschen ID", 2)
    with Sperre():
        liste = laden()
        rest = [w for w in liste if w["id"] != args[0]]
        if len(rest) == len(liste):
            raise Fehler("Diese Web-App gibt es nicht")
        speichern(rest)
        synchronisieren()
    return 0


def befehl_pruefen(args):
    if len(args) != 1:
        raise Fehler("Aufruf: zenos-webapp pruefen URL", 2)
    print(url_bereinigen(args[0]))
    return 0


def befehl_synchronisieren(args):
    if any(a != "--melden" for a in args):
        raise Fehler("Aufruf: zenos-webapp synchronisieren [--melden]", 2)
    with Sperre():
        synchronisieren(melden="--melden" in args)
    return 0


BEFEHLE = {
    "liste": befehl_liste,
    "anlegen": befehl_anlegen,
    "loeschen": befehl_loeschen,
    "pruefen": befehl_pruefen,
    "synchronisieren": befehl_synchronisieren,
}


def main(argv):
    if not argv or argv[0] in ("-h", "--hilfe", "--help", "hilfe"):
        print(__doc__.strip())
        return 0 if argv else 2
    befehl = BEFEHLE.get(argv[0])
    if befehl is None:
        meldung(f"unbekannter Befehl «{argv[0]}» (zenos-webapp --hilfe)")
        return 2
    try:
        return befehl(argv[1:])
    except Fehler as e:
        meldung(str(e))
        return e.code
    except OSError as e:
        meldung(f"Systemfehler: {e.strerror or type(e).__name__}")
        return 2
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
