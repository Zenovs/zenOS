#!/usr/bin/env bash
# zenos-bildschirmfoto – Bildschirmfoto eines Bereichs: Bereich wählen (slurp), aufnehmen (grim),
# als PNG nach ~/Bilder/Screenshots/ speichern und zugleich in die Zwischenablage kopieren (wl-copy).
#
#   zenos-bildschirmfoto          Bereich mit der Maus wählen
#   zenos-bildschirmfoto --ganz   ganzer Bildschirm (alle Ausgänge)
#
# Abbruch der Auswahl (Esc, rechte Maustaste) endet still mit Exit 0. Ein kurzer Hinweis erscheint
# über zenos-ipc, falls die Oberfläche läuft. Exit 1 bei Fehlern, 64 bei falschem Aufruf.
# Für Tests ohne Zeiger ersetzt ZENOS_BILDSCHIRMFOTO_BEREICH="<x>,<y> <b>x<h>" die Auswahl.
# Das Bild bleibt lokal; nichts wird hochgeladen.

set -euo pipefail

BIN=$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")
TOKENS="$BIN/../../shell/theme/tokens.json"

meldung() { printf 'zenos-bildschirmfoto: %s\n' "$*" >&2; }
hinweis() { "$BIN/zenos-ipc" hinweis zeigen "$1" > /dev/null 2>&1 || true; }
fehler() { # MELDUNG HINWEIS
  meldung "$1"
  hinweis "$2"
  exit 1
}

ganz=0
case "${1:-}" in
  "") ;;
  --ganz) ganz=1 ;;
  -h | --hilfe | --help)
    sed -n '4,7p' "$0" | sed 's/^# \{0,1\}//'
    exit 0
    ;;
  *)
    meldung "unbekannte Option «$1» (--ganz, --hilfe)"
    exit 64
    ;;
esac

[[ -n "${HOME:-}" && -d "$HOME" ]] || fehler "HOME fehlt" "Bildschirmfoto nicht möglich"
[[ -n "${WAYLAND_DISPLAY:-}" ]] || fehler "keine Wayland-Sitzung (WAYLAND_DISPLAY fehlt)" "Bildschirmfoto nicht möglich"
for programm in grim wl-copy; do
  command -v "$programm" > /dev/null || fehler "$programm fehlt" "Bildschirmfoto nicht möglich: $programm fehlt"
done

# Nie zwei Auswahlen gleichzeitig (z. B. Taste zweimal gedrückt)
sperrordner="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/zenos"
[[ -d "$sperrordner" ]] || mkdir -m 0700 -- "$sperrordner" 2> /dev/null || true
if [[ -d "$sperrordner" && -w "$sperrordner" ]]; then
  exec 9> "$sperrordner/bildschirmfoto.lock"
  flock -n 9 || exit 0
fi

# Farben der Auswahl aus den Design-Tokens: Umgebung leicht abgedunkelt (abdunkeln, höchstens
# 40 % deckend, damit der Inhalt erkennbar bleibt), Rahmen im Akzent. Ohne jq oder Tokens gelten
# die Farben von slurp.
slurp_farben() {
  command -v jq > /dev/null && [[ -r "$TOKENS" ]] || return 0
  local modus=hell akzent="" werte grund rand r g b a
  if [[ "$(gsettings get org.gnome.desktop.interface color-scheme 2> /dev/null || true)" == *prefer-dark* ]]; then
    modus=dunkel
  fi
  akzent=$(jq -r '.akzent // empty' "$HOME/.local/state/zenos/thema.json" 2> /dev/null || true)
  werte=$(jq -r --arg m "$modus" --arg a "$akzent" '
    .farben as $f
    | ($f.akzente[$a] // $f.akzente[$f.standardAkzent]) as $akz
    | [$f[$m].abdunkeln, $akz[$m]] | @tsv' "$TOKENS" 2> /dev/null) || return 0
  IFS=$'\t' read -r grund rand <<< "$werte"
  [[ "$rand" =~ ^#[0-9A-Fa-f]{6}$ ]] || return 0
  if [[ "$grund" =~ ^rgba\(\ *([0-9]{1,3})\ *,\ *([0-9]{1,3})\ *,\ *([0-9]{1,3})\ *,\ *([0-9.]+)\ *\)$ ]]; then
    r=${BASH_REMATCH[1]} g=${BASH_REMATCH[2]} b=${BASH_REMATCH[3]} a=${BASH_REMATCH[4]}
    a=$(awk -v a="$a" 'BEGIN { if (a > 0.4) a = 0.4; if (a < 0) a = 0; printf "%d", a * 255 + 0.5 }')
    printf -- '-b\n#%02X%02X%02X%02X\n' "$r" "$g" "$b" "$a"
  fi
  printf -- '-c\n%sFF\n-s\n#00000000\n-w\n2\n' "$rand"
}

bereich=""
if [[ -n "${ZENOS_BILDSCHIRMFOTO_BEREICH:-}" ]]; then
  bereich=$ZENOS_BILDSCHIRMFOTO_BEREICH
  [[ "$bereich" =~ ^-?[0-9]+,-?[0-9]+\ [0-9]+x[0-9]+$ ]] \
    || fehler "ZENOS_BILDSCHIRMFOTO_BEREICH als «x,y BxH»" "Bildschirmfoto nicht möglich"
elif (( ! ganz )); then
  command -v slurp > /dev/null || fehler "slurp fehlt" "Bildschirmfoto nicht möglich: slurp fehlt"
  mapfile -t farben < <(slurp_farben)
  # Abbruch (Esc) beendet slurp mit einem Fehler: still aufhören
  bereich=$(slurp "${farben[@]}" 2> /dev/null) || exit 0
  [[ -n "$bereich" ]] || exit 0
fi

ziel="$HOME/Bilder/Screenshots"
mkdir -p -- "$ziel"
stempel=$(date +%Y-%m-%d_%H-%M-%S)
datei="$ziel/Bildschirmfoto_$stempel.png"
n=2
while [[ -e "$datei" ]]; do
  datei="$ziel/Bildschirmfoto_${stempel}_$n.png"
  n=$((n + 1))
done

# Bildschirmfotos können Vertrauliches zeigen: nur für den Benutzer lesbar
umask 077
teil="$datei.teil"
trap 'rm -f -- "$teil"' EXIT
if (( ${#bereich} > 0 )); then
  grim -t png -g "$bereich" "$teil" || fehler "grim konnte nicht aufnehmen" "Bildschirmfoto fehlgeschlagen"
else
  grim -t png "$teil" || fehler "grim konnte nicht aufnehmen" "Bildschirmfoto fehlgeschlagen"
fi
mv -- "$teil" "$datei"
trap - EXIT

# Sperre freigeben: wl-copy bleibt im Hintergrund, bis etwas anderes kopiert wird, und darf sie
# nicht erben (sonst blockierte es jedes weitere Bildschirmfoto)
exec 9>&-
if wl-copy --type image/png < "$datei"; then
  hinweis "Bildschirmfoto kopiert und gespeichert"
else
  meldung "wl-copy fehlgeschlagen, das Bild liegt unter $datei"
  hinweis "Bildschirmfoto gespeichert, nicht kopiert"
fi
printf '%s\n' "$datei"
