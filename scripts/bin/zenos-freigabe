#!/usr/bin/env bash
# zenos-freigabe – Bildschirmfreigabe erkennen (aufgerufen von xdg-desktop-portal-wlr, siehe
# system/portal/xdpw.conf).
#
#   zenos-freigabe start     exec_before: Freigabe beginnt (Marker setzen, Oberfläche benachrichtigen)
#   zenos-freigabe ende      exec_after: Freigabe endet
#   zenos-freigabe waehlen   chooser_cmd: Bildschirm mit slurp wählen, Oberfläche benachrichtigen,
#                            «Monitor: <Ausgang>» ausgeben
#   zenos-freigabe status    «aktiv N» oder «inaktiv»
#
# Marker: $XDG_RUNTIME_DIR/zenos/freigabe, eine Zeile je geteiltem Ausgang (oder «*», wenn er nicht
# bekannt ist). Die Oberfläche (freigabe/Freigabe.qml) liest ihn beim Start und beobachtet ihn;
# zusätzlich meldet zenos-ipc freigabe gewaehlt|gestartet|beendet sofort.
#
# xdg-desktop-portal-wlr 0.8 wartet nicht auf exec_before (Doppel-fork) und legt den Stream gleich
# danach an; im Container zeigte das erste Bild noch eine Mitteilung mit Inhalt. Auf den Chooser
# wartet es dagegen. Deshalb meldet schon die Wahl die Freigabe (IPC «gewaehlt»), bevor der Stream
# beginnt; exec_before setzt danach den Marker. Ohne Wahl (gespeichertes Token, das xdpw nur mit
# XDPW_PERSIST_MODE ausgibt; zenOS setzt das nicht) bleibt es beim Wettlauf.
# exec_before läuft nur für die erste von mehreren gleichzeitigen Freigaben, exec_after erst nach
# der letzten: Eine Wahl während einer laufenden Freigabe trägt ihren Ausgang selbst ein, und «ende»
# leert den Marker ganz.

set -euo pipefail

laufzeit=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
ordner=$laufzeit/zenos
marker=$ordner/freigabe
wahl=$ordner/freigabe-wahl
bin=$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")

meldung() { printf 'zenos-freigabe: %s\n' "$*" >&2; }

ordner_bereit() {
  if [[ ! -d "$ordner" ]]; then
    mkdir -p -- "$ordner"
    chmod 0700 -- "$ordner"
  fi
}

# Führt den Rest der Zeile unter einer Sperre aus (start/ende/waehlen können gleichzeitig laufen)
gesperrt() {
  ordner_bereit
  exec {sperre}>> "$ordner/freigabe.lock"
  flock -w 5 "$sperre" || meldung "Sperre nicht erhalten, fahre trotzdem fort"
  "$@"
  flock -u "$sperre" || true
}

ausgang_gueltig() { [[ "$1" =~ ^[A-Za-z0-9._-]{1,64}$ ]]; }

# Oberfläche benachrichtigen; blockiert das Portal nie lange. Exit 0 nur, wenn die Shell es annahm.
melden() {
  local ipc=$bin/zenos-ipc
  [[ -x "$ipc" ]] || return 1
  timeout 5 "$ipc" freigabe "$@" >/dev/null 2>&1
}

marker_schreiben() {
  printf '%s\n' "$@" > "$marker.neu"
  mv -f -- "$marker.neu" "$marker"
}

_start() {
  local ausgang="*" jetzt alter
  if [[ -f "$wahl" ]]; then
    jetzt=$(date +%s)
    alter=$(stat -c %Y -- "$wahl" 2>/dev/null || echo 0)
    ausgang=$(head -n 1 -- "$wahl" 2>/dev/null || true)
    rm -f -- "$wahl"
    # Eine alte Wahl (z. B. abgebrochene Freigabe) zählt nicht
    if (( jetzt - alter > 120 )) || ! ausgang_gueltig "$ausgang"; then ausgang="*"; fi
  fi
  printf '%s\n' "$ausgang" >> "$marker"
}

# exec_after kommt erst nach der letzten Freigabe: alles ist zu Ende
_ende() {
  rm -f -- "$marker" "$marker.neu"
}

# Gewählten Ausgang festhalten; «start» übernimmt ihn in den Marker. Steht schon etwas im Marker,
# läuft eine Freigabe, und xdpw ruft exec_before nicht noch einmal auf: dann gleich eintragen
# (einen unbekannten Ausgang «*» ersetzen, falls exec_before vor der Wahl lief).
_wahl_merken() {
  local ausgang=$1 i
  local -a zeilen=()
  if [[ -s "$marker" ]]; then
    mapfile -t zeilen < "$marker"
    for (( i = ${#zeilen[@]} - 1; i >= 0; i-- )); do
      if [[ "${zeilen[i]}" == "*" ]]; then
        zeilen[i]=$ausgang
        marker_schreiben "${zeilen[@]}"
        return 0
      fi
    done
    for (( i = 0; i < ${#zeilen[@]}; i++ )); do
      [[ "${zeilen[i]}" == "$ausgang" ]] && return 0
    done
    marker_schreiben "${zeilen[@]}" "$ausgang"
    return 0
  fi
  printf '%s\n' "$ausgang" > "$wahl"
}

befehl_start() {
  gesperrt _start
  melden gestartet || true
}

befehl_ende() {
  gesperrt _ende
  melden beendet || true
}

befehl_waehlen() {
  local ausgang
  if ! command -v slurp >/dev/null 2>&1; then
    meldung "slurp fehlt"
    exit 1
  fi
  # Abbruch mit Esc: kein Ausgang, das Portal bricht die Freigabe ab
  ausgang=$(slurp -f '%o' -or) || exit 1
  ausgang=${ausgang%%$'\n'*}
  if ! ausgang_gueltig "$ausgang"; then
    meldung "unerwartete Ausgabe von slurp"
    exit 1
  fi
  gesperrt _wahl_merken "$ausgang"
  # Vor der Ausgabe melden: xdpw legt den Stream erst an, wenn der Chooser endet. zenos-ipc kehrt
  # zurück, sobald die Oberfläche die Meldung verarbeitet hat; das Bild ohne Inhalte folgt ein bis
  # zwei Bildwechsel später, deshalb kurz warten.
  if melden gewaehlt "$ausgang"; then sleep 0.1; fi
  printf 'Monitor: %s\n' "$ausgang"
}

befehl_status() {
  local n=0
  if [[ -f "$marker" ]]; then n=$(grep -c . "$marker" || true); fi
  if (( n > 0 )); then echo "aktiv $n"; else echo "inaktiv"; fi
}

case "${1:-}" in
  start) befehl_start ;;
  ende) befehl_ende ;;
  waehlen) befehl_waehlen ;;
  status) befehl_status ;;
  *)
    sed -n '2,9p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' >&2
    exit 2
    ;;
esac
