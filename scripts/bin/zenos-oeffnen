#!/usr/bin/env bash
# zenos-oeffnen – öffnet eine Datei, einen Ordner oder eine Adresse mit der zuständigen App oder startet ein
# Programm, beides in einer eigenen Einheit, und meldet über den Exit-Code, ob das geklappt hat. Die
# Oberfläche ruft es über Aktionen auf (dateiOeffnen, appStarten, terminal …) und zeigt bei einem Fehler
# einen Hinweis.
#
#   zenos-oeffnen [--] PFAD|URL
#   zenos-oeffnen --programm NAME -- BEFEHL [ARGUMENT …]
#
# Öffnet mit «gio open», nicht mit xdg-open: xdg-open wartet unter labwc (generischer Modus), bis die App
# beendet ist, und startet Apps mit Terminal=true (z. B. vim.desktop auf Ubuntu Server) ohne Terminal,
# meldet dabei aber Erfolg. gio startet die App (Terminal-Apps in x-terminal-emulator, also kitty), kehrt
# gleich zurück und endet mit einem Fehler, wenn keine App zuständig ist. Einen Ordner ohne zuständige App
# öffnet es in kitty (zenOS bringt keinen Dateimanager mit).
#
# --programm startet BEFEHL und kehrt gleich zurück; NAME (z. B. die Desktop-ID) steht im Namen der Einheit.
# Vorher prüft es, ob es das Programm gibt, bei «env NAME=WERT … PROGRAMM» (häufig in Startern) das Programm
# hinter den Zuweisungen: Nach dem Start lässt sich ein Fehler nicht mehr melden.
#
# Die App bekommt eine eigene Sitzung (setsid) und, wenn die systemd-Benutzerinstanz erreichbar ist, eine
# eigene Einheit (app-zenos-<name>-<zeit>.scope in app.slice): Sie läuft weiter, wenn dieses Programm endet
# oder zenos-shell.service neu startet. Ihre Ein- und Ausgaben gehen ins Leere.
#
# Exit 0 geöffnet bzw. gestartet · 1 fehlgeschlagen · 2 nicht gefunden · 3 keine App für die Datei oder
# Adresse · 4 keine App für den Ordner (und kein kitty) · 64 falscher Aufruf · 127 Programm nicht gefunden

set -uo pipefail

meldung() { printf 'zenos-oeffnen: %s\n' "$*" >&2; }

aufruf() {
  meldung "Aufruf: zenos-oeffnen [--] PFAD|URL · zenos-oeffnen --programm NAME -- BEFEHL [ARGUMENT …]"
  exit 64
}

# Name der Einheit: app-zenos-<name>-<zeit>. Nur [A-Za-z0-9_-] (erlaubt in jedem Einheitennamen), alles
# andere wird zu «_».
einheit() {
  local name=${1//[^A-Za-z0-9_-]/_}
  name=${name:0:64}
  printf 'app-zenos-%s-%s' "${name:-app}" "${EPOCHREALTIME//[.,]/}"
}

# Führt BEFEHL in einer eigenen Einheit aus, sonst ohne: in_einheit NAME BESCHREIBUNG BEFEHL [ARGUMENT …]
# Die Beschreibung erscheint im Journal statt der Befehlszeile (keine Datei- und Adressnamen).
# Exit-Code: der von BEFEHL. systemd-run selbst endet bei Fehlern mit 1 (keine Einheit möglich); dann
# läuft BEFEHL ohne eigene Einheit. BEFEHL darf deshalb nicht mit 1 scheitern: gio endet bei Fehlern mit 2,
# setsid --fork mit 0.
in_einheit() {
  local name=$1 beschreibung=$2 code=0
  shift 2
  if [[ -n "${XDG_RUNTIME_DIR:-}" && -S "$XDG_RUNTIME_DIR/systemd/private" ]] && command -v systemd-run > /dev/null; then
    systemd-run --user --scope --quiet --collect --slice=app.slice --unit="$(einheit "$name")" \
      --description="$beschreibung" -- "$@" < /dev/null > /dev/null 2>&1 || code=$?
    if (( code != 1 )); then
      return "$code"
    fi
    meldung "keine eigene Einheit möglich (systemd-run), starte ohne"
    code=0
  fi
  "$@" < /dev/null > /dev/null 2>&1 || code=$?
  return "$code"
}

# Gibt es PROGRAMM? Mit Schrägstrich als Pfad (relativ zum Arbeitsordner, wie bei exec), sonst im PATH;
# PFAD ersetzt den PATH (Zuweisung PATH=… vor dem Programm): programm_da PROGRAMM [PFAD]
programm_da() {
  if [[ "$1" == */* ]]; then
    [[ -x "$1" && ! -d "$1" ]]
  elif (( $# > 1 )); then
    (PATH=$2 && command -v -- "$1" > /dev/null)
  else
    command -v -- "$1" > /dev/null
  fi
}

# Das Programm, das BEFEHL startet, muss es geben (sonst Exit 127): BEFEHL [ARGUMENT …]
# Bei env zählt das Programm hinter den Zuweisungen NAME=WERT. Folgt eine Option von env (-u, -i, -S, --)
# oder nichts mehr, wird nur env geprüft.
programm_pruefen() {
  local -a pfad=()
  local i
  if ! programm_da "$1"; then
    meldung "Programm nicht gefunden: $1"
    exit 127
  fi
  [[ "$1" == env || "$1" == */env ]] || return 0
  for (( i = 2; i <= $#; i++ )); do
    [[ "${!i}" =~ ^[A-Za-z_][A-Za-z0-9_]*= ]] || break
    [[ "${!i}" != PATH=* ]] || pfad=("${!i#PATH=}")
  done
  (( i <= $# )) && [[ "${!i}" != -* ]] || return 0
  if ! programm_da "${!i}" "${pfad[@]}"; then
    meldung "Programm nicht gefunden: ${!i}"
    exit 127
  fi
}

programm=""
case "${1:-}" in
  -h | --hilfe | --help)
    sed -n '2,/^$/p' "$0" | sed -n 's/^# \{0,1\}//p'
    exit 0
    ;;
  --programm)
    if (( $# < 4 )) || [[ "$3" != -- || -z "$4" ]]; then
      aufruf
    fi
    programm=$2
    shift 3
    ;;
  --) shift ;;
  -*)
    meldung "unbekannte Option «$1»"
    exit 64
    ;;
esac

# Programm starten: setsid --fork kehrt gleich zurück, das Programm läuft in der Einheit weiter
if [[ -n "$programm" ]]; then
  programm_pruefen "$@"
  if ! in_einheit "$programm" "Gestartet von zenOS: $programm" setsid --fork -- "$@"; then
    meldung "$1 liess sich nicht starten"
    exit 1
  fi
  exit 0
fi

if (( $# != 1 )) || [[ -z "$1" ]]; then
  aufruf
fi
ziel=$1

command -v gio > /dev/null || { meldung "gio fehlt (Paket libglib2.0-bin)"; exit 1; }

# Standard-App für einen MIME-Typ (Desktop-ID), leer wenn keine. Englische Ausgabe, damit sie sich
# auswerten lässt; die App selbst startet mit der Sprache der Sitzung.
standard_app() {
  LC_ALL=C gio mime "$1" 2> /dev/null | sed -n 's/^Default application for .*: //p' | head -n 1
}

# Adresse (https:, mailto:, file: …), sofern es keinen gleichnamigen Pfad gibt
schema=""
if [[ ! -e "$ziel" && "$ziel" =~ ^([A-Za-z][A-Za-z0-9+.-]*): ]]; then
  schema=${BASH_REMATCH[1],,}
fi

if [[ -z "$schema" ]]; then
  if [[ ! -e "$ziel" ]]; then
    meldung "nicht gefunden: $ziel"
    exit 2
  fi
  # gio kennt kein «--»: ein absoluter Pfad beginnt nie mit «-»
  [[ "$ziel" == /* ]] || ziel="$PWD/$ziel"
fi

# --wait: falls setsid dafür einen eigenen Prozess braucht, kommt der Exit-Code von gio trotzdem zurück
if in_einheit oeffnen "Geöffnet mit zenos-oeffnen" setsid --wait gio open "$ziel"; then
  exit 0
fi

# Warum nicht? Keine zuständige App (der häufige Fall) oder der Start der App ging schief.
if [[ -n "$schema" ]]; then
  if [[ "$schema" == file ]]; then
    meldung "lässt sich nicht öffnen: $ziel"
    exit 1
  fi
  typ="x-scheme-handler/$schema"
else
  typ=$(LC_ALL=C gio info --attributes=standard::content-type "$ziel" 2> /dev/null |
    sed -n 's/^ *standard::content-type: //p' | head -n 1)
fi
if [[ -z "$typ" ]]; then
  meldung "Typ unbekannt, lässt sich nicht öffnen: $ziel"
  exit 1
fi
app=$(standard_app "$typ")
if [[ -z "$app" ]]; then
  if [[ -z "$schema" && -d "$ziel" ]]; then
    # Ohne Dateimanager: im Terminal, in diesem Ordner
    if command -v kitty > /dev/null &&
      in_einheit kitty "Geöffnet mit zenos-oeffnen" setsid --fork -- kitty --directory "$ziel"; then
      exit 0
    fi
    meldung "keine App für $typ"
    exit 4
  fi
  meldung "keine App für $typ"
  exit 3
fi
meldung "$app liess sich nicht starten ($typ)"
exit 1
