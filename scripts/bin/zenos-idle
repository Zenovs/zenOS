#!/usr/bin/env bash
# zenos-idle – automatische Sperre bei Inaktivität und vor dem Standby, danach Bildschirm aus (swayidle), dazu der
# Hemmer für die Ein/Aus-Taste.
#
#   zenos-idle            läuft als Benutzerdienst zenos-idle.service: startet swayidle und startet es neu,
#                         sobald sich die wirksamen Zeiten in ~/.config/zenos/einstellungen.json ändern
#                         (geprüft alle 10 s, gelesen nur bei geänderter Datei). SIGUSR1 wird nur noch notiert:
#                         «Bildschirm aus» sofort geht über «zen energie aus» (swayidle beachtet Idle-Hemmer).
#   zenos-idle minuten    wirksame Sperrzeit in Minuten
#   zenos-idle pruefen    «<minuten> <standard|einstellung|begrenzt|ungueltig>» (für zen doctor, Format fest)
#   zenos-idle energie    wirksame Werte, je Zeile «<name> <wert> <art>»: sperre, bildschirm und ausschalten
#                         (Minuten), ausschaltenwenn (nie|akku|immer) und taste (sperren|menue|ausschalten)
#
# Leitplanken (Code, gespiegelt aus shell/modi/zustandslogik.js, test/einheiten/idle.test.py gleicht ab):
# Die Sperrzeit liegt immer zwischen 1 und 15 Minuten (Standard 5), die automatische Sperre lässt sich nicht
# abschalten. Gesperrt wird immer über «zen lock»: bei Inaktivität (timeout), vor dem Standby (before-sleep;
# swayidle -w wartet, bis gesperrt ist) und auf Anforderung von logind (lock, z. B. «loginctl lock-session»).
# Der Bildschirm geht 1–10 Minuten nach der Sperre aus (bildschirmAusNachSperre, Standard 1), nie davor:
# zenos-bildschirm sperrt immer zuerst (dunkel heisst gesperrt). Jede Eingabe schaltet ihn wieder an (resume),
# die Sperre bleibt. Nichts hier verzögert die Sperre: Neu gestartet wird nur bei geänderten Zeiten oder,
# nach einem Update, erst gesperrt. Ist es gesperrt und dunkel, wartet beides, bis der Bildschirm wieder an ist
# (beim Beenden führt swayidle sein resume aus, der Bildschirm ginge sonst gesperrt an). Die übrigen Energie-Werte
# (Ausschalten, Ein/Aus-Taste) starten swayidle nie neu.
#
# Deckel (Rückfallebene, Leitplanke «Zuklappen sperrt»): Die Oberfläche sperrt beim Zuklappen sofort. Läuft sie
# gerade nicht (zenos-shell.service nicht aktiv, z. B. nach einem Absturz), sperrt zenos-idle bei einem neuen Wechsel
# zu «zu» in /run/zenos/geraet.json (zenos-argon), spätestens im nächsten Takt. Nur bei einem Wechsel, nie beim
# Start: Mit zugeklapptem Deckel an einem anderen Bildschirm weiterarbeiten bleibt möglich.
#
# Ein/Aus-Taste (einAusTaste): Ausser bei «ausschalten» hält zenos-idle einen logind-Hemmer «handle-power-key»
# (systemd-inhibit … tail --pid=<zenos-idle>). Ein kurzer Druck schaltet dann nicht sofort aus, labwc gibt die Taste
# an «zenos-energie taste» (rc.xml, XF86PowerOff). Der Hemmer gilt nur, solange zenos-idle läuft (tail endet mit
# ihm, systemd-inhibit mit tail; zwischen zwei Läufen 1 s Pause, RestartSec). Er läuft im Benutzerdienst, also
# ausserhalb einer Sitzung: logind zählt ihn dann vermutlich auf allen Konsolen (am Gerät zu prüfen, siehe
# docs/module/energie.md). Ohne zenos-idle (erste Sekunden der Sitzung) schaltet ein kurzer Druck sofort aus (logind).
# Am Login-Bildschirm hält der Login einen eigenen Hemmer (zenos-energie hemmer-login), dort weckt ein kurzer Druck
# nur. Halten schaltet immer hart aus.

set -euo pipefail

readonly STANDARD=5 MINIMUM=1 MAXIMUM=15
readonly BILDSCHIRM_STANDARD=1 BILDSCHIRM_MINIMUM=1 BILDSCHIRM_MAXIMUM=10
readonly AUSSCHALTEN_STANDARD=60 AUSSCHALTEN_MINIMUM=30 AUSSCHALTEN_MAXIMUM=240
# Feste Wörter, das erste ist jeweils der Standard (wie shell/dienste/energie.js)
readonly AUSSCHALTEN_WENN="akku nie immer" TASTE="sperren menue ausschalten"
# Endet der Hemmer für die Ein/Aus-Taste unerwartet (z. B. polkit lehnt ab), so lange bis zum nächsten Versuch
readonly HEMMER_PAUSE=60
# Prüfintervall in Sekunden; ZENOS_IDLE_INTERVALL nur für die Einheitentests (1–60)
PRUEFINTERVALL=10
if [[ "${ZENOS_IDLE_INTERVALL:-}" =~ ^[1-9][0-9]?$ ]] && (( ZENOS_IDLE_INTERVALL <= 60 )); then
  PRUEFINTERVALL=$ZENOS_IDLE_INTERVALL
fi
readonly PRUEFINTERVALL

selbst=$(readlink -f -- "${BASH_SOURCE[0]}")
bin=$(dirname -- "$selbst")
zen=$(dirname -- "$bin")/zen
bildschirm=$bin/zenos-bildschirm
einstellungen=$HOME/.config/zenos/einstellungen.json
laufzeit=${XDG_RUNTIME_DIR:-/run/user/$EUID}
# Nur für Tests: legt /run/zenos/geraet.json unter diesen Ordner (wie ZENOS_ENERGIE_TESTWURZEL)
testwurzel=${ZENOS_IDLE_TESTWURZEL:-}
geraet_datei=${testwurzel%/}/run/zenos/geraet.json

meldung() { printf 'zenos-idle: %s\n' "$*" >&2; }

# Gibt je Wert eine Zeile «<name> <wert> <art>» aus (sperre, bildschirm, ausschalten, ausschaltenwenn, taste).
# Fehlt die Datei oder der Schlüssel: Standard. Zahlen werden gerundet und begrenzt, Wörter müssen genau passen,
# alles andere ergibt den Standard («ungueltig»). sperre nimmt wie bisher alles, was float() als Zahl liest (auch
# mit Komma); bildschirm und ausschalten nur Ziffern mit Punkt oder Komma, genau wie shell/dienste/energie.js.
auswerten() {
  python3 - "$einstellungen" "$STANDARD" "$MINIMUM" "$MAXIMUM" \
    "$BILDSCHIRM_STANDARD" "$BILDSCHIRM_MINIMUM" "$BILDSCHIRM_MAXIMUM" \
    "$AUSSCHALTEN_STANDARD" "$AUSSCHALTEN_MINIMUM" "$AUSSCHALTEN_MAXIMUM" "$AUSSCHALTEN_WENN" "$TASTE" <<'PY'
import json
import math
import re
import sys

datei = sys.argv[1]
WERTE = [
    ("sperre", "sperreNachMinuten", *map(int, sys.argv[2:5]), False),
    ("bildschirm", "bildschirmAusNachSperre", *map(int, sys.argv[5:8]), True),
    ("ausschalten", "ausschaltenNachMinuten", *map(int, sys.argv[8:11]), True),
]
# Wörter: (name, schlüssel, erlaubt), das erste ist der Standard
WOERTER = [
    ("ausschaltenwenn", "ausschalten", sys.argv[11].split()),
    ("taste", "einAusTaste", sys.argv[12].split()),
]
ZAHL_TEXT = re.compile(r"[+-]?(?:[0-9]+(?:[.,][0-9]*)?|[.,][0-9]+)")


def zahl(wert, streng):
    if isinstance(wert, (int, float)) and not isinstance(wert, bool):
        return float(wert)
    if isinstance(wert, str):
        text = wert.strip()
        if streng and not ZAHL_TEXT.fullmatch(text):
            return None
        try:
            return float(text.replace(",", ".", 1 if streng else -1))
        except ValueError:
            return None
    return None


def ausgabe(arten):
    standards = [standard for _, _, standard, *_ in WERTE] + [erlaubt[0] for _, _, erlaubt in WOERTER]
    namen = [w[0] for w in WERTE] + [w[0] for w in WOERTER]
    for name, standard, (wert, art) in zip(namen, standards, arten):
        print(name, standard if wert is None else wert, art)
    sys.exit(0)


ANZAHL = len(WERTE) + len(WOERTER)
try:
    with open(datei, encoding="utf-8") as f:
        daten = json.load(f)
except FileNotFoundError:
    ausgabe([(None, "standard")] * ANZAHL)
except (OSError, ValueError):
    ausgabe([(None, "ungueltig")] * ANZAHL)

arten = []
for _, schluessel, standard, minimum, maximum, streng in WERTE:
    if not isinstance(daten, dict) or schluessel not in daten:
        arten.append((None, "standard"))
        continue
    n = zahl(daten[schluessel], streng)
    if n is None or not math.isfinite(n):
        arten.append((None, "ungueltig"))
        continue
    gerundet = math.floor(n + 0.5)
    begrenzt = min(maximum, max(minimum, gerundet))
    arten.append((begrenzt, "einstellung" if begrenzt == gerundet else "begrenzt"))
for _, schluessel, erlaubt in WOERTER:
    if not isinstance(daten, dict) or schluessel not in daten:
        arten.append((None, "standard"))
    elif isinstance(daten[schluessel], str) and daten[schluessel] in erlaubt:
        arten.append((daten[schluessel], "einstellung"))
    else:
        arten.append((None, "ungueltig"))
ausgabe(arten)
PY
}

# Setzt sperre_min, bildschirm_min und taste (bei jedem Fehler die Standardwerte)
werte_lesen() {
  local name wert zeilen
  sperre_min=$STANDARD
  bildschirm_min=$BILDSCHIRM_STANDARD
  taste=${TASTE%% *}
  zeilen=$(auswerten 2>/dev/null) || zeilen=""
  while read -r name wert _; do
    if [[ "$name" == taste ]] && [[ " $TASTE " == *" $wert "* ]]; then
      taste=$wert
      continue
    fi
    [[ "$wert" =~ ^[0-9]+$ ]] || continue
    if [[ "$name" == sperre ]] && (( wert >= MINIMUM && wert <= MAXIMUM )); then
      sperre_min=$wert
    elif [[ "$name" == bildschirm ]] && (( wert >= BILDSCHIRM_MINIMUM && wert <= BILDSCHIRM_MAXIMUM )); then
      bildschirm_min=$wert
    fi
  done <<< "$zeilen"
}

minuten() {
  werte_lesen
  printf '%s\n' "$sperre_min"
}

# Format für zen doctor (65-sperre liest «<minuten> <art>» mit read -r): bleibt, wie es ist
pruefen() {
  local zeilen
  zeilen=$(auswerten) || return 1
  sed -n 's/^sperre //p' <<< "$zeilen"
}

# Stand der Einstellungsdatei (ändert sich bei jedem Schreiben, auch beim atomaren Ersetzen)
stand() { stat -c '%i %s %Y' -- "$einstellungen" 2>/dev/null || printf 'fehlt\n'; }

# Stand des eigenen Codes (zen update ersetzt die Dateien)
code_stand() { stat -L -c '%i %s %Y' -- "$selbst" "$bildschirm" 2>/dev/null | tr '\n' ' ' || true; }

# Befehle für swayidle. swayidle führt sie über sh aus, deshalb nur geprüfte feste Pfade und feste Wörter.
sperrbefehl() {
  if [[ -x "$zen" && "$zen" =~ ^[A-Za-z0-9/._-]+$ ]]; then
    printf '%s lock\n' "$zen"
  elif command -v zen >/dev/null 2>&1; then
    printf 'zen lock\n'
  else
    return 1
  fi
}

bildschirmbefehl() { # aus|an
  [[ "$1" == aus || "$1" == an ]] || return 1
  [[ -x "$bildschirm" && "$bildschirm" =~ ^[A-Za-z0-9/._-]+$ ]] || return 1
  printf '%s %s\n' "$bildschirm" "$1"
}

gesperrt() { [[ -e "$laufzeit/zenos/gesperrt" ]]; }

# Ist der Bildschirm (ganz oder teils) aus? Ohne zenos-bildschirm oder ohne Antwort: nein.
dunkel() {
  local zustand
  [[ -n "$aus" ]] || return 1
  zustand=$("$bildschirm" status 2>/dev/null) || return 1
  [[ "$zustand" == aus || "$zustand" == teils ]]
}

# --- Deckel (Rückfallebene ohne Oberfläche) -------------------------------------
# deckel_seit: Zeitpunkt des zuletzt gesehenen Wechsels («-»: noch nicht gelesen, leer: keiner im Betrieb)

deckel_pruefen() {
  local inhalt objekt zu seit=""
  [[ -r "$geraet_datei" ]] || return 0
  inhalt=$(cat -- "$geraet_datei" 2>/dev/null) || return 0
  [[ "$inhalt" =~ \"deckel\":\ *\{([^}]*)\} ]] || return 0
  objekt=${BASH_REMATCH[1]}
  [[ "$objekt" =~ \"zu\":\ *(true|false) ]] || return 0
  zu=${BASH_REMATCH[1]}
  if [[ "$objekt" =~ \"seit\":\ *\"([0-9T:.+Z-]{1,40})\" ]]; then seit=${BASH_REMATCH[1]}; fi
  if [[ "$deckel_seit" == - ]]; then
    deckel_seit=$seit
    return 0
  fi
  [[ "$seit" != "$deckel_seit" ]] || return 0
  deckel_seit=$seit
  [[ "$zu" == true && -n "$seit" ]] || return 0
  gesperrt && return 0
  # Die Oberfläche sperrt selbst (sofort); nur ohne sie springt zenos-idle ein
  if systemctl --user --quiet is-active zenos-shell.service 2>/dev/null; then return 0; fi
  printf 'Deckel zugeklappt, die Oberfläche läuft nicht: sperre (zen lock)\n'
  "$zen" lock >/dev/null 2>&1 || meldung "Sperren nach dem Zuklappen fehlgeschlagen (zen lock)"
}

# --- Hemmer für die Ein/Aus-Taste ---------------------------------------------
# hemmer_pid: laufendes systemd-inhibit (leer: keins) · hemmer_naechster: frühester neuer Versuch (SECONDS)
# hemmer_gemeldet: der letzte Fehlschlag steht schon im Journal (nicht bei jedem Versuch erneut)

hemmer_starten() {
  [[ -z "$hemmer_pid" ]] || return 0
  if ! command -v systemd-inhibit >/dev/null 2>&1; then
    (( hemmer_gemeldet )) || meldung "systemd-inhibit fehlt: kurzer Druck auf die Ein/Aus-Taste schaltet aus"
    hemmer_gemeldet=1 hemmer_naechster=$((SECONDS + HEMMER_PAUSE))
    return 0
  fi
  local -a befehl=(systemd-inhibit --what=handle-power-key --mode=block --who=zenOS
    --why="Ein/Aus-Taste: zenOS sperrt (Einstellung «Ein/Aus-Taste»)" tail --pid=$$ -f /dev/null)
  # tail --pid endet spätestens 1 s nach zenos-idle (auch nach SIGKILL), systemd-inhibit mit ihm. Nach einem
  # gemeldeten Fehlschlag still weiter versuchen (sonst stünde dieselbe Meldung jede Minute im Journal).
  if (( hemmer_gemeldet )); then
    "${befehl[@]}" 2>/dev/null &
  else
    "${befehl[@]}" &
  fi
  hemmer_pid=$!
}

hemmer_stoppen() {
  [[ -n "$hemmer_pid" ]] || return 0
  # systemd-inhibit beendet tail beim eigenen Ende (Todessignal); tail zuerst, falls nicht
  pkill -TERM -P "$hemmer_pid" -x tail 2>/dev/null || true
  kill "$hemmer_pid" 2>/dev/null || true
  wait "$hemmer_pid" 2>/dev/null || true
  hemmer_pid=""
}

# Nach jedem Lesen der Werte und in jedem Takt: Hemmer genau dann, wenn die Taste nicht «ausschalten» ist
hemmer_pruefen() {
  local rc=0
  if [[ "$taste" == ausschalten ]]; then
    if [[ -n "$hemmer_pid" ]]; then
      hemmer_stoppen
      printf 'Ein/Aus-Taste: ausschalten (logind), kein Hemmer\n'
    fi
    hemmer_naechster=0 hemmer_gemeldet=0
    return 0
  fi
  if [[ -n "$hemmer_pid" ]] && ! kill -0 "$hemmer_pid" 2>/dev/null; then
    wait "$hemmer_pid" 2>/dev/null || rc=$?
    hemmer_pid=""
    (( hemmer_gemeldet )) || meldung "Hemmer für die Ein/Aus-Taste beendet (Exit $rc, polkit oder logind): kurzer Druck schaltet aus, neuer Versuch in ${HEMMER_PAUSE} s"
    hemmer_gemeldet=1 hemmer_naechster=$((SECONDS + HEMMER_PAUSE))
  fi
  if [[ -n "$hemmer_pid" ]] && (( hemmer_gemeldet && SECONDS >= hemmer_naechster + PRUEFINTERVALL )); then
    printf 'Hemmer für die Ein/Aus-Taste läuft wieder\n'
    hemmer_gemeldet=0
  fi
  if [[ -z "$hemmer_pid" ]] && (( SECONDS >= hemmer_naechster )); then
    hemmer_starten
    if [[ -n "$hemmer_pid" ]] && (( ! hemmer_gemeldet )); then
      printf 'Ein/Aus-Taste: %s (Hemmer handle-power-key)\n' "$taste"
    fi
  fi
}

laufen() {
  command -v swayidle >/dev/null 2>&1 || { meldung "swayidle fehlt"; exit 1; }
  [[ -n "${WAYLAND_DISPLAY:-}" ]] || { meldung "WAYLAND_DISPLAY fehlt (keine grafische Sitzung)"; exit 1; }
  local sperre aus="" an="" wirksam jetzt alt neu rc code
  local -a argumente
  sperre=$(sperrbefehl) || { meldung "zen fehlt"; exit 1; }
  if aus=$(bildschirmbefehl aus) && an=$(bildschirmbefehl an); then
    :
  else
    aus="" an=""
    meldung "zenos-bildschirm fehlt: nur die Sperre, der Bildschirm bleibt an"
  fi
  code=$(code_stand)

  swayidle_pid="" hemmer_pid="" hemmer_naechster=0 hemmer_gemeldet=0 taste=${TASTE%% *} deckel_seit=-
  # Beim Beenden (systemctl stop, Ende der Sitzung) swayidle und den Hemmer mitnehmen und ohne Fehler enden. SIGTERM
  # lässt swayidle noch die offenen resume-Befehle ausführen: Ein dunkler Bildschirm geht dabei wieder an.
  trap 'if [[ -n "$swayidle_pid" ]]; then kill "$swayidle_pid" 2>/dev/null || true; fi; hemmer_stoppen; exit 0' TERM INT HUP
  # SIGUSR1 nicht mehr an swayidle weiterreichen: Seine Timeouts beachten Idle-Hemmer, mit einem Video blieb der
  # Bildschirm an, und die Timeouts blieben auf 0 (sofort gesperrt nach dem Entsperren). Nur notieren, damit das
  # Signal zenos-idle nicht beendet (ein Neustart begänne die Leerlaufzeit von vorn).
  trap 'printf "SIGUSR1 ignoriert (Bildschirm aus sofort: zen energie aus)\n"' USR1

  # Beim Start ist der Bildschirm an: Endete ein früheres swayidle hart (SIGKILL, Absturz), lief sein resume nicht,
  # und der Bildschirm bliebe sonst dunkel. Ausnahme gesperrt und dunkel: Das bleibt so (sonst leuchtete die Sperre
  # bis S+B), die Sperre der Oberfläche weckt bei jeder Eingabe, ohne Oberfläche die Ein/Aus-Taste.
  if [[ -n "$an" ]]; then
    if gesperrt && dunkel; then
      printf 'Gesperrt und dunkel: der Bildschirm bleibt aus\n'
    else
      "$bildschirm" an >/dev/null 2>&1 || meldung "Bildschirm einschalten fehlgeschlagen (zenos-bildschirm an)"
    fi
  fi

  deckel_pruefen
  alt=$(stand)
  werte_lesen
  while true; do
    hemmer_pruefen
    wirksam="$sperre_min $bildschirm_min"
    argumente=()
    if [[ -n "$aus" ]]; then
      printf 'Automatische Sperre nach %s Min., Bildschirm aus %s Min. danach\n' "$sperre_min" "$bildschirm_min"
      # Der Bildschirm nach S+B, die Sperre nach S (zenos-bildschirm aus sperrt ohnehin selbst zuerst)
      argumente+=(timeout "$(((sperre_min + bildschirm_min) * 60))" "$aus" resume "$an")
    else
      printf 'Automatische Sperre nach %s Min.\n' "$sperre_min"
    fi
    argumente+=(before-sleep "$sperre" lock "$sperre" timeout "$((sperre_min * 60))" "$sperre")
    swayidle -w "${argumente[@]}" &
    swayidle_pid=$!

    while kill -0 "$swayidle_pid" 2>/dev/null; do
      sleep "$PRUEFINTERVALL" &
      wait $! || true
      hemmer_pruefen
      deckel_pruefen
      # Neuer Stand nach zen update: erst übernehmen, wenn gesperrt ist (ein Neustart beginnt die Leerlaufzeit
      # von vorn und schöbe die Sperre sonst hinaus) und solange der Bildschirm an ist (beim Beenden schaltet
      # swayidle ihn über resume an, er bliebe gesperrt hell). systemd startet den Dienst neu (Restart=always).
      if [[ "$(code_stand)" != "$code" ]] && gesperrt && ! dunkel; then
        printf 'Neuer Stand von zenos-idle, starte neu (gesperrt)\n'
        kill "$swayidle_pid" 2>/dev/null || true
        wait "$swayidle_pid" 2>/dev/null || true
        hemmer_stoppen
        exit 0
      fi
      neu=$(stand)
      if [[ "$neu" != "$alt" ]]; then
        alt=$neu
        werte_lesen
        hemmer_pruefen
      fi
      jetzt="$sperre_min $bildschirm_min"
      [[ "$jetzt" != "$wirksam" ]] || continue
      # Gesperrt und dunkel: später übernehmen (der Neustart schaltete den Bildschirm über resume an). Gesperrt
      # ist schon, die Sperrzeit spielt bis zum Entsperren keine Rolle.
      if gesperrt && dunkel; then continue; fi
      printf 'Einstellungen geändert: Sperre nach %s Min., Bildschirm aus %s Min. danach\n' "$sperre_min" "$bildschirm_min"
      kill "$swayidle_pid" 2>/dev/null || true
      wait "$swayidle_pid" 2>/dev/null || true
      continue 2
    done

    rc=0
    wait "$swayidle_pid" || rc=$?
    meldung "swayidle hat sich beendet (Exit $rc)"
    hemmer_stoppen
    # systemd startet den Dienst neu (Restart=always)
    exit 1
  done
}

case "${1:-}" in
  "") laufen ;;
  minuten) minuten ;;
  pruefen) pruefen ;;
  energie) auswerten ;;
  -h | --hilfe | --help) sed -n '2,36p' "$selbst" | sed 's/^# \{0,1\}//' ;;
  *) meldung "unbekannter Befehl «$1» (erlaubt: minuten, pruefen, energie)"; exit 2 ;;
esac
