#!/usr/bin/env bash
# zenos-1password-sperren – sperrt 1Password mit, wenn zenOS sperrt.
#
# Tut nur etwas, wenn 1Password installiert ist und für diesen Benutzer läuft: dann «1password --lock».
# Läuft 1Password nicht, ist es ohnehin gesperrt; der Aufruf würde es sonst erst starten.
# Aufrufer: der Sperrbildschirm (shell/sperre/Sperre.qml) und die Notfall-Sperre von zen lock.
# Exit 0: gesperrt oder nichts zu tun · 1: 1Password liess sich nicht sperren

set -euo pipefail

programm=""
for kandidat in /opt/1Password/1password /usr/bin/1password; do
  if [[ -x "$kandidat" ]]; then
    programm=$kandidat
    break
  fi
done
[[ -n "$programm" ]] || exit 0

# Hauptprozess und Helfer heissen «1password»
pgrep -u "$(id -u)" -x 1password >/dev/null 2>&1 || exit 0

if ! timeout 15 "$programm" --lock >/dev/null 2>&1; then
  echo "zenos-1password-sperren: 1Password liess sich nicht sperren" >&2
  exit 1
fi
