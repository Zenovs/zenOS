# --- Log -------------------------------------------------------------------


class Log:
    """Meldungen auf stderr; unter systemd mit Priorität für das Journal."""

    def __init__(self, journal=None, stream=None):
        self.journal = ("JOURNAL_STREAM" in os.environ) if journal is None else journal
        self.stream = stream
        self._open = set()

    def _write(self, priority, text):
        prefix = f"<{priority}>" if self.journal else ""
        print(prefix + text, file=self.stream or sys.stderr, flush=True)

    def info(self, text):
        self._write(6, text)

    def warning(self, text):
        self._write(4, text)

    def error(self, text):
        self._write(3, text)

    def problem(self, key, text):
        """Warnung nur beim ersten Auftreten eines Problems (kein Log-Schwall bei Dauerfehlern)."""
        if key not in self._open:
            self._open.add(key)
            self.warning(text)

    def solved(self, key, text):
        if key in self._open:
            self._open.discard(key)
            self.info(text)


# --- Konfiguration ---------------------------------------------------------


class Config:
    def __init__(self, curve=DEFAULT_CURVE, hysteresis=DEFAULT_HYSTERESIS, delay=DEFAULT_DELAY):
        self.curve = tuple(sorted((float(t), int(s)) for t, s in curve))
        self.hysteresis = float(hysteresis)
        self.delay = float(delay)

    def describe(self):
        stufen = " · ".join(f"{_fmt(t)} °C → {s} %" for t, s in self.curve)
        return f"{stufen} · Hysterese {_fmt(self.hysteresis)} °C · absenken nach {_fmt(self.delay)} s"


def _fmt(value):
    text = f"{value:.1f}".rstrip("0").rstrip(".")
    return text.replace(".", ",")


def _is_number(value):
    return isinstance(value, (int, float)) and not isinstance(value, bool) and math.isfinite(value)


def validate_config(data):
    """Prüft eine geparste Konfiguration. Gibt (Config oder None, Fehler, Hinweise) zurück."""
    errors, notes = [], []
    if not isinstance(data, dict):
        return None, ["Die Konfiguration muss ein JSON-Objekt sein"], notes
    for key in data:
        if key not in CONFIG_KEYS:
            notes.append(f"Unbekannter Schlüssel «{key}» wird ignoriert")

    curve = DEFAULT_CURVE
    if "kurve" in data:
        raw = data["kurve"]
        if not isinstance(raw, list) or not 1 <= len(raw) <= 10:
            errors.append("«kurve» muss eine Liste mit 1 bis 10 Stufen sein")
        else:
            points = []
            for index, entry in enumerate(raw, 1):
                if not isinstance(entry, dict):
                    errors.append(f"Stufe {index}: erwartet {{\"temperatur\": …, \"luefter\": …}}")
                    continue
                for key in entry:
                    if key not in ("temperatur", "luefter"):
                        notes.append(f"Stufe {index}: unbekannter Schlüssel «{key}» wird ignoriert")
                temperature, speed = entry.get("temperatur"), entry.get("luefter")
                if not _is_number(temperature) or not 0 <= temperature <= 100:
                    errors.append(f"Stufe {index}: «temperatur» muss eine Zahl von 0 bis 100 (°C) sein")
                    continue
                if not _is_number(speed) or speed != int(speed) or not 0 <= speed <= 100:
                    errors.append(f"Stufe {index}: «luefter» muss eine ganze Zahl von 0 bis 100 (%) sein")
                    continue
                points.append((float(temperature), int(speed)))
            points.sort()
            for (t1, s1), (t2, s2) in zip(points, points[1:]):
                if t1 == t2:
                    errors.append(f"Die Temperatur {_fmt(t1)} °C steht zweimal in der Kurve")
                elif s2 < s1:
                    errors.append(f"Die Kurve fällt bei {_fmt(t2)} °C (von {s1} % auf {s2} %)")
            curve = tuple(points)

    hysteresis = data.get("hysterese", DEFAULT_HYSTERESIS)
    if not _is_number(hysteresis) or not 0 <= hysteresis <= 10:
        errors.append("«hysterese» muss eine Zahl von 0 bis 10 (°C) sein")
    delay = data.get("absenkenNachSekunden", DEFAULT_DELAY)
    if not _is_number(delay) or not 0 <= delay <= 600:
        errors.append("«absenkenNachSekunden» muss eine Zahl von 0 bis 600 sein")

    if errors:
        return None, errors, notes
    return Config(curve, hysteresis, delay), errors, notes


def load_config(path):
    """(Config, Fehler, Hinweise, eigen). Fehlt die Datei, gelten die Standardwerte ohne Meldung."""
    try:
        with open(path, encoding="utf-8") as handle:
            data = json.load(handle)
    except FileNotFoundError:
        return Config(), [], [], False
    except (OSError, ValueError) as err:
        return Config(), [f"{path} ist nicht lesbar: {err}"], [], True
    config, errors, notes = validate_config(data)
    return (config or Config()), errors, notes, True


# --- Kurve und Hysterese ---------------------------------------------------


def fan_speed(temperature, curve):
    """Lüfter in % für eine Temperatur: die höchste erreichte Stufe (wie get_fanspeed im Original)."""
    if temperature >= EMERGENCY_TEMPERATURE:
        return 100
    for threshold, speed in sorted(curve, reverse=True):
        if temperature >= threshold:
            if speed < 1:
                return 0
            return max(speed, MIN_SPEED)
    return 0


class FanController:
    """Entscheidet über den Lüfterwert: schneller sofort, langsamer mit Hysterese und Verzögerung. minimum (in %, aus
    der Mindeststufe) hebt die Kurve nur an, nie ab; ab 80 °C bleibt es bei 100 %."""

    def __init__(self, config, minimum=0):
        self.config = config
        self.minimum = minimum
        self.speed = None
        self._lower_since = None

    def forget(self):
        """Nach einem Schreibfehler: Der nächste Takt setzt den Wert neu."""
        self.speed = None
        self._lower_since = None

    def _speed(self, temperature):
        return max(fan_speed(temperature, self.config.curve), self.minimum)

    def update(self, temperature, now):
        """Neuer Lüfterwert oder None, wenn alles bleibt."""
        if temperature is None:
            return self._set(SAFE_SPEED)
        higher = self._speed(temperature)
        if self.speed is None or higher > self.speed:
            return self._set(higher)
        # Wert, der auch bei um die Hysterese höherer Temperatur gälte: erst darunter wird abgesenkt
        lower = self._speed(temperature + self.config.hysteresis)
        if lower >= self.speed:
            self._lower_since = None
            return None
        if self._lower_since is None:
            self._lower_since = now
        if now - self._lower_since < self.config.delay:
            return None
        return self._set(lower)

    def _set(self, value):
        self._lower_since = None
        if value == self.speed:
            return None
        self.speed = value
        return value


# --- Power-Button ----------------------------------------------------------


def classify_pulse(width_ms):
    """«neustart», «ausschalten» oder None für eine Pulsbreite in ms."""
    if REBOOT_PULSE_MS[0] <= width_ms < REBOOT_PULSE_MS[1]:
        return "neustart"
    if POWEROFF_PULSE_MS[0] <= width_ms < POWEROFF_PULSE_MS[1]:
        return "ausschalten"
    return None


class PulseDetector:
    """Paart steigende und fallende Flanken zu Pulsbreiten (ms)."""

    def __init__(self):
        self._rising = None

    def edge(self, rising, timestamp_ns):
        if rising:
            self._rising = timestamp_ns
            return None
        if self._rising is None:
            return None
        width = (timestamp_ns - self._rising) / 1e6
        self._rising = None
        return width if width >= 0 else None


def gpio_devices():
    """Die GPIO-Chips unter /dev (in Tests unter ZENOS_ARGON_TESTWURZEL: dort gibt es keine echten)."""
    folder = system_path("/dev")
    try:
        return sorted(os.path.join(folder, name) for name in os.listdir(folder) if name.startswith("gpiochip"))
    except OSError:
        return []


def find_line(gpiod, name, devices=None):
    """(Pfad, Offset, Label) der GPIO-Leitung mit diesem Namen; der RP1 (pinctrl-rp1) hat Vorrang. None, wenn es sie
    nicht gibt. Die Nummern der Chips wechseln je nach Gerät und Kernel, deshalb immer nach Namen suchen."""
    if devices is None:
        devices = gpio_devices()
    found = []
    for path in devices:
        try:
            if not gpiod.is_gpiochip_device(path):
                continue
            with gpiod.Chip(path) as chip:
                label = chip.get_info().label
                try:
                    offset = chip.line_offset_from_id(name)
                except (OSError, ValueError):
                    continue
        except OSError:
            continue
        found.append((label != BUTTON_CHIP_LABEL, path, offset, label))
    if not found:
        return None
    found.sort(key=lambda entry: (entry[0], len(entry[1]), entry[1]))
    return found[0][1:]


def find_button_line(gpiod, devices=None):
    """(Pfad, Offset, Label) der Zeile «GPIO4» (Power-Button des V3); der RP1 des Pi 5 hat Vorrang."""
    return find_line(gpiod, BUTTON_LINE, devices)


def find_lid_line(gpiod, devices=None):
    """(Pfad, Offset, Label) der Zeile «GPIO27» (Deckel des ONE UP); der RP1 des Compute Module 5 hat Vorrang."""
    return find_line(gpiod, LID_LINE, devices)


class ButtonWatcher(threading.Thread):
    """Wartet auf Flanken an GPIO4 und meldet Pulsbreiten an on_pulse."""

    def __init__(self, stop, on_pulse, log):
        super().__init__(name="power-button", daemon=True)
        self.stop = stop
        self.on_pulse = on_pulse
        self.log = log

    def run(self):
        try:
            self._run()
        except Exception as err:  # der Lüfter soll weiterlaufen, was auch immer hier schiefgeht
            self.log.error(f"Power-Button: unerwarteter Fehler ({err!r}), der Knopf bleibt ohne Funktion")

    def _run(self):
        try:
            import gpiod
            from gpiod.line import Direction, Edge
        except ImportError:
            self.log.warning("python3-libgpiod fehlt, der Power-Button bleibt ohne Funktion (install.sh ausführen)")
            return
        for attempt in range(3):
            if self.stop.is_set():
                return
            found = find_button_line(gpiod)
            if found is None:
                self.log.warning(f"GPIO-Zeile {BUTTON_LINE} nicht gefunden, der Power-Button bleibt ohne Funktion")
                return
            path, offset, label = found
            settings = gpiod.LineSettings(direction=Direction.INPUT, edge_detection=Edge.BOTH)
            try:
                with gpiod.request_lines(path, consumer="zenos-argon", config={offset: settings}) as request:
                    self.log.info(f"Power-Button an {BUTTON_LINE} ({path}, {label}, Zeile {offset})")
                    self._watch(request, gpiod.EdgeEvent.Type.RISING_EDGE)
                return
            except OSError as err:
                if err.errno == errno.EBUSY:
                    self.log.warning(f"{BUTTON_LINE} ist schon belegt (läuft das Argon-Originalskript argononed?), "
                                     "der Power-Button bleibt ohne Funktion")
                    return
                self.log.warning(f"Power-Button: {err} (Versuch {attempt + 1} von 3)")
                self.stop.wait(10)
        self.log.warning("Power-Button aufgegeben, der Lüfter läuft weiter")

    def _watch(self, request, rising_type):
        detector = PulseDetector()
        while not self.stop.is_set():
            if not request.wait_edge_events(1.0):
                continue
            for event in request.read_edge_events():
                width = detector.edge(event.event_type == rising_type, event.timestamp_ns)
                if width is not None:
                    self.on_pulse(width)


# --- Deckel (Argon ONE UP) -------------------------------------------------


def now_iso_ms():
    """Jetzt als ISO 8601 mit Millisekunden und Zeitzone (zwei Wechsel des Deckels sind so nie gleich datiert)."""
    return datetime.datetime.now().astimezone().isoformat(timespec="milliseconds")


class Lid:
    """Entprellter Zustand des Deckels. LidWatcher schreibt ihn (eigener Thread), der Takt des Dienstes liest ihn für die
    Statusdatei. «seit» ist die Zeit des letzten Wechsels im Betrieb; der Pegel beim Start hat keine (null): Er ist
    kein Zuklappen, die Oberfläche reagiert nur auf Wechsel."""

    def __init__(self, now=now_iso_ms):
        self._now = now
        self._lock = threading.Lock()
        self._present = False
        self._closed = None
        self._since = None

    @property
    def closed(self):
        with self._lock:
            return self._closed if self._present else None

    def report(self):
        with self._lock:
            if not self._present:
                return {"vorhanden": False}
            return {"vorhanden": True, "zu": self._closed, "seit": self._since}

    def set(self, closed, changed):
        """Neuer entprellter Pegel (closed: True = zu). changed: ein Wechsel im Betrieb (mit Zeit), sonst der Pegel beim
        Start. True, wenn sich etwas geändert hat."""
        with self._lock:
            if self._present and closed == self._closed:
                return False
            self._present = True
            self._closed = bool(closed)
            self._since = self._now() if changed else None
            return True

    def absent(self):
        """Kein Deckel (mehr) lesbar. True, wenn er vorher da war."""
        with self._lock:
            was = self._present
            self._present, self._closed, self._since = False, None, None
            return was


class LidWatcher(threading.Thread):
    """Deckel des Argon ONE UP an GPIO27, nur lesend: Eingang mit Pull-up, beide Flanken, 100 ms Entprellung. Pegel 0
    heisst zu, 1 offen. Jeden Wechsel trägt er in lid (Lid) ein und meldet ihn an on_change (Statusdatei sofort
    schreiben). Beim Beenden wird die Leitung freigegeben (Ende des with-Blocks); geschrieben wird nie etwas ausser der
    Anforderung selbst mit dem Pull-up."""

    def __init__(self, stop, lid, on_change, log):
        super().__init__(name="deckel", daemon=True)
        self.stop = stop
        self.lid = lid
        self.on_change = on_change
        self.log = log

    def run(self):
        try:
            self._run()
        except Exception as err:  # Akku und Lüfter sollen weiterlaufen, was auch immer hier schiefgeht
            self.log.error(f"Deckel: unerwarteter Fehler ({err!r}), Zuklappen sperrt nicht")
        finally:
            self._gone()

    def _gone(self):
        if self.lid.absent():
            self.on_change()

    def _run(self):
        try:
            import gpiod
            from gpiod.line import Bias, Direction, Edge, Value
        except ImportError:
            self.log.warning("python3-libgpiod fehlt, der Deckel bleibt ohne Funktion (install.sh ausführen)")
            return
        for attempt in range(3):
            if self.stop.is_set():
                return
            found = find_lid_line(gpiod)
            if found is None:
                self.log.info(f"GPIO-Leitung {LID_LINE} nicht gefunden: kein Deckel, Zuklappen sperrt nicht")
                return
            path, offset, label = found
            settings = gpiod.LineSettings(direction=Direction.INPUT, edge_detection=Edge.BOTH, bias=Bias.PULL_UP)
            try:
                with gpiod.request_lines(path, consumer="zenos-argon", config={offset: settings}) as request:
                    self.log.info(f"Deckel an {LID_LINE} ({path}, {label}, Zeile {offset}), Eingang mit Pull-up")
                    self._watch(request, offset, Value.INACTIVE)
                return
            except OSError as err:
                self._gone()
                if err.errno == errno.EBUSY:
                    self.log.warning(f"{LID_LINE} ist schon belegt (läuft Argons Software argononeupd?), Zuklappen "
                                     "sperrt nicht")
                    return
                self.log.warning(f"Deckel: {err} (Versuch {attempt + 1} von 3)")
                self.stop.wait(10)
        self.log.warning("Deckel aufgegeben, Zuklappen sperrt nicht (Akku und Lüfter laufen weiter)")

    def _drain(self, request):
        request.read_edge_events()

    def _settled(self, request):
        """Entprellen: Flanken abholen, bis 100 ms lang keine mehr kommt. False, wenn der Dienst endet."""
        while not self.stop.is_set():
            if not request.wait_edge_events(LID_DEBOUNCE):
                return True
            self._drain(request)
        return False

    def _take(self, closed, changed):
        if not self.lid.set(closed, changed):
            return
        if changed:
            self.log.info("Deckel zu" if closed else "Deckel offen")
        else:
            self.log.info(f"Deckel beim Start {'zu' if closed else 'offen'}")
        self.on_change()

    def _watch(self, request, offset, closed_value):
        # Nach dem Einschalten des Pull-ups erst den ruhigen Pegel lesen (ohne Zeit: kein Wechsel)
        if not self._settled(request):
            return
        self._take(request.get_value(offset) == closed_value, changed=False)
        while not self.stop.is_set():
            if request.wait_edge_events(LID_POLL):
                self._drain(request)
                if not self._settled(request):
                    return
            # Nach jeder Flanke und sonst jede Sekunde: Der Pegel ist seit mindestens 100 ms ruhig
            self._take(request.get_value(offset) == closed_value, changed=True)


# --- Hardware --------------------------------------------------------------


class ArgonFan:
    """Lüfter der Argon-Platine über I2C (Protokoll wie argonregister.py)."""

    def __init__(self, bus, sleep=time.sleep):
        self.bus = bus
        self.sleep = sleep
        self.register = False

    def present(self):
        """Antwortet etwas an 0x1a? Erst lesen, dann (wie i2cdetect) ein Quick-Write ohne Daten."""
        try:
            self.bus.read_byte(ARGON_ADDRESS)
            return True
        except OSError:
            pass
        try:
            self.bus.write_quick(ARGON_ADDRESS)
            return True
        except OSError:
            return False

    def detect_register(self):
        """Wie argonregister_checksupport: Register 0x80 lesen, verändern, zurücklesen, wiederherstellen."""
        try:
            old = self.bus.read_byte_data(ARGON_ADDRESS, REG_DUTY_CYCLE)
            probe = old + 1
            if probe >= 100:
                probe = 98
            self._write_register(probe)
            back = self.bus.read_byte_data(ARGON_ADDRESS, REG_DUTY_CYCLE)
            self.register = back != old
            if self.register:
                self._write_register(min(old, 100))
        except OSError:
            self.register = False
        return self.register

    def _write_register(self, value):
        self.bus.write_byte_data(ARGON_ADDRESS, REG_DUTY_CYCLE, value)
        self.sleep(WRITE_PAUSE)

    def set_speed(self, value):
        value = max(0, min(100, int(value)))
        if self.register:
            self._write_register(value)
        else:
            self.bus.write_byte(ARGON_ADDRESS, value)
            self.sleep(WRITE_PAUSE)


class SimulatedFan:
    """Für --simulieren: schreibt nur ins Log."""

    register = False

    def __init__(self, log):
        self.log = log

    def set_speed(self, value):
        self.log.info(f"Simulation: Lüfter {int(value)} %")


def apply_speed(fan, value, previous):
    """Setzt den Lüfter; aus dem Stillstand (oder unbekannt) mit Anlaufhilfe wie im Original."""
    if 0 < value < KICK_SPEED and not previous:
        fan.set_speed(KICK_SPEED)
    fan.set_speed(value)


def test_root():
    """Ordner aus ZENOS_ARGON_TESTWURZEL (nur für Tests) oder ""."""
    return os.environ.get(TEST_ROOT_VARIABLE, "").rstrip("/")


def system_path(path):
    """Fester Pfad, in Tests unter ZENOS_ARGON_TESTWURZEL."""
    return test_root() + path


def read_model():
    for path in MODEL_PATHS:
        try:
            with open(system_path(path), "rb") as handle:
                return handle.read().replace(b"\0", b"").decode("utf-8", "replace").strip()
        except OSError:
            continue
    return ""


def is_pi5(model):
    return model.startswith(PI5_MODEL)


def is_cm5(model):
    return model.startswith(CM5_MODEL)


def read_temperature(path=None):
    """°C aus der Thermal-Zone (Milligrad) oder None."""
    path = path or system_path(THERMAL_PATH)
    try:
        with open(path, encoding="ascii") as handle:
            value = int(handle.read().strip()) / 1000
    except (OSError, ValueError):
        return None
    return value if -40 < value < 150 else None


def read_temperature_file(path):
    """Für --simulieren: °C oder Milligrad (Werte ab 1000) aus einer Datei, sonst None."""
    try:
        with open(path, encoding="utf-8") as handle:
            value = float(handle.read().strip().replace(",", "."))
    except (OSError, ValueError):
        return None
    if value >= 1000:
        value /= 1000
    return value if math.isfinite(value) and -40 < value < 150 else None


def uptime_seconds():
    try:
        with open("/proc/uptime", encoding="ascii") as handle:
            return float(handle.read().split()[0])
    except (OSError, ValueError, IndexError):
        return 0.0


def watchdog_ping():
    """Lebenszeichen an systemd (WatchdogSec= in zenos-argon.service, NotifyAccess=main). Bleibt es aus, beendet
    systemd den hängenden Dienst; ExecStopPost gibt den Lüfter dann dem Kernel zurück, und der Dienst startet neu.
    Ohne NOTIFY_SOCKET (Tests, --simulieren von Hand) geschieht nichts."""
    address = os.environ.get("NOTIFY_SOCKET", "")
    if not address:
        return
    if address.startswith("@"):
        address = "\0" + address[1:]
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as sock:
            sock.connect(address)
            sock.sendall(b"WATCHDOG=1")
    except OSError:
        pass


def system_stopping(runner=subprocess.run):
    """Fährt das System gerade herunter (Neustart oder Ausschalten)?"""
    try:
        result = runner(["systemctl", "is-system-running"], stdin=subprocess.DEVNULL,
                        capture_output=True, text=True, timeout=3, check=False)
    except (OSError, subprocess.SubprocessError):
        return False
    return result.stdout.strip() == "stopping"


# --- Status für die Leiste -------------------------------------------------


def round_temperature(value):
    return None if value is None else round(float(value), 1)


def fan_wish_report(wish, steerable):
    """Lüfterwunsch für die Statusdatei: modus, mindeststufe und ob zenOS ihn umsetzen kann (steuerbar)."""
    return {
        "modus": wish.mode if wish is not None else "auto",
        "mindeststufe": wish.stage if wish is not None else None,
        "steuerbar": bool(steerable and wish is not None),
    }


def argon_v3_report(temperature, speed, wish=None):
    """Inhalt der Statusdatei beim Argon ONE V3: Lüfter in % mit dem Wunsch, kein Akku."""
    luefter = {"vorhanden": True, "prozent": None if speed is None else int(speed)}
    luefter.update(fan_wish_report(wish, True))
    return {
        "geraet": "argon-one-v3",
        "akku": {"vorhanden": False},
        "luefter": luefter,
        "temperatur": {"cpu": round_temperature(temperature)},
    }


class StatusFile:
    """/run/zenos/geraet.json: Version 1, atomar (tmp + rename), 0644."""

    def __init__(self, path, log):
        self.path = path
        self.log = log

    def write(self, report, now=None):
        now = now or datetime.datetime.now().astimezone()
        data = {"version": STATUS_VERSION, "zeit": now.isoformat(timespec="seconds")}
        data.update(report)
        directory = os.path.dirname(self.path) or "."
        temp = None
        try:
            os.makedirs(directory, mode=0o755, exist_ok=True)
            handle, temp = tempfile.mkstemp(prefix=".geraet-", suffix=".tmp", dir=directory)
            with os.fdopen(handle, "w", encoding="utf-8") as out:
                out.write(json.dumps(data, ensure_ascii=False) + "\n")
            os.chmod(temp, 0o644)
            os.replace(temp, self.path)
            temp = None
        except OSError as err:
            self.log.problem("status", f"{self.path} lässt sich nicht schreiben: {err}")
            return False
        finally:
            if temp is not None:
                try:
                    os.unlink(temp)
                except OSError:
                    pass
        self.log.solved("status", f"{self.path} wird wieder geschrieben")
        return True

    def remove(self):
        try:
            os.unlink(self.path)
        except OSError:
            pass


# --- Lüfterwunsch ----------------------------------------------------------


def parse_fan_wish(text):
    """Inhalt von /var/lib/zenos/luefter → (modus, stufe, Fehler). Kommentare (#) und unbekannte Schlüssel (z. B.
    «seit») zählen nicht, bei doppelten gilt der letzte. Ungültiges gilt als «auto»: Dann regelt der Kernel bzw. die
    Kurve allein, also nie weniger Kühlung als vorgesehen."""
    values = {}
    for raw in text.splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        key, sep, value = line.partition("=")
        if not sep:
            return "auto", None, f"Zeile «{line[:40]}» ohne «=»"
        values[key.strip()] = value.strip()
    mode = values.get("modus")
    if mode == "auto":
        return "auto", None, None
    if mode == "mindest":
        stage = values.get("stufe")
        if stage in tuple(str(s) for s in FAN_MIN_STAGES):
            return "mindest", int(stage), None
        return "auto", None, "«stufe» muss 1, 2, 3 oder 4 sein"
    if mode is None:
        return "auto", None, "«modus» fehlt"
    return "auto", None, "«modus» muss «auto» oder «mindest» sein"


def read_fan_wish(path):
    """(modus, stufe, Fehler) aus der Datei. Fehlt sie, gilt «auto» ohne Fehler."""
    try:
        with open(path, "rb") as handle:
            data = handle.read(FAN_WISH_MAX_BYTES + 1)
    except FileNotFoundError:
        return "auto", None, None
    except OSError as err:
        return "auto", None, f"nicht lesbar ({err.strerror or err})"
    if len(data) > FAN_WISH_MAX_BYTES:
        return "auto", None, f"grösser als {FAN_WISH_MAX_BYTES} Byte"
    try:
        text = data.decode("utf-8")
    except UnicodeDecodeError:
        return "auto", None, "kein UTF-8"
    return parse_fan_wish(text)


def describe_fan_wish(mode, stage):
    return f"Mindeststufe {stage}" if mode == "mindest" else "automatisch"


class FanWish:
    """Zenos Wunsch für den Lüfter (/var/lib/zenos/luefter): «auto» oder eine Mindeststufe 1–4. Neu gelesen, sobald
    sich die Datei ändert (Inode, Grösse, Zeit); ein neuer Wunsch wirkt also ohne Neustart des Dienstes."""

    def __init__(self, path, log):
        self.path = path
        self.log = log
        self.mode = "auto"
        self.stage = None
        self._stamp = ()  # noch nie gelesen

    @property
    def minimum(self):
        """Mindeststufe oder 0 (auto)."""
        return self.stage if self.mode == "mindest" else 0

    def _current_stamp(self):
        try:
            info = os.stat(self.path)
        except FileNotFoundError:
            return None
        except OSError as err:
            return ("fehler", err.errno)
        return (info.st_ino, info.st_size, info.st_mtime_ns)

    def refresh(self):
        """Liest die Datei neu, wenn sie sich geändert hat. True, wenn sich der Wunsch geändert hat."""
        stamp = self._current_stamp()
        if stamp == self._stamp:
            return False
        self._stamp = stamp
        mode, stage, problem = read_fan_wish(self.path)
        if problem:
            self.log.problem("luefter-wunsch", f"Lüfterwunsch {self.path}: {problem}, es gilt «automatisch»")
        else:
            self.log.solved("luefter-wunsch", f"Lüfterwunsch {self.path} ist wieder gültig")
        if (mode, stage) == (self.mode, self.stage):
            return False
        self.mode, self.stage = mode, stage
        self.log.info(f"Lüfterwunsch: {describe_fan_wish(mode, stage)}")
        return True


# --- Dienst ----------------------------------------------------------------


class Daemon:
    def __init__(self, fan, log, status, config_path, temperature_source, simulate=False,
                 clock=time.monotonic, runner=subprocess.run, stopping=None, wish=None):
        self.fan = fan
        self.log = log
        self.status = status
        self.config_path = config_path
        self.temperature_source = temperature_source
        self.simulate = simulate
        self.clock = clock
        self.runner = runner
        self.stopping = stopping or (lambda: system_stopping(runner))
        # Lüfterwunsch (FanWish) oder None: dann nur die Kurve (Einheitentests)
        self.wish = wish
        self.stop = threading.Event()
        self.applied = None
        self._config_stamp = None
        self._action_started = False
        self._action_lock = threading.Lock()
        self.controller = FanController(self._load_config(initial=True))

    # Konfiguration beim Start und bei jeder Änderung der Datei
    def _stamp(self):
        try:
            info = os.stat(self.config_path)
        except OSError:
            return None
        return (info.st_ino, info.st_size, info.st_mtime_ns)

    def _load_config(self, initial=False):
        self._config_stamp = self._stamp()
        config, errors, notes, own = load_config(self.config_path)
        for note in notes:
            self.log.warning(f"{self.config_path}: {note}")
        if errors:
            for error in errors:
                self.log.warning(f"{self.config_path}: {error}")
            self.log.warning(f"Konfiguration ungültig, es gilt die Standardkurve: {config.describe()}")
        elif own:
            self.log.info(f"Lüfterkurve aus {self.config_path}: {config.describe()}")
        elif initial:
            self.log.info(f"Standardkurve: {config.describe()}")
        else:
            self.log.info(f"{self.config_path} entfernt, es gilt die Standardkurve")
        return config

    def _check_config(self):
        if self._stamp() != self._config_stamp:
            self.controller.config = self._load_config()

    def _check_wish(self):
        """Mindeststufe aus dem Lüfterwunsch: hebt die Kurve auf 30 / 50 / 70 / 100 % an (nie darunter)."""
        if self.wish is not None and self.wish.refresh():
            self.controller.minimum = FAN_STAGE_PERCENT[self.wish.minimum]

    def tick(self):
        watchdog_ping()
        self._check_config()
        self._check_wish()
        temperature = self.temperature_source()
        if temperature is None:
            self.log.problem("temperatur", "Temperatur nicht lesbar, der Lüfter läuft sicherheitshalber mit 100 %")
        else:
            self.log.solved("temperatur", "Temperatur wieder lesbar")
        value = self.controller.update(temperature, self.clock())
        if value is not None:
            previous = self.applied
            try:
                apply_speed(self.fan, value, previous)
            except OSError as err:
                self.applied = None
                self.controller.forget()
                self.log.problem("i2c", f"Lüfter lässt sich nicht setzen ({err}), neuer Versuch im nächsten Takt")
            else:
                self.applied = value
                self.log.solved("i2c", "I2C antwortet wieder")
                shown = "?" if temperature is None else _fmt(round(temperature, 1))
                floor = f" (Mindeststufe {self.wish.stage})" if self.wish is not None and self.wish.minimum else ""
                self.log.info(f"Lüfter {value} % bei {shown} °C{floor}")
        self.status.write(argon_v3_report(temperature, self.applied, self.wish))

    def on_pulse(self, width_ms):
        action = classify_pulse(width_ms)
        if action is None:
            self.log.info(f"Power-Button: Puls {width_ms:.0f} ms ohne Bedeutung, ignoriert")
            return
        verb, name = ACTIONS[action]
        if self.simulate:
            self.log.info(f"Simulation: Power-Button {width_ms:.0f} ms → {name} (systemctl {verb}, nicht ausgeführt)")
            return
        with self._action_lock:
            if self._action_started:
                return
            self._action_started = True
        self.log.info(f"Power-Button {width_ms:.0f} ms → {name} (systemctl {verb})")
        try:
            result = self.runner(["systemctl", verb], stdin=subprocess.DEVNULL, timeout=60, check=False)
            ok = result.returncode == 0
        except (OSError, subprocess.SubprocessError) as err:
            ok = False
            if not self.stop.is_set():
                self.log.error(f"systemctl {verb} ist fehlgeschlagen: {err}")
        # Beim Herunterfahren beendet systemd auch den wartenden systemctl-Aufruf: kein Fehler
        if not ok and not self.stop.is_set():
            self.log.error(f"{name} hat nicht geklappt (systemctl {verb})")
            with self._action_lock:
                self._action_started = False

    def finish(self):
        """Lüfter auf einen sicheren Wert: beim Herunterfahren aus (wie das Original), sonst 100 %."""
        if self.stopping():
            value, why = 0, "aus, das System fährt herunter"
        else:
            value, why = SAFE_SPEED, f"{SAFE_SPEED} %, der Dienst endet und niemand regelt mehr"
        try:
            self.fan.set_speed(value)
            self.log.info(f"Lüfter {why}")
        except OSError as err:
            self.log.warning(f"Lüfter liess sich beim Beenden nicht setzen: {err}")
        self.status.remove()

    def run(self, interval, rounds=None):
        count = 0
        try:
            while not self.stop.is_set():
                self.tick()
                count += 1
                if rounds is not None and count >= rounds:
                    break
                self.stop.wait(interval)
        finally:
            self.stop.set()
            self.finish()
        return 0


# --- I2C-Bus ---------------------------------------------------------------


class FileBus:
    """Nur für Tests (ZENOS_ARGON_TESTWURZEL): jedes I2C-Gerät ist eine JSON-Datei <ordner>/0x<adresse>.json mit
    Registerwerten ({"0x04": 87}, fehlende Register lesen 0). Fehlt die Datei oder steht darin "fehler": true,
    antwortet das Gerät nicht. Schreiben ändert die Datei und steht in <ordner>/protokoll («0x64 0x08 0x30»)."""

    def __init__(self, folder):
        self.folder = folder

    def _path(self, address):
        return os.path.join(self.folder, f"0x{address:02x}.json")

    def _load(self, address):
        try:
            with open(self._path(address), encoding="utf-8") as handle:
                registers = json.load(handle)
        except (OSError, ValueError):
            registers = None
        if not isinstance(registers, dict) or registers.get("fehler"):
            raise OSError(getattr(errno, "EREMOTEIO", 121), "Remote I/O error")
        return registers

    def _log(self, *values):
        with open(os.path.join(self.folder, "protokoll"), "a", encoding="utf-8") as handle:
            handle.write(" ".join(f"0x{v:02x}" for v in values) + "\n")

    def read_byte_data(self, address, register):
        return int(self._load(address).get(f"0x{register:02x}", 0)) & 0xFF

    def write_byte_data(self, address, register, value):
        registers = self._load(address)
        registers[f"0x{register:02x}"] = value & 0xFF
        self._log(address, register, value)
        temp = self._path(address) + ".tmp"
        with open(temp, "w", encoding="utf-8") as handle:
            json.dump(registers, handle, sort_keys=True)
        os.replace(temp, self._path(address))

    def read_byte(self, address):
        self._load(address)
        return 0

    def write_byte(self, address, value):
        self._load(address)
        self._log(address, value)

    def write_quick(self, address):
        self._load(address)

    def close(self):
        pass


def open_bus(log):
    """I2C-Bus 1 (in Tests FileBus) oder None mit Meldung."""
    root = test_root()
    if root:
        return FileBus(os.path.join(root, "i2c-1"))
    try:
        import smbus
    except ImportError:
        log.error("python3-smbus fehlt (install.sh ausführen)")
        return None
    try:
        return smbus.SMBus(I2C_BUS)
    except OSError as err:
        log.error(f"{I2C_DEVICE} lässt sich nicht öffnen: {err}")
        return None


# --- Argon ONE UP: Akku-Messchip CW2217 ------------------------------------


class BatteryGauge:
    """Akku-Messchip CW2217 an 0x64 (Protokoll wie argononeupd.py). Schreibt nur in load_profile und restart."""

    def __init__(self, bus, sleep=time.sleep, stop=None):
        self.bus = bus
        self.sleep = sleep
        self.stop = stop or threading.Event()

    def _read(self, register):
        return self.bus.read_byte_data(GAUGE_ADDRESS, register)

    def _write(self, register, value):
        self.bus.write_byte_data(GAUGE_ADDRESS, register, value)

    def chip_id(self):
        return self._read(REG_VERSION)

    def read_profile(self):
        return bytes(self._read(REG_PROFILE + offset) for offset in range(len(ARGON_UP_PROFILE)))

    def status(self):
        """Nur lesend, ohne Profilvergleich: «ok», «schlaeft» oder «ohne-profil»."""
        if self._read(REG_CONTROL) != CONTROL_ACTIVE:
            return "schlaeft"
        if not self._read(REG_SOCALERT) & PROFILE_LOADED:
            return "ohne-profil"
        return "ok"

    def check(self):
        """Nur lesend: wie status, dazu «anderes-profil», wenn die Register 0x10–0x5F nicht Argons Profil sind."""
        state = self.status()
        if state == "ok" and self.read_profile() != ARGON_UP_PROFILE:
            return "anderes-profil"
        return state

    def load_profile(self):
        """Argons Profil schreiben und den Chip aktivieren, genau wie battery_checkupdateprofile in argononeupd.py.
        Gibt (bereit, Zustand) zurück: bereit = Register 0xA7 meldete «bereit», Zustand = check() danach."""
        self._write(REG_CONTROL, CONTROL_RESTART)
        self.sleep(GAUGE_PAUSE)
        self._write(REG_CONTROL, CONTROL_SLEEP)
        self.sleep(GAUGE_PAUSE)
        for offset, value in enumerate(ARGON_UP_PROFILE):
            self._write(REG_PROFILE + offset, value)
        self._write(REG_SOCALERT, PROFILE_LOADED)
        self.sleep(GAUGE_PAUSE)
        self._write(REG_GPIOCONFIG, 0x00)
        self.sleep(GAUGE_PAUSE)
        ready = self.restart()
        return ready, self.check()

    def restart(self, attempts=3, wait_seconds=5):
        """Aktivieren wie battery_restart: 0x08 ← 0x30, 0x08 ← 0x00, dann bis zu 5 s auf Register 0xA7 warten;
        höchstens dreimal. Beim Beenden des Dienstes wird nicht weiter gewartet."""
        for _ in range(attempts):
            self._write(REG_CONTROL, CONTROL_RESTART)
            self.sleep(GAUGE_PAUSE)
            self._write(REG_CONTROL, CONTROL_ACTIVE)
            self.sleep(GAUGE_PAUSE)
            for _ in range(wait_seconds):
                if self._read(REG_ICSTATE) & ICSTATE_READY:
                    return True
                if self.stop.is_set():
                    return False
                self.sleep(1)
        return False

    def read_soc(self):
        """Ladestand in ganzen % (Register 0x04, ohne Bruchteil aus 0x05)."""
        return self._read(REG_SOC)

    def read_discharging(self):
        """Stromrichtung: Bit 7 von 0x0E (Vorzeichen des Stroms) gesetzt = Entladen (battery_isplugged)."""
        return bool(self._read(REG_CURRENT_HIGH) & CURRENT_NEGATIVE)


class Debounce:
    """Ein neuer Wert gilt erst, wenn er so oft hintereinander gemessen wurde. Der erste gilt sofort."""

    def __init__(self, needed):
        self.needed = needed
        self.value = None
        self._candidate = None
        self._count = 0

    @property
    def pending(self):
        return self._candidate is not None

    def update(self, sample):
        """True, wenn der Wert gewechselt hat (nicht beim ersten Wert)."""
        if self.value is None:
            self.value = sample
            return False
        if sample == self.value:
            self._candidate, self._count = None, 0
            return False
        if sample == self._candidate:
            self._count += 1
        else:
            self._candidate, self._count = sample, 1
        if self._count < self.needed:
            return False
        self.value = sample
        self._candidate, self._count = None, 0
        return True

    def reset(self):
        self.value = None
        self._candidate, self._count = None, 0


def profile_backoff(failures):
    """Pause vor dem nächsten Versuch nach N gescheiterten: 30 s, 60 s, 120 s … höchstens 1 h."""
    return min(PROFILE_RETRY_FIRST * 2 ** max(0, failures - 1), PROFILE_RETRY_MAX)


class BatteryMonitor:
    """Ladestand und Laderichtung: Profil prüfen und nur bei Bedarf laden (mit Grenze und Pausen), Werte auf
    Plausibilität prüfen, Laden/Entladen entprellen. Schreibt nichts ins Journal, was sich nur wiederholt."""

    def __init__(self, gauge, log, clock=time.monotonic, read_only=False, released=None):
        self.gauge = gauge
        self.log = log
        self.clock = clock
        self.read_only = read_only
        # Freigabe für das Schreiben (im Dienst: profile_released); ohne Angabe frei (Einheitentests)
        self.released = released or (lambda: True)
        self._blocked = False
        self.ready = False
        self.percent = None
        self.charging = Debounce(CHARGE_CONFIRMATIONS)
        self._soc_candidate = None
        self._read_failures = 0
        self._profile_failures = 0
        self._next_profile = 0.0
        self._profile_writes = []
        self._failed = False
        self._zero_since = None
        self._announced = False
        # Rohe Messung dieses Takts: (Ladestand, entlädt) mit plausiblem Ladestand (1–100 %), sonst None (Lesefehler,
        # Chip startet oder misst nicht, unplausibel). Für CriticalBattery: ein einzelner Takt, ohne Entprellung.
        self.sample = None

    @property
    def pending(self):
        """Wartet eine Änderung auf Bestätigung? Dann misst der Dienst öfter."""
        return self.charging.pending or self._soc_candidate is not None

    def snapshot(self):
        if self.percent is not None:
            state = "ok"
        elif self._blocked:
            state = "freigabe"
        elif self._failed or self._read_failures > READ_TOLERANCE:
            state = "fehler"
        else:
            state = "unbekannt"
        return {"vorhanden": True, "prozent": self.percent, "laedt": self.charging.value, "zustand": state}

    def tick(self):
        now = self.clock()
        self.sample = None
        try:
            if not self.ready and not self._prepare(now):
                return self.snapshot()
            state = self.gauge.status()
            if state != "ok":
                # Nach einem Zurücksetzen (z. B. Akku ganz leer) schläft der Chip wieder oder Bit 7 von 0x0B fehlt
                self.log.warning(f"Akku-Messchip {GAUGE_STATES[state]} (zurückgesetzt?)")
                self._forget()
                if not self._prepare(now):
                    return self.snapshot()
            soc = self.gauge.read_soc()
            discharging = self.gauge.read_discharging()
        except OSError as err:
            self._read_failures += 1
            self.log.problem("akku-i2c", f"Akku-Messchip an 0x{GAUGE_ADDRESS:02x} antwortet nicht ({err}), neuer "
                             "Versuch im nächsten Takt")
            if self._read_failures > READ_TOLERANCE:
                self._forget(keep_ready=True)
            return self.snapshot()
        self._read_failures = 0
        self.log.solved("akku-i2c", "Akku-Messchip antwortet wieder")
        self._take(soc, discharging, now)
        return self.snapshot()

    def _forget(self, keep_ready=False):
        self.ready = self.ready and keep_ready
        self.percent = None
        self.charging.reset()
        self._soc_candidate = None

    def _prepare(self, now):
        """Profil prüfen und nur bei Bedarf laden. True, wenn der Chip danach misst."""
        if now < self._next_profile:
            return False
        state = self.gauge.check()
        if state == "ok":
            if not self._announced:
                self.log.info("Akku-Messchip misst, Argons Akkuprofil ist geladen (nichts geschrieben)")
            self._set_ready()
            return True
        if self.read_only:
            self._failed = True
            self.log.problem("akku-profil", f"Akku-Messchip {GAUGE_STATES[state]}; Argons eigene Software ist "
                             "aktiviert, zenos-argon schreibt nichts in den Chip")
            return False
        if not self.released():
            # Ohne Zenos Freigabe nur lesen; geprüft wird bei jedem Takt (zwei Register), geschrieben nichts
            self._blocked = True
            self.log.problem("akku-freigabe", f"Akku-Messchip {GAUGE_STATES[state]}; zenos-argon lädt Argons "
                             "Akkuprofil erst nach der Freigabe (zen akku freigeben) und schreibt bis dahin nichts")
            return False
        self._blocked = False
        self.log.solved("akku-freigabe", "Freigabe für das Akkuprofil ist da")
        self._profile_writes = [t for t in self._profile_writes if now - t < 3600]
        if len(self._profile_writes) >= PROFILE_WRITES_PER_HOUR:
            self._failed = True
            self._next_profile = self._profile_writes[0] + 3600
            minutes = max(1, math.ceil((self._next_profile - now) / 60))
            self.log.problem("akku-profil", f"Akku-Messchip {GAUGE_STATES[state]}; das Profil wurde in der letzten "
                             f"Stunde schon {len(self._profile_writes)}-mal geschrieben, nächster Versuch in "
                             f"{minutes} min")
            return False
        self._profile_writes.append(now)
        self._profile_failures += 1
        # gilt auch, wenn das Schreiben mit einem I2C-Fehler abbricht
        self._next_profile = now + profile_backoff(self._profile_failures)
        self._failed = True
        self.log.info(f"Akku-Messchip {GAUGE_STATES[state]}: lade Argons Akkuprofil (80 Byte) und aktiviere ihn")
        ready, after = self.gauge.load_profile()
        if after != "ok":
            self.log.warning(f"Akkuprofil laden hat nicht geklappt: Der Chip {GAUGE_STATES[after]}. Neuer Versuch in "
                             f"{_fmt(profile_backoff(self._profile_failures))} s")
            return False
        if not ready:
            self.log.info("Register 0xA7 meldete nicht «bereit», Steuerregister und Profil stimmen aber")
        self.log.info("Akkuprofil geladen, der Messchip misst")
        self._profile_failures = 0
        self._next_profile = 0.0
        self._set_ready()
        return True

    def _set_ready(self):
        self.ready = True
        self._failed = False
        self._blocked = False
        self._announced = True
        self.log.solved("akku-profil", "Akku-Messchip misst wieder")

    def _take(self, soc, discharging, now):
        if 100 < soc <= 105:
            soc = 100
        if soc == 0:
            # Kurz nach dem Aktivieren meldet der Chip 0 %, bis er den ersten Wert hat (Argon wertet 0 ebenso
            # als ungültig). Bleibt es dabei, einmal ins Journal.
            self._zero_since = self._zero_since if self._zero_since is not None else now
            if now - self._zero_since >= SOC_ZERO_NOTICE:
                self.log.problem("akku-null", "Der Akku-Messchip meldet seit 2 Minuten 0 % (noch kein Messwert?)")
            return
        self._zero_since = None
        self.log.solved("akku-null", "Der Akku-Messchip meldet wieder einen Ladestand")
        if soc > 100:
            self.log.problem("akku-wert", f"Unplausibler Ladestand {soc} % ignoriert")
            return
        self.log.solved("akku-wert", "Ladestand wieder plausibel")
        self.sample = (soc, bool(discharging))
        if self.percent is not None and abs(soc - self.percent) > SOC_JUMP:
            if self._soc_candidate is None or abs(soc - self._soc_candidate) > 2:
                self._soc_candidate = soc
                return
        self._soc_candidate = None
        first = self.percent is None
        self.percent = soc
        changed = self.charging.update(not discharging)
        if first:
            self.log.info(f"Akku {soc} %, {'lädt' if self.charging.value else 'entlädt'}")
        elif changed:
            self.log.info(f"Netzteil angeschlossen, Akku {soc} %" if self.charging.value else
                          f"Akkubetrieb, Akku {soc} %")


# --- Ausschalten bei leerem Akku (Argon ONE UP) ----------------------------


def install_running(path=None):
    """Läuft install.sh (hält /run/lock/zenos-install.lock exklusiv)? Nur lesend geöffnet und kurz geteilt gesperrt;
    install.sh wartet auf eine belegte Sperre (bis 15 Min.), stört sich also nicht daran. Ist die Datei da, aber nicht
    prüfbar, gilt sie als belegt (dann wird höchstens 5 Min. gewartet)."""
    path = path or system_path(INSTALL_LOCK_PATH)
    try:
        handle = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW | os.O_NONBLOCK)
    except FileNotFoundError:
        return False
    except OSError:
        return True
    try:
        fcntl.flock(handle, fcntl.LOCK_SH | fcntl.LOCK_NB)
    except OSError:
        return True
    finally:
        os.close(handle)
    return False


def process_running(name, proc=None):
    """Läuft ein Prozess mit genau diesem Namen (/proc/<pid>/comm)? Ist /proc nicht lesbar, gilt er als laufend."""
    proc = proc or system_path("/proc")
    try:
        entries = os.listdir(proc)
    except OSError:
        return True
    for entry in entries:
        if not entry.isdigit():
            continue
        try:
            with open(os.path.join(proc, entry, "comm"), encoding="utf-8", errors="replace") as handle:
                if handle.read(64).strip() == name:
                    return True
        except OSError:
            continue  # Prozess eben beendet
    return False


def system_busy():
    """Warum jetzt nicht ausgeschaltet werden sollte (install.sh oder dpkg läuft), sonst ""."""
    if install_running():
        return "install.sh läuft"
    if process_running("dpkg"):
        return "dpkg läuft"
    return ""


class CriticalBattery:
    """Leitplanke (Code, nicht abschaltbar): kontrolliertes Ausschalten bei leerem Akku statt eines harten Aus.

    - Zählen nur bei sicherem Messwert (Zustand «ok») und sicherem Entladen (entprellt und in diesem Takt): drei
      Messungen hintereinander mit höchstens 3 % (CRITICAL_PERCENT). Jeder andere Takt setzt zurück.
    - Dann 60 s Vorwarnung: report() liefert die Uhrzeit für «akku.ausschaltenUm» (Oberfläche: dringende Mitteilung,
      Zeile auf der Sperre). Abbrechen kann nur das Netzteil: schon eine Messung «lädt» bricht ab, eine Taste nicht.
      Ein unsicherer Messwert bricht ebenfalls ab (nie ausschalten ohne sicheren Wert); dann beginnt alles von vorn.
    - Läuft danach install.sh oder dpkg, wird gewartet, höchstens CRITICAL_MAX_DEFER (5 Min.) länger; die Uhrzeit zeigt
      dann diese späteste. SSH-Sitzungen, tmux und Hemmer halten es nicht auf: Bei leerem Akku käme sonst das harte Aus.
    - Ausgeschaltet wird mit «systemctl poweroff» (nie neu starten, nie --force). Mit ZENOS_ARGON_TESTWURZEL nie."""

    def __init__(self, log, clock=time.monotonic, wall=None, busy=system_busy, runner=subprocess.run):
        self.log = log
        self.clock = clock
        self.wall = wall or (lambda: datetime.datetime.now().astimezone())
        self.busy = busy
        self.runner = runner
        self.count = 0
        self.deadline = None  # Ende der Vorwarnung (clock)
        self.until = None  # Uhrzeit des Ausschaltens für die Statusdatei (wall)
        self.deferred = False
        self.done = False

    @property
    def active(self):
        """Läuft die Vorwarnung (oder das Warten auf dpkg/install.sh)? Dann misst der Dienst alle 5 s."""
        return self.deadline is not None

    def report(self):
        """«akku.ausschaltenUm» für die Statusdatei: ISO 8601 oder None."""
        return self.until.isoformat(timespec="seconds") if self.active and self.until is not None else None

    @staticmethod
    def _safe(monitor):
        """Sicherer Messwert in diesem Takt: (Ladestand, entlädt) und ein bestätigter Zustand, sonst None."""
        sample = monitor.sample
        if sample is None or monitor.percent is None or monitor.charging.value is None:
            return None
        return sample

    def update(self, monitor):
        if self.done:
            return
        sample = self._safe(monitor)
        if not self.active:
            low = (sample is not None and sample[1] and monitor.charging.value is False
                   and sample[0] <= CRITICAL_PERCENT and monitor.percent <= CRITICAL_PERCENT)
            self.count = self.count + 1 if low else 0
            if self.count >= CRITICAL_CONFIRMATIONS:
                self._start(sample[0])
            return
        if monitor.sample is not None and not monitor.sample[1]:
            self._cancel("Netzteil angeschlossen")
            return
        if sample is None:
            self._cancel("Messwert unsicher, es beginnt von vorn")
            return
        now = self.clock()
        if now < self.deadline:
            return
        reason = self.busy()
        if reason and now < self.deadline + CRITICAL_MAX_DEFER:
            if not self.deferred:
                self.deferred = True
                self.until = self.until + datetime.timedelta(seconds=CRITICAL_MAX_DEFER)
                self.log.warning(f"Akku leer, aber {reason}: zenOS wartet damit, spätestens bis "
                                 f"{self.until.strftime('%H:%M:%S')}")
            return
        if reason:
            self.log.warning(f"Akku leer und {reason}: zenOS wartet nicht länger als "
                             f"{CRITICAL_MAX_DEFER // 60} Min.")
        self._poweroff(sample[0])

    def _start(self, percent):
        self.deadline = self.clock() + CRITICAL_WARNING_SECONDS
        self.until = self.wall() + datetime.timedelta(seconds=CRITICAL_WARNING_SECONDS)
        self.deferred = False
        self.log.warning(f"Akku bei {percent} % im Akkubetrieb ({CRITICAL_CONFIRMATIONS} Messungen): zenOS schaltet um "
                         f"{self.until.strftime('%H:%M:%S')} kontrolliert aus, nur das Netzteil bricht ab")

    def _cancel(self, why):
        self.log.info(f"Ausschalten bei leerem Akku abgebrochen: {why}")
        self.count = 0
        self.deadline = self.until = None
        self.deferred = False

    def _poweroff(self, percent):
        if test_root():
            self.log.info("Testwurzel: hier schaltete zenOS aus (systemctl poweroff), nicht ausgeführt")
            self.done = True
            return
        self.log.warning(f"Akku bei {percent} %: schalte kontrolliert aus (systemctl poweroff)")
        try:
            result = self.runner(["systemctl", "poweroff"], stdin=subprocess.DEVNULL, capture_output=True, text=True,
                                 timeout=60, check=False)
            ok, detail = result.returncode == 0, (result.stderr or "").strip()[:200] or f"Exit {result.returncode}"
        except (OSError, subprocess.SubprocessError) as err:
            ok, detail = False, str(err)
        if ok:
            self.done = True
            return
        # Beim Herunterfahren beendet systemd auch diesen Dienst; sonst im nächsten Takt (5 s) wieder versuchen
        self.log.problem("akku-aus", f"systemctl poweroff ist fehlgeschlagen ({detail}), neuer Versuch im nächsten Takt")


# --- Lüfter am Compute Module 5 (Kernel) -----------------------------------


def _read_int(path):
    try:
        with open(path, encoding="ascii") as handle:
            return int(handle.read().strip())
    except (OSError, ValueError):
        return None


def _natural(name):
    digits = "".join(c for c in name if c.isdigit())
    return (int(digits) if digits else -1, name)


def find_sysfs_device(directory, prefix, attribute, value):
    """Erster Eintrag <directory>/<prefix>N, dessen Datei <attribute> genau <value> enthält, oder None.
    Die Nummern N wechseln zwischen zwei Starts, deshalb immer nach Namen suchen."""
    try:
        names = sorted((n for n in os.listdir(directory) if n.startswith(prefix)), key=_natural)
    except OSError:
        return None
    for name in names:
        try:
            with open(os.path.join(directory, name, attribute), encoding="utf-8") as handle:
                if handle.read().strip() == value:
                    return os.path.join(directory, name)
        except OSError:
            continue
    return None


class KernelFan:
    """Lüfter am Lüfteranschluss (Kernel-Treiber pwm-fan, Regler step_wise). Liest die Stufe aus der
    cooling_device «pwm-fan» (cur_state/max_state) und die Drehzahl aus hwmon «pwmfan» (fan1_input). Geschrieben
    wird nur über KernelFanControl (Mindeststufe)."""

    def __init__(self, sysfs, log, clock=time.monotonic):
        self.sysfs = sysfs
        self.log = log
        self.clock = clock
        self.hwmon = None
        self.cooling = None
        self._next_scan = 0.0
        self._announced = None

    def _scan(self, now):
        self._next_scan = now + FAN_RESCAN_SECONDS
        self.hwmon = find_sysfs_device(os.path.join(self.sysfs, "class", "hwmon"), "hwmon", "name", "pwmfan")
        self.cooling = find_sysfs_device(os.path.join(self.sysfs, "class", "thermal"), "cooling_device", "type",
                                         "pwm-fan")
        found = (self.hwmon, self.cooling)
        if found == self._announced:
            return
        self._announced = found
        names = [os.path.basename(p) for p in found if p]
        if names:
            self.log.info(f"Lüfter: Kernel-Treiber pwm-fan ({', '.join(names)})")
        else:
            self.log.info("Kein Kernel-Lüfter (pwm-fan) gefunden")

    def locate(self):
        """Pfad der cooling_device «pwm-fan» oder None (sucht höchstens jede Minute neu, solange nichts da ist)."""
        now = self.clock()
        if self.hwmon is None and self.cooling is None and now >= self._next_scan:
            self._scan(now)
        return self.cooling

    def read(self):
        now = self.clock()
        self.locate()
        stage = stages = rpm = None
        broken = False
        if self.cooling:
            stage = _read_int(os.path.join(self.cooling, "cur_state"))
            stages = _read_int(os.path.join(self.cooling, "max_state"))
            if stage is None or stages is None or not 0 <= stage <= stages <= 20:
                stage = stages = None
                broken = True
        if self.hwmon:
            # fan1_input fehlt, wenn der Lüfter keinen Drehzahlgeber hat
            rpm = _read_int(os.path.join(self.hwmon, "fan1_input"))
            if rpm is not None and not 0 <= rpm <= 30000:
                rpm = None
            if not os.path.isdir(self.hwmon):
                broken = True
        if broken and now >= self._next_scan:
            self._scan(now)
        return {"vorhanden": bool(self.hwmon or self.cooling), "stufe": stage, "stufen": stages, "upm": rpm}


# --- Mindeststufe für den Kernel-Lüfter --------------------------------------


def _read_text(path, limit=256):
    try:
        with open(path, encoding="ascii", errors="replace") as handle:
            return handle.read(limit).strip()
    except OSError:
        return None


def write_sysfs(path, value):
    """Ein Wert in eine sysfs-Datei, mit einem einzigen write (O_TRUNC wirkt nur bei den Attrappen der Tests)."""
    handle = os.open(path, os.O_WRONLY | os.O_TRUNC)
    try:
        os.write(handle, str(value).encode("ascii"))
    finally:
        os.close(handle)


def _zone_name(zone):
    return os.path.basename(zone.rstrip("/")) if zone else "?"


def find_fan_zones(thermal_dir, cooling):
    """Thermal-Zonen, an die der Kühler gebunden ist (Verweis thermal_zoneN/cdevK → cooling_deviceM)."""
    target = os.path.realpath(cooling)
    try:
        names = sorted((n for n in os.listdir(thermal_dir) if n.startswith("thermal_zone")), key=_natural)
    except OSError:
        return []
    zones = []
    for name in names:
        zone = os.path.join(thermal_dir, name)
        try:
            entries = os.listdir(zone)
        except OSError:
            continue
        for entry in entries:
            if entry.startswith("cdev") and entry[4:].isdigit() and \
                    os.path.realpath(os.path.join(zone, entry)) == target:
                zones.append(zone)
                break
    return zones


def fan_zone(thermal_dir, cooling):
    """Die Thermal-Zone des Lüfters: die erste mit Verweis auf ihn, sonst thermal_zone0 (wie am Gerät gelesen)."""
    zones = find_fan_zones(thermal_dir, cooling)
    if zones:
        return zones[0]
    fallback = os.path.join(thermal_dir, FALLBACK_ZONE)
    return fallback if os.path.isdir(fallback) else None


def trip_types(zone):
    types = []
    for index in range(64):
        kind = _read_text(os.path.join(zone, f"trip_point_{index}_type"))
        if kind is None:
            break
        types.append(kind)
    return types


def read_trips(zone):
    """Aktive Trip-Punkte der Zone als ((°C, Hysterese °C), …), aufsteigend, oder None, wenn sie fehlen oder
    unplausibel sind. Kritische und heisse Trip-Punkte gehören nicht zum Lüfter (die behandelt der Kernel immer,
    unabhängig vom Regler)."""
    trips = []
    for index, kind in enumerate(trip_types(zone)):
        if kind != "active":
            continue
        base = os.path.join(zone, f"trip_point_{index}_")
        temperature = _read_int(base + "temp")
        hysteresis = _read_int(base + "hyst")
        if temperature is None:
            return None
        trips.append((temperature / 1000, (hysteresis or 0) / 1000))
    trips.sort()
    if not 1 <= len(trips) <= 10:
        return None
    for temperature, hysteresis in trips:
        if not 20 <= temperature <= 100 or not 0 <= hysteresis <= 20:
            return None
    if any(t1 == t2 for (t1, _h1), (t2, _h2) in zip(trips, trips[1:])):
        return None
    return tuple(trips)


def describe_trips(trips):
    hystereses = {h for _t, h in trips}
    text = " / ".join(_fmt(t) for t, _h in trips) + " °C"
    if len(hystereses) == 1:
        return f"{text}, Hysterese {_fmt(hystereses.pop())} °C"
    return text + " (Hysterese " + " / ".join(_fmt(h) for _t, h in trips) + " °C)"


def zone_links(zone):
    """Verweise cdevN der Zone als [(echter Pfad des Kühlers, Index des Trip-Punkts oder None)]."""
    try:
        entries = sorted((e for e in os.listdir(zone) if e.startswith("cdev") and e[4:].isdigit()), key=_natural)
    except OSError:
        return []
    return [(os.path.realpath(os.path.join(zone, entry)), _read_int(os.path.join(zone, f"{entry}_trip_point")))
            for entry in entries]


def zone_problem(zone, cooling=None):
    """Warum zenos-argon die Zone nicht übernehmen kann, oder None. Mit cooling (Pfad der cooling_device «pwm-fan»)
    auch, ob die Zone genau so am Lüfter hängt, wie AutoStage es nachrechnet: Unter user_space regelt der Kernel an
    dieser Zone gar nichts mehr, und die Leitplanke «nie weniger als automatisch» stimmt nur für dieses Muster."""
    policy = os.path.join(zone, "policy")
    if _read_text(policy) is None:
        return "Regler der Thermal-Zone nicht lesbar"
    available = (_read_text(os.path.join(zone, "available_policies"), 1024) or "").split()
    for needed in (POLICY_USER, POLICY_KERNEL):
        if needed not in available:
            return f"der Kernel kennt den Regler {needed} nicht"
    types = trip_types(zone)
    if "passive" in types:
        # user_space schaltete auch das Drosseln der CPU durch den Kernel ab: weniger Kühlung als automatisch
        return "die Zone drosselt auch die CPU (passiver Trip-Punkt)"
    if cooling is not None:
        fan = os.path.realpath(cooling)
        links = zone_links(zone)
        if not any(target == fan for target, _trip in links):
            return "die Thermal-Zone ist nicht mit dem Lüfter verbunden"
        if any(target != fan for target, _trip in links):
            # user_space hielte auch diesen Kühler an: weniger Kühlung als automatisch
            return "an der Thermal-Zone hängt noch ein anderer Kühler"
        active = {index for index, kind in enumerate(types) if kind == "active"}
        linked = {trip for target, trip in links if target == fan}
        stages = _read_int(os.path.join(cooling, "max_state"))
        # Ohne lesbare Trip-Punkte gelten FALLBACK_TRIPS (am Gerät gelesen); sonst je aktiver Trip-Punkt eine Stufe
        if active and (len(active) != stages or not active <= linked):
            return "Trip-Punkte und Stufen des Lüfters passen nicht zusammen"
        if not os.access(os.path.join(cooling, "cur_state"), os.W_OK):
            return "Stufe des Lüfters nicht schreibbar"
    if not os.access(policy, os.W_OK):
        return "Regler der Thermal-Zone nicht schreibbar"
    return None


class AutoStage:
    """Stufe, die der Kernel-Regler step_wise wählen würde: Der N-te aktive Trip-Punkt (aufsteigend) bringt Stufe N.
    Er greift ab seiner Temperatur und lässt erst unter Temperatur − Hysterese wieder los, wie im Kernel.
    stage: Ausgangsstufe für die Hysterese (beim Übernehmen die Stufe, die der Kernel gerade hat)."""

    def __init__(self, trips, stage=0):
        self.trips = tuple(trips)
        self.on = [index < stage for index in range(len(self.trips))]

    @property
    def stage(self):
        return max((index + 1 for index, on in enumerate(self.on) if on), default=0)

    def update(self, temperature):
        for index, (trip, hysteresis) in enumerate(self.trips):
            if temperature >= trip:
                self.on[index] = True
            elif temperature < trip - hysteresis:
                self.on[index] = False
        return self.stage


def kernel_fan_target(temperature, auto_stage, minimum, max_state):
    """Stufe für den Kernel-Lüfter. Leitplanken: nie unter der automatischen Stufe, ab 80 °C und ohne lesbare
    Temperatur die volle."""
    if temperature is None or temperature >= EMERGENCY_TEMPERATURE:
        return max_state
    return max(0, min(max(auto_stage, minimum), max_state))


class KernelFanControl:
    """Mindeststufe für den Kernel-Lüfter am Compute Module 5 (pwm-fan an einer Thermal-Zone mit step_wise).

    «auto» (Standard): Der Kernel regelt allein, zenos-argon schreibt nichts nach /sys.
    Mindeststufe 1–4: zenos-argon stellt die Zone auf den Regler user_space (der Kernel ändert die Stufe dann nicht
    mehr selbst) und setzt in jedem Takt cur_state = max(Mindeststufe, Stufe des Kernels). Die Stufe des Kernels
    rechnet AutoStage aus der Temperatur der Zone und ihren Trip-Punkten nach. Kritische Trip-Punkte (Abschalten bei
    110 °C) behandelt der Kernel unabhängig vom Regler weiter.
    Leitplanken (Code, nicht Konfiguration): nie weniger als automatisch, ab 80 °C und ohne lesbare Temperatur volle
    Stufe; bei «auto», beim Beenden und nach jedem Schreibfehler regelt wieder der Kernel (step_wise)."""

    def __init__(self, fan, wish, log, thermal_dir, clock=time.monotonic, temperature_source=None):
        self.fan = fan
        self.wish = wish
        self.log = log
        self.thermal_dir = thermal_dir
        self.clock = clock
        # Ohne Angabe die Temperatur der Zone selbst (dieselbe, nach der der Kernel regelt)
        self._temperature_source = temperature_source
        self.zone = None
        self.reason = "kein Kernel-Lüfter (pwm-fan)"
        self.active = False
        self.auto = None
        self.trips = None
        self._trips_at = 0.0
        self._next_scan = 0.0
        self._retry_at = 0.0
        self._announced = None
        self._reported = None
        # Stufe, die der Kernel beim Übernehmen hatte. step_wise behält unter user_space seine Ziele je Trip-Punkt
        # (höchstens diese Stufe) und setzt die Stufe erst neu, wenn sich eines davon ändert: Beim Zurückgeben nie
        # darunter, sonst bliebe der Lüfter bei steigender Temperatur unter dem, was automatisch gälte (_hand_back).
        self._kernel_floor = 0
        # Stufe in diesem Takt geändert: Die Statusdatei soll sie gleich zeigen, nicht erst nach 15 s
        self._stage_changed = False

    # --- Hilfen ---

    def _path(self, name):
        return os.path.join(self.zone, name)

    def _cooling(self, name):
        return os.path.join(self.fan.cooling, name)

    def temperature(self):
        if self._temperature_source is not None:
            return self._temperature_source()
        return read_temperature(self._path("temp")) if self.zone else None

    def policy(self):
        return _read_text(self._path("policy")) if self.zone else None

    def _max_state(self):
        value = _read_int(self._cooling("max_state"))
        if value is None or not 1 <= value <= 20:
            raise OSError(errno.EIO, f"max_state des Lüfters unplausibel ({value})")
        return value

    def _set_stage(self, stage, temperature, why=""):
        current = _read_int(self._cooling("cur_state"))
        if current == stage:
            return
        write_sysfs(self._cooling("cur_state"), stage)
        self._stage_changed = True
        shown = "?" if temperature is None else _fmt(round(temperature, 1))
        self.log.info(f"Lüfter Stufe {stage} bei {shown} °C{why}")

    # --- Suche ---

    def _discover(self, now):
        self._next_scan = now + FAN_RESCAN_SECONDS
        cooling = self.fan.locate()
        zone = fan_zone(self.thermal_dir, cooling) if cooling else None
        if cooling is None:
            reason = "kein Kernel-Lüfter (pwm-fan)"
        elif zone is None:
            reason = "keine Thermal-Zone zum Lüfter"
        else:
            reason = zone_problem(zone, cooling)
        self.zone, self.reason = zone, reason
        if (zone, reason) == self._announced:
            return
        self._announced = (zone, reason)
        if zone is not None and reason is None:
            self.log.info(f"Lüfter einstellbar über {_zone_name(zone)} (Regler {self.policy()})")
        elif cooling is not None:
            self.log.info(f"Lüfter nicht einstellbar: {reason}; der Kernel regelt allein")

    def _load_trips(self, now):
        self._trips_at = now
        trips = read_trips(self.zone)
        if trips is None:
            self.log.problem("luefter-trips", f"Trip-Punkte von {_zone_name(self.zone)} fehlen oder sind unplausibel, "
                             f"es gelten {describe_trips(FALLBACK_TRIPS)}")
            trips = FALLBACK_TRIPS
        else:
            self.log.solved("luefter-trips", f"Trip-Punkte von {_zone_name(self.zone)} wieder lesbar")
        if trips != self.trips and self.auto is not None:
            self.log.info(f"Trip-Punkte von {_zone_name(self.zone)} geändert: {describe_trips(trips)}")
            self.auto = AutoStage(trips, self.auto.stage)
        self.trips = trips
        return trips

    # --- Übernehmen und zurückgeben ---

    def _take_over(self, now):
        trips = self._load_trips(now)
        # Die Hysterese beginnt bei der Stufe, die der Kernel gerade hat
        current = _read_int(self._cooling("cur_state")) or 0
        self.auto = AutoStage(trips, current)
        write_sysfs(self._path("policy"), POLICY_USER)
        if self.policy() != POLICY_USER:
            raise OSError(errno.EIO, f"Regler {POLICY_USER} nicht übernommen")
        self.active = True
        # Mit max: Wurde der Regler von Hand zurückgestellt und gleich wieder übernommen, gelten die Ziele von davor
        self._kernel_floor = max(self._kernel_floor, current)
        self.log.info(f"Lüfter: Mindeststufe {self.wish.stage}, zenos-argon regelt ({_zone_name(self.zone)}: Regler "
                      f"{POLICY_USER}, Trip-Punkte {describe_trips(trips)})")

    def _hand_back(self, why, conservative=False):
        """Der Kernel regelt wieder: zuerst cur_state auf die Stufe, die er selbst hätte, dann der Regler step_wise.
        step_wise setzt die Stufe nur neu, wenn sich das Ziel eines Trip-Punkts ändert (Trend der Temperatur über eine
        Schwelle); bis dahin bleibt cur_state, wie es ist. Deshalb:
        - nicht die Mindeststufe stehen lassen (sie bliebe sonst bis zum nächsten Wechsel an einem Trip-Punkt);
        - nicht unter die Stufe beim Übernehmen (_kernel_floor): Die Ziele von damals gelten für step_wise weiter. Läge
          cur_state darunter und stiege die Temperatur ohne Zwischentief über diese Trip-Punkte, änderte sich kein Ziel,
          und der Lüfter bliebe leiser als automatisch. Darüber bringt ihn der Kernel mit der nächsten fallenden Messung
          herunter.
        conservative: ohne eigene Hysterese (verwaister Zustand) die höchste Stufe, die der Kernel haben könnte."""
        temperature = self.temperature()
        if self.fan.cooling:
            try:
                max_state = self._max_state()
                floor = min(self._kernel_floor, max_state)
                if temperature is None:
                    # Ohne Temperatur regelt auch der Kernel nicht: die Stufe lassen (der letzte Takt ohne Temperatur
                    # hat sie schon auf voll gestellt), nur nicht unter die Ziele des Kernels
                    stage = _read_int(self._cooling("cur_state")) or 0
                    target = min(max(stage, floor), max_state)
                else:
                    trips = self.trips or read_trips(self.zone) or FALLBACK_TRIPS
                    if conservative or self.auto is None:
                        stage = AutoStage(trips, len(trips)).update(temperature)
                    else:
                        stage = self.auto.update(temperature)
                    target = kernel_fan_target(temperature, max(stage, floor), 0, max_state)
                note = ""
                if floor > stage and target == floor:
                    note = " (Stufe beim Übernehmen; der Kernel senkt sie mit der nächsten fallenden Messung)"
                self._set_stage(target, temperature, note)
            except OSError as err:
                self.log.warning(f"Lüfterstufe vor der Rückgabe an den Kernel nicht gesetzt ({err})")
        write_sysfs(self._path("policy"), POLICY_KERNEL)
        self.active = False
        self.auto = None
        self._kernel_floor = 0
        self.log.info(f"Lüfter: wieder automatisch, der Kernel regelt ({_zone_name(self.zone)}: Regler "
                      f"{POLICY_KERNEL}; {why})")

    def _fail(self, now, err):
        """Schreibfehler oder Programmfehler: dem Kernel zurückgeben und erst nach einer Pause neu versuchen."""
        self._retry_at = now + FAN_RETRY_SECONDS
        self.log.problem("luefter-steuern", f"Lüfter lässt sich nicht einstellen ({err}); der Kernel regelt, neuer "
                         f"Versuch in {_fmt(FAN_RETRY_SECONDS)} s")
        if self.zone is None or (not self.active and self.policy() != POLICY_USER):
            return
        try:
            self._hand_back("Fehler beim Einstellen")
        except Exception as again:
            self._last_resort(again)

    def _last_resort(self, err):
        """Zurückgeben an den Kernel ging schief: Dann wenigstens voll kühlen (Sicherheit vor Ruhe)."""
        self.log.error(f"Regler {POLICY_KERNEL} liess sich nicht setzen ({err}), der Lüfter läuft auf voller Stufe")
        try:
            write_sysfs(self._cooling("cur_state"), self._max_state())
        except (OSError, TypeError) as again:
            self.log.error(f"Auch die volle Lüfterstufe liess sich nicht setzen ({again})")

    # --- Takt ---

    def start(self):
        """Beim Start des Dienstes: Steht die Zone noch auf user_space (zenos-argon zuvor abgestürzt oder hart
        beendet), regelt zuerst wieder der Kernel. Eine Mindeststufe übernimmt danach tick()."""
        try:
            self._discover(self.clock())
        except Exception as err:  # Programmfehler: tick() versucht es wieder, ExecStopPost sichert ab
            self.log.error(f"Lüfter: Suche nach der Thermal-Zone fehlgeschlagen ({err!r})")
            return
        if self.zone is None or self.policy() != POLICY_USER:
            return
        self.log.warning(f"{_zone_name(self.zone)} stand noch auf dem Regler {POLICY_USER} (zenos-argon zuvor "
                         f"abgestürzt?), zurück auf {POLICY_KERNEL}")
        try:
            self._hand_back("verwaister Zustand aufgeräumt", conservative=True)
        except Exception as err:
            self._last_resort(err)

    def tick(self):
        """Wunsch prüfen; bei einer Mindeststufe regeln, sonst dem Kernel überlassen. True, wenn sich die Angaben für
        die Statusdatei oder die Stufe geändert haben (dann schreibt der Dienst sie sofort)."""
        now = self.clock()
        self.wish.refresh()
        try:
            if not self.active and now >= self._next_scan:
                self._discover(now)
            want = self.wish.mode == "mindest" and self.zone is not None and self.reason is None
            if want and now >= self._retry_at:
                self._regulate(now)
                self.log.solved("luefter-steuern", "Lüfter lässt sich wieder einstellen")
            elif not want and self.active:
                self._hand_back("Wunsch «automatisch»" if self.wish.mode == "auto" else self.reason or "Lüfter fehlt")
        except Exception as err:  # auch Programmfehler: Akku und Statusdatei sollen weiterlaufen
            self._fail(now, err)
        report = self.report()
        changed = report != self._reported or self._stage_changed
        self._reported = report
        self._stage_changed = False
        return changed

    def _regulate(self, now):
        if not self.active:
            self._take_over(now)
        else:
            if now - self._trips_at >= FAN_RESCAN_SECONDS:
                self._load_trips(now)
            if self.policy() != POLICY_USER:
                # Jemand hat den Regler von Hand umgestellt: neu übernehmen (mit der Stufe, die der Kernel jetzt hat)
                self.active = False
                self._take_over(now)
        max_state = self._max_state()
        temperature = self.temperature()
        if temperature is None:
            self.log.problem("luefter-temperatur", "Temperatur der Zone nicht lesbar, der Lüfter läuft sicherheitshalber "
                             "auf voller Stufe")
            auto = max_state
        else:
            self.log.solved("luefter-temperatur", "Temperatur der Zone wieder lesbar")
            auto = self.auto.update(temperature)
        minimum = min(self.wish.stage, max_state)
        target = kernel_fan_target(temperature, auto, minimum, max_state)
        why = " (Mindeststufe)" if target == minimum and auto < minimum else ""
        self._set_stage(target, temperature, why)

    def release(self):
        """Beim Beenden des Dienstes: Steht die Zone auf user_space, regelt danach wieder der Kernel."""
        if self.zone is None or (not self.active and self.policy() != POLICY_USER):
            return
        try:
            self._hand_back("der Dienst endet")
        except Exception as err:
            self._last_resort(err)
            try:
                write_sysfs(self._path("policy"), POLICY_KERNEL)
            except OSError:
                pass

    def report(self):
        """Angaben für die Statusdatei: Wunsch und ob zenOS ihn umsetzen kann."""
        return fan_wish_report(self.wish, self.zone is not None and self.reason is None)


class UpDaemon:
    """Takt beim Argon ONE UP: Akku, Lüfter und Temperatur lesen, Statusdatei schreiben. Schreibt an die Hardware nur
    beim Laden des Akkuprofils und, mit einer Mindeststufe für den Lüfter, über control (KernelFanControl).
    lid (Lid): Deckel, den LidWatcher in einem eigenen Thread liest; jeder Wechsel kommt über lid_changed sofort in die
    Statusdatei. critical (CriticalBattery): Ausschalten bei leerem Akku, geprüft in jedem Takt."""

    def __init__(self, monitor, fan, log, status, temperature_source, control=None, lid=None, critical=None):
        self.monitor = monitor
        self.fan = fan
        self.log = log
        self.status = status
        self.temperature_source = temperature_source
        self.control = control
        self.lid = lid
        self.critical = critical
        # Thread des Deckels (LidWatcher): beim Beenden kurz abwarten, damit er die Leitung freigibt
        self.lid_watcher = None
        self.stop = threading.Event()
        self._akku = None
        # Takt und Deckel-Thread schreiben die Statusdatei: nacheinander, und immer mit dem neuesten Deckel
        self._write_lock = threading.Lock()
        self._last = None

    def _write(self):
        temperature = self.temperature_source()
        luefter = self.fan.read()
        if self.control is not None:
            luefter.update(self.control.report())
        akku = self._akku
        if self.critical is not None and isinstance(akku, dict):
            akku = dict(akku, ausschaltenUm=self.critical.report())
        report = {
            "geraet": "argon-one-up",
            "akku": akku,
            "luefter": luefter,
            "temperatur": {"cpu": round_temperature(temperature)},
        }
        with self._write_lock:
            if self.lid is not None:
                report["deckel"] = self.lid.report()
            self._last = report
            self.status.write(report)

    def lid_changed(self):
        """Vom Deckel-Thread: Statusdatei sofort schreiben, mit den letzten Werten von Akku, Lüfter und Temperatur (der
        Takt liest sie; vor dem ersten Takt gibt es noch keine, dann schreibt ihn der erste Takt)."""
        with self._write_lock:
            if self._last is None or self.lid is None:
                return
            report = dict(self._last, deckel=self.lid.report())
            self._last = report
            self.status.write(report)

    def tick(self):
        watchdog_ping()
        if self.control is not None:
            self.control.tick()
        self._akku = self.monitor.tick()
        if self.critical is not None:
            try:
                self.critical.update(self.monitor)
            except Exception as err:  # Programmfehler: Akku, Lüfter und Statusdatei sollen weiterlaufen
                self.log.problem("akku-aus-fehler", f"Ausschalten bei leerem Akku: unerwarteter Fehler ({err!r})")
        self._write()

    def _short(self):
        """Öfter messen: eine Änderung wartet auf Bestätigung, oder die Vorwarnung bei leerem Akku läuft."""
        return self.monitor.pending or (self.critical is not None and self.critical.active)

    def pause(self, seconds):
        """Pause mitten in einer längeren Arbeit am Messchip (Akkuprofil laden und aktivieren, bis etwa 20 s; als
        sleep von BatteryGauge): Lüfter weiter regeln und Lebenszeichen geben, sonst stünde die Mindeststufe so lange
        ohne Blick auf die Temperatur."""
        watchdog_ping()
        if self.control is not None and self.control.tick() and self._akku is not None:
            self._write()
        time.sleep(seconds)

    def _wait(self, seconds):
        """Bis zur nächsten Messung warten. Mit Lüftersteuerung in Schritten von höchstens FAN_CONTROL_INTERVAL: Jeder
        Schritt prüft den Wunsch und regelt bei einer Mindeststufe; ein neuer Wunsch steht sofort in der Statusdatei."""
        if self.control is None:
            self.stop.wait(seconds)
            return
        steps = max(1, math.ceil(seconds / FAN_CONTROL_INTERVAL - 1e-9))
        for _ in range(steps):
            if self.stop.wait(seconds / steps):
                return
            watchdog_ping()
            if self.control.tick():
                self._write()

    def run(self, interval, rounds=None):
        count = 0
        try:
            if self.control is not None:
                self.control.start()
            while not self.stop.is_set():
                self.tick()
                count += 1
                if rounds is not None and count >= rounds:
                    break
                self._wait(min(interval, UP_PENDING_INTERVAL) if self._short() else interval)
        finally:
            self.stop.set()
            if self.control is not None:
                self.control.release()
            if self.lid_watcher is not None and self.lid_watcher.is_alive():
                # Er wartet höchstens 1 s auf Flanken und gibt die Leitung danach frei
                self.lid_watcher.join(LID_POLL + 1.5)
            with self._write_lock:
                self._last = None
                self.status.remove()
        return 0


def argon_up_original_active():
    """Ist Argons eigener Dienst für den ONE UP (argononeupd.service) aktiviert?"""
    return os.path.lexists(system_path(ARGON_UP_DAEMON_WANTS))


def profile_released():
    """Hat Zeno das Schreiben des Akkuprofils freigegeben (zen akku freigeben)?"""
    return os.path.isfile(system_path(PROFILE_RELEASE_PATH))


# --- Aufruf ----------------------------------------------------------------


class UsageError(Exception):
    pass


def _option_value(items, arg):
    if not items:
        raise UsageError(f"{arg} braucht einen Wert")
    return items.pop(0)


def _option_number(items, arg, low, high):
    text = _option_value(items, arg)
    try:
        result = float(text.replace(",", "."))
    except ValueError:
        raise UsageError(f"{arg}: «{text}» ist keine Zahl") from None
    if not math.isfinite(result) or not low <= result <= high:
        raise UsageError(f"{arg}: erlaubt sind {_fmt(low)} bis {_fmt(high)}")
    return result


def parse_args(argv):
    options = {
        "mode": "dienst",
        "konfig": CONFIG_PATH,
        "status": STATUS_PATH,
        "intervall": None,
        "durchlaeufe": None,
        "temperatur": None,
        "temperatur_datei": None,
        "pulse": [],
    }
    modes = {"--simulieren": "simulation", "--pruefen": "pruefen", "--konfig-pruefen": "konfig",
             "--luefter-kernel": "luefter-kernel"}
    items = list(argv)
    while items:
        arg = items.pop(0)
        if arg in ("-h", "--hilfe", "--help"):
            options["mode"] = "hilfe"
        elif arg in modes:
            if options["mode"] not in ("dienst", modes[arg]):
                raise UsageError("--simulieren, --pruefen, --konfig-pruefen und --luefter-kernel schliessen sich aus")
            options["mode"] = modes[arg]
        elif arg == "--konfig":
            options["konfig"] = _option_value(items, arg)
        elif arg == "--status-datei":
            options["status"] = _option_value(items, arg)
        elif arg == "--intervall":
            options["intervall"] = _option_number(items, arg, 0.05, 60)
        elif arg == "--durchlaeufe":
            options["durchlaeufe"] = int(_option_number(items, arg, 1, 1_000_000))
        elif arg == "--temperatur":
            options["temperatur"] = _option_number(items, arg, -40, 150)
        elif arg == "--temperatur-datei":
            options["temperatur_datei"] = _option_value(items, arg)
        elif arg == "--puls":
            options["pulse"].append(_option_number(items, arg, 0, 10_000))
        else:
            raise UsageError(f"unbekannte Option «{arg}»")
    simulation_only = options["temperatur"] is not None or options["temperatur_datei"] or options["pulse"]
    if simulation_only and options["mode"] != "simulation":
        raise UsageError("--temperatur, --temperatur-datei und --puls gibt es nur mit --simulieren")
    if options["temperatur"] is not None and options["temperatur_datei"]:
        raise UsageError("entweder --temperatur oder --temperatur-datei")
    return options


def install_signals(stop, handler_log):
    def handle(signum, _frame):
        handler_log.info(f"Signal {signal.Signals(signum).name}, beende")
        stop.set()

    signal.signal(signal.SIGTERM, handle)
    signal.signal(signal.SIGINT, handle)


def wait_for_device(path, stop, seconds):
    deadline = time.monotonic() + seconds
    while not os.path.exists(path):
        if time.monotonic() >= deadline or stop.is_set():
            return False
        watchdog_ping()
        stop.wait(1)
    return True


def run_service(options, log):
    stop = threading.Event()
    install_signals(stop, log)

    model = read_model()
    if not is_pi5(model) and not is_cm5(model):
        log.info(f"Weder Raspberry Pi 5 noch Compute Module 5 ({model or 'kein Gerätebaum'}), zenos-argon hat "
                 "nichts zu tun")
        return 0

    wait = I2C_WAIT_SECONDS if uptime_seconds() < I2C_WAIT_UPTIME else 0
    if not wait_for_device(system_path(I2C_DEVICE), stop, wait):
        if stop.is_set():
            return 0
        log.info(f"I2C-Bus 1 fehlt ({I2C_DEVICE}), zenos-argon hat nichts zu tun. Für den Argon ONE braucht es "
                 "dtparam=i2c_arm=on in /boot/firmware/config.txt; zenOS ändert die Firmware-Einstellungen "
                 "nicht selbst (zen doctor)")
        return 0

    bus = open_bus(log)
    if bus is None:
        return 1
    if is_cm5(model):
        try:
            return run_up_service(options, log, model, bus, stop)
        finally:
            bus.close()

    fan = ArgonFan(bus)
    present = False
    for attempt in range(3):
        present = fan.present()
        if present or stop.is_set():
            break
        stop.wait(2)
    if not present:
        log.info(f"Kein Argon ONE an I2C-Adresse 0x{ARGON_ADDRESS:02x}, zenos-argon hat nichts zu tun")
        bus.close()
        return 0
    if stop.is_set():
        bus.close()
        return 0

    register = fan.detect_register()
    how = f"Register 0x{REG_DUTY_CYCLE:02x}" if register else "einzelnes Byte (Firmware ohne Register)"
    log.info(f"Argon ONE an 0x{ARGON_ADDRESS:02x} gefunden ({model}), Lüfter über {how}")

    daemon = Daemon(fan, log, StatusFile(options["status"], log), options["konfig"], read_temperature,
                    wish=FanWish(system_path(FAN_WISH_PATH), log))
    daemon.stop = stop
    ButtonWatcher(stop, daemon.on_pulse, log).start()
    try:
        return daemon.run(options["intervall"] or V3_INTERVAL, options["durchlaeufe"])
    finally:
        bus.close()


def find_gauge(gauge, stop):
    """Chip-ID an 0x64 lesen (nur lesend, bis zu dreimal). Gibt die gelesene ID oder None zurück."""
    chip = None
    for _ in range(3):
        try:
            chip = gauge.chip_id()
        except OSError:
            chip = None
        if chip == GAUGE_CHIP_ID or stop.is_set():
            break
        stop.wait(2)
    return chip


def run_up_service(options, log, model, bus, stop):
    """Argon ONE UP am Compute Module 5: Akku-Messchip CW2217 an 0x64, Lüfter und Temperatur vom Kernel."""
    gauge = BatteryGauge(bus, stop=stop)
    chip = find_gauge(gauge, stop)
    if stop.is_set():
        return 0
    if chip != GAUGE_CHIP_ID:
        seen = "keine Antwort" if chip is None else f"Chip-ID 0x{chip:02x}"
        log.info(f"Kein Argon ONE UP: kein Akku-Messchip CW2217 an I2C-Adresse 0x{GAUGE_ADDRESS:02x} ({seen}), "
                 "zenos-argon hat nichts zu tun")
        return 0
    log.info(f"Argon ONE UP erkannt ({model}): Akku-Messchip CW2217 an 0x{GAUGE_ADDRESS:02x}")
    read_only = argon_up_original_active()
    if read_only:
        log.warning("Argons eigene Software (argononeupd.service) ist aktiviert: zenos-argon liest den Akku nur "
                    "und schreibt nichts in den Messchip (entfernen: argon-uninstall)")
    monitor = BatteryMonitor(gauge, log, read_only=read_only, released=profile_released)
    fan = KernelFan(system_path("/sys"), log)
    control = KernelFanControl(fan, FanWish(system_path(FAN_WISH_PATH), log), log, system_path(THERMAL_CLASS))
    lid = Lid()
    daemon = UpDaemon(monitor, fan, log, StatusFile(options["status"], log), read_temperature, control=control,
                      lid=lid, critical=CriticalBattery(log))
    daemon.stop = stop
    # Pausen beim Laden des Akkuprofils regeln den Lüfter weiter (UpDaemon.pause)
    gauge.sleep = daemon.pause
    daemon.lid_watcher = LidWatcher(stop, lid, daemon.lid_changed, log)
    daemon.lid_watcher.start()
    return daemon.run(options["intervall"] or UP_INTERVAL, options["durchlaeufe"])


def run_simulation(options, log):
    stop = threading.Event()
    install_signals(stop, log)
    if options["temperatur"] is not None:
        fixed = options["temperatur"]

        def source():
            return fixed
    elif options["temperatur_datei"]:
        path = options["temperatur_datei"]

        def source():
            return read_temperature_file(path)
    else:
        source = read_temperature
    log.info("Simulation: kein I2C, kein GPIO")
    daemon = Daemon(SimulatedFan(log), log, StatusFile(options["status"], log), options["konfig"], source,
                    simulate=True, stopping=lambda: False, wish=FanWish(system_path(FAN_WISH_PATH), log))
    daemon.stop = stop
    for width in options["pulse"]:
        daemon.on_pulse(width)
    return daemon.run(options["intervall"] or V3_INTERVAL, options["durchlaeufe"])


def run_config_check(options, out=sys.stdout):
    config, errors, notes, own = load_config(options["konfig"])
    for note in notes:
        print(f"Hinweis: {note}", file=out)
    if errors:
        for error in errors:
            print(f"Ungültig: {error}", file=out)
        print(f"Wirksam ist die Standardkurve: {config.describe()}", file=out)
        return 1
    herkunft = f"Eigene Kurve ({options['konfig']})" if own else "Standardkurve"
    print(f"{herkunft}: {config.describe()}", file=out)
    return 0


def run_check(options, out=sys.stdout):
    """Nur lesend: nichts wird geschrieben, auch nicht an den Argon."""
    good = True

    def line(ok, text):
        print(f"  {'✓' if ok else '✗'} {text}", file=out)

    model = read_model()
    pi5 = is_pi5(model)
    if is_cm5(model):
        return run_check_up(model, out, options["status"])
    line(pi5, f"Gerät: {model or 'kein Gerätebaum'}")
    # Auf anderen Geräten können I2C-Bus 1 und GPIO4 etwas ganz anderes sein: dort nichts anfragen
    if not pi5:
        _check_config_line(options, line)
        return 1

    if os.path.exists(I2C_DEVICE):
        line(True, f"I2C-Bus 1 ({I2C_DEVICE})")
        try:
            import smbus
            bus = smbus.SMBus(I2C_BUS)
        except (ImportError, OSError) as err:
            line(False, f"I2C-Bus 1 nicht nutzbar: {err}")
            good = False
        else:
            try:
                bus.read_byte(ARGON_ADDRESS)
                line(True, f"Argon ONE antwortet an 0x{ARGON_ADDRESS:02x} (Lesezugriff)")
            except OSError as err:
                line(False, f"Keine Antwort an 0x{ARGON_ADDRESS:02x} ({err})")
                good = False
            finally:
                bus.close()
    else:
        line(False, f"I2C-Bus 1 fehlt ({I2C_DEVICE}): dtparam=i2c_arm=on in /boot/firmware/config.txt nötig")
        good = False

    try:
        import gpiod
    except ImportError:
        line(False, "python3-libgpiod fehlt")
        good = False
    else:
        found = find_button_line(gpiod)
        if found is None:
            line(False, f"GPIO-Zeile {BUTTON_LINE} nicht gefunden")
            good = False
        else:
            path, offset, label = found
            used = ""
            try:
                with gpiod.Chip(path) as chip:
                    info = chip.get_line_info(offset)
                    if info.used:
                        used = f", belegt von «{info.consumer or '?'}»"
            except OSError:
                pass
            line(True, f"Power-Button: {BUTTON_LINE} = {path} ({label}), Zeile {offset}{used}")

    _check_config_line(options, line)
    _check_fan_wish_line(line, ok=True, bad=False)
    return 0 if good else 1


def run_check_up(model, out=sys.stdout, status_path=STATUS_PATH):
    """Argon ONE UP, nur lesend: Messchip (Chip-ID, Steuerregister, Profil, Ladestand, Stromrichtung), Deckel, Lüfter,
    Temperatur. Schreibt nichts in den Chip, auch wenn er schläft."""

    def line(mark, text):
        print(f"  {mark} {text}", file=out)

    line("✓", f"Gerät: {model} (Argon ONE UP erwartet)")
    good = True
    if not os.path.exists(system_path(I2C_DEVICE)):
        line("✗", f"I2C-Bus 1 fehlt ({I2C_DEVICE}): dtparam=i2c_arm=on in /boot/firmware/config.txt nötig")
        good = False
    else:
        line("✓", f"I2C-Bus 1 ({I2C_DEVICE})")
        bus = open_bus(Log(journal=False, stream=out))
        if bus is None:
            good = False
        else:
            try:
                good = _check_gauge(BatteryGauge(bus), line)
            finally:
                bus.close()
    _check_lid(line, status_path)
    fan = KernelFan(system_path("/sys"), Log(journal=False, stream=io.StringIO())).read()
    if fan["vorhanden"]:
        parts = []
        if fan["stufe"] is not None:
            parts.append("aus" if fan["stufe"] == 0 else f"Stufe {fan['stufe']} von {fan['stufen']}")
        if fan["upm"] is not None:
            parts.append(f"{fan['upm']} U/min")
        line("✓", "Lüfter (Kernel, pwm-fan): " + (" · ".join(parts) or "keine Werte"))
        _check_fan_control(line)
    else:
        line("·", "Kein Kernel-Lüfter (pwm-fan) gefunden")
    temperature = read_temperature()
    line("✓" if temperature is not None else "✗",
         f"CPU {_fmt(round(temperature, 1))} °C" if temperature is not None else "CPU-Temperatur nicht lesbar")
    if argon_up_original_active():
        line("·", "Argons eigene Software (argononeupd.service) ist aktiviert: zenos-argon schreibt dann nichts in "
                  "den Messchip")
    elif profile_released():
        line("✓", f"Akkuprofil schreiben: freigegeben ({PROFILE_RELEASE_PATH})")
    else:
        line("·", "Akkuprofil schreiben: nicht freigegeben, zenos-argon liest den Messchip nur (zen akku freigeben)")
    return 0 if good else 1


def _check_fan_wish_line(line, ok="✓", bad="✗"):
    """Lüfterwunsch, nur lesend. Gibt (modus, stufe) zurück."""
    path = system_path(FAN_WISH_PATH)
    mode, stage, problem = read_fan_wish(path)
    if problem:
        line(bad, f"Lüfterwunsch {path}: {problem}, es gilt «automatisch» (zen luefter)")
    else:
        line(ok, f"Lüfterwunsch: {describe_fan_wish(mode, stage)}")
    return mode, stage


def _check_fan_control(line):
    """Argon ONE UP, nur lesend: Wunsch, Thermal-Zone des Lüfters, Regler und Trip-Punkte."""
    mode, _stage = _check_fan_wish_line(line)
    thermal = system_path(THERMAL_CLASS)
    cooling = find_sysfs_device(thermal, "cooling_device", "type", "pwm-fan")
    zone = fan_zone(thermal, cooling) if cooling else None
    if zone is None:
        line("·", "Keine Thermal-Zone zum Lüfter: nicht einstellbar, der Kernel regelt allein")
        return
    policy = _read_text(os.path.join(zone, "policy")) or "?"
    problem = zone_problem(zone, cooling)
    if problem:
        line("·", f"{_zone_name(zone)} (Regler {policy}): nicht einstellbar, {problem}")
    trips = read_trips(zone)
    line("✓" if trips else "·", f"Trip-Punkte von {_zone_name(zone)}: " +
         (describe_trips(trips) if trips else f"nicht lesbar, es gälten {describe_trips(FALLBACK_TRIPS)}"))
    if policy == POLICY_USER and mode == "mindest":
        line("✓", f"{_zone_name(zone)}: Regler {POLICY_USER}, zenos-argon hält die Mindeststufe")
    elif policy == POLICY_USER:
        line("✗", f"{_zone_name(zone)}: Regler {POLICY_USER}, obwohl «automatisch» gilt (sudo systemctl restart "
                  "zenos-argon stellt step_wise wieder her)")
    elif mode == "mindest" and not problem:
        line("·", f"{_zone_name(zone)}: Regler {policy}; die Mindeststufe übernimmt der Dienst (läuft zenos-argon?)")
    elif not problem:
        line("✓", f"{_zone_name(zone)}: Regler {policy}, der Kernel regelt")


def run_fan_reset(log):
    """Sicherung für ExecStopPost (zenos-argon.service): Steht die Thermal-Zone des Kernel-Lüfters noch auf dem Regler
    user_space (Absturz oder hartes Beenden), wieder step_wise. Schreibt sonst nichts; ohne Lüfter oder Zone Exit 0."""
    thermal = system_path(THERMAL_CLASS)
    cooling = find_sysfs_device(thermal, "cooling_device", "type", "pwm-fan")
    zone = fan_zone(thermal, cooling) if cooling else None
    if zone is None or _read_text(os.path.join(zone, "policy")) != POLICY_USER:
        return 0
    try:
        write_sysfs(os.path.join(zone, "policy"), POLICY_KERNEL)
    except OSError as err:
        log.error(f"{_zone_name(zone)}: Regler {POLICY_KERNEL} liess sich nicht setzen ({err})")
        return 1
    log.warning(f"{_zone_name(zone)} stand nach dem Ende von zenos-argon noch auf {POLICY_USER}: wieder "
                f"{POLICY_KERNEL}, der Kernel regelt den Lüfter")
    return 0


def _check_gauge(gauge, line):
    try:
        chip = gauge.chip_id()
    except OSError as err:
        line("✗", f"Keine Antwort an 0x{GAUGE_ADDRESS:02x} ({err}): kein Argon ONE UP?")
        return False
    if chip != GAUGE_CHIP_ID:
        line("✗", f"An 0x{GAUGE_ADDRESS:02x} antwortet kein CW2217 (Chip-ID 0x{chip:02x} statt "
                  f"0x{GAUGE_CHIP_ID:02x})")
        return False
    line("✓", f"Akku-Messchip CW2217 an 0x{GAUGE_ADDRESS:02x} (Chip-ID 0x{chip:02x}, Lesezugriff)")
    try:
        control = gauge._read(REG_CONTROL)
        state = gauge.check()
        if state != "ok":
            if argon_up_original_active():
                folge = "Argons eigene Software ist zuständig"
            elif profile_released():
                folge = "der Dienst lädt Argons Akkuprofil im nächsten Takt"
            else:
                folge = "Argons Akkuprofil kommt erst nach «zen akku freigeben»"
            line("·", f"Messchip {GAUGE_STATES[state]} (Register 0x08 = 0x{control:02x}); {folge}")
            return True
        line("✓", "Messchip aktiv, Argons Akkuprofil ist geladen")
        soc = gauge.read_soc()
        discharging = gauge.read_discharging()
    except OSError as err:
        line("✗", f"Messchip nicht lesbar ({err})")
        return False
    shown = f"{soc} %" if 1 <= soc <= 100 else f"noch kein Wert (Register 0x04 = {soc})"
    line("✓", f"Akku {shown}, {'entlädt' if discharging else 'lädt oder Netzteil'}")
    return True


def _lid_from_status(path):
    """Deckel laut Statusdatei des laufenden Dienstes: «offen», «zu» oder None."""
    try:
        with open(path, encoding="utf-8") as handle:
            deckel = json.load(handle).get("deckel")
    except (OSError, ValueError, AttributeError):
        return None
    if not isinstance(deckel, dict) or deckel.get("vorhanden") is not True or not isinstance(deckel.get("zu"), bool):
        return None
    return "zu" if deckel["zu"] else "offen"


def _check_lid(line, status_path=STATUS_PATH):
    """Deckel des Argon ONE UP (GPIO27): Belegt der Dienst die Leitung, zählt sein Wert aus der Statusdatei. Ist sie
    frei, wird sie kurz angefordert wie im Dienst (Eingang mit Pull-up), der Pegel gelesen und sofort wieder freigegeben.
    So lässt sich die Richtung prüfen: offen 1, zu 0."""
    try:
        import gpiod
        from gpiod.line import Bias, Direction, Value
    except ImportError:
        line("·", "python3-libgpiod fehlt, Deckel nicht geprüft")
        return
    found = find_lid_line(gpiod)
    if found is None:
        line("·", f"Kein Deckel: GPIO-Leitung {LID_LINE} nicht gefunden")
        return
    path, offset, label = found
    where = f"Deckel an {LID_LINE} = {path} ({label}), Zeile {offset}"
    try:
        with gpiod.Chip(path) as chip:
            info = chip.get_line_info(offset)
            consumer = (info.consumer or "?") if info.used else None
    except OSError as err:
        line("✗", f"{where}: nicht lesbar ({err})")
        return
    if consumer == "zenos-argon":
        state = _lid_from_status(status_path)
        shown = f"{state} (Pegel {0 if state == 'zu' else 1})" if state else f"Wert nicht in {status_path}"
        line("✓", f"{where}, überwacht von zenos-argon: {shown}")
        return
    if consumer is not None:
        line("✗", f"{where}: belegt von «{consumer}» (Argons Software?), Zuklappen sperrt nicht")
        return
    settings = gpiod.LineSettings(direction=Direction.INPUT, bias=Bias.PULL_UP)
    try:
        with gpiod.request_lines(path, consumer="zenos-argon-pruefen", config={offset: settings}) as request:
            time.sleep(LID_DEBOUNCE)
            closed = request.get_value(offset) == Value.INACTIVE
    except OSError as err:
        line("✗", f"{where}: nicht lesbar ({err})")
        return
    line("✓", f"{where}: Pegel {0 if closed else 1} = {'zu' if closed else 'offen'} (kurz mit Pull-up gelesen, "
              "zenos-argon läuft nicht)")


def _check_config_line(options, line):
    config, errors, _notes, own = load_config(options["konfig"])
    if errors:
        line(False, f"{options['konfig']} ungültig, Standardkurve aktiv: {errors[0]}")
    else:
        line(True, f"{'Eigene Kurve' if own else 'Standardkurve'}: {config.describe()}")


def main(argv=None):
    try:
        options = parse_args(sys.argv[1:] if argv is None else argv)
    except UsageError as err:
        print(f"zenos-argon: {err}", file=sys.stderr)
        print("Aufruf: zenos-argon [--simulieren | --pruefen | --konfig-pruefen | --luefter-kernel] [Optionen] "
              "(--hilfe)", file=sys.stderr)
        return 2
    mode = options["mode"]
    if mode == "hilfe":
        print(__doc__.strip())
        return 0
    if mode == "konfig":
        return run_config_check(options)
    if mode == "pruefen":
        return run_check(options)
    log = Log()
    if mode == "luefter-kernel":
        return run_fan_reset(log)
    if mode == "simulation":
        return run_simulation(options, log)
    return run_service(options, log)


if __name__ == "__main__":
    sys.exit(main())
