# --- Log -------------------------------------------------------------------


class Log:
    """Meldungen auf stderr; unter systemd mit Priorität für das Journal."""

    def __init__(self, journal=None, stream=None):
        self.journal = ("JOURNAL_STREAM" in os.environ) if journal is None else journal
        self.stream = stream
        self._open = set()

    def _write(self, priority, text):
        prefix = f"<{priority}>" if self.journal else ""
        print(prefix + text, file=self.stream or sys.stderr, flush=True)

    def info(self, text):
        self._write(6, text)

    def warning(self, text):
        self._write(4, text)

    def error(self, text):
        self._write(3, text)

    def problem(self, key, text):
        """Warnung nur beim ersten Auftreten eines Problems (kein Log-Schwall bei Dauerfehlern)."""
        if key not in self._open:
            self._open.add(key)
            self.warning(text)

    def solved(self, key, text):
        if key in self._open:
            self._open.discard(key)
            self.info(text)


# --- Konfiguration ---------------------------------------------------------


class Config:
    def __init__(self, curve=DEFAULT_CURVE, hysteresis=DEFAULT_HYSTERESIS, delay=DEFAULT_DELAY):
        self.curve = tuple(sorted((float(t), int(s)) for t, s in curve))
        self.hysteresis = float(hysteresis)
        self.delay = float(delay)

    def describe(self):
        stufen = " · ".join(f"{_fmt(t)} °C → {s} %" for t, s in self.curve)
        return f"{stufen} · Hysterese {_fmt(self.hysteresis)} °C · absenken nach {_fmt(self.delay)} s"


def _fmt(value):
    text = f"{value:.1f}".rstrip("0").rstrip(".")
    return text.replace(".", ",")


def _is_number(value):
    return isinstance(value, (int, float)) and not isinstance(value, bool) and math.isfinite(value)


def validate_config(data):
    """Prüft eine geparste Konfiguration. Gibt (Config oder None, Fehler, Hinweise) zurück."""
    errors, notes = [], []
    if not isinstance(data, dict):
        return None, ["Die Konfiguration muss ein JSON-Objekt sein"], notes
    for key in data:
        if key not in CONFIG_KEYS:
            notes.append(f"Unbekannter Schlüssel «{key}» wird ignoriert")

    curve = DEFAULT_CURVE
    if "kurve" in data:
        raw = data["kurve"]
        if not isinstance(raw, list) or not 1 <= len(raw) <= 10:
            errors.append("«kurve» muss eine Liste mit 1 bis 10 Stufen sein")
        else:
            points = []
            for index, entry in enumerate(raw, 1):
                if not isinstance(entry, dict):
                    errors.append(f"Stufe {index}: erwartet {{\"temperatur\": …, \"luefter\": …}}")
                    continue
                for key in entry:
                    if key not in ("temperatur", "luefter"):
                        notes.append(f"Stufe {index}: unbekannter Schlüssel «{key}» wird ignoriert")
                temperature, speed = entry.get("temperatur"), entry.get("luefter")
                if not _is_number(temperature) or not 0 <= temperature <= 100:
                    errors.append(f"Stufe {index}: «temperatur» muss eine Zahl von 0 bis 100 (°C) sein")
                    continue
                if not _is_number(speed) or speed != int(speed) or not 0 <= speed <= 100:
                    errors.append(f"Stufe {index}: «luefter» muss eine ganze Zahl von 0 bis 100 (%) sein")
                    continue
                points.append((float(temperature), int(speed)))
            points.sort()
            for (t1, s1), (t2, s2) in zip(points, points[1:]):
                if t1 == t2:
                    errors.append(f"Die Temperatur {_fmt(t1)} °C steht zweimal in der Kurve")
                elif s2 < s1:
                    errors.append(f"Die Kurve fällt bei {_fmt(t2)} °C (von {s1} % auf {s2} %)")
            curve = tuple(points)

    hysteresis = data.get("hysterese", DEFAULT_HYSTERESIS)
    if not _is_number(hysteresis) or not 0 <= hysteresis <= 10:
        errors.append("«hysterese» muss eine Zahl von 0 bis 10 (°C) sein")
    delay = data.get("absenkenNachSekunden", DEFAULT_DELAY)
    if not _is_number(delay) or not 0 <= delay <= 600:
        errors.append("«absenkenNachSekunden» muss eine Zahl von 0 bis 600 sein")

    if errors:
        return None, errors, notes
    return Config(curve, hysteresis, delay), errors, notes


def load_config(path):
    """(Config, Fehler, Hinweise, eigen). Fehlt die Datei, gelten die Standardwerte ohne Meldung."""
    try:
        with open(path, encoding="utf-8") as handle:
            data = json.load(handle)
    except FileNotFoundError:
        return Config(), [], [], False
    except (OSError, ValueError) as err:
        return Config(), [f"{path} ist nicht lesbar: {err}"], [], True
    config, errors, notes = validate_config(data)
    return (config or Config()), errors, notes, True


# --- Kurve und Hysterese ---------------------------------------------------


def fan_speed(temperature, curve):
    """Lüfter in % für eine Temperatur: die höchste erreichte Stufe (wie get_fanspeed im Original)."""
    if temperature >= EMERGENCY_TEMPERATURE:
        return 100
    for threshold, speed in sorted(curve, reverse=True):
        if temperature >= threshold:
            if speed < 1:
                return 0
            return max(speed, MIN_SPEED)
    return 0


class FanController:
    """Entscheidet über den Lüfterwert: schneller sofort, langsamer mit Hysterese und Verzögerung."""

    def __init__(self, config):
        self.config = config
        self.speed = None
        self._lower_since = None

    def forget(self):
        """Nach einem Schreibfehler: Der nächste Takt setzt den Wert neu."""
        self.speed = None
        self._lower_since = None

    def update(self, temperature, now):
        """Neuer Lüfterwert oder None, wenn alles bleibt."""
        if temperature is None:
            return self._set(SAFE_SPEED)
        curve = self.config.curve
        higher = fan_speed(temperature, curve)
        if self.speed is None or higher > self.speed:
            return self._set(higher)
        # Wert, der auch bei um die Hysterese höherer Temperatur gälte: erst darunter wird abgesenkt
        lower = fan_speed(temperature + self.config.hysteresis, curve)
        if lower >= self.speed:
            self._lower_since = None
            return None
        if self._lower_since is None:
            self._lower_since = now
        if now - self._lower_since < self.config.delay:
            return None
        return self._set(lower)

    def _set(self, value):
        self._lower_since = None
        if value == self.speed:
            return None
        self.speed = value
        return value


# --- Power-Button ----------------------------------------------------------


def classify_pulse(width_ms):
    """«neustart», «ausschalten» oder None für eine Pulsbreite in ms."""
    if REBOOT_PULSE_MS[0] <= width_ms < REBOOT_PULSE_MS[1]:
        return "neustart"
    if POWEROFF_PULSE_MS[0] <= width_ms < POWEROFF_PULSE_MS[1]:
        return "ausschalten"
    return None


class PulseDetector:
    """Paart steigende und fallende Flanken zu Pulsbreiten (ms)."""

    def __init__(self):
        self._rising = None

    def edge(self, rising, timestamp_ns):
        if rising:
            self._rising = timestamp_ns
            return None
        if self._rising is None:
            return None
        width = (timestamp_ns - self._rising) / 1e6
        self._rising = None
        return width if width >= 0 else None


def find_button_line(gpiod, devices=None):
    """(Pfad, Offset, Label) der Zeile «GPIO4»; der RP1 des Pi 5 hat Vorrang. None, wenn es sie nicht gibt."""
    if devices is None:
        try:
            devices = sorted("/dev/" + name for name in os.listdir("/dev") if name.startswith("gpiochip"))
        except OSError:
            devices = []
    found = []
    for path in devices:
        try:
            if not gpiod.is_gpiochip_device(path):
                continue
            with gpiod.Chip(path) as chip:
                label = chip.get_info().label
                try:
                    offset = chip.line_offset_from_id(BUTTON_LINE)
                except (OSError, ValueError):
                    continue
        except OSError:
            continue
        found.append((label != BUTTON_CHIP_LABEL, path, offset, label))
    if not found:
        return None
    found.sort(key=lambda entry: (entry[0], len(entry[1]), entry[1]))
    return found[0][1:]


class ButtonWatcher(threading.Thread):
    """Wartet auf Flanken an GPIO4 und meldet Pulsbreiten an on_pulse."""

    def __init__(self, stop, on_pulse, log):
        super().__init__(name="power-button", daemon=True)
        self.stop = stop
        self.on_pulse = on_pulse
        self.log = log

    def run(self):
        try:
            self._run()
        except Exception as err:  # der Lüfter soll weiterlaufen, was auch immer hier schiefgeht
            self.log.error(f"Power-Button: unerwarteter Fehler ({err!r}), der Knopf bleibt ohne Funktion")

    def _run(self):
        try:
            import gpiod
            from gpiod.line import Direction, Edge
        except ImportError:
            self.log.warning("python3-libgpiod fehlt, der Power-Button bleibt ohne Funktion (install.sh ausführen)")
            return
        for attempt in range(3):
            if self.stop.is_set():
                return
            found = find_button_line(gpiod)
            if found is None:
                self.log.warning(f"GPIO-Zeile {BUTTON_LINE} nicht gefunden, der Power-Button bleibt ohne Funktion")
                return
            path, offset, label = found
            settings = gpiod.LineSettings(direction=Direction.INPUT, edge_detection=Edge.BOTH)
            try:
                with gpiod.request_lines(path, consumer="zenos-argon", config={offset: settings}) as request:
                    self.log.info(f"Power-Button an {BUTTON_LINE} ({path}, {label}, Zeile {offset})")
                    self._watch(request, gpiod.EdgeEvent.Type.RISING_EDGE)
                return
            except OSError as err:
                if err.errno == errno.EBUSY:
                    self.log.warning(f"{BUTTON_LINE} ist schon belegt (läuft das Argon-Originalskript argononed?), "
                                     "der Power-Button bleibt ohne Funktion")
                    return
                self.log.warning(f"Power-Button: {err} (Versuch {attempt + 1} von 3)")
                self.stop.wait(10)
        self.log.warning("Power-Button aufgegeben, der Lüfter läuft weiter")

    def _watch(self, request, rising_type):
        detector = PulseDetector()
        while not self.stop.is_set():
            if not request.wait_edge_events(1.0):
                continue
            for event in request.read_edge_events():
                width = detector.edge(event.event_type == rising_type, event.timestamp_ns)
                if width is not None:
                    self.on_pulse(width)


# --- Hardware --------------------------------------------------------------


class ArgonFan:
    """Lüfter der Argon-Platine über I2C (Protokoll wie argonregister.py)."""

    def __init__(self, bus, sleep=time.sleep):
        self.bus = bus
        self.sleep = sleep
        self.register = False

    def present(self):
        """Antwortet etwas an 0x1a? Erst lesen, dann (wie i2cdetect) ein Quick-Write ohne Daten."""
        try:
            self.bus.read_byte(ARGON_ADDRESS)
            return True
        except OSError:
            pass
        try:
            self.bus.write_quick(ARGON_ADDRESS)
            return True
        except OSError:
            return False

    def detect_register(self):
        """Wie argonregister_checksupport: Register 0x80 lesen, verändern, zurücklesen, wiederherstellen."""
        try:
            old = self.bus.read_byte_data(ARGON_ADDRESS, REG_DUTY_CYCLE)
            probe = old + 1
            if probe >= 100:
                probe = 98
            self._write_register(probe)
            back = self.bus.read_byte_data(ARGON_ADDRESS, REG_DUTY_CYCLE)
            self.register = back != old
            if self.register:
                self._write_register(min(old, 100))
        except OSError:
            self.register = False
        return self.register

    def _write_register(self, value):
        self.bus.write_byte_data(ARGON_ADDRESS, REG_DUTY_CYCLE, value)
        self.sleep(WRITE_PAUSE)

    def set_speed(self, value):
        value = max(0, min(100, int(value)))
        if self.register:
            self._write_register(value)
        else:
            self.bus.write_byte(ARGON_ADDRESS, value)
            self.sleep(WRITE_PAUSE)


class SimulatedFan:
    """Für --simulieren: schreibt nur ins Log."""

    register = False

    def __init__(self, log):
        self.log = log

    def set_speed(self, value):
        self.log.info(f"Simulation: Lüfter {int(value)} %")


def apply_speed(fan, value, previous):
    """Setzt den Lüfter; aus dem Stillstand (oder unbekannt) mit Anlaufhilfe wie im Original."""
    if 0 < value < KICK_SPEED and not previous:
        fan.set_speed(KICK_SPEED)
    fan.set_speed(value)


def test_root():
    """Ordner aus ZENOS_ARGON_TESTWURZEL (nur für Tests) oder ""."""
    return os.environ.get(TEST_ROOT_VARIABLE, "").rstrip("/")


def system_path(path):
    """Fester Pfad, in Tests unter ZENOS_ARGON_TESTWURZEL."""
    return test_root() + path


def read_model():
    for path in MODEL_PATHS:
        try:
            with open(system_path(path), "rb") as handle:
                return handle.read().replace(b"\0", b"").decode("utf-8", "replace").strip()
        except OSError:
            continue
    return ""


def is_pi5(model):
    return model.startswith(PI5_MODEL)


def is_cm5(model):
    return model.startswith(CM5_MODEL)


def read_temperature(path=None):
    """°C aus der Thermal-Zone (Milligrad) oder None."""
    path = path or system_path(THERMAL_PATH)
    try:
        with open(path, encoding="ascii") as handle:
            value = int(handle.read().strip()) / 1000
    except (OSError, ValueError):
        return None
    return value if -40 < value < 150 else None


def read_temperature_file(path):
    """Für --simulieren: °C oder Milligrad (Werte ab 1000) aus einer Datei, sonst None."""
    try:
        with open(path, encoding="utf-8") as handle:
            value = float(handle.read().strip().replace(",", "."))
    except (OSError, ValueError):
        return None
    if value >= 1000:
        value /= 1000
    return value if math.isfinite(value) and -40 < value < 150 else None


def uptime_seconds():
    try:
        with open("/proc/uptime", encoding="ascii") as handle:
            return float(handle.read().split()[0])
    except (OSError, ValueError, IndexError):
        return 0.0


def system_stopping(runner=subprocess.run):
    """Fährt das System gerade herunter (Neustart oder Ausschalten)?"""
    try:
        result = runner(["systemctl", "is-system-running"], stdin=subprocess.DEVNULL,
                        capture_output=True, text=True, timeout=3, check=False)
    except (OSError, subprocess.SubprocessError):
        return False
    return result.stdout.strip() == "stopping"


# --- Status für die Leiste -------------------------------------------------


def round_temperature(value):
    return None if value is None else round(float(value), 1)


def argon_v3_report(temperature, speed):
    """Inhalt der Statusdatei beim Argon ONE V3: Lüfter in %, kein Akku."""
    return {
        "geraet": "argon-one-v3",
        "akku": {"vorhanden": False},
        "luefter": {"vorhanden": True, "prozent": None if speed is None else int(speed)},
        "temperatur": {"cpu": round_temperature(temperature)},
    }


class StatusFile:
    """/run/zenos/geraet.json: Version 1, atomar (tmp + rename), 0644."""

    def __init__(self, path, log):
        self.path = path
        self.log = log

    def write(self, report, now=None):
        now = now or datetime.datetime.now().astimezone()
        data = {"version": STATUS_VERSION, "zeit": now.isoformat(timespec="seconds")}
        data.update(report)
        directory = os.path.dirname(self.path) or "."
        temp = None
        try:
            os.makedirs(directory, mode=0o755, exist_ok=True)
            handle, temp = tempfile.mkstemp(prefix=".geraet-", suffix=".tmp", dir=directory)
            with os.fdopen(handle, "w", encoding="utf-8") as out:
                out.write(json.dumps(data, ensure_ascii=False) + "\n")
            os.chmod(temp, 0o644)
            os.replace(temp, self.path)
            temp = None
        except OSError as err:
            self.log.problem("status", f"{self.path} lässt sich nicht schreiben: {err}")
            return False
        finally:
            if temp is not None:
                try:
                    os.unlink(temp)
                except OSError:
                    pass
        self.log.solved("status", f"{self.path} wird wieder geschrieben")
        return True

    def remove(self):
        try:
            os.unlink(self.path)
        except OSError:
            pass


# --- Dienst ----------------------------------------------------------------


class Daemon:
    def __init__(self, fan, log, status, config_path, temperature_source, simulate=False,
                 clock=time.monotonic, runner=subprocess.run, stopping=None):
        self.fan = fan
        self.log = log
        self.status = status
        self.config_path = config_path
        self.temperature_source = temperature_source
        self.simulate = simulate
        self.clock = clock
        self.runner = runner
        self.stopping = stopping or (lambda: system_stopping(runner))
        self.stop = threading.Event()
        self.applied = None
        self._config_stamp = None
        self._action_started = False
        self._action_lock = threading.Lock()
        self.controller = FanController(self._load_config(initial=True))

    # Konfiguration beim Start und bei jeder Änderung der Datei
    def _stamp(self):
        try:
            info = os.stat(self.config_path)
        except OSError:
            return None
        return (info.st_ino, info.st_size, info.st_mtime_ns)

    def _load_config(self, initial=False):
        self._config_stamp = self._stamp()
        config, errors, notes, own = load_config(self.config_path)
        for note in notes:
            self.log.warning(f"{self.config_path}: {note}")
        if errors:
            for error in errors:
                self.log.warning(f"{self.config_path}: {error}")
            self.log.warning(f"Konfiguration ungültig, es gilt die Standardkurve: {config.describe()}")
        elif own:
            self.log.info(f"Lüfterkurve aus {self.config_path}: {config.describe()}")
        elif initial:
            self.log.info(f"Standardkurve: {config.describe()}")
        else:
            self.log.info(f"{self.config_path} entfernt, es gilt die Standardkurve")
        return config

    def _check_config(self):
        if self._stamp() != self._config_stamp:
            self.controller.config = self._load_config()

    def tick(self):
        self._check_config()
        temperature = self.temperature_source()
        if temperature is None:
            self.log.problem("temperatur", "Temperatur nicht lesbar, der Lüfter läuft sicherheitshalber mit 100 %")
        else:
            self.log.solved("temperatur", "Temperatur wieder lesbar")
        value = self.controller.update(temperature, self.clock())
        if value is not None:
            previous = self.applied
            try:
                apply_speed(self.fan, value, previous)
            except OSError as err:
                self.applied = None
                self.controller.forget()
                self.log.problem("i2c", f"Lüfter lässt sich nicht setzen ({err}), neuer Versuch im nächsten Takt")
            else:
                self.applied = value
                self.log.solved("i2c", "I2C antwortet wieder")
                shown = "?" if temperature is None else _fmt(round(temperature, 1))
                self.log.info(f"Lüfter {value} % bei {shown} °C")
        self.status.write(argon_v3_report(temperature, self.applied))

    def on_pulse(self, width_ms):
        action = classify_pulse(width_ms)
        if action is None:
            self.log.info(f"Power-Button: Puls {width_ms:.0f} ms ohne Bedeutung, ignoriert")
            return
        verb, name = ACTIONS[action]
        if self.simulate:
            self.log.info(f"Simulation: Power-Button {width_ms:.0f} ms → {name} (systemctl {verb}, nicht ausgeführt)")
            return
        with self._action_lock:
            if self._action_started:
                return
            self._action_started = True
        self.log.info(f"Power-Button {width_ms:.0f} ms → {name} (systemctl {verb})")
        try:
            result = self.runner(["systemctl", verb], stdin=subprocess.DEVNULL, timeout=60, check=False)
            ok = result.returncode == 0
        except (OSError, subprocess.SubprocessError) as err:
            ok = False
            if not self.stop.is_set():
                self.log.error(f"systemctl {verb} ist fehlgeschlagen: {err}")
        # Beim Herunterfahren beendet systemd auch den wartenden systemctl-Aufruf: kein Fehler
        if not ok and not self.stop.is_set():
            self.log.error(f"{name} hat nicht geklappt (systemctl {verb})")
            with self._action_lock:
                self._action_started = False

    def finish(self):
        """Lüfter auf einen sicheren Wert: beim Herunterfahren aus (wie das Original), sonst 100 %."""
        if self.stopping():
            value, why = 0, "aus, das System fährt herunter"
        else:
            value, why = SAFE_SPEED, f"{SAFE_SPEED} %, der Dienst endet und niemand regelt mehr"
        try:
            self.fan.set_speed(value)
            self.log.info(f"Lüfter {why}")
        except OSError as err:
            self.log.warning(f"Lüfter liess sich beim Beenden nicht setzen: {err}")
        self.status.remove()

    def run(self, interval, rounds=None):
        count = 0
        try:
            while not self.stop.is_set():
                self.tick()
                count += 1
                if rounds is not None and count >= rounds:
                    break
                self.stop.wait(interval)
        finally:
            self.stop.set()
            self.finish()
        return 0


# --- I2C-Bus ---------------------------------------------------------------


class FileBus:
    """Nur für Tests (ZENOS_ARGON_TESTWURZEL): jedes I2C-Gerät ist eine JSON-Datei <ordner>/0x<adresse>.json mit
    Registerwerten ({"0x04": 87}, fehlende Register lesen 0). Fehlt die Datei oder steht darin "fehler": true,
    antwortet das Gerät nicht. Schreiben ändert die Datei und steht in <ordner>/protokoll («0x64 0x08 0x30»)."""

    def __init__(self, folder):
        self.folder = folder

    def _path(self, address):
        return os.path.join(self.folder, f"0x{address:02x}.json")

    def _load(self, address):
        try:
            with open(self._path(address), encoding="utf-8") as handle:
                registers = json.load(handle)
        except (OSError, ValueError):
            registers = None
        if not isinstance(registers, dict) or registers.get("fehler"):
            raise OSError(getattr(errno, "EREMOTEIO", 121), "Remote I/O error")
        return registers

    def _log(self, *values):
        with open(os.path.join(self.folder, "protokoll"), "a", encoding="utf-8") as handle:
            handle.write(" ".join(f"0x{v:02x}" for v in values) + "\n")

    def read_byte_data(self, address, register):
        return int(self._load(address).get(f"0x{register:02x}", 0)) & 0xFF

    def write_byte_data(self, address, register, value):
        registers = self._load(address)
        registers[f"0x{register:02x}"] = value & 0xFF
        self._log(address, register, value)
        temp = self._path(address) + ".tmp"
        with open(temp, "w", encoding="utf-8") as handle:
            json.dump(registers, handle, sort_keys=True)
        os.replace(temp, self._path(address))

    def read_byte(self, address):
        self._load(address)
        return 0

    def write_byte(self, address, value):
        self._load(address)
        self._log(address, value)

    def write_quick(self, address):
        self._load(address)

    def close(self):
        pass


def open_bus(log):
    """I2C-Bus 1 (in Tests FileBus) oder None mit Meldung."""
    root = test_root()
    if root:
        return FileBus(os.path.join(root, "i2c-1"))
    try:
        import smbus
    except ImportError:
        log.error("python3-smbus fehlt (install.sh ausführen)")
        return None
    try:
        return smbus.SMBus(I2C_BUS)
    except OSError as err:
        log.error(f"{I2C_DEVICE} lässt sich nicht öffnen: {err}")
        return None


# --- Argon ONE UP: Akku-Messchip CW2217 ------------------------------------


class BatteryGauge:
    """Akku-Messchip CW2217 an 0x64 (Protokoll wie argononeupd.py). Schreibt nur in load_profile und restart."""

    def __init__(self, bus, sleep=time.sleep, stop=None):
        self.bus = bus
        self.sleep = sleep
        self.stop = stop or threading.Event()

    def _read(self, register):
        return self.bus.read_byte_data(GAUGE_ADDRESS, register)

    def _write(self, register, value):
        self.bus.write_byte_data(GAUGE_ADDRESS, register, value)

    def chip_id(self):
        return self._read(REG_VERSION)

    def read_profile(self):
        return bytes(self._read(REG_PROFILE + offset) for offset in range(len(ARGON_UP_PROFILE)))

    def status(self):
        """Nur lesend, ohne Profilvergleich: «ok», «schlaeft» oder «ohne-profil»."""
        if self._read(REG_CONTROL) != CONTROL_ACTIVE:
            return "schlaeft"
        if not self._read(REG_SOCALERT) & PROFILE_LOADED:
            return "ohne-profil"
        return "ok"

    def check(self):
        """Nur lesend: wie status, dazu «anderes-profil», wenn die Register 0x10–0x5F nicht Argons Profil sind."""
        state = self.status()
        if state == "ok" and self.read_profile() != ARGON_UP_PROFILE:
            return "anderes-profil"
        return state

    def load_profile(self):
        """Argons Profil schreiben und den Chip aktivieren, genau wie battery_checkupdateprofile in argononeupd.py.
        Gibt (bereit, Zustand) zurück: bereit = Register 0xA7 meldete «bereit», Zustand = check() danach."""
        self._write(REG_CONTROL, CONTROL_RESTART)
        self.sleep(GAUGE_PAUSE)
        self._write(REG_CONTROL, CONTROL_SLEEP)
        self.sleep(GAUGE_PAUSE)
        for offset, value in enumerate(ARGON_UP_PROFILE):
            self._write(REG_PROFILE + offset, value)
        self._write(REG_SOCALERT, PROFILE_LOADED)
        self.sleep(GAUGE_PAUSE)
        self._write(REG_GPIOCONFIG, 0x00)
        self.sleep(GAUGE_PAUSE)
        ready = self.restart()
        return ready, self.check()

    def restart(self, attempts=3, wait_seconds=5):
        """Aktivieren wie battery_restart: 0x08 ← 0x30, 0x08 ← 0x00, dann bis zu 5 s auf Register 0xA7 warten;
        höchstens dreimal. Beim Beenden des Dienstes wird nicht weiter gewartet."""
        for _ in range(attempts):
            self._write(REG_CONTROL, CONTROL_RESTART)
            self.sleep(GAUGE_PAUSE)
            self._write(REG_CONTROL, CONTROL_ACTIVE)
            self.sleep(GAUGE_PAUSE)
            for _ in range(wait_seconds):
                if self._read(REG_ICSTATE) & ICSTATE_READY:
                    return True
                if self.stop.is_set():
                    return False
                self.sleep(1)
        return False

    def read_soc(self):
        """Ladestand in ganzen % (Register 0x04, ohne Bruchteil aus 0x05)."""
        return self._read(REG_SOC)

    def read_discharging(self):
        """Stromrichtung: Bit 7 von 0x0E (Vorzeichen des Stroms) gesetzt = Entladen (battery_isplugged)."""
        return bool(self._read(REG_CURRENT_HIGH) & CURRENT_NEGATIVE)


class Debounce:
    """Ein neuer Wert gilt erst, wenn er so oft hintereinander gemessen wurde. Der erste gilt sofort."""

    def __init__(self, needed):
        self.needed = needed
        self.value = None
        self._candidate = None
        self._count = 0

    @property
    def pending(self):
        return self._candidate is not None

    def update(self, sample):
        """True, wenn der Wert gewechselt hat (nicht beim ersten Wert)."""
        if self.value is None:
            self.value = sample
            return False
        if sample == self.value:
            self._candidate, self._count = None, 0
            return False
        if sample == self._candidate:
            self._count += 1
        else:
            self._candidate, self._count = sample, 1
        if self._count < self.needed:
            return False
        self.value = sample
        self._candidate, self._count = None, 0
        return True

    def reset(self):
        self.value = None
        self._candidate, self._count = None, 0


def profile_backoff(failures):
    """Pause vor dem nächsten Versuch nach N gescheiterten: 30 s, 60 s, 120 s … höchstens 1 h."""
    return min(PROFILE_RETRY_FIRST * 2 ** max(0, failures - 1), PROFILE_RETRY_MAX)


class BatteryMonitor:
    """Ladestand und Laderichtung: Profil prüfen und nur bei Bedarf laden (mit Grenze und Pausen), Werte auf
    Plausibilität prüfen, Laden/Entladen entprellen. Schreibt nichts ins Journal, was sich nur wiederholt."""

    def __init__(self, gauge, log, clock=time.monotonic, read_only=False, released=None):
        self.gauge = gauge
        self.log = log
        self.clock = clock
        self.read_only = read_only
        # Freigabe für das Schreiben (im Dienst: profile_released); ohne Angabe frei (Einheitentests)
        self.released = released or (lambda: True)
        self._blocked = False
        self.ready = False
        self.percent = None
        self.charging = Debounce(CHARGE_CONFIRMATIONS)
        self._soc_candidate = None
        self._read_failures = 0
        self._profile_failures = 0
        self._next_profile = 0.0
        self._profile_writes = []
        self._failed = False
        self._zero_since = None
        self._announced = False

    @property
    def pending(self):
        """Wartet eine Änderung auf Bestätigung? Dann misst der Dienst öfter."""
        return self.charging.pending or self._soc_candidate is not None

    def snapshot(self):
        if self.percent is not None:
            state = "ok"
        elif self._blocked:
            state = "freigabe"
        elif self._failed or self._read_failures > READ_TOLERANCE:
            state = "fehler"
        else:
            state = "unbekannt"
        return {"vorhanden": True, "prozent": self.percent, "laedt": self.charging.value, "zustand": state}

    def tick(self):
        now = self.clock()
        try:
            if not self.ready and not self._prepare(now):
                return self.snapshot()
            state = self.gauge.status()
            if state != "ok":
                # Nach einem Zurücksetzen (z. B. Akku ganz leer) schläft der Chip wieder oder Bit 7 von 0x0B fehlt
                self.log.warning(f"Akku-Messchip {GAUGE_STATES[state]} (zurückgesetzt?)")
                self._forget()
                if not self._prepare(now):
                    return self.snapshot()
            soc = self.gauge.read_soc()
            discharging = self.gauge.read_discharging()
        except OSError as err:
            self._read_failures += 1
            self.log.problem("akku-i2c", f"Akku-Messchip an 0x{GAUGE_ADDRESS:02x} antwortet nicht ({err}), neuer "
                             "Versuch im nächsten Takt")
            if self._read_failures > READ_TOLERANCE:
                self._forget(keep_ready=True)
            return self.snapshot()
        self._read_failures = 0
        self.log.solved("akku-i2c", "Akku-Messchip antwortet wieder")
        self._take(soc, discharging, now)
        return self.snapshot()

    def _forget(self, keep_ready=False):
        self.ready = self.ready and keep_ready
        self.percent = None
        self.charging.reset()
        self._soc_candidate = None

    def _prepare(self, now):
        """Profil prüfen und nur bei Bedarf laden. True, wenn der Chip danach misst."""
        if now < self._next_profile:
            return False
        state = self.gauge.check()
        if state == "ok":
            if not self._announced:
                self.log.info("Akku-Messchip misst, Argons Akkuprofil ist geladen (nichts geschrieben)")
            self._set_ready()
            return True
        if self.read_only:
            self._failed = True
            self.log.problem("akku-profil", f"Akku-Messchip {GAUGE_STATES[state]}; Argons eigene Software ist "
                             "aktiviert, zenos-argon schreibt nichts in den Chip")
            return False
        if not self.released():
            # Ohne Zenos Freigabe nur lesen; geprüft wird bei jedem Takt (zwei Register), geschrieben nichts
            self._blocked = True
            self.log.problem("akku-freigabe", f"Akku-Messchip {GAUGE_STATES[state]}; zenos-argon lädt Argons "
                             "Akkuprofil erst nach der Freigabe (zen akku freigeben) und schreibt bis dahin nichts")
            return False
        self._blocked = False
        self.log.solved("akku-freigabe", "Freigabe für das Akkuprofil ist da")
        self._profile_writes = [t for t in self._profile_writes if now - t < 3600]
        if len(self._profile_writes) >= PROFILE_WRITES_PER_HOUR:
            self._failed = True
            self._next_profile = self._profile_writes[0] + 3600
            minutes = max(1, math.ceil((self._next_profile - now) / 60))
            self.log.problem("akku-profil", f"Akku-Messchip {GAUGE_STATES[state]}; das Profil wurde in der letzten "
                             f"Stunde schon {len(self._profile_writes)}-mal geschrieben, nächster Versuch in "
                             f"{minutes} min")
            return False
        self._profile_writes.append(now)
        self._profile_failures += 1
        # gilt auch, wenn das Schreiben mit einem I2C-Fehler abbricht
        self._next_profile = now + profile_backoff(self._profile_failures)
        self._failed = True
        self.log.info(f"Akku-Messchip {GAUGE_STATES[state]}: lade Argons Akkuprofil (80 Byte) und aktiviere ihn")
        ready, after = self.gauge.load_profile()
        if after != "ok":
            self.log.warning(f"Akkuprofil laden hat nicht geklappt: Der Chip {GAUGE_STATES[after]}. Neuer Versuch in "
                             f"{_fmt(profile_backoff(self._profile_failures))} s")
            return False
        if not ready:
            self.log.info("Register 0xA7 meldete nicht «bereit», Steuerregister und Profil stimmen aber")
        self.log.info("Akkuprofil geladen, der Messchip misst")
        self._profile_failures = 0
        self._next_profile = 0.0
        self._set_ready()
        return True

    def _set_ready(self):
        self.ready = True
        self._failed = False
        self._blocked = False
        self._announced = True
        self.log.solved("akku-profil", "Akku-Messchip misst wieder")

    def _take(self, soc, discharging, now):
        if 100 < soc <= 105:
            soc = 100
        if soc == 0:
            # Kurz nach dem Aktivieren meldet der Chip 0 %, bis er den ersten Wert hat (Argon wertet 0 ebenso
            # als ungültig). Bleibt es dabei, einmal ins Journal.
            self._zero_since = self._zero_since if self._zero_since is not None else now
            if now - self._zero_since >= SOC_ZERO_NOTICE:
                self.log.problem("akku-null", "Der Akku-Messchip meldet seit 2 Minuten 0 % (noch kein Messwert?)")
            return
        self._zero_since = None
        self.log.solved("akku-null", "Der Akku-Messchip meldet wieder einen Ladestand")
        if soc > 100:
            self.log.problem("akku-wert", f"Unplausibler Ladestand {soc} % ignoriert")
            return
        self.log.solved("akku-wert", "Ladestand wieder plausibel")
        if self.percent is not None and abs(soc - self.percent) > SOC_JUMP:
            if self._soc_candidate is None or abs(soc - self._soc_candidate) > 2:
                self._soc_candidate = soc
                return
        self._soc_candidate = None
        first = self.percent is None
        self.percent = soc
        changed = self.charging.update(not discharging)
        if first:
            self.log.info(f"Akku {soc} %, {'lädt' if self.charging.value else 'entlädt'}")
        elif changed:
            self.log.info(f"Netzteil angeschlossen, Akku {soc} %" if self.charging.value else
                          f"Akkubetrieb, Akku {soc} %")


# --- Lüfter am Compute Module 5 (Kernel) -----------------------------------


def _read_int(path):
    try:
        with open(path, encoding="ascii") as handle:
            return int(handle.read().strip())
    except (OSError, ValueError):
        return None


def _natural(name):
    digits = "".join(c for c in name if c.isdigit())
    return (int(digits) if digits else -1, name)


def find_sysfs_device(directory, prefix, attribute, value):
    """Erster Eintrag <directory>/<prefix>N, dessen Datei <attribute> genau <value> enthält, oder None.
    Die Nummern N wechseln zwischen zwei Starts, deshalb immer nach Namen suchen."""
    try:
        names = sorted((n for n in os.listdir(directory) if n.startswith(prefix)), key=_natural)
    except OSError:
        return None
    for name in names:
        try:
            with open(os.path.join(directory, name, attribute), encoding="utf-8") as handle:
                if handle.read().strip() == value:
                    return os.path.join(directory, name)
        except OSError:
            continue
    return None


class KernelFan:
    """Lüfter am Lüfteranschluss (Kernel-Treiber pwm-fan, Regler step_wise). Nur lesen: Stufe aus der
    cooling_device «pwm-fan» (cur_state/max_state), Drehzahl aus hwmon «pwmfan» (fan1_input)."""

    def __init__(self, sysfs, log, clock=time.monotonic):
        self.sysfs = sysfs
        self.log = log
        self.clock = clock
        self.hwmon = None
        self.cooling = None
        self._next_scan = 0.0
        self._announced = None

    def _scan(self, now):
        self._next_scan = now + FAN_RESCAN_SECONDS
        self.hwmon = find_sysfs_device(os.path.join(self.sysfs, "class", "hwmon"), "hwmon", "name", "pwmfan")
        self.cooling = find_sysfs_device(os.path.join(self.sysfs, "class", "thermal"), "cooling_device", "type",
                                         "pwm-fan")
        found = (self.hwmon, self.cooling)
        if found == self._announced:
            return
        self._announced = found
        names = [os.path.basename(p) for p in found if p]
        if names:
            self.log.info(f"Lüfter: Kernel-Treiber pwm-fan ({', '.join(names)}), der Kernel regelt ihn")
        else:
            self.log.info("Kein Kernel-Lüfter (pwm-fan) gefunden")

    def read(self):
        now = self.clock()
        if self.hwmon is None and self.cooling is None and now >= self._next_scan:
            self._scan(now)
        stage = stages = rpm = None
        broken = False
        if self.cooling:
            stage = _read_int(os.path.join(self.cooling, "cur_state"))
            stages = _read_int(os.path.join(self.cooling, "max_state"))
            if stage is None or stages is None or not 0 <= stage <= stages <= 20:
                stage = stages = None
                broken = True
        if self.hwmon:
            # fan1_input fehlt, wenn der Lüfter keinen Drehzahlgeber hat
            rpm = _read_int(os.path.join(self.hwmon, "fan1_input"))
            if rpm is not None and not 0 <= rpm <= 30000:
                rpm = None
            if not os.path.isdir(self.hwmon):
                broken = True
        if broken and now >= self._next_scan:
            self._scan(now)
        return {"vorhanden": bool(self.hwmon or self.cooling), "stufe": stage, "stufen": stages, "upm": rpm}


class UpDaemon:
    """Takt beim Argon ONE UP: Akku, Lüfter und Temperatur lesen, Statusdatei schreiben. Schreibt nur beim Laden
    des Akkuprofils etwas an die Hardware."""

    def __init__(self, monitor, fan, log, status, temperature_source):
        self.monitor = monitor
        self.fan = fan
        self.log = log
        self.status = status
        self.temperature_source = temperature_source
        self.stop = threading.Event()

    def tick(self):
        temperature = self.temperature_source()
        self.status.write({
            "geraet": "argon-one-up",
            "akku": self.monitor.tick(),
            "luefter": self.fan.read(),
            "temperatur": {"cpu": round_temperature(temperature)},
        })

    def run(self, interval, rounds=None):
        count = 0
        try:
            while not self.stop.is_set():
                self.tick()
                count += 1
                if rounds is not None and count >= rounds:
                    break
                self.stop.wait(min(interval, UP_PENDING_INTERVAL) if self.monitor.pending else interval)
        finally:
            self.stop.set()
            self.status.remove()
        return 0


def argon_up_original_active():
    """Ist Argons eigener Dienst für den ONE UP (argononeupd.service) aktiviert?"""
    return os.path.lexists(system_path(ARGON_UP_DAEMON_WANTS))


def profile_released():
    """Hat Zeno das Schreiben des Akkuprofils freigegeben (zen akku freigeben)?"""
    return os.path.isfile(system_path(PROFILE_RELEASE_PATH))


# --- Aufruf ----------------------------------------------------------------


class UsageError(Exception):
    pass


def _option_value(items, arg):
    if not items:
        raise UsageError(f"{arg} braucht einen Wert")
    return items.pop(0)


def _option_number(items, arg, low, high):
    text = _option_value(items, arg)
    try:
        result = float(text.replace(",", "."))
    except ValueError:
        raise UsageError(f"{arg}: «{text}» ist keine Zahl") from None
    if not math.isfinite(result) or not low <= result <= high:
        raise UsageError(f"{arg}: erlaubt sind {_fmt(low)} bis {_fmt(high)}")
    return result


def parse_args(argv):
    options = {
        "mode": "dienst",
        "konfig": CONFIG_PATH,
        "status": STATUS_PATH,
        "intervall": None,
        "durchlaeufe": None,
        "temperatur": None,
        "temperatur_datei": None,
        "pulse": [],
    }
    modes = {"--simulieren": "simulation", "--pruefen": "pruefen", "--konfig-pruefen": "konfig"}
    items = list(argv)
    while items:
        arg = items.pop(0)
        if arg in ("-h", "--hilfe", "--help"):
            options["mode"] = "hilfe"
        elif arg in modes:
            if options["mode"] not in ("dienst", modes[arg]):
                raise UsageError("--simulieren, --pruefen und --konfig-pruefen schliessen sich aus")
            options["mode"] = modes[arg]
        elif arg == "--konfig":
            options["konfig"] = _option_value(items, arg)
        elif arg == "--status-datei":
            options["status"] = _option_value(items, arg)
        elif arg == "--intervall":
            options["intervall"] = _option_number(items, arg, 0.05, 60)
        elif arg == "--durchlaeufe":
            options["durchlaeufe"] = int(_option_number(items, arg, 1, 1_000_000))
        elif arg == "--temperatur":
            options["temperatur"] = _option_number(items, arg, -40, 150)
        elif arg == "--temperatur-datei":
            options["temperatur_datei"] = _option_value(items, arg)
        elif arg == "--puls":
            options["pulse"].append(_option_number(items, arg, 0, 10_000))
        else:
            raise UsageError(f"unbekannte Option «{arg}»")
    simulation_only = options["temperatur"] is not None or options["temperatur_datei"] or options["pulse"]
    if simulation_only and options["mode"] != "simulation":
        raise UsageError("--temperatur, --temperatur-datei und --puls gibt es nur mit --simulieren")
    if options["temperatur"] is not None and options["temperatur_datei"]:
        raise UsageError("entweder --temperatur oder --temperatur-datei")
    return options


def install_signals(stop, handler_log):
    def handle(signum, _frame):
        handler_log.info(f"Signal {signal.Signals(signum).name}, beende")
        stop.set()

    signal.signal(signal.SIGTERM, handle)
    signal.signal(signal.SIGINT, handle)


def wait_for_device(path, stop, seconds):
    deadline = time.monotonic() + seconds
    while not os.path.exists(path):
        if time.monotonic() >= deadline or stop.is_set():
            return False
        stop.wait(1)
    return True


def run_service(options, log):
    stop = threading.Event()
    install_signals(stop, log)

    model = read_model()
    if not is_pi5(model) and not is_cm5(model):
        log.info(f"Weder Raspberry Pi 5 noch Compute Module 5 ({model or 'kein Gerätebaum'}), zenos-argon hat "
                 "nichts zu tun")
        return 0

    wait = I2C_WAIT_SECONDS if uptime_seconds() < I2C_WAIT_UPTIME else 0
    if not wait_for_device(system_path(I2C_DEVICE), stop, wait):
        if stop.is_set():
            return 0
        log.info(f"I2C-Bus 1 fehlt ({I2C_DEVICE}), zenos-argon hat nichts zu tun. Für den Argon ONE braucht es "
                 "dtparam=i2c_arm=on in /boot/firmware/config.txt; zenOS ändert die Firmware-Einstellungen "
                 "nicht selbst (zen doctor)")
        return 0

    bus = open_bus(log)
    if bus is None:
        return 1
    if is_cm5(model):
        try:
            return run_up_service(options, log, model, bus, stop)
        finally:
            bus.close()

    fan = ArgonFan(bus)
    present = False
    for attempt in range(3):
        present = fan.present()
        if present or stop.is_set():
            break
        stop.wait(2)
    if not present:
        log.info(f"Kein Argon ONE an I2C-Adresse 0x{ARGON_ADDRESS:02x}, zenos-argon hat nichts zu tun")
        bus.close()
        return 0
    if stop.is_set():
        bus.close()
        return 0

    register = fan.detect_register()
    how = f"Register 0x{REG_DUTY_CYCLE:02x}" if register else "einzelnes Byte (Firmware ohne Register)"
    log.info(f"Argon ONE an 0x{ARGON_ADDRESS:02x} gefunden ({model}), Lüfter über {how}")

    daemon = Daemon(fan, log, StatusFile(options["status"], log), options["konfig"], read_temperature)
    daemon.stop = stop
    ButtonWatcher(stop, daemon.on_pulse, log).start()
    try:
        return daemon.run(options["intervall"] or V3_INTERVAL, options["durchlaeufe"])
    finally:
        bus.close()


def find_gauge(gauge, stop):
    """Chip-ID an 0x64 lesen (nur lesend, bis zu dreimal). Gibt die gelesene ID oder None zurück."""
    chip = None
    for _ in range(3):
        try:
            chip = gauge.chip_id()
        except OSError:
            chip = None
        if chip == GAUGE_CHIP_ID or stop.is_set():
            break
        stop.wait(2)
    return chip


def run_up_service(options, log, model, bus, stop):
    """Argon ONE UP am Compute Module 5: Akku-Messchip CW2217 an 0x64, Lüfter und Temperatur vom Kernel."""
    gauge = BatteryGauge(bus, stop=stop)
    chip = find_gauge(gauge, stop)
    if stop.is_set():
        return 0
    if chip != GAUGE_CHIP_ID:
        seen = "keine Antwort" if chip is None else f"Chip-ID 0x{chip:02x}"
        log.info(f"Kein Argon ONE UP: kein Akku-Messchip CW2217 an I2C-Adresse 0x{GAUGE_ADDRESS:02x} ({seen}), "
                 "zenos-argon hat nichts zu tun")
        return 0
    log.info(f"Argon ONE UP erkannt ({model}): Akku-Messchip CW2217 an 0x{GAUGE_ADDRESS:02x}")
    read_only = argon_up_original_active()
    if read_only:
        log.warning("Argons eigene Software (argononeupd.service) ist aktiviert: zenos-argon liest den Akku nur "
                    "und schreibt nichts in den Messchip (entfernen: argon-uninstall)")
    monitor = BatteryMonitor(gauge, log, read_only=read_only, released=profile_released)
    fan = KernelFan(system_path("/sys"), log)
    daemon = UpDaemon(monitor, fan, log, StatusFile(options["status"], log), read_temperature)
    daemon.stop = stop
    return daemon.run(options["intervall"] or UP_INTERVAL, options["durchlaeufe"])


def run_simulation(options, log):
    stop = threading.Event()
    install_signals(stop, log)
    if options["temperatur"] is not None:
        fixed = options["temperatur"]

        def source():
            return fixed
    elif options["temperatur_datei"]:
        path = options["temperatur_datei"]

        def source():
            return read_temperature_file(path)
    else:
        source = read_temperature
    log.info("Simulation: kein I2C, kein GPIO")
    daemon = Daemon(SimulatedFan(log), log, StatusFile(options["status"], log), options["konfig"], source,
                    simulate=True, stopping=lambda: False)
    daemon.stop = stop
    for width in options["pulse"]:
        daemon.on_pulse(width)
    return daemon.run(options["intervall"] or V3_INTERVAL, options["durchlaeufe"])


def run_config_check(options, out=sys.stdout):
    config, errors, notes, own = load_config(options["konfig"])
    for note in notes:
        print(f"Hinweis: {note}", file=out)
    if errors:
        for error in errors:
            print(f"Ungültig: {error}", file=out)
        print(f"Wirksam ist die Standardkurve: {config.describe()}", file=out)
        return 1
    herkunft = f"Eigene Kurve ({options['konfig']})" if own else "Standardkurve"
    print(f"{herkunft}: {config.describe()}", file=out)
    return 0


def run_check(options, out=sys.stdout):
    """Nur lesend: nichts wird geschrieben, auch nicht an den Argon."""
    good = True

    def line(ok, text):
        print(f"  {'✓' if ok else '✗'} {text}", file=out)

    model = read_model()
    pi5 = is_pi5(model)
    if is_cm5(model):
        return run_check_up(model, out)
    line(pi5, f"Gerät: {model or 'kein Gerätebaum'}")
    # Auf anderen Geräten können I2C-Bus 1 und GPIO4 etwas ganz anderes sein: dort nichts anfragen
    if not pi5:
        _check_config_line(options, line)
        return 1

    if os.path.exists(I2C_DEVICE):
        line(True, f"I2C-Bus 1 ({I2C_DEVICE})")
        try:
            import smbus
            bus = smbus.SMBus(I2C_BUS)
        except (ImportError, OSError) as err:
            line(False, f"I2C-Bus 1 nicht nutzbar: {err}")
            good = False
        else:
            try:
                bus.read_byte(ARGON_ADDRESS)
                line(True, f"Argon ONE antwortet an 0x{ARGON_ADDRESS:02x} (Lesezugriff)")
            except OSError as err:
                line(False, f"Keine Antwort an 0x{ARGON_ADDRESS:02x} ({err})")
                good = False
            finally:
                bus.close()
    else:
        line(False, f"I2C-Bus 1 fehlt ({I2C_DEVICE}): dtparam=i2c_arm=on in /boot/firmware/config.txt nötig")
        good = False

    try:
        import gpiod
    except ImportError:
        line(False, "python3-libgpiod fehlt")
        good = False
    else:
        found = find_button_line(gpiod)
        if found is None:
            line(False, f"GPIO-Zeile {BUTTON_LINE} nicht gefunden")
            good = False
        else:
            path, offset, label = found
            used = ""
            try:
                with gpiod.Chip(path) as chip:
                    info = chip.get_line_info(offset)
                    if info.used:
                        used = f", belegt von «{info.consumer or '?'}»"
            except OSError:
                pass
            line(True, f"Power-Button: {BUTTON_LINE} = {path} ({label}), Zeile {offset}{used}")

    _check_config_line(options, line)
    return 0 if good else 1


def run_check_up(model, out=sys.stdout):
    """Argon ONE UP, nur lesend: Messchip (Chip-ID, Steuerregister, Profil, Ladestand, Stromrichtung), Lüfter,
    Temperatur. Schreibt nichts in den Chip, auch wenn er schläft."""

    def line(mark, text):
        print(f"  {mark} {text}", file=out)

    line("✓", f"Gerät: {model} (Argon ONE UP erwartet)")
    good = True
    if not os.path.exists(system_path(I2C_DEVICE)):
        line("✗", f"I2C-Bus 1 fehlt ({I2C_DEVICE}): dtparam=i2c_arm=on in /boot/firmware/config.txt nötig")
        good = False
    else:
        line("✓", f"I2C-Bus 1 ({I2C_DEVICE})")
        bus = open_bus(Log(journal=False, stream=out))
        if bus is None:
            good = False
        else:
            try:
                good = _check_gauge(BatteryGauge(bus), line)
            finally:
                bus.close()
    fan = KernelFan(system_path("/sys"), Log(journal=False, stream=io.StringIO())).read()
    if fan["vorhanden"]:
        parts = []
        if fan["stufe"] is not None:
            parts.append("aus" if fan["stufe"] == 0 else f"Stufe {fan['stufe']} von {fan['stufen']}")
        if fan["upm"] is not None:
            parts.append(f"{fan['upm']} U/min")
        line("✓", "Lüfter (Kernel, pwm-fan): " + (" · ".join(parts) or "keine Werte"))
    else:
        line("·", "Kein Kernel-Lüfter (pwm-fan) gefunden")
    temperature = read_temperature()
    line("✓" if temperature is not None else "✗",
         f"CPU {_fmt(round(temperature, 1))} °C" if temperature is not None else "CPU-Temperatur nicht lesbar")
    if argon_up_original_active():
        line("·", "Argons eigene Software (argononeupd.service) ist aktiviert: zenos-argon schreibt dann nichts in "
                  "den Messchip")
    elif profile_released():
        line("✓", f"Akkuprofil schreiben: freigegeben ({PROFILE_RELEASE_PATH})")
    else:
        line("·", "Akkuprofil schreiben: nicht freigegeben, zenos-argon liest den Messchip nur (zen akku freigeben)")
    return 0 if good else 1


def _check_gauge(gauge, line):
    try:
        chip = gauge.chip_id()
    except OSError as err:
        line("✗", f"Keine Antwort an 0x{GAUGE_ADDRESS:02x} ({err}): kein Argon ONE UP?")
        return False
    if chip != GAUGE_CHIP_ID:
        line("✗", f"An 0x{GAUGE_ADDRESS:02x} antwortet kein CW2217 (Chip-ID 0x{chip:02x} statt "
                  f"0x{GAUGE_CHIP_ID:02x})")
        return False
    line("✓", f"Akku-Messchip CW2217 an 0x{GAUGE_ADDRESS:02x} (Chip-ID 0x{chip:02x}, Lesezugriff)")
    try:
        control = gauge._read(REG_CONTROL)
        state = gauge.check()
        if state != "ok":
            if argon_up_original_active():
                folge = "Argons eigene Software ist zuständig"
            elif profile_released():
                folge = "der Dienst lädt Argons Akkuprofil im nächsten Takt"
            else:
                folge = "Argons Akkuprofil kommt erst nach «zen akku freigeben»"
            line("·", f"Messchip {GAUGE_STATES[state]} (Register 0x08 = 0x{control:02x}); {folge}")
            return True
        line("✓", "Messchip aktiv, Argons Akkuprofil ist geladen")
        soc = gauge.read_soc()
        discharging = gauge.read_discharging()
    except OSError as err:
        line("✗", f"Messchip nicht lesbar ({err})")
        return False
    shown = f"{soc} %" if 1 <= soc <= 100 else f"noch kein Wert (Register 0x04 = {soc})"
    line("✓", f"Akku {shown}, {'entlädt' if discharging else 'lädt oder Netzteil'}")
    return True


def _check_config_line(options, line):
    config, errors, _notes, own = load_config(options["konfig"])
    if errors:
        line(False, f"{options['konfig']} ungültig, Standardkurve aktiv: {errors[0]}")
    else:
        line(True, f"{'Eigene Kurve' if own else 'Standardkurve'}: {config.describe()}")


def main(argv=None):
    try:
        options = parse_args(sys.argv[1:] if argv is None else argv)
    except UsageError as err:
        print(f"zenos-argon: {err}", file=sys.stderr)
        print("Aufruf: zenos-argon [--simulieren | --pruefen | --konfig-pruefen] [Optionen] (--hilfe)",
              file=sys.stderr)
        return 2
    mode = options["mode"]
    if mode == "hilfe":
        print(__doc__.strip())
        return 0
    if mode == "konfig":
        return run_config_check(options)
    if mode == "pruefen":
        return run_check(options)
    log = Log()
    if mode == "simulation":
        return run_simulation(options, log)
    return run_service(options, log)


if __name__ == "__main__":
    sys.exit(main())
