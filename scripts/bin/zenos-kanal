#!/usr/bin/python3 -I
"""zenos-kanal: der signierte Update-Kanal von zenOS. Holt die Tags und Branches von origin, prüft sie gegen den
Vertrauensanker des Geräts, stellt einen geprüften Stand bereit und installiert ihn, mit Gesundheitsprüfung und Rückweg.
Von Hand mit «zen update» und «zen rollback», automatisch über zenos-kanal.timer (siehe «Automatik» unten).

Aufruf:
  zenos-kanal update                   zen update: holen, prüfen, bei Bedarf «ja», bereitstellen, installieren (root,
                                       im Terminal; die Arbeit machen die Units, ein SSH-Abbruch schadet nicht)
  zenos-kanal rollback TAG             zen rollback: wie update, Ziel ist TAG (signiert, sonst nur mit «ja»)
  zenos-kanal jetzt ZIEL               «Jetzt installieren» in den Einstellungen: wie update, aber ohne Terminal, ohne
                                       Frage und ohne neues Holen, nur für den angezeigten Stand (ZIEL: Tag-Objekt, auf
                                       dev der Commit); was ein «ja» bräuchte, bleibt liegen (zenos-kanal-jetzt@ZIEL)
  zenos-kanal zustimmen OBJEKT         «Zustimmen …» in den Einstellungen (Passwort über polkit): wie update ohne neues
                                       Holen, mit dem «ja» für genau dieses Tag-Objekt, nur für gültig signierte Stände
                                       (zenos-kanal-zustimmen@OBJEKT.service)
  zenos-kanal zeitpunkt [sperre|fenster VON BIS|jederzeit|hand]
                                       zeigt bzw. setzt (root) den Zeitpunkt automatischer Updates in
                                       /etc/xdg/zenos/kanal-zeitpunkt; ohne Datei gilt «sperre»
  zenos-kanal status [--json|--kurz|--installation]
                                       Kanal, Anker mit Fingerabdrücken, letzte Prüfung und Installation (ohne root)
  zenos-kanal pruefen                  prüft das zuletzt geholte Bundle ohne Netz, erfüllt einen Wunsch von update oder
                                       rollback (bereitstellen) und schreibt den Stand (zenos-kanal-pruefen.service)
  zenos-kanal installieren             installiert den bereitgestellten Stand oder setzt einen unterbrochenen Lauf fort
                                       (zenos-kanal-installieren.service: root, mit Netz, Inhibitor)
  zenos-kanal nachstart                vollendet nach einem Abbruch die Übernahme des Codes vor dem Login
                                       (zenos-kanal-nachstart.service, vor greetd, ohne Netz)
  zenos-kanal selbsttest [--anker] [--probelauf] [--tag NAME OBJEKT REPO]
                                       Teil der Gesundheitsprüfung: liest der eben installierte zenos-kanal den Anker,
                                       nimmt er den installierten Tag an, und (--probelauf, nur wenn der Stand einen
                                       anderen zenos-kanal brachte) laufen status, update, rollback, installieren und
                                       nachstart als Probelauf in einem Wegwerf-Zustand ohne Netz durch?
  zenos-kanal anker                    zeigt den Vertrauensanker /etc/zenos/vertrauen
  zenos-kanal anker ORDNER             setzt den Anker von Hand aus ORDNER (root, nur im Terminal: der Fingerabdruck
                                       der Wurzel und von jedem Release-Schlüssel die ersten 8 Zeichen werden aus
                                       1Password eingetippt; die Werte aus dem Ordner zeigt es erst danach)
  zenos-kanal anker --pruefen ORDNER   prüft nur den Inhalt eines Ankers: vollständig (Exit 0), leer (1), ungültig (3)
  zenos-kanal automatik                zeigt, ob die Automatik an ist, wann sie läuft und was sie zuletzt tat
  zenos-kanal automatik an|aus         Notschalter (root, sudo zen kanal automatik an|aus): schaltet die Timer ein bzw.
                                       aus und vermerkt das in /etc/xdg/zenos/kanal-automatik-aus (install.sh hält sich
                                       daran). Die Signaturprüfung bleibt in jedem Fall
  zenos-kanal automatik lauf           zenos-kanal-automatik.service (zenos-kanal.timer, alle 6 h): bis 2 Min. auf eine
                                       synchronisierte Uhr warten, holen, prüfen, und wenn der Zeitpunkt passt,
                                       installieren
  zenos-kanal automatik gelegenheit    zenos-kanal-gelegenheit.service (alle 15 Min., nur wenn etwas bereit ist): wie
                                       lauf ohne Holen, damit «bei Sperre» und das Zeitfenster getroffen werden
  zenos-kanal bestaetigen              zenos-kanal-bestaetigen.service (2 Min. nach dem Start): Kommt nach einem
                                       automatischen Update der Login (greetd mit Greeter oder Sitzung)? Erst dann gilt
                                       der Stand als gut; fehlt er bei zwei Starts, geht es auf den guten Stand zurück
  zenos-kanal holen-intern             nur für zenos-kanal-holen.service: holt ohne Rechte von origin
  zenos-kanal image vX.Y.Z[-rcN]       nur für image/bauen.sh (im chroot, nach install.sh --image): prüft den Tag wie
                                       das Gerät und legt den Zustand ab Werk an (gut.json, hoechste, gesehen.json);
                                       nur in einem neuen Zustand

Holen (zenos-kanal-holen.service, DynamicUser, nur mit Netz und in einer Sandbox): «git fetch» von der https-Adresse
von origin (aus /opt/zenos/.git/config) in einen eigenen Spiegel, nur die Tags v* (Versionen und vertrauen/NNNN) und
den Branch dev, erzwungen nach refs/kanal/tags/* und refs/kanal/heads/dev. Ein auf origin verschobener oder gelöschter
Tag bricht dabei nichts ab. Danach packt es den Spiegel neu und löscht, was nicht mehr erreichbar ist; ist er dann
grösser als 2 GB, fliegt er weg. Das Ergebnis geht als Bundle (uebergabe.bundle) an root; root öffnet das Repo des
Holers nie.

Prüfen (root, ohne Netz): Das Bundle kommt in ein Repo, das bei jedem Lauf neu entsteht (eigene config, keine Hooks).
Jedes git läuft mit leerer Umgebung (nur PATH, HOME=/nonexistent, LC_ALL=C), ohne System- und Benutzer-config, ohne
Ersatzobjekte, mit core.hooksPath=/dev/null, core.fsmonitor=false, protocol.allow=never, gpg.ssh.program=ssh-keygen
und abgeschaltetem OpenPGP und X.509. Regeln:
  1. Anker /etc/zenos/vertrauen (nie aus /opt/zenos): release, wurzel, widerrufen und serie, root-eigen, für andere
     nicht schreibbar, streng im Format (nur Ed25519, Prinzipale zenos-release und zenos-wurzel). Fehlt etwas: «Anker
     fehlt», nichts gilt als gültig. Die Widerrufsdatei muss es geben, sie darf leer sein.
  2. Ein Tag gilt nur, wenn er annotiert ist, sein Kopf genau object, type, tag und tagger hat, das Feld «tag» dem
     Ref-Namen gleicht, type «commit» ist, er genau eine SSH-Signatur (Namespace git) am Ende trägt, keine OpenPGP-
     oder X.509-Signatur enthält und «git verify-tag <Objekt-ID>» ihn gegen den Anker für den Prinzipal annimmt.
  3. Tags vertrauen/NNNN mit NNNN über der eigenen Serie kommen zuerst, aufsteigend: gültig gegen wurzel (Prinzipal
     zenos-wurzel) und widerrufen. Massgeblich ist der Anker im Commit des Tags: Serie gleich NNNN, dieselbe Wurzel.
     Übernommen werden release und widerrufen (als Vereinigung mit den alten) und die Serie. Die Wurzel ändert sich
     nie über das Netz.
  4. Releases vX.Y.Z (stabil) und zusätzlich vX.Y.Z-rcN (vorschau) gelten gegen release (Prinzipal zenos-release).
  5. Hauptbuch gesehen.json (Name → Objekt und Commit, nur Namen, die gültig waren): Zeigt ein Name, der schon gültig
     war, gültig signiert auf einen anderen Commit, ist der Kanal «blockiert» (ALARM). Derselbe Commit in einem anderen
     Tag-Objekt (die Signatur lässt sich ohne Schlüssel neu umbrechen) gilt weiter. Ein ungültiges neues Objekt ist nur
     ein Hinweis, ebenso ein auf origin gelöschter Tag. Viele Tags sind kein Grund für «blockiert»: Leichte, unsignierte
     und fremd signierte kosten kaum etwas; git verify-tag läuft höchstens 2000-mal je Lauf (schon gültige Namen
     ausgenommen), die übrigen bleiben ungeprüft (Hinweis).
  6. Ziel ist die höchste gültige Version des Kanals über «hoechste» (kein Downgrade; rcN liegt vor der finalen
     Version), ohne Versionen in gesperrt/. «hoechste» steigt mit dem installierten Stand: Jeder gültige Tag, dessen
     Commit im Verlauf von /opt/zenos liegt, hebt es an. Fehlt «hoechste» und ist der installierte Stand keiner
     signierten Version zuzuordnen, ist der Kanal «blockiert». Trifft der Weg dorthin Firewall, Netz oder Boot
     (Rückfrage-Pfade, fest im Code), heisst der Zustand «zustimmung».
  7. Kanal dev: neuer Stand von origin/dev, ob der installierte Stand darin liegt und ob alle Commits dazwischen mit
     einem Release-Schlüssel signiert sind. Automatisch kommt auf dev nie etwas.

Wunsch (zen update, zen rollback): Das Ziel braucht ein getipptes «ja», gebunden an genau diese Commit- bzw. Objekt-ID,
wenn es nicht gültig signiert ist (dev: nicht jeder Commit seit dem installierten Stand; Anker fehlt), dev umgeschrieben
wurde, es gesperrt ist, ein Rückschritt wäre oder Firewall, Netz oder Boot trifft. Stabil und vorschau nehmen nur
Signiertes. Bereitgestellt wird in /var/lib/zenos/kanal/bereit/<commit> (eigenes Repo, ausgecheckt, geprüft).

Installieren (root, mit Netz, unter einem Block-Inhibitor für Ausschalten und Ruhezustand): Läuft ein install.sh von
Hand (Vermerk /run/zenos-sperre/hand), wartet es (Exit 75). Vorher: zurückgebliebene Sperrdateien von git in
/opt/zenos/.git weg, «dpkg --configure -a», falls dpkg unterbrochen wurde, und eine Bereitstellung des laufenden Stands
als Rückweg. Dann <bereit>/scripts/install.sh mit ZENOS_KANAL_LAUF=1; 10-code übernimmt den Code Datei für Datei atomar
nach /opt/zenos. Gesund heisst: Exit 0 und «== Ende … ok» im install.log, /opt/zenos auf dem Commit und sauber, die
Shell-Skripte ohne Syntaxfehler, scripts/zen läuft, quickshell läuft und greetd ist nicht ausgefallen (beides nur, wenn
es vor install.sh noch ging), und der neue zenos-kanal besteht seinen Selbsttest (mit Probelauf, wenn er geändert
ist; beim Rückweg nur den Anker). Sonst: Version nach gesperrt/,
Rückweg auf den Stand davor (Ergebnis «zurueck»); scheitert auch der, «kaputt». Scheitert install.sh nur an seiner
Sperre (Exit 75, nichts begonnen), zählt der Versuch nicht. Ein Abbruch (Strom, kill) hinterlässt laeuft.json:
nachstart vollendet die Übernahme des Codes vor dem Login, zen update setzt fort; nach zwei unterbrochenen Versuchen
wird die Version gesperrt und der Rückweg genommen. Danach prüft zen update den Stand neu (stand.json).

Zeitpunkt (/etc/xdg/zenos/kanal-zeitpunkt, root, 0644; setzt der Benutzer am Gerät über zenos-kanal-bedienen und
polkit oder mit «sudo zen kanal zeitpunkt»): «sperre» (Standard: nur gesperrt oder ohne Sitzung), «fenster» mit von
und bis (HH:MM, mindestens eine Stunde, über Mitternacht erlaubt), «jederzeit» oder «hand» (nie automatisch, nur
die Mitteilung «Update bereit»).

Automatik (Entscheid Zeno, Oktober 2026): Automatisch installiert wird nur auf stabil und vorschau, nie auf dev, nur
ein gültig signierter Stand ohne Rückfrage-Pfade («zustimmung» bleibt liegen, die Oberfläche meldet es), nur nach der
Wartezeit (stabil 24 h ab dem ersten Sehen, vorschau sofort) und nur zum Zeitpunkt:
  sperre     jede Sitzung auf seat0 ist seit mindestens 5 Min. gesperrt: Marker der Oberfläche
             /run/user/<uid>/zenos/gesperrt (Besitzer der Benutzer; vor dem ersten Abgleich der Uhr gilt der Abgleich
             als Beginn) und «zenos-ipc sperre status» als dieser Benutzer sagt «gesperrt» (ext-session-lock bestätigt).
             Eine Textkonsole auf seat0 (logind Type tty) ist nie gesperrt. Ohne Sitzung auf seat0 erst, wenn der
             Login-Bildschirm seit 5 Min. läuft (Alter seines Prozesses; ohne greetd 5 Min. nach dem Start). Ist jemand
             per SSH angemeldet (logind Remote), ist es nie ruhig; ein tmux-Server ohne Verbindung zählt nicht.
  fenster    nur zwischen von und bis (Ortszeit, auch über Mitternacht) und nur mit synchronisierter Uhr, auch während
             jemand arbeitet
  jederzeit  sobald es bereit ist
  hand       nie; nur stand.json und die Mitteilung «Update bereit» der Oberfläche
Bei jedem Zeitpunkt ausserdem nur am Netzteil oder ab 50 % Akku (Statusdatei von zenos-argon, sonst
/sys/class/power_supply; unbekannt gilt als Netzteil), nicht solange der Stand «angehalten» ist (install.sh von Hand aus
einem Arbeitsstand, bis zum nächsten zen update) und nicht, solange ein automatisch installierter Stand aus einem
früheren Start auf die Bestätigung wartet. Unmittelbar vor dem Installieren liest die Automatik den Zeitpunkt neu und
prüft alles noch einmal. Eine unterbrochene Installation setzt sie nur fort, wenn sie selbst sie begann (oder es der
Weg zurück auf den guten Stand ist); eine von Hand setzt zen update fort.
«erstmals gesehen» (gesehen.json) entsteht nur mit synchronisierter Uhr (timedatectl NTPSynchronized; time-sync.target
wartet nicht) und merkt sich den Start: Im selben Start zählt für die 24 h die Zeit seit dem Start, sonst die Uhr, und
auch die nur synchronisiert. Nach «zen rollback» bringt die Automatik die verlassene Version nicht wieder, weil
«hoechste» nicht sinkt; zurueckgestellt.json merkt sie sich für die Anzeige (und hält sie fern, falls hoechste
verloren ging), bis ein Update von Hand gelingt. Ein automatisch installierter Stand gilt erst als gut, wenn nach einem
Neustart der Login kommt (unbestaetigt.json, zenos-kanal bestaetigen: Greeter oder grafische Sitzung, keine
Textkonsole); fehlt das bei zwei Starts, geht es auf den guten Stand zurück (ohne Rückweg auf den Stand ohne Login),
und die Version wird gesperrt. Scheitert der Weg zurück, ist das «kaputt», und der nächste Start versucht es noch
einmal.

Dateien: /etc/xdg/zenos/kanal (Kanal: stabil, vorschau, dev; main gilt als stabil), /etc/zenos/vertrauen (Anker),
/etc/xdg/zenos/kanal-automatik-aus (Notschalter), /var/lib/zenos/kanal/{stand.json, gesehen.json, hoechste, gesperrt/,
wunsch.json, auftrag.json, laeuft.json, gut.json, unbestaetigt.json, zurueckgestellt.json, automatik-bereit,
automatik.json, letzte.json, angehalten, bereit/} (root, alles für alle lesbar), /var/lib/zenos-kanal-holen/{spiegel.git,
uebergabe.bundle, holen.json} (Holer), /run/zenos-sperre/{kanal.lock, bedienung.lock, install.lock, hand} (nur root).

Exit: 0 in Ordnung (aktuell, bereit, installiert) · 1 Fehler · 2 Aufruf · 3 abgelehnt, blockiert oder Anker fehlt ·
4 gescheitert, Rückweg ok · 5 kaputt (auch der Rückweg scheiterte) · 10 wartet (Netz, Platz, Zustimmung) · 75 läuft
schon (Sperre /run/zenos-sperre/kanal.lock, ein install.sh von Hand oder eine andere Installation).
"""

import base64
import contextlib
import datetime
import fcntl
import hashlib
import json
import os
import pwd
import re
import secrets
import shutil
import signal
import stat
import struct
import subprocess
import sys
import tempfile
import time
import traceback

NAME = "zenos-kanal"
GIT = "/usr/bin/git"
SSH_KEYGEN = "/usr/bin/ssh-keygen"
SYSTEM_PATH = "/usr/bin:/bin"

CODE_DIR = "/opt/zenos"
CHANNEL_FILE = "/etc/xdg/zenos/kanal"
SCHEDULE_FILE = "/etc/xdg/zenos/kanal-zeitpunkt"
# Notschalter der Automatik (sudo zen kanal automatik aus): Gibt es die Datei, laufen die Timer nicht, und install.sh
# schaltet sie nicht wieder ein
AUTOMATIC_OFF_FILE = "/etc/xdg/zenos/kanal-automatik-aus"
ANCHOR_DIR = "/etc/zenos/vertrauen"
STATE_DIR = "/var/lib/zenos/kanal"
FETCH_DIR = "/var/lib/zenos-kanal-holen"
# Sperren nur für root: /run/zenos-sperre (0700). In /run/lock (für alle beschreibbar) könnte jeder Benutzer eine
# Sperre anlegen oder lesend öffnen und halten und so den Kanal abschneiden.
LOCK_FILE = "/run/zenos-sperre/kanal.lock"

# Wem Anker, Zustand und Ordner darüber gehören dürfen, bis wohin die Ordner geprüft werden und welche Adressen der
# Holer annimmt. Nur die Einheitentests setzen andere Werte (nach dem Laden als Modul); einen Schalter gibt es nicht.
TRUSTED_UIDS = (0,)
PATH_CHECK_TOP = "/"
ALLOWED_SCHEMES = ("https",)
# Nur während «selbsttest» (Probelauf in einem Wegwerf-Zustand): nichts bereitstellen, nichts installieren, dpkg und
# /opt/zenos nicht anfassen. Von aussen nicht zu setzen.
DRY_RUN = False

UI_LOCK_FILE = "/run/zenos-sperre/bedienung.lock"
# Vermerk eines install.sh von Hand (PID, nur root schreibt ihn): Solange dieser Prozess läuft, installiert der Kanal
# nichts. install.sh schreibt ihn unter der Kanal-Sperre und entfernt ihn am Ende.
HAND_MARK = "/run/zenos-sperre/hand"
RUNTIME_DIR = "/run/zenos-kanal"
INSTALL_LOG = "/var/log/zenos/install.log"
INSTALLED_PROGRAM = "/usr/local/libexec/zenos/zenos-kanal"
SPACE_PATHS = ("/var",)
DPKG_UPDATES = "/var/lib/dpkg/updates"
DPKG_LOCKS = ("/var/lib/dpkg/lock-frontend", "/var/lib/dpkg/lock")
SYSTEMD_RUN_DIR = "/run/systemd/system"

PYTHON = "/usr/bin/python3"
BASH = "/bin/bash"
DPKG = "/usr/bin/dpkg"
SLEEP = "/usr/bin/sleep"
SYSTEMCTL = "/usr/bin/systemctl"
JOURNALCTL = "/usr/bin/journalctl"
LOGINCTL = "/usr/bin/loginctl"
LOGGER = "/usr/bin/logger"
SYSTEMD_INHIBIT = "/usr/bin/systemd-inhibit"
TIMEDATECTL = "/usr/bin/timedatectl"
SETPRIV = "/usr/bin/setpriv"
QUICKSHELL = "/usr/local/bin/quickshell"
INSTALL_PATH = "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

FETCH_TIMEOUT = 600
GIT_TIMEOUT = 300
CHECK_TIMEOUT = 120
DPKG_TIMEOUT = 3600
DPKG_WAIT = 600
MAX_BUNDLE = 1 << 30
MAX_MIRROR = 2 * MAX_BUNDLE
MAX_SMALL_FILE = 1 << 16
MAX_TAG_SIZE = 1 << 16
# Signaturprüfungen (git verify-tag) je Lauf, ausser für Namen, die schon gültig waren. Mehr Tags sind kein Grund für
# «blockiert»: Die übrigen bleiben ungeprüft (Hinweis), die bekannten gültigen und die höchsten Versionen kommen zuerst.
MAX_VERIFY = 2000
MAX_REJECTED_SHOWN = 100
MAX_DEV_RANGE = 2000
MAX_SHOWN = 20
MIN_FREE = 1 << 30
MAX_ATTEMPTS = 2
WAIT_STABLE = datetime.timedelta(hours=24)
MAX_AGE = datetime.timedelta(hours=1)
BOOT_ID = "/proc/sys/kernel/random/boot_id"
PROC = "/proc"
# Automatik: so lange vor dem Holen auf eine synchronisierte Uhr warten (time-sync.target wartet nicht), so lange muss
# eine Sitzung gesperrt sein, so lange wartet die Bestätigung nach dem Start auf den Login, so alt muss der Greeter sein
# (ein Greeter, der immer wieder abstürzt, zählt nicht), so viele Starts ohne Login führen zurück
CLOCK_WAIT = 120
CLOCK_POLL = 5
MIN_LOCKED = datetime.timedelta(minutes=5)
CONFIRM_WAIT = 180
CONFIRM_POLL = 10
GREETER_MIN_AGE = 20
GREETER_USER = "_greetd"
GREETER_COMM = "quickshell"
MAX_UNCONFIRMED = 2
# So lange wartet die Bestätigung nach dem Start auf die Sperre der Bedienung (eine Automatik, die beim Start nachholt,
# holt und prüft nur, solange ein Stand auf die Bestätigung wartet)
CONFIRM_LOCK_WAIT = 1800
TIMERS = ("zenos-kanal.timer", "zenos-kanal-gelegenheit.timer")
USER_PATH = "/usr/local/bin:/usr/bin:/bin"
RUN_USER = "/run/user"
# Sitzungsarten, die als grafischer Login zählen (logind Type). «tty» ist eine Textkonsole (Ctrl+Alt+F2).
GRAPHICAL_TYPES = ("wayland", "x11", "mir")
# Den legt systemd-timesyncd beim ersten Abgleich an: Was davor geschah, hat eine Zeit von der falschen Uhr
TIMESYNC_FLAG = "/run/systemd/timesync/synchronized"
# Akku: Statusdatei von zenos-argon (Argon ONE UP), sonst /sys/class/power_supply. Automatisch installiert wird nur am
# Netzteil oder ab MIN_BATTERY Prozent; ein unbekannter Stand gilt wie in der Oberfläche als Netzteil.
POWER_STATUS = "/run/zenos/geraet.json"
POWER_SUPPLY_DIR = "/sys/class/power_supply"
POWER_STATUS_MAX_AGE = datetime.timedelta(minutes=5)
