UNITS = {
    "holen": "zenos-kanal-holen.service",
    "pruefen": "zenos-kanal-pruefen.service",
    "installieren": "zenos-kanal-installieren.service",
}
# Zustandsdateien der Automatik in /var/lib/zenos/kanal
UNCONFIRMED = "unbestaetigt.json"
HOLD = "zurueckgestellt.json"
READY_MARK = "automatik-bereit"
AUTO_LOG = "automatik.json"

# Rückfrage-Pfade: Ein Update, das einen davon ändert, installiert nur nach Zustimmung (Firewall, Netz, Boot). Dieselben
# wie die Gruppen firewall, netz und boot in scripts/lib/sensible-pfade (ein Einheitentest hält beide gleich). Fest im
# Code: Ein neuer Stand kann keinen streichen, seine eigene Liste kommt nur dazu. Muster wie dort: git-Pfadmuster, ein
# Ordner endet mit /, ein * passt auf beliebige Zeichen (auch auf /). Indirekte Änderungen fängt die Liste nicht.
CONSENT_PATHS = (
    "scripts/lib/firewall.sh",
    "scripts/bin/zenos-firewall",
    "scripts/zen.d/firewall.sh",
    "scripts/module/70-sicherheit.sh",
    "scripts/pakete/sicherheit.txt",
    "system/polkit/org.zenos.firewall.policy",
    "scripts/module/35-netzwerk.sh",
    "scripts/bin/zenos-netzwerk",
    "scripts/zen.d/netzwerk.sh",
    "scripts/pakete/netzwerk.txt",
    "system/cloud/",
    "system/modprobe/",
    "system/systemd/system/zenos-netzwerk-erststart.service",
    "system/systemd/system/zenos-wlan-land.service",
    "system/systemd/system/systemd-networkd-wait-online.service.d/",
    "scripts/module/42-bootsplash.sh",
    "scripts/zen.d/bootsplash.sh",
    "scripts/pakete/bootsplash.txt",
    "system/plymouth/",
)
CONSENT_GROUPS = ("firewall", "netz", "boot")
PATTERN_RE = re.compile(r"[A-Za-z0-9._][A-Za-z0-9._*/-]{0,199}")
# Schlüsselfiles, die nach einer Installation nicht leer sein dürfen (eine volle Platte schrieb früher 0 Byte)
KEY_FILES = ("scripts/zen", "scripts/install.sh", "scripts/bin/zenos-greeter", "scripts/bin/zenos-sitzung")

CHANNELS = ("stabil", "vorschau", "dev")
ANCHOR_FILES = ("release", "wurzel", "widerrufen", "serie")
KEY_PATTERN = r"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI[A-Za-z0-9+/]{43}"
RELEASE_LINE = re.compile(r'zenos-release namespaces="git" (' + KEY_PATTERN + ")")
ROOT_LINE = re.compile(r'zenos-wurzel namespaces="git" (' + KEY_PATTERN + ")")
REVOKED_LINE = re.compile("(" + KEY_PATTERN + ")")
SERIES_LINE = re.compile(r"[1-9][0-9]{0,3}")
VERSION_RE = re.compile(r"v(0|[1-9][0-9]{0,8})\.(0|[1-9][0-9]{0,8})\.(0|[1-9][0-9]{0,8})(?:-rc([1-9][0-9]{0,8}))?")
TRUST_RE = re.compile(r"vertrauen/([0-9]{4})")
TAG_NAME_RE = re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]{0,99}")
BRANCH_RE = re.compile(r"[A-Za-z0-9][A-Za-z0-9._/-]{0,99}")
USER_RE = re.compile(r"[a-z_][a-z0-9_-]{0,31}")
WISH_ID_RE = re.compile(r"[0-9a-f]{16}")
OID_RE = re.compile(r"[0-9a-f]{40}")
TIME_RE = re.compile(r"[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z")
HTTPS_RE = re.compile(r"https://[A-Za-z0-9.-]+(?::[0-9]{1,5})?/[A-Za-z0-9._~/+-]+")
FILE_RE = re.compile(r"file:///[A-Za-z0-9._~/+-]+")
SIG_BEGIN = "-----BEGIN SSH SIGNATURE-----"
SIG_END = "-----END SSH SIGNATURE-----"
REPO_CONFIG = "[core]\n\trepositoryformatversion = 0\n\tfilemode = true\n\tbare = true\n"

RELEASE_PRINCIPAL = "zenos-release"
ROOT_PRINCIPAL = "zenos-wurzel"

# Zeitpunkt automatischer Updates (Entscheid Zeno, Oktober 2026). Ohne Datei gilt «sperre».
SCHEDULES = ("sperre", "fenster", "jederzeit", "hand")
SCHEDULE_DEFAULT = "sperre"
SCHEDULE_WINDOW = ("02:00", "05:00")
CLOCK_RE = re.compile(r"([01][0-9]|2[0-3]):([0-5][0-9])")
MIN_WINDOW_MINUTES = 60


class Failure(Exception):
    """Fehler mit einer Meldung für Menschen."""


# --- Allgemein -------------------------------------------------------------------------------------------------


def now():
    return datetime.datetime.now(datetime.timezone.utc).replace(microsecond=0)


def iso(t):
    return t.strftime("%Y-%m-%dT%H:%M:%SZ")


def parse_iso(text):
    if not isinstance(text, str) or not TIME_RE.fullmatch(text):
        return None
    try:
        return datetime.datetime.strptime(text, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=datetime.timezone.utc)
    except ValueError:
        return None


def local_time(text):
    t = parse_iso(text)
    return t.astimezone().strftime("%Y-%m-%d %H:%M") if t else "–"


def short(text, length=60):
    text = "".join(c if c.isprintable() else "?" for c in str(text))
    return text if len(text) <= length else text[: length - 1] + "…"


def journal(text):
    """Eine Zeile ins Journal (logger -t zenos-kanal), still, wenn das nicht geht."""
    if os.access(LOGGER, os.X_OK):
        run([LOGGER, "-t", NAME, "--", short(text, 400)], env={"PATH": SYSTEM_PATH, "LANG": "C.UTF-8"}, timeout=10)


def first_line(text):
    for line in str(text).splitlines():
        line = line.strip()
        if line:
            return short(line, 160)
    return ""


def run(argv, cwd="/", env=None, timeout=GIT_TIMEOUT, stdin=None):
    """Startet ein Programm mit Argumentliste (nie über eine Shell). Zeitlimit → Exit 124, fehlt es → 127. stdin: eine
    offene Datei, sonst /dev/null."""
    try:
        return subprocess.run(argv, cwd=cwd, env=env, stdin=stdin if stdin is not None else subprocess.DEVNULL,
                              capture_output=True, text=True, errors="replace", timeout=timeout, check=False)
    except subprocess.TimeoutExpired:
        return subprocess.CompletedProcess(argv, 124, "", f"Zeitlimit von {timeout} s überschritten")
    except OSError as e:
        return subprocess.CompletedProcess(argv, 127, "", f"{argv[0]}: {e.strerror}")


def run_visible(argv, env, timeout=None, cwd="/"):
    """Startet ein Programm mit Argumentliste, die Ausgabe geht durch (Journal bzw. Terminal). Exit-Code; Zeitlimit →
    124, fehlt es → 127."""
    sys.stdout.flush()
    sys.stderr.flush()
    try:
        return subprocess.run(argv, cwd=cwd, env=env, stdin=subprocess.DEVNULL, timeout=timeout, check=False).returncode
    except subprocess.TimeoutExpired:
        print(f"{NAME}: {os.path.basename(argv[0])}: Zeitlimit von {timeout} s überschritten", file=sys.stderr)
        return 124
    except OSError as e:
        print(f"{NAME}: {argv[0]}: {e.strerror}", file=sys.stderr)
        return 127


def install_env():
    """Umgebung für install.sh und die Prüfungen danach: leer bis auf das Nötigste. ZENOS_KANAL_LAUF=1 sagt 10-code,
    dass der Lauf vom Kanal kommt (der die Sperre schon hält)."""
    return {"PATH": INSTALL_PATH, "HOME": "/root", "LANG": "C.UTF-8", "ZENOS_KANAL_LAUF": "1"}


def state_path(*parts):
    return os.path.join(STATE_DIR, *parts)


def boot_clock():
    """(Kennung dieses Starts, Sekunden seit dem Start inklusive Ruhezustand) oder (None, None). Anders als die Uhrzeit
    springt das nicht, wenn NTP die Uhr nach dem Start stellt (der Pi hat keine Uhr mit Batterie)."""
    try:
        with open(BOOT_ID, encoding="ascii") as f:
            boot = f.read(64).strip()
        clock = time.clock_gettime(getattr(time, "CLOCK_BOOTTIME", time.CLOCK_MONOTONIC))
    except (OSError, ValueError, AttributeError):
        return None, None
    return (boot, clock) if re.fullmatch(r"[0-9a-f-]{16,40}", boot) else (None, None)


def stamp():
    """Zeitstempel für wunsch.json und auftrag.json: Uhrzeit und Zeit seit dem Start."""
    boot, clock = boot_clock()
    return {"zeit": iso(now()), "start": boot, "seit_start": clock}


def stamp_age(data, t):
    """Alter eines Zeitstempels von stamp() als timedelta, None wenn er unbrauchbar ist. Im selben Start zählt die Zeit
    seit dem Start, sonst die Uhrzeit."""
    boot, clock = boot_clock()
    if boot and data.get("start") == boot and isinstance(data.get("seit_start"), (int, float)):
        return datetime.timedelta(seconds=clock - data["seit_start"])
    when = parse_iso(data.get("zeit"))
    return t - when if when else None


def fresh(data, t):
    age = stamp_age(data, t)
    return age is not None and abs(age) <= MAX_AGE


def clock_synced():
    """Ist die Uhr synchronisiert (timedatectl: NTPSynchronized=yes, aus dem Kernel, auch mit chrony)? Nicht
    feststellbar heisst nein. time-sync.target allein sichert das nicht (systemd-time-wait-sync ist aus)."""
    if not os.access(TIMEDATECTL, os.X_OK):
        return False
    r = run([TIMEDATECTL, "show", "--property=NTPSynchronized", "--value"],
            env={"PATH": SYSTEM_PATH, "LANG": "C.UTF-8", "SYSTEMD_PAGER": ""}, timeout=30)
    return r.returncode == 0 and r.stdout.strip() == "yes"


def start_id():
    """Kennung dieses Systemstarts: Start-ID des Kerns und Startzeit von PID 1 (so ist auch ein neu gestarteter
    Container ein neuer Start). None, wenn sie sich nicht lesen lässt."""
    boot, _ = boot_clock()
    try:
        with open(os.path.join(PROC, "1", "stat"), encoding="ascii", errors="replace") as f:
            fields = f.read(4096).rsplit(")", 1)[1].split()
        started = fields[19]  # Feld 22 (starttime), gezählt ab dem Feld nach «(comm)»
    except (OSError, IndexError):
        return None
    return f"{boot}:{started}" if boot and started.isdigit() else None


def wait_over(entry, wait, t, synced):
    """Ist die Wartezeit WAIT seit dem ersten Sehen (Eintrag im Hauptbuch) um? Ohne Wartezeit ja. Sonst braucht es
    «erstmals» (das nur mit synchronisierter Uhr entsteht); im selben Start zählt die Zeit seit dem Start (ein Sprung der
    Uhr verkürzt nichts), über einen Neustart hinweg die Uhr, und die nur, wenn sie jetzt synchronisiert ist."""
    if wait <= datetime.timedelta(0):
        return True
    first = parse_iso((entry or {}).get("erstmals"))
    if not first or t - first < wait:
        return False
    seen = (entry or {}).get("erstmals_start") or {}
    boot, clock = boot_clock()
    if boot and isinstance(seen, dict) and seen.get("start") == boot and isinstance(seen.get("seit_start"), (int, float)):
        return clock - seen["seit_start"] >= wait.total_seconds()
    return bool(synced)


def git_env():
    """Leere Umgebung für git: keine config ausser der Repo-config und der Befehlszeile, keine Ersatzobjekte."""
    return {
        "PATH": SYSTEM_PATH,
        "HOME": "/nonexistent",
        "LC_ALL": "C",
        "GIT_CONFIG_NOSYSTEM": "1",
        "GIT_CONFIG_GLOBAL": "/dev/null",
        "GIT_ATTR_NOSYSTEM": "1",
        "GIT_NO_REPLACE_OBJECTS": "1",
        "GIT_TERMINAL_PROMPT": "0",
        "GIT_OPTIONAL_LOCKS": "0",
    }


def git_hardening():
    return [
        "-c", "core.hooksPath=/dev/null",
        "-c", "core.fsmonitor=false",
        "-c", f"gpg.ssh.program={SSH_KEYGEN}",
        "-c", "gpg.openpgp.program=false",
        "-c", "gpg.x509.program=false",
        "-c", "protocol.allow=never",
        "-c", "gc.auto=0",
        "-c", "maintenance.auto=false",
    ]


def git_argv(repo, *args):
    return [GIT] + (["-C", repo] if repo else []) + git_hardening() + list(args)


def git(repo, *args, timeout=GIT_TIMEOUT, stdin=None):
    return run(git_argv(repo, *args), env=git_env(), timeout=timeout, stdin=stdin)


def path_problem(path):
    """Grund, warum PATH (und jeder Ordner darüber bis PATH_CHECK_TOP) nicht sicher ist, sonst None: kein Verweis,
    Besitzer root, für Gruppe und andere nicht schreibbar."""
    path = os.path.abspath(path)
    top = os.path.abspath(PATH_CHECK_TOP)
    while True:
        try:
            st = os.lstat(path)
        except OSError as e:
            return f"{path}: {e.strerror}"
        if stat.S_ISLNK(st.st_mode):
            return f"{path} ist ein Verweis"
        if st.st_uid not in TRUSTED_UIDS:
            return f"{path} gehört nicht root"
        if st.st_mode & 0o022:
            return f"{path} ist für andere schreibbar"
        if path in (top, "/"):
            return None
        path = os.path.dirname(path)


def read_small(path, trusted=False, limit=MAX_SMALL_FILE):
    """Liest eine kleine reguläre Datei ohne Verweis zu folgen. trusted: Besitzer root, für andere nicht schreibbar.
    FileNotFoundError, wenn sie fehlt; Failure bei allem anderen."""
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | getattr(os, "O_CLOEXEC", 0))
    except FileNotFoundError:
        raise
    except OSError as e:
        raise Failure(f"{path}: {e.strerror}") from e
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            raise Failure(f"{path} ist keine Datei")
        if trusted and st.st_uid not in TRUSTED_UIDS:
            raise Failure(f"{path} gehört nicht root")
        if trusted and st.st_mode & 0o022:
            raise Failure(f"{path} ist für andere schreibbar")
        data = os.read(fd, limit + 1)
        if len(data) > limit:
            raise Failure(f"{path} ist zu gross")
    finally:
        os.close(fd)
    try:
        return data.decode("utf-8")
    except UnicodeDecodeError as e:
        raise Failure(f"{path} ist kein UTF-8") from e


def write_atomic(path, text, mode=0o644):
    """Schreibt PATH atomar: PATH.neu im selben Ordner, fsync, rename, fsync des Ordners."""
    folder = os.path.dirname(path)
    tmp = os.path.join(folder, "." + os.path.basename(path) + ".neu")
    try:
        os.unlink(tmp)
    except FileNotFoundError:
        pass
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | getattr(os, "O_CLOEXEC", 0), mode)
    try:
        data = text.encode("utf-8")
        while data:
            data = data[os.write(fd, data):]
        os.fchmod(fd, mode)
        os.fsync(fd)
    finally:
        os.close(fd)
    os.replace(tmp, path)
    dfd = os.open(folder, os.O_RDONLY)
    try:
        os.fsync(dfd)
    finally:
        os.close(dfd)


def write_json(path, data, mode=0o644):
    write_atomic(path, json.dumps(data, ensure_ascii=False, indent=1) + "\n", mode)


def load_json(path, trusted=False):
    """JSON-Objekt aus PATH, None wenn es fehlt oder unlesbar ist."""
    try:
        data = json.loads(read_small(path, trusted=trusted, limit=4 << 20))
    except (FileNotFoundError, Failure, ValueError):
        return None
    return data if isinstance(data, dict) else None


# --- Versionen -------------------------------------------------------------------------------------------------


def version_key(name):
    """(X, Y, Z, final, rc) zum Vergleichen, None für andere Namen. vX.Y.Z-rcN liegt vor vX.Y.Z."""
    m = VERSION_RE.fullmatch(name or "")
    if not m:
        return None
    x, y, z, rc = m.groups()
    if rc is None:
        return (int(x), int(y), int(z), 1, 0)
    return (int(x), int(y), int(z), 0, int(rc))


def in_channel(name, channel):
    m = VERSION_RE.fullmatch(name)
    if not m:
        return False
    if channel == "stabil":
        return m.group(4) is None
    return True


def highest(names):
    names = [n for n in names if version_key(n)]
    return max(names, key=version_key) if names else None


# --- Anker -----------------------------------------------------------------------------------------------------


class AnchorError(Exception):
    def __init__(self, reason, empty=False):
        super().__init__(reason)
        self.reason = reason
        self.empty = empty


class Anchor:
    def __init__(self, release, root, revoked, series):
        self.release = release
        self.root = root
        self.revoked = revoked
        self.series = series

    def summary(self):
        return {
            "serie": self.series,
            "wurzel": fingerprint(self.root),
            "release": [fingerprint(k) for k in self.release],
            "widerrufen": [fingerprint(k) for k in self.revoked],
        }


def content_lines(text):
    """Zeilen ohne Kommentare (#) und ohne leere Zeilen, sonst unverändert."""
    return [z for z in text.split("\n") if z.strip() and not z.lstrip().startswith("#")]


def key_blob(key):
    """Bytes eines «ssh-ed25519 AAAA…»-Schlüssels, geprüft: Typ ssh-ed25519 und 32 Byte Schlüssel."""
    try:
        blob = base64.b64decode(key.split(" ", 1)[1], validate=True)
    except (IndexError, ValueError) as e:
        raise AnchorError(f"Schlüssel unlesbar: {short(key, 40)}") from e
    if len(blob) != 51 or blob[:15] != b"\x00\x00\x00\x0bssh-ed25519" or blob[15:19] != b"\x00\x00\x00\x20":
        raise AnchorError(f"Schlüssel unlesbar: {short(key, 40)}")
    return blob


def fingerprint(key):
    """SHA256-Fingerabdruck wie bei ssh-keygen -l."""
    blob = base64.b64decode(key.split(" ", 1)[1])
    return "SHA256:" + base64.b64encode(hashlib.sha256(blob).digest()).decode("ascii").rstrip("=")


def parse_anchor(texts):
    """Anker aus den Texten der vier Dateien (None: Datei fehlt). AnchorError mit empty=True, wenn keine Datei einen
    Eintrag hat."""
    lines = {n: content_lines(texts[n]) for n in ANCHOR_FILES if texts.get(n) is not None}
    if not any(lines.values()):
        raise AnchorError("ohne Schlüssel und ohne Serie", empty=True)
    for name in ANCHOR_FILES:
        if texts.get(name) is None:
            raise AnchorError(f"{name} fehlt")
    release, roots, revoked = [], [], []
    for target, name, pattern in ((release, "release", RELEASE_LINE), (roots, "wurzel", ROOT_LINE),
                                  (revoked, "widerrufen", REVOKED_LINE)):
        for line in lines[name]:
            m = pattern.fullmatch(line)
            if not m:
                raise AnchorError(f"{name} hat eine ungültige Zeile: {short(line, 50)}")
            key_blob(m.group(1))
            target.append(m.group(1))
    if not release:
        raise AnchorError("release enthält keinen Schlüssel")
    if len(set(roots)) != 1 or len(roots) != 1:
        raise AnchorError("wurzel muss genau einen Schlüssel enthalten")
    if len(lines["serie"]) != 1 or not SERIES_LINE.fullmatch(lines["serie"][0]):
        raise AnchorError("serie enthält keine Zahl von 1 bis 9999")
    root = roots[0]
    release = sorted(set(release))
    revoked = sorted(set(revoked))
    if root in release:
        raise AnchorError("Wurzel- und Release-Schlüssel müssen verschieden sein")
    if set(release) & set(revoked):
        raise AnchorError("ein Release-Schlüssel steht auch in widerrufen")
    if root in revoked:
        raise AnchorError("der Wurzel-Schlüssel steht in widerrufen")
    return Anchor(release, root, revoked, int(lines["serie"][0]))


def read_anchor_dir(folder, trusted):
    """Texte der vier Dateien aus FOLDER (None: fehlt). trusted: Besitz und Rechte wie für den Anker des Geräts."""
    if trusted:
        problem = path_problem(folder)
        if problem:
            raise AnchorError(f"Rechte: {problem}")
    texts = {}
    for name in ANCHOR_FILES:
        try:
            texts[name] = read_small(os.path.join(folder, name), trusted=trusted)
        except FileNotFoundError:
            texts[name] = None
        except Failure as e:
            raise AnchorError(f"Rechte: {e}" if trusted else str(e)) from e
    return texts


def load_device_anchor():
    if not os.path.lexists(ANCHOR_DIR):
        raise AnchorError(f"{ANCHOR_DIR} fehlt", empty=True)
    return parse_anchor(read_anchor_dir(ANCHOR_DIR, trusted=True))


def signer_files(anchor, folder):
    """Schreibt den geprüften Anker in der Form für git nach FOLDER: release, wurzel, widerrufen."""
    os.makedirs(folder, mode=0o700, exist_ok=True)
    files = {
        "release": "".join(f'{RELEASE_PRINCIPAL} namespaces="git" {k}\n' for k in anchor.release),
        "wurzel": f'{ROOT_PRINCIPAL} namespaces="git" {anchor.root}\n',
        "widerrufen": "".join(f"{k}\n" for k in anchor.revoked),
    }
    paths = {}
    for name, text in files.items():
        paths[name] = os.path.join(folder, name)
        write_atomic(paths[name], text, 0o600)
    return paths


def anchor_texts(anchor, origin):
    head = f"# zenOS-Vertrauensanker – geschrieben von zenos-kanal ({origin}). Format: docs/image-und-releases.md.\n"
    return {
        "release": head + "".join(f'{RELEASE_PRINCIPAL} namespaces="git" {k}\n' for k in anchor.release),
        "wurzel": head + f'{ROOT_PRINCIPAL} namespaces="git" {anchor.root}\n',
        "widerrufen": head + "".join(f"{k}\n" for k in anchor.revoked),
        "serie": head + f"{anchor.series}\n",
    }


def write_device_anchor(anchor, origin, with_root=False):
    """Schreibt den Anker des Geräts, jede Datei atomar: release, widerrufen, (wurzel), die Serie zuletzt. Bricht es
    dazwischen ab (Strom weg), bleibt ein gültiger Anker: Neue Release-Schlüssel stehen nie in widerrufen (trust_update,
    anchor_set), und widerrufen wächst nur. Zuerst widerrufen hiesse: Der alte Release-Schlüssel stünde in release und
    in widerrufen, der Anker gälte als fehlend und verarbeitete kein vertrauen/NNNN mehr."""
    os.makedirs(ANCHOR_DIR, mode=0o755, exist_ok=True)
    texts = anchor_texts(anchor, origin)
    names = ["release", "widerrufen", "serie"]
    if with_root:
        names.insert(2, "wurzel")
    for name in names:
        write_atomic(os.path.join(ANCHOR_DIR, name), texts[name], 0o644)


# --- Tags ------------------------------------------------------------------------------------------------------


def signature_key(raw):
    """(«ssh-ed25519 AAAA…» oder Typ, Namespace) aus der SSH-Signatur am Ende des Tags, None wenn unlesbar."""
    start = raw.find(SIG_BEGIN)
    end = raw.find(SIG_END, start)
    if start < 0 or end < 0:
        return None
    try:
        blob = base64.b64decode("".join(raw[start + len(SIG_BEGIN):end].split()), validate=True)
    except ValueError:
        return None

    def string(pos):
        if pos + 4 > len(blob):
            raise ValueError
        (n,) = struct.unpack(">I", blob[pos:pos + 4])
        if pos + 4 + n > len(blob):
            raise ValueError
        return blob[pos + 4:pos + 4 + n], pos + 4 + n

    try:
        # SSHSIG, Version (uint32), Schlüssel, Namespace, … (PROTOCOL.sshsig von OpenSSH)
        if blob[:6] != b"SSHSIG" or blob[6:10] != b"\x00\x00\x00\x01":
            return None
        public, pos = string(10)
        namespace, pos = string(pos)
        kind, _ = string_of(public)
    except ValueError:
        return None
    if kind == b"ssh-ed25519":
        key = "ssh-ed25519 " + base64.b64encode(public).decode("ascii")
    else:
        key = kind.decode("ascii", "replace")
    return key, namespace.decode("ascii", "replace")


def string_of(blob):
    """Erster SSH-String aus BLOB → (Bytes, Rest)."""
    if len(blob) < 4:
        raise ValueError
    (n,) = struct.unpack(">I", blob[:4])
    if 4 + n > len(blob):
        raise ValueError
    return blob[4:4 + n], blob[4 + n:]


class TagCheck:
    def __init__(self, name, oid, ok=False, reason="", commit=None, key=None):
        self.name = name
        self.oid = oid
        self.ok = ok
        self.reason = reason
        self.commit = commit
        self.key = key
        self.unchecked = False


class TagForm:
    """Form eines Tag-Objekts, unabhängig vom Ref-Namen und vom Anker. fields: die vier Kopfzeilen (None: Kopf
    unerwartet); reason: Grund aus Signatur und Inhalt (gilt nach den Feldern); key: Schlüssel der Signatur."""

    def __init__(self, fields=None, reason=None, key=None):
        self.fields = fields
        self.reason = reason
        self.key = key


def tag_form(raw):
    head, sep, _ = raw.partition("\n\n")
    fields = [z.split(" ", 1) for z in head.split("\n")]
    if not sep or [f[0] for f in fields] != ["object", "type", "tag", "tagger"] or any(len(f) != 2 for f in fields):
        return TagForm()
    form = TagForm(fields={f[0]: f[1] for f in fields})
    if "-----BEGIN PGP" in raw:
        form.reason = "OpenPGP-Signatur (nicht erlaubt)"
        return form
    if "-----BEGIN SIGNED MESSAGE-----" in raw:
        form.reason = "X.509-Signatur (nicht erlaubt)"
        return form
    count = raw.count(SIG_BEGIN)
    if count == 0:
        form.reason = "unsigniert"
        return form
    if count != 1 or raw.count(SIG_END) != 1 or not raw.rstrip("\n").endswith(SIG_END):
        form.reason = "mehr als eine Signatur"
        return form
    parsed = signature_key(raw)
    if not parsed:
        form.reason = "Signatur unlesbar"
        return form
    form.key, namespace = parsed
    if not form.key.startswith("ssh-ed25519 "):
        form.reason = f"Signatur mit {short(form.key, 30)} statt Ed25519"
    elif namespace != "git":
        form.reason = f"Signatur für «{short(namespace, 30)}» statt git"
    return form


def batch_check(repo, oids, work):
    """oid → (Typ, Grösse) für OIDS, ein Aufruf von git cat-file --batch-check (fehlende fehlen)."""
    result = {}
    if not oids:
        return result
    path = os.path.join(work, "batch-check")
    write_atomic(path, "".join(f"{o}\n" for o in oids), 0o600)
    with open(path, "rb") as f:
        r = git(repo, "cat-file", "--batch-check=%(objectname) %(objecttype) %(objectsize)", stdin=f)
    os.unlink(path)
    for line in r.stdout.split("\n"):
        parts = line.split(" ")
        if len(parts) == 3 and OID_RE.fullmatch(parts[0]) and parts[2].isdigit():
            result[parts[0]] = (parts[1], int(parts[2]))
    return result


def batch_forms(repo, oids, work):
    """oid → TagForm für die Tag-Objekte OIDS, ein Aufruf von git cat-file --batch, Objekt für Objekt gelesen."""
    forms = {}
    if not oids:
        return forms
    path = os.path.join(work, "batch")
    write_atomic(path, "".join(f"{o}\n" for o in oids), 0o600)
    with open(path, "rb") as f:
        proc = subprocess.Popen(git_argv(repo, "cat-file", "--batch"), stdin=f, stdout=subprocess.PIPE,
                                stderr=subprocess.DEVNULL, env=git_env(), cwd="/")
    try:
        for _ in oids:
            parts = proc.stdout.readline(200).split()
            if len(parts) == 2 and parts[1] == b"missing":
                continue
            if len(parts) != 3 or not parts[2].isdigit() or int(parts[2]) > MAX_TAG_SIZE:
                break
            data = proc.stdout.read(int(parts[2]) + 1)
            if len(data) != int(parts[2]) + 1:
                break
            forms[parts[0].decode("ascii", "replace")] = tag_form(data[:-1].decode("utf-8", "replace"))
    finally:
        proc.stdout.close()
        proc.kill()
        proc.wait()
        os.unlink(path)
    return forms


class TagCache:
    """Die Tag-Objekte vieler Namen mit drei Aufrufen von git cat-file statt zwei je Tag: so kosten auch tausende
    unsignierte oder leichte Tags auf origin kaum Zeit. Zu grosse Objekte (über MAX_TAG_SIZE) gelten als unlesbar."""

    def __init__(self, repo, oids, work):
        oids = sorted(set(oids))
        sizes = batch_check(repo, oids, work)
        wanted = [o for o in oids if sizes.get(o, ("", 0))[0] == "tag" and sizes[o][1] <= MAX_TAG_SIZE]
        self.forms = batch_forms(repo, wanted, work)
        targets = sorted({f.fields["object"] for f in self.forms.values()
                          if f.fields and OID_RE.fullmatch(f.fields["object"])})
        self.kinds = {o: v[0] for o, v in batch_check(repo, targets, work).items()}


class Budget:
    """Wie viele Signaturprüfungen (git verify-tag mit ssh-keygen) dieser Lauf noch macht."""

    def __init__(self, left):
        self.left = left


def inspect_tag(repo, name, oid, objtype, cache=None):
    """Formprüfung ohne Anker: TagCheck mit reason (abgelehnt) oder ohne (Signatur noch zu prüfen)."""
    result = TagCheck(name, oid)
    if objtype != "tag":
        result.reason = "kein annotierter Tag"
        return result
    if cache is not None:
        form = cache.forms.get(oid)
    else:
        r = git(repo, "cat-file", "tag", oid)
        form = tag_form(r.stdout) if r.returncode == 0 else None
    if form is None:
        result.reason = "Tag-Objekt nicht lesbar oder zu gross"
        return result
    if form.fields is None:
        result.reason = "Kopf des Tags unerwartet"
        return result
    values = form.fields
    if values["tag"] != name:
        result.reason = f"Feld «tag» ist «{short(values['tag'], 40)}», nicht «{name}»"
        return result
    if values["type"] != "commit":
        result.reason = "zeigt nicht auf einen Commit"
        return result
    commit = values["object"]
    if not OID_RE.fullmatch(commit):
        result.reason = "zeigt nicht auf einen Commit"
        return result
    kind = cache.kinds.get(commit) if cache is not None else git(repo, "cat-file", "-t", commit).stdout.strip()
    if kind != "commit":
        result.reason = "zeigt nicht auf einen Commit"
        return result
    result.commit = commit
    if form.reason:
        result.reason = form.reason
        return result
    result.key = form.key
    return result


def check_tag(repo, name, oid, objtype, anchor, files, principal, cache=None, budget=None):
    """Volle Prüfung gegen den Anker. principal: zenos-release (Releases) oder zenos-wurzel (vertrauen/NNNN). budget:
    Ist es aufgebraucht, bleibt der Tag ungeprüft (unchecked), statt git verify-tag zu starten."""
    result = inspect_tag(repo, name, oid, objtype, cache)
    if result.reason:
        return result
    allowed = anchor.release if principal == RELEASE_PRINCIPAL else [anchor.root]
    signers = files["release"] if principal == RELEASE_PRINCIPAL else files["wurzel"]
    if result.key in anchor.revoked:
        result.reason = f"Schlüssel widerrufen ({fingerprint(result.key)})"
        return result
    if result.key not in allowed:
        other = RELEASE_PRINCIPAL if principal == ROOT_PRINCIPAL else ROOT_PRINCIPAL
        if result.key in (anchor.release if other == RELEASE_PRINCIPAL else [anchor.root]):
            result.reason = f"mit dem falschen Schlüssel signiert ({other})"
        else:
            result.reason = f"fremder Schlüssel ({fingerprint(result.key)})"
        return result
    if budget is not None:
        if budget.left <= 0:
            result.unchecked = True
            result.reason = "ungeprüft (zu viele Tags auf origin)"
            return result
        budget.left -= 1
    r = git(repo, "-c", f"gpg.ssh.allowedSignersFile={signers}", "-c", f"gpg.ssh.revocationFile={files['widerrufen']}",
            "verify-tag", oid)
    expected = f'Good "git" signature for {principal} with ED25519 key {fingerprint(result.key)}'
    if r.returncode != 0 or expected not in r.stderr.splitlines():
        result.reason = "Signatur ungültig"
        return result
    result.ok = True
    return result


# --- Holen (ohne Rechte) ---------------------------------------------------------------------------------------


def url_allowed(url):
    for scheme in ALLOWED_SCHEMES:
        if scheme == "https" and HTTPS_RE.fullmatch(url) and ".." not in url:
            return True
        if scheme == "file" and FILE_RE.fullmatch(url):
            return True
    return False


def origin_url():
    r = run([GIT, *git_hardening(), "config", "--file", os.path.join(CODE_DIR, ".git", "config"), "--get",
             "remote.origin.url"], env=git_env())
    url = r.stdout.strip()
    if r.returncode != 0 or not url:
        raise Failure(f"keine Adresse für origin in {CODE_DIR}")
    if not url_allowed(url):
        raise Failure(f"Adresse von origin nicht erlaubt (nur {', '.join(ALLOWED_SCHEMES)}, ohne Zugangsdaten)")
    return url


def init_repo(path):
    """Leeres blankes Repo ohne Vorlage (keine Hooks), config fest wie REPO_CONFIG."""
    shutil.rmtree(path, ignore_errors=True)
    r = git(None, "init", "--quiet", "--bare", "--template=", path)
    if r.returncode != 0:
        raise Failure(f"git init {path}: {first_line(r.stderr)}")
    write_atomic(os.path.join(path, "config"), REPO_CONFIG, 0o644)


def fetch_status_write(folder, data):
    write_json(os.path.join(folder, "holen.json"), data)


def tree_size(path):
    total = 0
    for root, _dirs, files in os.walk(path):
        for name in files:
            with contextlib.suppress(OSError):
                total += os.lstat(os.path.join(root, name)).st_size
    return total


def mirror_tidy(mirror):
    """Nach dem Holen: Refs ausser dev und v* entfernen (Reste älterer Fassungen), dann alles packen, was nicht mehr
    erreichbar ist, löschen (git setzt sonst nie etwas frei: gc.auto=0). Liste der Refs, None wenn der Spiegel danach
    grösser als MAX_MIRROR ist."""
    refs = []
    for ref in git(mirror, "for-each-ref", "--format=%(refname)", "refs/").stdout.split("\n"):
        if not ref:
            continue
        if ref == "refs/kanal/heads/dev" or ref.startswith("refs/kanal/tags/v"):
            refs.append(ref)
        else:
            git(mirror, "update-ref", "-d", ref)
    git(mirror, "repack", "-a", "-d", "-q")
    git(mirror, "prune", "--expire=now")
    return refs if tree_size(mirror) <= MAX_MIRROR else None


def cmd_fetch_internal(argv):
    if argv:
        print(f"{NAME} holen-intern: keine Argumente erwartet", file=sys.stderr)
        return EXIT_USAGE
    os.umask(0o022)
    folder = FETCH_DIR
    os.makedirs(folder, exist_ok=True)
    before = load_json(os.path.join(folder, "holen.json")) or {}
    status = {"version": 1, "versuch": iso(now()), "ok": False, "fehler": None,
              "letzter_erfolg": before.get("letzter_erfolg") if parse_iso(before.get("letzter_erfolg")) else None,
              "refs": None}
    try:
        url = origin_url()
    except Failure as e:
        status["fehler"] = str(e)
        fetch_status_write(folder, status)
        print(f"{NAME}: {e}", file=sys.stderr)
        return EXIT_ERROR

    mirror = os.path.join(folder, "spiegel.git")
    try:
        with open(os.path.join(mirror, "config"), encoding="utf-8") as f:
            fresh = f.read() != REPO_CONFIG
    except OSError:
        fresh = True
    if fresh:
        init_repo(mirror)
    protocols = []
    for scheme in ALLOWED_SCHEMES:
        protocols += ["-c", f"protocol.{scheme}.allow=always"]
    network = [*protocols, "-c", "http.lowSpeedLimit=1000", "-c", "http.lowSpeedTime=60", "-c", "credential.helper="]
    # Nur, was der Kanal braucht: die Tags v* (Versionen und vertrauen/NNNN) und den Branch dev, keine anderen
    # Branches (ein fremder Branch voller Daten füllte sonst Platte und Bundle). Ob es dev gibt, sagt ls-remote vorher:
    # Ein fehlender Branch in der Liste liesse git fetch scheitern.
    r = git(None, *network, "ls-remote", "--heads", url, "refs/heads/dev", timeout=FETCH_TIMEOUT)
    if r.returncode == 0:
        specs = ["+refs/tags/v*:refs/kanal/tags/v*"]
        if any(z.endswith("\trefs/heads/dev") for z in r.stdout.split("\n")):
            specs.append("+refs/heads/dev:refs/kanal/heads/dev")
        r = git(mirror, *network, "-c", "transfer.fsckObjects=true", "-c", "fetch.fsckObjects=true",
                "fetch", "--quiet", "--no-tags", "--prune", "--no-write-fetch-head", "--no-recurse-submodules", url,
                *specs, timeout=FETCH_TIMEOUT)
    if r.returncode != 0:
        # Beim nächsten Mal mit einem frischen Spiegel: ein halber oder kaputter bleibt nicht liegen
        shutil.rmtree(mirror, ignore_errors=True)
        status["fehler"] = first_line(r.stderr) or f"git fetch Exit {r.returncode}"
        fetch_status_write(folder, status)
        print(f"{NAME}: Holen von origin gescheitert: {status['fehler']}", file=sys.stderr)
        return EXIT_NO_CONTACT

    refs = mirror_tidy(mirror)
    if refs is None:
        shutil.rmtree(mirror, ignore_errors=True)
        status["fehler"] = f"Der Stand von origin ist grösser als {MAX_MIRROR >> 20} MB"
        fetch_status_write(folder, status)
        print(f"{NAME}: {status['fehler']}", file=sys.stderr)
        return EXIT_ERROR
    bundle = os.path.join(folder, "uebergabe.bundle")
    tmp = bundle + ".neu"
    for path in (tmp,) if refs else (tmp, bundle):
        try:
            os.unlink(path)
        except FileNotFoundError:
            pass
    if refs:
        r = git(mirror, "bundle", "create", tmp, "--all")
        if r.returncode != 0:
            status["fehler"] = f"Bundle: {first_line(r.stderr)}"
            fetch_status_write(folder, status)
            print(f"{NAME}: {status['fehler']}", file=sys.stderr)
            return EXIT_ERROR
        os.chmod(tmp, 0o644)
        os.replace(tmp, bundle)
    status.update(ok=True, letzter_erfolg=status["versuch"], refs=len(refs), leer=not refs)
    fetch_status_write(folder, status)
    print(f"{NAME}: geholt, {len(refs)} Refs")
    return EXIT_OK


# --- Prüfen (root, ohne Netz) ----------------------------------------------------------------------------------


def lock_dir(path):
    """Ordner der Sperre PATH: legt ihn an (0700), prüft ihn (root, kein Verweis, nur für root zugänglich). Failure,
    wenn er nicht sicher ist."""
    folder = os.path.dirname(path)
    with contextlib.suppress(FileExistsError):
        os.mkdir(folder, 0o700)
    problem = path_problem(folder)
    if problem:
        raise Failure(f"Ordner der Sperren unsicher: {problem}")
    if os.lstat(folder).st_mode & 0o077:
        os.chmod(folder, 0o700)
    return folder


def take_lock(path=None):
    """Sperre PATH (Standard /run/zenos-sperre/kanal.lock: Prüfen, Installieren, Anker, Lauf von Hand). None, wenn sie
    belegt ist; Failure, wenn Ordner oder Datei nicht sicher sind. Ordner und Datei gehören root und sind für andere
    nicht zugänglich: Sonst könnte jeder Benutzer die Sperre halten (flock geht auch auf einer nur lesbaren Datei)."""
    path = path or LOCK_FILE
    lock_dir(path)
    try:
        fd = os.open(path, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | getattr(os, "O_CLOEXEC", 0), 0o600)
    except OSError as e:
        raise Failure(f"Sperre {path}: {e.strerror}") from e
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_uid not in TRUSTED_UIDS:
            raise Failure(f"Sperre {path} gehört nicht root")
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        os.close(fd)
        return None
    except BaseException:
        os.close(fd)
        raise
    return fd


def lock_holder(path):
    """«PID n (Name)» des Prozesses, der die flock-Sperre PATH hält (aus /proc/locks), sonst ""."""
    try:
        st = os.stat(path)
        with open(os.path.join(PROC, "locks"), encoding="ascii", errors="replace") as f:
            lines = f.read(1 << 20).split("\n")
    except OSError:
        return ""
    for line in lines:
        parts = line.split()
        # «1: FLOCK  ADVISORY  WRITE 1234 00:1a:5678 0 EOF»; Wartende stehen mit «->» darunter
        if len(parts) < 6 or parts[1] != "FLOCK" or not parts[4].isdigit():
            continue
        ident = parts[5].split(":")
        try:
            same = (len(ident) == 3 and int(ident[0], 16) == os.major(st.st_dev)
                    and int(ident[1], 16) == os.minor(st.st_dev) and int(ident[2]) == st.st_ino)
        except ValueError:
            continue
        if same:
            try:
                with open(os.path.join(PROC, parts[4], "comm"), encoding="utf-8", errors="replace") as f:
                    return f"PID {parts[4]} ({short(f.read(64).strip(), 30)})"
            except OSError:
                return f"PID {parts[4]}"
    return ""


def busy_text(path):
    holder = lock_holder(path)
    return f"Ein Update oder eine Prüfung läuft gerade{f' ({holder})' if holder else ''}. Später noch einmal."


def hand_run():
    """PID eines laufenden install.sh von Hand (Vermerk HAND_MARK), sonst None. Den Vermerk schreibt nur root (der
    Ordner ist nur für root); er gilt nur, solange der Prozess lebt und install.sh ist."""
    try:
        text = read_small(HAND_MARK, trusted=True, limit=64)
    except (FileNotFoundError, Failure):
        return None
    pid = text.strip()
    if not re.fullmatch(r"[1-9][0-9]{0,9}", pid):
        return None
    try:
        with open(os.path.join(PROC, pid, "cmdline"), "rb") as f:
            argv = f.read(1 << 16).split(b"\0")
    except OSError:
        return None
    return int(pid) if any(a.endswith(b"/install.sh") or a == b"install.sh" for a in argv) else None


class Locked:
    """Eine gehaltene Sperre (Dateideskriptor)."""

    def __init__(self, fd):
        self.fd = fd

    def release(self):
        if self.fd is not None:
            os.close(self.fd)
            self.fd = None


def lock_or_exit(path=None, quiet=False):
    """Locked, sonst den Exit-Code mit Meldung: 75, wenn die Sperre belegt ist, 1, wenn sie nicht sicher ist."""
    path = path or LOCK_FILE
    try:
        fd = take_lock(path)
    except Failure as e:
        print(f"{NAME}: {e}", file=sys.stderr)
        return EXIT_ERROR
    if fd is None:
        if not quiet:
            print(f"{NAME}: {busy_text(path)}", file=sys.stderr)
        return EXIT_BUSY
    return Locked(fd)


def hand_text(pid):
    return (f"Ein install.sh von Hand läuft gerade (PID {pid}). Erst wenn es fertig ist, installiert der Kanal wieder; "
            "danach noch einmal.")


def read_channel():
    """(Kanal, Hinweis) aus /etc/xdg/zenos/kanal; Failure bei einem unbekannten Wert."""
    try:
        text = read_small(CHANNEL_FILE)
    except FileNotFoundError:
        return "dev", f"{CHANNEL_FILE} fehlt, es gilt dev"
    except Failure as e:
        raise Failure(f"Kanal nicht lesbar: {e}") from e
    raw = text.split("\n", 1)[0].strip()
    if raw == "main":
        return "stabil", "Kanal main gilt als stabil"
    if raw == "":
        return "dev", f"{CHANNEL_FILE} ist leer, es gilt dev"
    if raw not in CHANNELS:
        raise Failure(f"Kanal «{short(raw, 30)}» in {CHANNEL_FILE} ist unbekannt (erlaubt: stabil, vorschau, dev)")
    return raw, None


def clock_minutes(text):
    """Minuten seit Mitternacht aus «HH:MM» (streng: zwei Stellen, 00:00 bis 23:59), sonst None."""
    m = CLOCK_RE.fullmatch(text) if isinstance(text, str) else None
    return int(m.group(1)) * 60 + int(m.group(2)) if m else None


def window_problem(start, end):
    """Grund, warum das Zeitfenster START–END nicht gilt, sonst None. Über Mitternacht ist erlaubt (22:00–06:00)."""
    a, b = clock_minutes(start), clock_minutes(end)
    if a is None or b is None:
        return "Uhrzeiten als HH:MM, etwa 02:00"
    if (b - a) % 1440 < MIN_WINDOW_MINUTES:
        return f"Das Zeitfenster muss mindestens {MIN_WINDOW_MINUTES} Minuten lang sein"
    return None


def parse_schedule(text):
    """(Zeitpunkt, Problem) aus dem Inhalt von kanal-zeitpunkt. Zeitpunkt: {"art", "von", "bis"} (von und bis nur bei
    «fenster»). Zeilen «schluessel=wert», die letzte gilt, Kommentare (#) und andere Schlüssel zählen nicht. Ist etwas
    ungültig, gilt der Standard «sperre», und Problem nennt den Grund."""
    values = {}
    for line in text.split("\n"):
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        if "=" not in line:
            return {"art": SCHEDULE_DEFAULT}, f"Zeile «{short(line, 30)}» ist kein «schluessel=wert»"
        key, value = (part.strip() for part in line.split("=", 1))
        if key in ("zeitpunkt", "von", "bis"):
            values[key] = value
    art = values.get("zeitpunkt")
    if art not in SCHEDULES:
        return {"art": SCHEDULE_DEFAULT}, f"Zeitpunkt «{short(art or '', 20)}» ist unbekannt"
    if art != "fenster":
        return {"art": art}, None
    problem = window_problem(values.get("von"), values.get("bis"))
    if problem:
        return {"art": SCHEDULE_DEFAULT}, problem
    return {"art": art, "von": values["von"], "bis": values["bis"]}, None


def read_schedule():
    """(Zeitpunkt, Hinweis) aus SCHEDULE_FILE (root-eigen, für andere nicht schreibbar). Fehlt die Datei: «sperre»
    ohne Hinweis. Ist sie unlesbar, unsicher oder ungültig: «sperre» mit Hinweis (die vorsichtigste Wahl)."""
    try:
        text = read_small(SCHEDULE_FILE, trusted=True, limit=4096)
    except FileNotFoundError:
        return {"art": SCHEDULE_DEFAULT}, None
    except Failure as e:
        return {"art": SCHEDULE_DEFAULT}, f"Zeitpunkt nicht lesbar ({e}), es gilt «{SCHEDULE_DEFAULT}»"
    schedule, problem = parse_schedule(text)
    if problem:
        return schedule, f"{SCHEDULE_FILE}: {problem}, es gilt «{SCHEDULE_DEFAULT}»"
    return schedule, None


def schedule_text(schedule):
    art = schedule.get("art")
    if art == "fenster":
        return f"zwischen {schedule['von']} und {schedule['bis']}"
    return {"sperre": "nur gesperrt oder ohne Anmeldung", "jederzeit": "jederzeit",
            "hand": "von Hand (nur die Mitteilung «Update bereit»)"}.get(art, str(art))


def schedule_file_text(schedule, via):
    """Inhalt von kanal-zeitpunkt. «ueber» (pkexec oder sudo mit uid) zeigt die Oberfläche in der Mitteilung, wenn sich
    der Zeitpunkt ändert, ohne dass sie es selbst war."""
    lines = ["# zenOS: Zeitpunkt automatischer Updates (zenos-kanal zeitpunkt). Nicht von Hand ändern: Einstellungen ›",
             "# System › Updates oder «sudo zen kanal zeitpunkt». Ohne diese Datei gilt «sperre».",
             f"zeitpunkt={schedule['art']}"]
    if schedule["art"] == "fenster":
        lines += [f"von={schedule['von']}", f"bis={schedule['bis']}"]
    lines += [f"seit={iso(now())}", f"ueber={via}"]
    return "\n".join(lines) + "\n"


def caller_text():
    """Wer root gerufen hat: «pkexec, uid N», «sudo, uid N» oder «root» (die Variablen setzen pkexec bzw. sudo)."""
    if str(os.environ.get("PKEXEC_UID", "")).isdigit():
        return f"pkexec, uid {os.environ['PKEXEC_UID']}"
    if str(os.environ.get("SUDO_UID", "")).isdigit():
        return f"sudo, uid {os.environ['SUDO_UID']}"
    return "root"


def cmd_schedule(argv):
    """zeitpunkt: zeigen (ohne Rechte) oder setzen (root, nur feste Wörter, Uhrzeiten streng geprüft)."""
    usage = f"{NAME} zeitpunkt [sperre|fenster VON BIS|jederzeit|hand] (VON und BIS als HH:MM)"
    if not argv:
        schedule, note = read_schedule()
        print(f"Zeitpunkt: {schedule['art']}" + (f" {schedule['von']}-{schedule['bis']}" if schedule["art"] == "fenster"
                                                 else "") + f" · {schedule_text(schedule)}")
        if note:
            print(f"  Hinweis: {note}")
        return EXIT_OK
    art = argv[0]
    if art not in SCHEDULES or (art == "fenster") != (len(argv) == 3) or (art != "fenster" and len(argv) != 1):
        print(usage, file=sys.stderr)
        return EXIT_USAGE
    schedule = {"art": art}
    if art == "fenster":
        problem = window_problem(argv[1], argv[2])
        if problem:
            print(f"{NAME} zeitpunkt: {problem}.", file=sys.stderr)
            return EXIT_USAGE
        schedule.update(von=argv[1], bis=argv[2])
    if os.geteuid() not in TRUSTED_UIDS:
        print(f"{NAME} zeitpunkt: Setzen nur als root (Einstellungen › System › Updates oder sudo zen kanal zeitpunkt)",
              file=sys.stderr)
        return EXIT_USAGE
    os.umask(0o022)
    folder = os.path.dirname(SCHEDULE_FILE)
    os.makedirs(folder, mode=0o755, exist_ok=True)
    problem = path_problem(folder)
    if problem:
        print(f"{NAME} zeitpunkt: {problem}. Nichts geändert.", file=sys.stderr)
        return EXIT_BLOCKED
    before, problem = read_schedule()
    if before == schedule and os.path.lexists(SCHEDULE_FILE) and not problem:
        print(f"Zeitpunkt: schon {schedule_text(schedule)}.")
        return EXIT_OK
    # Auch eine ungültige Datei (es galt «sperre») wird so ersetzt, selbst wenn die Wahl «sperre» ist
    via = caller_text()
    write_atomic(SCHEDULE_FILE, schedule_file_text(schedule, via))
    journal(f"Zeitpunkt: {schedule_text(schedule)}, vorher {schedule_text(before)} ({via})")
    print(f"Zeitpunkt: {schedule_text(schedule)}.")
    return EXIT_OK


def read_fetch_status():
    """Zeitpunkt des letzten erfolgreichen Holens und Fehler des letzten Versuchs, nur zur Anzeige (der Holer
    schreibt die Datei, root glaubt ihr nichts weiter)."""
    data = load_json(os.path.join(FETCH_DIR, "holen.json")) or {}
    error = data.get("fehler")
    return {
        "letzter_kontakt": data.get("letzter_erfolg") if parse_iso(data.get("letzter_erfolg")) else None,
        "fehler": short(error, 160) if isinstance(error, str) and error and data.get("ok") is not True else None,
        "leer": data.get("leer") is True and data.get("ok") is True,
    }


def copy_bundle(target):
    """Kopiert das Bundle des Holers nach TARGET (root-eigen). False, wenn es keines gibt."""
    source = os.path.join(FETCH_DIR, "uebergabe.bundle")
    try:
        fd = os.open(source, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | getattr(os, "O_CLOEXEC", 0))
    except FileNotFoundError:
        return False
    except OSError as e:
        raise Failure(f"Bundle nicht lesbar: {e.strerror}") from e
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_nlink != 1:
            raise Failure("Bundle ist keine einfache Datei")
        if st.st_size > MAX_BUNDLE:
            raise Failure("Bundle ist zu gross")
        out = os.open(target, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
        try:
            total = 0
            while True:
                chunk = os.read(fd, 1 << 20)
                if not chunk:
                    break
                total += len(chunk)
                if total > MAX_BUNDLE:
                    raise Failure("Bundle ist zu gross")
                while chunk:
                    chunk = chunk[os.write(out, chunk):]
        finally:
            os.close(out)
    finally:
        os.close(fd)
    return True


def is_ancestor(repo, older, newer):
    """True/False, None wenn git es nicht sagen kann."""
    r = git(repo, "merge-base", "--is-ancestor", older, newer)
    if r.returncode == 0:
        return True
    if r.returncode == 1:
        return False
    return None


def has_commit(repo, oid):
    return git(repo, "cat-file", "-e", f"{oid}^{{commit}}").returncode == 0


def installed_commit():
    if not os.path.isdir(os.path.join(CODE_DIR, ".git")):
        return None
    r = git(CODE_DIR, "rev-parse", "--verify", "--quiet", "HEAD^{commit}")
    oid = r.stdout.strip()
    return oid if r.returncode == 0 and OID_RE.fullmatch(oid) else None


def code_history_usable():
    """Taugt /opt/zenos, um Vorfahren zu prüfen? Nicht flach und kein Teilklon (sonst fehlen Commits zu Recht)."""
    r = git(CODE_DIR, "rev-parse", "--is-shallow-repository")
    if r.returncode != 0 or r.stdout.strip() != "false":
        return False
    return git(CODE_DIR, "config", "--get", "extensions.partialclone").stdout.strip() == ""


class Waiting(Exception):
    """Es fehlt etwas, das sich von selbst geben kann (Platz): Exit 10, nichts geändert."""


class Refusal(Exception):
    """Ein Wunsch lässt sich nicht erfüllen (abgelehnt, Exit 3)."""


class Current(Exception):
    """Nichts zu tun."""


def write_wish(art, tag=None, ja=None, only_signed=False, target=None):
    """Wunsch von zen update oder zen rollback (bzw. der Automatik, art «automatik») für den nächsten Lauf von
    «pruefen»; gibt seine Kennung zurück. only_signed («Zustimmen …» in den Einstellungen): Das «ja» gilt nur für ein
    gültig signiertes Ziel. target («Jetzt installieren»): Tag-Objekt bzw. Commit, den die Einstellungen zeigten;
    nennt die Prüfung ein anderes Ziel, geschieht nichts."""
    wish_id = secrets.token_hex(8)
    os.makedirs(STATE_DIR, mode=0o755, exist_ok=True)
    write_json(state_path("wunsch.json"), {"version": 1, "id": wish_id, "art": art, "tag": tag, "ja": ja,
                                           "nur_signiert": bool(only_signed), "ziel": target, **stamp()}, 0o600)
    return wish_id


def take_wish(t):
    """Liest und entfernt wunsch.json. None, wenn es keinen gültigen, frischen Wunsch gibt (höchstens eine Stunde alt,
    gemessen seit dem Start: Stellt NTP die Uhr dazwischen, gilt er trotzdem)."""
    path = state_path("wunsch.json")
    data = load_json(path, trusted=True)
    if os.path.lexists(path):
        os.unlink(path)
    if not data or data.get("version") != 1 or not WISH_ID_RE.fullmatch(str(data.get("id"))):
        return None
    if not fresh(data, t):
        return None
    art, tag, ja, target = data.get("art"), data.get("tag"), data.get("ja"), data.get("ziel")
    if art not in ("update", "rollback", "automatik") or (ja is not None and not OID_RE.fullmatch(str(ja))):
        return None
    if target is not None and not OID_RE.fullmatch(str(target)):
        return None
    if art == "automatik" and ja is not None:
        return None  # Die Automatik stimmt nie zu
    if art == "rollback" and not TAG_NAME_RE.fullmatch(str(tag)):
        return None
    # Fehlt das Feld, kommt der Wunsch von zen update (älteres Format); ein unklarer Wert gilt als das strengere
    only_signed = "nur_signiert" in data and data["nur_signiert"] is not False
    return {"id": data["id"], "art": art, "tag": tag if art == "rollback" else None, "ja": ja,
            "nur_signiert": only_signed, "ziel": target}


def consent_patterns(repo, commits):
    """Rückfrage-Muster: CONSENT_PATHS, dazu die Gruppen firewall, netz und boot aus scripts/lib/sensible-pfade der
    genannten Commits (sie kommen nur dazu)."""
    patterns = set(CONSENT_PATHS)
    for commit in commits:
        r = git(repo, "cat-file", "blob", f"{commit}:scripts/lib/sensible-pfade")
        if r.returncode != 0:
            continue
        for line in r.stdout.split("\n"):
            parts = line.split()
            if len(parts) == 2 and parts[0] in CONSENT_GROUPS and PATTERN_RE.fullmatch(parts[1]):
                patterns.add(parts[1])
    return sorted(patterns)


def consent_hits(repo, old, new):
    """Geänderte Rückfrage-Pfade von OLD nach NEW (sortierte Liste). None, wenn sich das nicht feststellen lässt (dann
    gilt: Zustimmung nötig)."""
    if not old or not repo or not has_commit(repo, old) or not has_commit(repo, new):
        return None
    if old == new:
        return []
    r = git(repo, "diff", "--name-only", "--no-renames", "-z", old, new, "--", *consent_patterns(repo, (old, new)))
    if r.returncode != 0:
        return None
    return sorted(p for p in r.stdout.split("\0") if p)


def free_space_problem(paths):
    """Text, wenn auf dem Dateisystem eines Pfads weniger als MIN_FREE frei ist, sonst None."""
    for path in paths:
        probe = os.path.abspath(path)
        while not os.path.exists(probe) and probe != "/":
            probe = os.path.dirname(probe)
        try:
            st = os.statvfs(probe)
        except OSError:
            continue
        free = st.f_bavail * st.f_frsize
        if free < MIN_FREE:
            return (f"Nur {free >> 20} MB frei unter {probe}, gebraucht wird mindestens {MIN_FREE >> 20} MB. "
                    "Zuerst Platz schaffen.")
    return None


def install_space_paths():
    return (state_path("bereit"), CODE_DIR, *SPACE_PATHS)


def repo_intact(folder, commit):
    """Ist FOLDER eine sichere Bereitstellung von COMMIT? Root-eigen bis oben, HEAD gleich COMMIT, Baum sauber (auch ohne
    unversionierte oder ignorierte Dateien)."""
    if path_problem(folder) or not os.path.isdir(os.path.join(folder, ".git")):
        return False
    r = git(folder, "rev-parse", "--verify", "--quiet", "HEAD^{commit}")
    if r.returncode != 0 or r.stdout.strip() != commit:
        return False
    r = git(folder, "status", "--porcelain", "--ignored", "--untracked-files=all")
    return r.returncode == 0 and r.stdout == ""


def stage(source, refspecs, commit, branch, origin):
    """Stellt COMMIT in bereit/<commit> bereit: eigenes Repo ohne Hooks, Objekte und Refs per REFSPECS aus SOURCE (ohne
    Netz), ausgecheckt auf BRANCH oder losgelöst, origin auf ORIGIN. Immer neu: Eine ältere Bereitstellung desselben
    Commits (etwa von dev) hätte andere Refs, etwa den Tag nicht, den das Installieren nachprüft. Waiting bei zu wenig
    Platz, Failure bei Fehlern."""
    folder = state_path("bereit", commit)
    if DRY_RUN:
        return folder
    problem = free_space_problem(install_space_paths())
    if problem:
        raise Waiting(problem)
    os.makedirs(state_path("bereit"), mode=0o755, exist_ok=True)
    tmp = state_path("bereit", f".{commit}.neu")
    shutil.rmtree(tmp, ignore_errors=True)
    steps = [
        (None, "init", "--quiet", "--template=", tmp),
        (tmp, "-c", "protocol.file.allow=always", "fetch", "--quiet", "--no-tags", "--no-write-fetch-head",
         "--no-recurse-submodules", source, *refspecs),
        (tmp, "checkout", "--quiet", "-B", branch, commit) if branch else (tmp, "checkout", "--quiet", "--detach",
                                                                           commit),
    ]
    if origin:
        steps.append((tmp, "remote", "add", "origin", origin))
    try:
        for repo, *args in steps:
            r = git(repo, *args)
            if r.returncode != 0:
                raise Failure(f"Bereitstellen ({args[0] if args[0] != '-c' else args[2]}): {first_line(r.stderr)}")
        os.chmod(tmp, 0o755)
        if not repo_intact(tmp, commit):
            raise Failure("Bereitstellung stimmt nach dem Auschecken nicht mit dem Commit überein")
        shutil.rmtree(folder, ignore_errors=True)
        os.replace(tmp, folder)
    finally:
        shutil.rmtree(tmp, ignore_errors=True)
    return folder


def locked_entries():
    """Gesperrte Ziele: Name (Version oder Commit) → Eintrag (grund, zeit)."""
    folder = state_path("gesperrt")
    entries = {}
    try:
        names = os.listdir(folder)
    except OSError:
        return entries
    for name in names:
        if version_key(name) or OID_RE.fullmatch(name):
            entries[name] = load_json(os.path.join(folder, name)) or {}
    return entries


def lock_target(entry, reason):
    """Sperrt ein gescheitertes Ziel: Versionen unter ihrem Namen, alles andere unter dem Commit."""
    name = entry.get("version") if version_key(entry.get("version") or "") else entry["commit"]
    os.makedirs(state_path("gesperrt"), mode=0o755, exist_ok=True)
    write_json(state_path("gesperrt", name), {"commit": entry["commit"], "grund": short(reason, 300), "zeit": iso(now())})
    return name


def target_label(entry):
    if not entry:
        return "?"
    commit = str(entry.get("commit") or "")[:12]
    if entry.get("tag"):
        return f"{entry['tag']} ({commit})"
    if entry.get("zweig"):
        return f"{entry['zweig']} {commit}"
    return commit


class Check:
    """Ein Lauf von «pruefen». Schreibt den Anker (nur über gültige vertrauen/NNNN), gesehen.json, hoechste und
    stand.json. Mit einem Wunsch (wunsch.json von zen update oder zen rollback) stellt es das Ziel bereit
    (bereit/<commit>, auftrag.json). Installiert nichts."""

    def __init__(self):
        self.t = now()
        self.notes = []
        self.rejected = []
        self.rejected_more = 0
        self.have_bundle = False
        self.contact = None
        self.ledger_changed = False
        self.wish = None
        self.repo = None
        self.refs = None
        self.installed = None
        self.anchor = None
        self.files = None
        self.valid = {}
        self.ledger = {}
        self.floor_value = None
        self.channel = None
        # Uhr synchronisiert? (einmal je Lauf; «erstmals» entsteht nur so)
        self.synced = None
        self.stand = {
            "version": 1,
            "kanal": None,
            "zustand": None,
            "grund": "",
            "geprueft": iso(self.t),
            "letzter_kontakt": None,
            "holen_fehler": None,
            "anker": None,
            "anker_problem": None,
            "installiert": None,
            "hoechste": None,
            "bereit": None,
            "dev": None,
            "gueltig": [],
            "abgelehnt": self.rejected,
            "hinweise": self.notes,
            "wunsch": None,
            "installation": installation_marks(),
            "uhr_synchron": None,
            "automatik": {"an": not automatic_off()},
            "unbestaetigt": unconfirmed_summary(),
            "zurueckgestellt": hold_summary(),
            "angehalten": hand_held_summary(),
            # Lage der Installation wie «zen kanal status --installation» (unterbrochen, kaputt, angehalten, zurueck,
            # gescheitert, fehler, unbestaetigt, gut, keine): Die Oberfläche zeigt «kaputt» und Co. auch dann noch,
            # wenn diese Prüfung jünger ist als letzte.json
            "installation_lage": installation_state(),
        }

    # -- Zustand auf der Platte --

    def load_ledger(self):
        data = load_json(os.path.join(STATE_DIR, "gesehen.json"), trusted=True)
        if data is None:
            if os.path.lexists(os.path.join(STATE_DIR, "gesehen.json")):
                self.notes.append("gesehen.json war unlesbar und wird neu angelegt")
            return {}
        tags = data.get("tags")
        ledger = {}
        if isinstance(tags, dict):
            for name, entry in tags.items():
                # Nur gültige Namen zählen (ältere Fassungen führten auch ungültige)
                if (isinstance(entry, dict) and isinstance(name, str) and OID_RE.fullmatch(str(entry.get("objekt")))
                        and entry.get("gueltig") is True):
                    commit = entry.get("commit")
                    seen = entry.get("erstmals_start")
                    ledger[name] = {"objekt": entry["objekt"], "gueltig": True,
                                    "erstmals": entry.get("erstmals") if parse_iso(entry.get("erstmals")) else None,
                                    "erstmals_start": seen if valid_start_stamp(seen) else None,
                                    "commit": commit if OID_RE.fullmatch(str(commit)) else None}
        return ledger

    def load_floor(self):
        try:
            text = read_small(os.path.join(STATE_DIR, "hoechste"), trusted=True)
        except FileNotFoundError:
            return None
        except Failure as e:
            self.notes.append(f"hoechste nicht lesbar ({e}), wird neu bestimmt")
            return None
        lines = content_lines(text)
        if len(lines) == 1 and version_key(lines[0].strip()):
            return lines[0].strip()
        self.notes.append("hoechste ist ungültig und wird neu bestimmt")
        return None

    def locked_versions(self):
        folder = os.path.join(STATE_DIR, "gesperrt")
        try:
            return {n for n in os.listdir(folder) if version_key(n)}
        except OSError:
            return set()

    # -- Ablauf --

    def run(self):
        os.makedirs(STATE_DIR, mode=0o755, exist_ok=True)
        problem = path_problem(STATE_DIR)
        if problem:
            raise Failure(f"Zustand unsicher: {problem}")
        self.wish = take_wish(self.t)
        self.synced = clock_synced()
        self.stand["uhr_synchron"] = self.synced
        code = self.check()
        if self.wish:
            code = self.fulfil(code)
        return code

    def check(self):
        contact = read_fetch_status()
        self.contact = contact
        self.stand["letzter_kontakt"] = contact["letzter_kontakt"]
        self.stand["holen_fehler"] = contact["fehler"]

        anchor = None
        try:
            anchor = load_device_anchor()
            self.stand["anker"] = anchor.summary()
        except AnchorError as e:
            self.stand["anker_problem"] = e.reason

        try:
            channel, note = read_channel()
        except Failure as e:
            return self.finish("blockiert", str(e), EXIT_BLOCKED)
        self.stand["kanal"] = channel
        self.channel = channel
        if note:
            self.notes.append(note)

        work = os.path.join(STATE_DIR, "arbeit")
        shutil.rmtree(work, ignore_errors=True)
        os.makedirs(work, mode=0o700)
        os.chmod(work, 0o700)
        self.repo = os.path.join(work, "repo.git")
        init_repo(self.repo)
        bundle = os.path.join(work, "eingang.bundle")
        have_bundle = copy_bundle(bundle)
        self.have_bundle = have_bundle
        if have_bundle:
            r = git(self.repo, "-c", "protocol.file.allow=always", "-c", "transfer.fsckObjects=true",
                    "-c", "fetch.fsckObjects=true", "fetch", "--quiet", "--no-tags", "--no-write-fetch-head",
                    "--no-recurse-submodules", bundle, "+refs/kanal/*:refs/eingang/*")
            os.unlink(bundle)
            if r.returncode != 0:
                return self.finish("blockiert", f"Das Bundle des Holers ist unbrauchbar: {first_line(r.stderr)}",
                                   EXIT_BLOCKED)

        refs = self.read_refs()
        self.refs = refs
        installed = installed_commit()
        self.installed = installed
        self.stand["installiert"] = {"commit": installed, "version": None} if installed else None

        if anchor is None:
            self.without_anchor(refs, work)
            return self.finish("anker_fehlt",
                               f"{self.stand['anker_problem']}. Über den Kanal gilt nichts als gültig, es wird nichts "
                               "installiert. «zen update» über dev geht weiter.", EXIT_BLOCKED)
        if self.no_contact():
            return self.finish("kein_kontakt", self.no_contact(), EXIT_NO_CONTACT)
        return self.with_anchor(anchor, refs, channel, work)

    def no_contact(self):
        """Text, wenn es kein Bundle gibt, weil nie etwas geholt wurde oder das Holen scheiterte; sonst None."""
        if self.have_bundle or not self.contact or self.contact["leer"]:
            return None
        if self.contact["fehler"]:
            return f"Kein Kontakt zu origin: {self.contact['fehler']}."
        return "Noch nichts geholt."

    def read_refs(self):
        tags, heads = {}, {}
        r = git(self.repo, "for-each-ref", "--format=%(refname)%09%(objectname)%09%(objecttype)", "refs/eingang/")
        for line in r.stdout.split("\n"):
            parts = line.split("\t")
            if len(parts) != 3:
                continue
            ref, oid, kind = parts
            if ref.startswith("refs/eingang/tags/"):
                tags[ref[len("refs/eingang/tags/"):]] = (oid, kind)
            elif ref.startswith("refs/eingang/heads/"):
                heads[ref[len("refs/eingang/heads/"):]] = (oid, kind)
        return {"tags": tags, "heads": heads}

    def finish(self, state, reason, code):
        self.stand["zustand"] = state
        self.stand["grund"] = reason
        return code

    def reject(self, name, reason):
        if len(self.rejected) < MAX_REJECTED_SHOWN:
            self.rejected.append({"tag": name, "grund": reason})
        else:
            self.rejected_more += 1

    def note_rejected_more(self):
        if self.rejected_more:
            self.notes.append(f"{self.rejected_more} weitere Tags abgelehnt (nicht einzeln aufgeführt)")

    def without_anchor(self, refs, work):
        """Ohne Anker: nur die Form der Releases zeigen; nichts gilt, das Hauptbuch bleibt unberührt."""
        names = sorted((n for n in refs["tags"] if version_key(n)), key=version_key, reverse=True)
        cache = TagCache(self.repo, [refs["tags"][n][0] for n in names if refs["tags"][n][1] == "tag"], work)
        for name in names:
            oid, kind = refs["tags"][name]
            result = inspect_tag(self.repo, name, oid, kind, cache)
            self.reject(name, result.reason or "signiert, aber nicht prüfbar (Anker fehlt)")
        self.note_rejected_more()
        self.dev_info(refs, None, None)

    def with_anchor(self, anchor, refs, channel, work):
        files = signer_files(anchor, os.path.join(work, "anker"))
        self.anchor, self.files = anchor, files
        names = [n for n in refs["tags"] if version_key(n) or TRUST_RE.fullmatch(n)]
        # Viele Tags sind kein Grund für «blockiert» (sonst blockierte ein Push von 1001 leichten Tags jedes Gerät):
        # Leichte, unsignierte und fremd signierte kosten dank TagCache kaum etwas; git verify-tag läuft nur für Tags
        # mit einem Schlüssel des Ankers, höchstens MAX_VERIFY-mal je Lauf (schon gültige Namen ausgenommen).
        cache = TagCache(self.repo, [refs["tags"][n][0] for n in names if refs["tags"][n][1] == "tag"], work)
        budget = Budget(MAX_VERIFY)
        ledger = self.load_ledger()
        alarm = None

        # 1. Vertrauensanker: vertrauen/NNNN aufsteigend, vor allen Releases
        for name in sorted((n for n in names if TRUST_RE.fullmatch(n)), key=lambda n: int(n.split("/")[1])):
            oid, kind = refs["tags"][name]
            number = int(name.split("/")[1])
            known = ledger.get(name)
            # Bis zur eigenen Serie zählt nur, ob ein schon gültiger Name noch auf dasselbe Objekt zeigt
            if number <= anchor.series and (not known or known["objekt"] == oid):
                continue
            result = check_tag(self.repo, name, oid, kind, anchor, files, ROOT_PRINCIPAL, cache,
                               None if known else budget)
            if result.unchecked:
                self.notes.append(f"{name} und alle Vertrauens-Tags danach blieben ungeprüft: zu viele Tags auf origin")
                break
            alarm = self.ledger_update(ledger, name, result)
            if alarm:
                break
            entry = ledger.get(name)
            if entry and entry["objekt"] != oid:
                self.notes.append(f"{name} zeigt auf origin jetzt auf ein ungültiges Objekt ({result.reason})")
                continue
            if number <= anchor.series:
                continue
            if not result.ok:
                self.reject(name, result.reason)
                continue
            try:
                new = self.trust_update(anchor, name, number, result.commit)
            except AnchorError as e:
                self.reject(name, e.reason)
                continue
            write_device_anchor(new, f"{name}, Commit {result.commit[:12]}")
            anchor = new
            files = signer_files(anchor, os.path.join(work, "anker"))
            self.anchor, self.files = anchor, files
            self.notes.append(f"Vertrauensanker Serie {number} aus {name} übernommen")
        self.stand["anker"] = anchor.summary()
        if alarm:
            self.save_ledger(ledger)
            return self.finish("blockiert", alarm, EXIT_BLOCKED)

        # 2. Releases (alle Versionen fürs Hauptbuch, gewählt wird nur im Kanal). Zuerst die schon gültigen Namen, dann
        # die höchsten Versionen: Reicht MAX_VERIFY nicht, bleiben die niedrigsten ungeprüft.
        valid, unchecked = {}, 0

        def order(n):
            return (0 if n in ledger else 1, tuple(-x for x in version_key(n)))

        for name in sorted((n for n in names if version_key(n)), key=order):
            oid, kind = refs["tags"][name]
            result = check_tag(self.repo, name, oid, kind, anchor, files, RELEASE_PRINCIPAL, cache,
                               None if name in ledger else budget)
            if result.unchecked:
                unchecked += 1
                continue
            moved = self.ledger_update(ledger, name, result)
            if moved:
                alarm = alarm or moved
                continue
            shown = in_channel(name, channel) or channel == "dev"
            entry = ledger.get(name)
            if entry and entry["objekt"] != oid:
                # Vorher gültig, jetzt auf ein ungültiges Objekt verschoben: Der Name zählt nicht, bis er wieder stimmt
                if shown:
                    self.reject(name, f"auf origin verschoben, das neue Objekt ist ungültig ({result.reason})")
                continue
            if result.ok:
                valid[name] = result.commit
            elif shown:
                self.reject(name, result.reason)
        if unchecked:
            self.notes.append(f"{unchecked} Tags blieben ungeprüft: zu viele auf origin (höchstens {MAX_VERIFY} "
                              "Signaturprüfungen je Lauf; die schon gültigen und die höchsten Versionen kamen zuerst)")
        self.note_rejected_more()
        for name in sorted(ledger):
            if name not in refs["tags"]:
                self.notes.append(f"{name} gibt es auf origin nicht mehr")
        self.save_ledger(ledger)
        self.valid, self.ledger = valid, ledger
        self.stand["gueltig"] = sorted((n for n in valid if in_channel(n, channel) or channel == "dev"),
                                       key=version_key)
        if alarm:
            return self.finish("blockiert", alarm, EXIT_BLOCKED)

        # 3. Installierter Stand, hoechste, Ziel
        if self.installed:
            exact = [n for n, c in valid.items() if c == self.installed]
            self.stand["installiert"]["version"] = highest(exact)
        floor, blocked = self.floor(valid)
        self.stand["hoechste"] = floor
        self.floor_value = floor
        self.dev_info(refs, anchor, files)
        if blocked:
            return self.finish("blockiert", blocked, EXIT_BLOCKED)
        if channel == "dev":
            return self.finish("dev", self.dev_text(), EXIT_OK)

        locked = self.locked_versions()
        held = held_version()
        candidates = [n for n in valid if in_channel(n, channel) and n not in locked
                      and (floor is None or version_key(n) > version_key(floor))]
        for name in sorted((n for n in valid if in_channel(n, channel) and n in locked
                            and (floor is None or version_key(n) > version_key(floor))), key=version_key)[-3:]:
            self.notes.append(f"{name} ist gesperrt (eine Installation scheiterte) und kein Ziel; noch einmal "
                              f"versuchen: zen rollback {name} mit «ja»")
        if held in candidates:
            # Die verlassene Version liegt nie über «hoechste» (das sank beim Rollback nicht): Hier landet sie nur, wenn
            # hoechste verloren ging. Dann hält die Rückstellung sie von der Automatik fern (zen update holt sie)
            candidates.remove(held)
            self.notes.append(f"{held} ist nach «zen rollback» für die Automatik zurückgestellt; zen update holt es")
        target = highest(candidates)
        if not target:
            text = f"Keine neuere gültig signierte Version im Kanal {channel}."
            if held:
                text += (f" {held} ist zurückgestellt: Nach «zen rollback» läuft der ältere Stand; automatisch kommt "
                         f"{held} nicht wieder, zurück dorthin: zen update.")
            return self.finish("aktuell", text, EXIT_OK)
        wait = WAIT_STABLE if channel == "stabil" else datetime.timedelta(0)
        first = parse_iso(ledger[target].get("erstmals"))
        free_at = first + wait if first else (self.t if not wait else None)
        free = wait_over(ledger[target], wait, self.t, self.synced)
        self.import_installed()
        hits = consent_hits(self.repo, self.installed, valid[target])
        self.stand["bereit"] = {"version": target, "commit": valid[target], "objekt": refs["tags"][target][0],
                                "erstmals": iso(first) if first else None,
                                "frei_ab": iso(free_at) if free_at else None, "frei": free, "rueckfrage": hits}
        if hits is None or hits:
            what = ", ".join(hits[:5]) if hits else "der Vergleich mit dem installierten Stand ist nicht möglich"
            return self.finish("zustimmung", f"{target} ist gültig signiert, betrifft aber Firewall, Netz oder Boot "
                               f"({what}). Installiert wird nur mit Zustimmung: zen update.", EXIT_WAIT)
        text = f"{target} ist gültig signiert und neuer als der installierte Stand. Installieren: zen update."
        if not free and not first:
            text += " Automatisch erst 24 h, nachdem es mit synchronisierter Uhr gesehen wurde (Wartezeit auf stabil)."
        elif not free and free_at > self.t:
            text += f" Automatisch frühestens ab {local_time(iso(free_at))} (24 h Wartezeit auf stabil)."
        elif not free:
            text += " Automatisch, sobald die Uhr synchronisiert ist (24 h Wartezeit auf stabil)."
        return self.finish("bereit", text, EXIT_OK)

    def ledger_update(self, ledger, name, result):
        """Trägt ein Ergebnis ins Hauptbuch ein (Name → Objekt und Commit; darin stehen nur Namen, die gültig waren).
        Gibt einen Alarmtext zurück, wenn ein schon gültiger Name jetzt gültig signiert auf einen anderen Commit zeigt.
        Derselbe Commit in einem anderen Tag-Objekt ist kein Alarm: Die Signatur lässt sich ohne Schlüssel neu
        umbrechen oder mit einer Leerzeile versehen (git nimmt das an, die Objekt-ID ändert sich). Das Hauptbuch
        übernimmt dann die neue Objekt-ID."""
        entry = ledger.get(name)
        if entry is None:
            if result.ok:
                ledger[name] = {"objekt": result.oid, "gueltig": True, "erstmals": None, "erstmals_start": None,
                                "commit": result.commit}
                self.first_seen(ledger[name])
                self.ledger_changed = True
            return None
        if entry["objekt"] == result.oid:
            if result.ok and entry.get("commit") != result.commit:
                entry["commit"] = result.commit  # Eintrag einer älteren Fassung ohne Commit
                self.ledger_changed = True
            if result.ok and not entry.get("erstmals") and self.first_seen(entry):
                self.ledger_changed = True
            return None
        if not result.ok:
            # Das Hauptbuch behält das gültige Objekt; der Aufrufer sieht die Abweichung
            return None
        if entry.get("commit") == result.commit:
            self.notes.append(f"{name}: derselbe Commit {result.commit[:12]} in einem anderen Tag-Objekt (vorher "
                              f"{entry['objekt'][:12]}, jetzt {result.oid[:12]}, etwa anders umbrochen); gilt weiter")
            entry["objekt"] = result.oid
            self.ledger_changed = True
            return None
        before = entry["commit"][:12] if entry.get("commit") else f"Objekt {entry['objekt'][:12]}"
        return (f"ALARM: {name} zeigt jetzt gültig signiert auf einen anderen Commit (vorher {before}, jetzt "
                f"{result.commit[:12]}). Ist ein Schlüssel in falschen Händen? Es gilt nichts mehr, bis das geklärt "
                "ist.")

    def first_seen(self, entry):
        """Trägt «erstmals» (Uhrzeit und Start) ein, aber nur mit synchronisierter Uhr: Eine Uhr, die nach dem Start
        noch falsch geht (der Pi hat keine Uhr mit Batterie) oder später springt, verkürzte sonst die Wartezeit auf
        stabil. True, wenn eingetragen."""
        if not self.synced:
            return False
        boot, clock = boot_clock()
        entry["erstmals"] = iso(self.t)
        entry["erstmals_start"] = {"start": boot, "seit_start": clock} if boot else None
        return True

    def save_ledger(self, ledger):
        if self.ledger_changed:
            write_json(os.path.join(STATE_DIR, "gesehen.json"), {"version": 1, "tags": ledger})

    def trust_update(self, anchor, name, number, commit):
        """Neuer Anker aus dem Commit eines gültigen vertrauen/NNNN; AnchorError, wenn er nicht passt."""
        texts = {}
        for file_name in ANCHOR_FILES:
            r = git(self.repo, "cat-file", "blob", f"{commit}:system/vertrauen/{file_name}")
            texts[file_name] = r.stdout if r.returncode == 0 else None
        try:
            new = parse_anchor(texts)
        except AnchorError as e:
            raise AnchorError(f"Anker im Commit unbrauchbar: {e.reason}") from e
        if new.series != number:
            raise AnchorError(f"Serie im Commit ist {new.series}, nicht {number}")
        if new.root != anchor.root:
            raise AnchorError("Anker im Commit hat eine andere Wurzel (die ändert sich nie über das Netz)")
        revoked = sorted(set(anchor.revoked) | set(new.revoked))
        if set(new.release) & set(revoked):
            raise AnchorError("ein neuer Release-Schlüssel ist widerrufen")
        return Anchor(new.release, anchor.root, revoked, number)

    def floor(self, valid):
        """(hoechste, Grund für «blockiert» oder None). Hebt hoechste an, wenn ein gültiger Tag im Verlauf des
        installierten Stands liegt; senkt es nie."""
        stored = self.load_floor()
        derived, known = None, False
        # Während eine Installation unterbrochen ist (laeuft.json), steht /opt/zenos womöglich auf einem Ziel, das nie
        # gesund wurde und gleich gesperrt wird: Daraus hebt sich hoechste nicht (im Ende-zu-Ende-Test so passiert)
        interrupted = os.path.lexists(state_path("laeuft.json"))
        if interrupted:
            self.notes.append("Eine Installation ist unterbrochen: hoechste bleibt, bis sie fertig ist")
        if self.installed and valid and not interrupted:
            if has_commit(self.repo, self.installed):
                repo, known = self.repo, True
            elif code_history_usable():
                repo, known = CODE_DIR, True
            if known:
                inside = []
                for name, commit in valid.items():
                    if repo == CODE_DIR and not has_commit(CODE_DIR, commit):
                        continue  # fehlt im vollständigen Verlauf: also kein Vorfahre
                    answer = is_ancestor(repo, commit, self.installed)
                    if answer is None:
                        known = False
                        break
                    if answer:
                        inside.append(name)
                derived = highest(inside) if known else None
        floor = stored
        if derived and (floor is None or version_key(derived) > version_key(floor)):
            floor = derived
        if floor != stored and floor:
            write_atomic(os.path.join(STATE_DIR, "hoechste"), floor + "\n")
            if stored is None:
                self.notes.append(f"hoechste aus dem installierten Stand abgeleitet: {floor}")
        if floor or not valid:
            return floor, None
        # Kein gespeicherter Wert und keiner ableitbar: nur in Ordnung, wenn der installierte Stand vor allen gültigen
        # Versionen liegt (dann ist jede ein Schritt vorwärts)
        if (self.installed and has_commit(self.repo, self.installed)
                and all(is_ancestor(self.repo, self.installed, c) for c in valid.values())):
            self.notes.append("installierter Stand liegt vor allen signierten Versionen")
            return None, None
        if not self.installed:
            return None, ("hoechste fehlt, und der installierte Stand in /opt/zenos ist unbekannt. Ohne ihn lässt "
                          "sich ein Downgrade nicht ausschliessen.")
        return None, (f"hoechste fehlt, und der installierte Stand {self.installed[:12]} gehört zu keiner signierten "
                      "Version. Ohne ihn lässt sich ein Downgrade nicht ausschliessen.")

    def dev_info(self, refs, anchor, files):
        tip = refs["heads"].get("dev")
        if not tip or tip[1] != "commit":
            return
        tip = tip[0]
        info = {"commit": tip, "neu": tip != self.installed, "vorfahre": None, "commits": None,
                "signiert": False, "braucht_ja": True}
        if self.installed and has_commit(self.repo, self.installed):
            info["vorfahre"] = is_ancestor(self.repo, self.installed, tip)
            if info["vorfahre"]:
                count = git(self.repo, "rev-list", "--count", f"{self.installed}..{tip}").stdout.strip()
                info["commits"] = int(count) if count.isdigit() else None
        if anchor and info["vorfahre"] and info["commits"] is not None and info["commits"] <= MAX_DEV_RANGE:
            if info["commits"] == 0:
                info["signiert"] = True
            else:
                r = git(self.repo, "-c", f"gpg.ssh.allowedSignersFile={files['release']}",
                        "-c", f"gpg.ssh.revocationFile={files['widerrufen']}", "log", "--format=%H %G?",
                        f"{self.installed}..{tip}")
                marks = [z.split(" ")[1] for z in r.stdout.split("\n") if " " in z]
                info["signiert"] = r.returncode == 0 and len(marks) == info["commits"] and all(m == "G" for m in marks)
        info["braucht_ja"] = not (info["vorfahre"] and info["signiert"])
        self.stand["dev"] = info

    def dev_text(self):
        info = self.stand["dev"]
        if not info:
            return "Kanal dev: origin/dev fehlt im Bundle."
        if not info["neu"]:
            return "Kanal dev: installiert ist der Stand von origin/dev."
        what = f"{info['commits']} Commits" if info["commits"] is not None else "Abstand unbekannt"
        sign = "alle signiert" if info["signiert"] else "nicht alle signiert"
        text = f"Kanal dev: neuer Stand {info['commit'][:12]} ({what}, {sign})."
        if info["braucht_ja"]:
            text += " Nur von Hand mit «ja»; automatisch kommt auf dev nichts."
        return text


    # -- Wunsch von zen update oder zen rollback --

    def import_installed(self):
        """Holt den installierten Commit aus /opt/zenos ins Prüf-Repo, wenn er im Bundle fehlt (nicht gepusht): nötig
        für den Vergleich der Rückfrage-Pfade. Nur lesend, ohne Netz."""
        if not self.installed or not self.repo or has_commit(self.repo, self.installed) or not code_history_usable():
            return
        git(self.repo, "-c", "protocol.file.allow=always", "fetch", "--quiet", "--no-tags", "--no-write-fetch-head",
            "--no-recurse-submodules", CODE_DIR, "+HEAD:refs/installiert/HEAD")

    def answer(self, result, reason, code, **extra):
        self.stand["wunsch"] = {"id": self.wish["id"], "art": self.wish["art"], "tag": self.wish["tag"],
                                "ergebnis": result, "grund": reason, **extra}
        return code

    def fulfil(self, code):
        """Erfüllt den Wunsch: Ziel bestimmen, Gründe für ein «ja» sammeln, bereitstellen, auftrag.json schreiben.
        Rückgabe: Exit-Code dieses Laufs (der Wunsch zählt mehr als der Kanalzustand)."""
        # Ein Auftrag von früher (nie installiert) gilt nicht mehr, sobald ein neuer Wunsch kommt
        with contextlib.suppress(FileNotFoundError):
            os.unlink(state_path("auftrag.json"))
        state = self.stand["zustand"]
        if state in ("fehler", "kein_kontakt") or self.refs is None:
            result = "wartet" if state == "kein_kontakt" else "abgelehnt"
            return self.answer(result, self.stand["grund"] or "Prüfung abgebrochen.",
                               EXIT_WAIT if result == "wartet" else code or EXIT_BLOCKED)
        if self.no_contact():
            # Auch ohne Anker: Fehlt das Bundle, weil das Holen scheiterte, ist das «wartet», nicht «abgelehnt»
            return self.answer("wartet", self.no_contact(), EXIT_WAIT)
        # Signaturen zählen nur mit Anker und ohne Alarm. Sonst geht nur, was ein «ja» bekommt (dev, rollback).
        trusted = self.anchor is not None and state != "blockiert"
        self.import_installed()
        try:
            if self.wish["art"] == "rollback":
                target = self.rollback_target(self.wish["tag"], trusted)
            elif self.wish["art"] == "automatik":
                target = self.automatic_target(trusted)
            elif self.channel == "dev":
                target = self.dev_target(trusted)
            else:
                target = self.channel_target(trusted)
        except Refusal as e:
            return self.answer("abgelehnt", str(e), EXIT_BLOCKED)
        except Current as e:
            return self.answer("aktuell", str(e), EXIT_OK)
        shown = self.wish.get("ziel")
        if shown and target.get("id") != shown:
            # «Jetzt installieren» gilt nur dem Stand, den die Einstellungen zeigten
            return self.answer("wartet", f"Angezeigt war {shown[:12]}, die Prüfung nennt jetzt {target_label(target)}. "
                               "Nichts installiert; bitte noch einmal ansehen.", EXIT_WAIT)
        if self.is_current(target):
            return self.answer("aktuell", f"Schon installiert: {target_label(target)}.", EXIT_OK)
        if self.wish.get("nur_signiert") and not target.get("signiert"):
            # «Zustimmen …» in den Einstellungen ersetzt das getippte «ja» nur für gültig signierte Versionen (Firewall,
            # Netz oder Boot); Unsigniertes, dev und Rollbacks bleiben beim Terminal
            return self.answer("abgelehnt", f"{target_label(target)} ist nicht gültig signiert. Zustimmen in den "
                               "Einstellungen gilt nur für gültig signierte Versionen; sonst im Terminal: zen update.",
                               EXIT_BLOCKED)

        reasons = target.pop("gruende")
        commits = target.pop("commits", None)
        locked = locked_entries()
        for name in (target.get("version"), target["commit"]):
            if name and name in locked:
                entry = locked[name]
                reasons.append(f"{name} ist gesperrt: Die Installation am {local_time(entry.get('zeit'))} scheiterte "
                               f"({short(entry.get('grund') or '?', 120)}).")
                break
        hits = consent_hits(self.repo, self.installed, target["commit"])
        if hits is None:
            reasons.append("Firewall, Netz und Boot: Der Vergleich mit dem installierten Stand ist nicht möglich.")
        elif hits:
            shown = ", ".join(hits[:MAX_SHOWN]) + (f" und {len(hits) - MAX_SHOWN} weitere" if len(hits) > MAX_SHOWN else "")
            reasons.append(f"Betrifft Firewall, Netz oder Boot: {shown}.")
        target["rueckfrage"] = hits

        if reasons and self.wish["ja"] != target["id"]:
            question = {"id": target["id"], "ziel": target_label(target), "gruende": reasons, "commits": commits}
            return self.answer("zustimmung", f"{target_label(target)} braucht deine Zustimmung.", EXIT_WAIT,
                               frage=question)
        target["freigabe"] = "ja" if reasons else None
        target.setdefault("bereich_von", None)

        try:
            origin = origin_url()
        except Failure:
            origin = None
        try:
            folder = stage(self.repo, target.pop("refspecs"), target["commit"], target.get("zweig"), origin)
        except Waiting as e:
            return self.answer("wartet", str(e), EXIT_WAIT)
        except Failure as e:
            return self.answer("abgelehnt", str(e), EXIT_ERROR)
        order = {"version": 1, **target, "pfad": folder, "kanal": self.channel, "art": self.wish["art"],
                 "von_hand": self.wish["art"] != "automatik", **stamp()}
        write_json(state_path("auftrag.json"), order)
        what = ("mit deinem «ja»" if target["freigabe"] else "jeder neue Commit gültig signiert" if target["bereich_von"]
                else "gültig signiert")
        return self.answer("bereitgestellt", f"{target_label(target)} ist bereitgestellt ({what}).", EXIT_OK,
                           auftrag=order)

    def is_current(self, target):
        """Läuft genau dieses Ziel schon, vom Kanal installiert und unverändert?"""
        if target["commit"] != self.installed:
            return False
        gut = load_json(state_path("gut.json"), trusted=True) or {}
        pending = load_json(state_path(UNCONFIRMED), trusted=True) or {}
        if target["commit"] not in (gut.get("commit"), pending.get("commit")) or os.path.lexists(
                state_path("angehalten")):
            return False
        if os.path.lexists(state_path("laeuft.json")):
            return False
        r = git(CODE_DIR, "status", "--porcelain")
        return r.returncode == 0 and r.stdout.strip() == ""

    def range_commits(self, old, new, trusted):
        """Commits OLD..NEW als Liste [{commit, zeichen, titel}] (%G?: G gültig signiert; ohne Anker «?»), None wenn es
        zu viele sind."""
        count = git(self.repo, "rev-list", "--count", f"{old}..{new}").stdout.strip()
        if not count.isdigit() or int(count) > MAX_DEV_RANGE:
            return None
        if trusted:
            r = git(self.repo, "-c", f"gpg.ssh.allowedSignersFile={self.files['release']}",
                    "-c", f"gpg.ssh.revocationFile={self.files['widerrufen']}", "log", "--format=%H %G? %s",
                    f"{old}..{new}")
        else:
            r = git(self.repo, "log", "--format=%H ? %s", f"{old}..{new}")
        if r.returncode != 0:
            return None
        commits = []
        for line in r.stdout.split("\n"):
            parts = line.split(" ", 2)
            if len(parts) >= 2 and OID_RE.fullmatch(parts[0]):
                commits.append({"commit": parts[0], "zeichen": parts[1], "titel": short(parts[2] if len(parts) > 2
                                                                                       else "", 72)})
        return commits if len(commits) == int(count) else None

    def dev_target(self, trusted):
        tip = self.refs["heads"].get("dev")
        if not tip or tip[1] != "commit":
            raise Refusal("origin/dev fehlt im zuletzt geholten Stand.")
        tip = tip[0]
        # In die Bereitstellung (und damit nach /opt/zenos) kommen nur geprüfte Tags: Ein fremder Tag auf demselben
        # Commit fälschte sonst «zen version» (git describe)
        tags = [f"+refs/eingang/tags/{n}:refs/tags/{n}" for n in sorted(self.valid)] if trusted else []
        target = {"commit": tip, "zweig": "dev", "tag": None, "objekt": None, "version": None, "signiert": False,
                  "id": tip, "hoechste": False, "refspecs": ["+refs/eingang/heads/dev:refs/heads/dev", *tags]}
        reasons, commits, signed_range = [], None, False
        if not self.anchor:
            reasons.append("Anker fehlt: Signaturen lassen sich nicht prüfen. dev geht von Hand weiter, nur mit «ja» "
                           "für genau diesen Stand.")
        elif not trusted:
            reasons.append(f"Der Kanal ist blockiert, Signaturen zählen nicht: {short(self.stand['grund'], 160)}")
        if not self.installed or not has_commit(self.repo, self.installed):
            reasons.append("Der installierte Stand ist unbekannt; welche Commits dazukommen, lässt sich nicht zeigen.")
        elif not is_ancestor(self.repo, self.installed, tip):
            reasons.append("Der installierte Stand liegt nicht in origin/dev: dev wurde umgeschrieben, oder der Stand "
                           "kam von Hand und ist nicht gepusht.")
        else:
            commits = self.range_commits(self.installed, tip, trusted)
            if commits is None:
                reasons.append(f"Mehr als {MAX_DEV_RANGE} neue Commits, ihre Signaturen werden nicht geprüft.")
            elif trusted:
                unsigned = [c for c in commits if c["zeichen"] != "G"]
                if unsigned:
                    reasons.append(f"{len(unsigned)} von {len(commits)} neuen Commits sind nicht gültig signiert.")
                    commits = unsigned + [c for c in commits if c["zeichen"] == "G"]
                else:
                    signed_range = True
        if commits is not None:
            commits = commits[:MAX_SHOWN] + ([{"weitere": len(commits) - MAX_SHOWN}] if len(commits) > MAX_SHOWN
                                              else [])
        target["gruende"], target["commits"] = reasons, commits
        # Ohne «ja» nur, weil jeder Commit seit dem installierten Stand gültig signiert ist; installieren prüft das nach
        target["bereich_von"] = self.installed if signed_range else None
        return target

    def channel_target(self, trusted):
        if not self.anchor:
            raise Refusal(f"Anker fehlt ({self.stand['anker_problem']}). Auf {self.channel} kommt nur gültig "
                          "Signiertes. Von Hand weiter geht es auf dev (Kanal in /etc/xdg/zenos/kanal).")
        if not trusted:
            raise Refusal(f"Kanal blockiert: {self.stand['grund']}")
        floor = self.floor_value
        # Wie «bereit» in der Prüfung: ohne gesperrte Versionen (eine gescheiterte Version noch einmal versuchen geht
        # nur bewusst, mit zen rollback und «ja»). Sonst zielte zen update auf die gesperrte höhere Version, während die
        # Einstellungen die niedrigere als bereit zeigen.
        locked = self.locked_versions()
        candidates = [n for n in self.valid if in_channel(n, self.channel) and n not in locked
                      and (floor is None or version_key(n) >= version_key(floor))]
        if not candidates:
            skipped = sorted((n for n in locked if n in self.valid and in_channel(n, self.channel)), key=version_key)
            raise Current(f"Keine gültig signierte Version im Kanal {self.channel}"
                          + (f" (gesperrt: {', '.join(skipped[-3:])}; noch einmal versuchen: zen rollback "
                             f"{skipped[-1]})." if skipped else "."))
        name = highest(candidates)
        commit, oid = self.valid[name], self.refs["tags"][name][0]
        reasons = []
        if (self.installed and commit != self.installed and has_commit(self.repo, self.installed)
                and is_ancestor(self.repo, commit, self.installed)):
            reasons.append(f"Rückschritt: Der installierte Stand ist neuer als {name}.")
        return {"commit": commit, "zweig": None, "tag": name, "objekt": oid, "version": name, "signiert": True,
                "id": oid, "hoechste": True, "gruende": reasons, "commits": None,
                "refspecs": [f"+refs/eingang/tags/{name}:refs/tags/{name}"]}

    def automatic_target(self, trusted):
        """Ziel der Automatik: genau der Stand, den diese Prüfung «bereit» nennt, nach der Wartezeit, ohne Grund für ein
        «ja» (Rückschritt, gesperrt, Firewall, Netz, Boot prüft fulfil danach), nie auf dev und nie eine Version, die
        nach «zen rollback» zurückgestellt ist."""
        if self.channel == "dev":
            raise Refusal("Kanal dev: Automatisch kommt nie etwas, nur von Hand mit zen update.")
        if hand_held_summary():
            # install.sh von Hand aus einem Arbeitsstand: Bis zum nächsten zen update kommt nichts automatisch
            raise Refusal(HAND_HELD_TEXT)
        ready = self.stand.get("bereit")
        if self.stand["zustand"] == "zustimmung":
            raise Current(f"{ready['version'] if ready else 'Das Update'} wartet auf Zustimmung (Firewall, Netz oder "
                          "Boot); automatisch kommt es nicht.")
        if self.stand["zustand"] != "bereit" or not ready:
            raise Current(f"Nichts für die Automatik ({STATE_TEXT.get(self.stand['zustand'], self.stand['zustand'])}).")
        if not ready.get("frei"):
            raise Current(f"{ready['version']} wartet noch (24 h Wartezeit auf stabil, nur mit synchronisierter Uhr).")
        held = held_version()
        if held == ready["version"]:
            raise Current(f"{held} ist nach «zen rollback» für die Automatik zurückgestellt.")
        if not self.anchor or not trusted:
            raise Refusal(f"Kanal {STATE_TEXT.get(self.stand['zustand'], self.stand['zustand'])}: nichts automatisch.")
        name = ready["version"]
        if (name not in self.valid or not in_channel(name, self.channel) or self.valid[name] != ready["commit"]
                or self.refs["tags"].get(name, (None,))[0] != ready["objekt"]):
            raise Refusal(f"{name} ist nicht mehr der bereite Stand dieser Prüfung.")
        commit, oid = ready["commit"], ready["objekt"]
        if (self.installed and commit != self.installed and has_commit(self.repo, self.installed)
                and is_ancestor(self.repo, commit, self.installed)):
            raise Refusal(f"{name} wäre ein Rückschritt: Der installierte Stand ist neuer.")
        return {"commit": commit, "zweig": None, "tag": name, "objekt": oid, "version": name, "signiert": True,
                "id": oid, "hoechste": True, "gruende": [], "commits": None,
                "refspecs": [f"+refs/eingang/tags/{name}:refs/tags/{name}"]}

    def rollback_target(self, name, trusted):
        if TRUST_RE.fullmatch(name):
            raise Refusal(f"{name} ist ein Vertrauens-Tag, kein Stand.")
        entry = self.refs["tags"].get(name)
        if not entry:
            known = sorted((n for n in self.refs["tags"] if version_key(n)), key=version_key, reverse=True)[:10]
            raise Refusal(f"Den Tag {name} gibt es auf origin nicht (Stand des letzten Holens). Vorhanden: "
                          f"{', '.join(known) or 'keine'}.")
        oid, kind = entry
        target = {"zweig": None, "tag": name, "objekt": oid, "version": name if version_key(name) else None,
                  "hoechste": False, "commits": None, "refspecs": [f"+refs/eingang/tags/{name}:refs/tags/{name}"]}
        if trusted and name in self.valid:
            target.update(commit=self.valid[name], signiert=True, id=oid, gruende=[])
            return target
        known = self.ledger.get(name)
        if known and known["gueltig"] and known["objekt"] != oid:
            raise Refusal(f"{name} war gültig signiert und zeigt auf origin jetzt auf ein anderes Objekt. Nichts "
                          "geändert.")
        r = git(self.repo, "rev-parse", "--verify", "--quiet", f"{oid}^{{commit}}")
        commit = r.stdout.strip()
        if r.returncode != 0 or not OID_RE.fullmatch(commit):
            raise Refusal(f"{name} zeigt nicht auf einen Commit.")
        if not self.anchor:
            why = "Anker fehlt, Signaturen lassen sich nicht prüfen"
        elif not trusted:
            why = f"der Kanal ist blockiert ({short(self.stand['grund'], 120)})"
        else:
            result = check_tag(self.repo, name, oid, kind, self.anchor, self.files, RELEASE_PRINCIPAL)
            why = "nicht gültig signiert" + (f": {result.reason}" if result.reason else "")
        target.update(commit=commit, signiert=False, id=oid,
                      gruende=[f"{name} ist ungeprüft ({why}). Das «ja» gilt nur für das Objekt {oid[:12]}."])
        return target


def cmd_check(argv):
    if argv:
        print(f"{NAME} pruefen: keine Argumente erwartet", file=sys.stderr)
        return EXIT_USAGE
    if os.geteuid() not in TRUSTED_UIDS:
        print(f"{NAME} pruefen: nur als root (sudo zen kanal pruefen)", file=sys.stderr)
        return EXIT_USAGE
    os.umask(0o022)
    lock = lock_or_exit()
    if not isinstance(lock, Locked):
        return lock
    check = Check()
    try:
        try:
            code = check.run()
        except Failure as e:
            code = check.finish("fehler", f"Prüfung abgebrochen: {e}", EXIT_ERROR)
        except Exception as e:  # noqa: BLE001 – jeder Fehler endet als Zustand «fehler», nie als Freigabe
            if DRY_RUN and not isinstance(e, OSError):
                raise  # Der Selbsttest soll Fehler im Programm sehen
            traceback.print_exc()
            code = check.finish("fehler", f"Prüfung abgebrochen: {type(e).__name__}: {short(e, 120)}", EXIT_ERROR)
        finally:
            shutil.rmtree(os.path.join(STATE_DIR, "arbeit"), ignore_errors=True)
        if check.wish and not check.stand["wunsch"]:
            code = check.answer("abgelehnt", check.stand["grund"] or "Prüfung abgebrochen.", code or EXIT_ERROR)
        if os.path.isdir(STATE_DIR) and not path_problem(STATE_DIR):
            write_json(os.path.join(STATE_DIR, "stand.json"), check.stand)
            ready_mark(check.stand)
    except OSError as e:
        print(f"{NAME}: stand.json nicht geschrieben: {e.strerror}", file=sys.stderr)
        code = code or EXIT_ERROR
    finally:
        lock.release()
    print_check(check.stand)
    return code


def ready_mark(stand):
    """automatik-bereit: Gibt es auf stabil oder vorschau einen bereiten Stand, schaut zenos-kanal-gelegenheit.service
    alle 15 Min., ob der Zeitpunkt passt (ConditionPathExists); sonst startet es gar nicht erst."""
    path = state_path(READY_MARK)
    ready = stand.get("bereit")
    if (stand.get("zustand") == "bereit" and stand.get("kanal") in ("stabil", "vorschau") and ready
            and not stand.get("angehalten")):
        write_json(path, {"version": ready.get("version"), "objekt": ready.get("objekt"), "frei": ready.get("frei"),
                          "frei_ab": ready.get("frei_ab")})
    else:
        with contextlib.suppress(FileNotFoundError):
            os.unlink(path)


def print_check(stand):
    print(f"Kanal {stand.get('kanal') or '?'}: {stand.get('zustand')} – {stand.get('grund')}")
    wish = stand.get("wunsch")
    if wish:
        print(f"  Wunsch {wish.get('art')}: {wish.get('ergebnis')} – {wish.get('grund')}")
    for entry in stand.get("abgelehnt") or []:
        print(f"  abgelehnt: {entry['tag']}: {entry['grund']}")
    for note in stand.get("hinweise") or []:
        print(f"  Hinweis: {note}")


# --- Installieren (root, mit Netz) -----------------------------------------------------------------------------

ENTRY_KEYS = ("commit", "zweig", "tag", "objekt", "version", "signiert", "bereich_von", "freigabe", "hoechste", "pfad",
              "art", "kanal", "von_hand", "quelle")


def entry_problem(entry):
    """Grund, warum ein Ziel aus auftrag.json oder laeuft.json unbrauchbar ist, sonst None."""
    if not isinstance(entry, dict) or not OID_RE.fullmatch(str(entry.get("commit"))):
        return "ohne gültigen Commit"
    if entry.get("pfad") != state_path("bereit", entry["commit"]):
        return "Bereitstellung an unerwartetem Ort"
    if entry.get("tag") is not None and not TAG_NAME_RE.fullmatch(str(entry["tag"])):
        return "ungültiger Tag"
    if entry.get("zweig") is not None and not BRANCH_RE.fullmatch(str(entry["zweig"])):
        return "ungültiger Branch"
    if entry.get("signiert") and not (entry.get("tag") and OID_RE.fullmatch(str(entry.get("objekt")))):
        return "signiert, aber ohne Tag"
    if entry.get("bereich_von") is not None and not OID_RE.fullmatch(str(entry["bereich_von"])):
        return "ungültiger Bereich"
    return None


def dpkg_interrupted():
    try:
        names = os.listdir(DPKG_UPDATES)
    except OSError:
        return False
    return any(re.fullmatch(r"[0-9]+", n) for n in names)


def dpkg_busy():
    """Hält gerade ein anderer Paketvorgang die Sperren von dpkg (fcntl-Sperren wie apt und dpkg)?"""
    for path in DPKG_LOCKS:
        try:
            fd = os.open(path, os.O_RDWR | os.O_NOFOLLOW | getattr(os, "O_CLOEXEC", 0))
        except OSError:
            continue
        try:
            fcntl.lockf(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            fcntl.lockf(fd, fcntl.LOCK_UN)
        except OSError:
            return True
        finally:
            os.close(fd)
    return False


def dpkg_repair():
    """Wurde dpkg mittendrin unterbrochen (Strom, kill), verweigert apt alles bis «dpkg --configure -a». Das holt es nach,
    wenn kein anderer Paketvorgang läuft."""
    if not dpkg_interrupted():
        return
    end = time.monotonic() + DPKG_WAIT
    while dpkg_busy():
        if time.monotonic() > end:
            print(f"{NAME}: Ein anderer Paketvorgang läuft noch; dpkg bleibt unterbrochen.", file=sys.stderr)
            return
        time.sleep(5)
    if not dpkg_interrupted():
        return
    print("dpkg wurde unterbrochen: dpkg --configure -a …")
    env = {"PATH": INSTALL_PATH, "HOME": "/root", "LANG": "C.UTF-8", "DEBIAN_FRONTEND": "noninteractive"}
    rc = run_visible([DPKG, "--configure", "-a"], env, timeout=DPKG_TIMEOUT)
    if rc != 0:
        print(f"{NAME}: dpkg --configure -a endete mit Exit {rc}", file=sys.stderr)


@contextlib.contextmanager
def inhibitor(why):
    """Block-Inhibitor für Ausschalten und Ruhezustand, solange der Block läuft (systemd-inhibit mit sleep). Ohne logind
    geht es ohne, mit Hinweis."""
    if not os.path.isdir(SYSTEMD_RUN_DIR) or not os.access(SYSTEMD_INHIBIT, os.X_OK):
        yield False
        return
    proc = subprocess.Popen([SYSTEMD_INHIBIT, "--what=shutdown:sleep", "--mode=block", "--who=zenOS", f"--why={why}",
                             SLEEP, "infinity"], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                            stderr=subprocess.PIPE, env={"PATH": SYSTEM_PATH, "LANG": "C.UTF-8"})
    time.sleep(0.5)
    if proc.poll() is not None:
        print(f"{NAME}: ohne Inhibitor: {first_line(proc.stderr.read().decode('utf-8', 'replace'))}", file=sys.stderr)
        yield False
        return
    try:
        yield True
    finally:
        proc.terminate()
        try:
            proc.wait(10)
        except subprocess.TimeoutExpired:
            proc.kill()
            proc.wait()


@contextlib.contextmanager
def takeover_flag(entry):
    """/run/zenos-kanal/uebernahme, solange install.sh läuft (Einstellungen, System-Menü und Login-Bildschirm zeigen
    «Update läuft»). Dazu bekommen die Oberflächen auf seat0 Bescheid (session_notify): Während der Übernahme lädt
    Quickshell geänderte Dateien nicht einzeln nach (sonst womöglich ein Mischstand), danach richtet die Oberfläche
    die Benutzerteile ein und startet neu, wenn sich QML geändert hat."""
    flag = os.path.join(RUNTIME_DIR, "uebernahme")
    made = False
    if os.path.isdir(RUNTIME_DIR) and not path_problem(RUNTIME_DIR):
        write_atomic(flag, f"{entry['commit']}\n")
        made = True
    session_notify("beginn")
    try:
        yield
    finally:
        if made:
            with contextlib.suppress(FileNotFoundError):
                os.unlink(flag)
        session_notify("ende")


def session_notify(what):
    """«zenos-ipc kanal uebernahme WHAT» als jeder Benutzer mit einer Sitzung auf seat0 (wie die Prüfung der Sperre:
    setpriv ohne neue Rechte, feste Argumente). Ohne Oberfläche oder ohne systemd geschieht nichts; ein Fehler hält die
    Installation nicht auf."""
    if DRY_RUN or not os.path.isdir(SYSTEMD_RUN_DIR):
        return
    ipc = os.path.join(CODE_DIR, "scripts", "bin", "zenos-ipc")
    if not os.access(SETPRIV, os.X_OK) or not os.path.isfile(ipc):
        return
    for uid in sorted({s[1] for s in seat_sessions() or []}):
        try:
            account = pwd.getpwuid(uid)
        except KeyError:
            continue
        runtime = os.path.join(RUN_USER, str(uid))
        run([SETPRIV, f"--reuid={uid}", f"--regid={account.pw_gid}", "--init-groups", "--no-new-privs", "--", ipc,
             "kanal", "uebernahme", what], env={"PATH": USER_PATH, "HOME": account.pw_dir, "XDG_RUNTIME_DIR": runtime,
                                                 "LANG": "C.UTF-8"}, timeout=20)


def session_users():
    """Benutzer mit einer Sitzung auf seat0 (für das daemon-reload ihrer Benutzerinstanz)."""
    if not os.path.isdir(SYSTEMD_RUN_DIR):
        return []
    r = run([LOGINCTL, "list-sessions", "--json=short", "--no-pager"], env={"PATH": SYSTEM_PATH, "LANG": "C.UTF-8"},
            timeout=CHECK_TIMEOUT)
    try:
        sessions = json.loads(r.stdout) if r.returncode == 0 else []
    except ValueError:
        sessions = []
    users = set()
    for item in sessions if isinstance(sessions, list) else []:
        if isinstance(item, dict) and item.get("seat") == "seat0" and USER_RE.fullmatch(str(item.get("user"))):
            users.add(item["user"])
    return sorted(users)


def reload_user_managers():
    for user in session_users():
        r = run([SYSTEMCTL, "--user", "-M", f"{user}@", "daemon-reload"], env={"PATH": SYSTEM_PATH, "LANG": "C.UTF-8"},
                timeout=CHECK_TIMEOUT)
        if r.returncode == 0:
            print(f"systemd-Benutzerinstanz von {user} neu geladen; der Rest der Benutzerteile folgt beim nächsten "
                  "Login.")


def raise_floor(version):
    current = None
    with contextlib.suppress(FileNotFoundError, Failure):
        lines = content_lines(read_small(state_path("hoechste"), trusted=True))
        current = lines[0].strip() if len(lines) == 1 and version_key(lines[0].strip()) else None
    if current is None or version_key(version) > version_key(current):
        write_atomic(state_path("hoechste"), version + "\n")


def cleanup_staged(keep):
    folder = state_path("bereit")
    with contextlib.suppress(OSError):
        for name in os.listdir(folder):
            if name not in keep:
                shutil.rmtree(os.path.join(folder, name), ignore_errors=True)


def install_log_marks(offset):
    """Zeilen «== Beginn …» und «== Ende …» im install.log nach OFFSET (auch nach einem Kürzen des Logs)."""
    try:
        with open(INSTALL_LOG, "rb") as f:
            size = os.fstat(f.fileno()).st_size
            f.seek(offset if offset <= size else max(0, size - 524288))
            text = f.read().decode("utf-8", "replace")
    except OSError:
        return []
    return [z for z in text.split("\n") if z.startswith("== Beginn ") or z.startswith("== Ende ")]


def install_log_ok(offset):
    """Steht im install.log nach OFFSET der Abschluss eines normalen Laufs mit «ok»?"""
    marks = install_log_marks(offset)
    begins = [i for i, z in enumerate(marks) if z.startswith("== Beginn ") and " · normal · " in z]
    if not begins:
        return False
    return any(z.startswith("== Ende ") and " · normal · ok · " in z for z in marks[begins[-1] + 1:])


def log_size():
    try:
        return os.path.getsize(INSTALL_LOG)
    except OSError:
        return 0


def greetd_failed():
    """Ist greetd ausgefallen (systemctl is-failed)? None ohne systemd."""
    if not os.path.isdir(SYSTEMD_RUN_DIR):
        return None
    r = run([SYSTEMCTL, "is-failed", "--quiet", "greetd.service"], env=install_env(), timeout=CHECK_TIMEOUT)
    return r.returncode == 0


def quickshell_exit():
    """Exit von «quickshell --version», None, wenn es Quickshell nicht gibt."""
    if not os.path.exists(QUICKSHELL):
        return None
    return run([QUICKSHELL, "--version"], env=install_env(), timeout=CHECK_TIMEOUT).returncode


def program_digest():
    """SHA-256 des installierten zenos-kanal, None ohne ihn."""
    try:
        with open(INSTALLED_PROGRAM, "rb") as f:
            return hashlib.sha256(f.read(16 << 20)).hexdigest()
    except OSError:
        return None


def health_baseline():
    """Zustand vor install.sh. Was vorher schon kaputt war, legt die Gesundheitsprüfung dem neuen Stand nicht zur Last:
    Sonst machte ein schon ausgefallenes greetd jedes Update «kaputt», auch das, das es reparieren soll. Dazu der
    Fingerabdruck des installierten zenos-kanal: Nur ein geänderter bekommt den Probelauf im Selbsttest."""
    return {"greetd_ausgefallen": greetd_failed(), "quickshell_exit": quickshell_exit(), "programm": program_digest()}


def wants_dry_run(baseline):
    """Probelauf im Selbsttest nur, wenn der Stand einen anderen zenos-kanal brachte und der ihn kennt (--probelauf in
    der Datei). Ein unveränderter Updater hat eben dieses Update ausgeführt; ein Fehlalarm des Probelaufs sperrte sonst
    jedes weitere Update, auch den Fix."""
    after = program_digest()
    if not after or after == baseline.get("programm"):
        return False
    try:
        with open(INSTALLED_PROGRAM, "rb") as f:
            return b"--probelauf" in f.read(16 << 20)
    except OSError:
        return False


def shell_files():
    """Shell-Skripte des installierten Stands, die zen, zen update und install.sh laden (für bash -n)."""
    paths = [os.path.join(CODE_DIR, "scripts", n) for n in ("zen", "install.sh")]
    for folder in ("zen.d", "lib", "module", "doctor.d"):
        with contextlib.suppress(OSError):
            path = os.path.join(CODE_DIR, "scripts", folder)
            paths += [os.path.join(path, n) for n in sorted(os.listdir(path)) if n.endswith(".sh")]
    return [p for p in paths if os.path.isfile(p)]


def healthy(entry, offset, anchor_ok, baseline=None, tag_check=True, notes=None):
    """Gesundheitsprüfung nach install.sh: Liste der Probleme (leer: gesund). baseline: Zustand vor install.sh
    (health_baseline). tag_check: Der Selbsttest prüft auch den Tag des Ziels und macht, wenn der Stand einen anderen
    zenos-kanal brachte, einen Probelauf. Beides nicht beim Rückweg: Dessen Schlüssel kann inzwischen widerrufen sein,
    und sein zenos-kanal lief schon; der alte Stand soll zurückkommen, auch wenn der Selbsttest etwas fände."""
    baseline = baseline or {}
    problems = []
    env = install_env()
    if not install_log_ok(offset):
        problems.append(f"im {INSTALL_LOG} fehlt «== Ende … ok» für diesen Lauf")
    head = installed_commit()
    if head != entry["commit"]:
        problems.append(f"{CODE_DIR} steht auf {str(head)[:12]} statt auf {entry['commit'][:12]}")
    else:
        r = git(CODE_DIR, "status", "--porcelain")
        if r.returncode != 0 or r.stdout.strip():
            problems.append(f"{CODE_DIR} weicht vom Commit ab")
    for name in KEY_FILES:
        path = os.path.join(CODE_DIR, name)
        if os.path.lexists(os.path.join(entry["pfad"], name)) and (not os.path.isfile(path)
                                                                   or os.path.getsize(path) == 0):
            problems.append(f"{name} fehlt oder ist leer")
    broken = [os.path.relpath(p, CODE_DIR) for p in shell_files()
              if run([BASH, "-n", p], env=env, timeout=CHECK_TIMEOUT).returncode != 0]
    if broken:
        problems.append(f"Syntaxfehler in {', '.join(broken[:5])}")
    zen = os.path.join(CODE_DIR, "scripts", "zen")
    r = run([zen, "version"], env=env, timeout=CHECK_TIMEOUT)
    if r.returncode != 0 or not re.search(r"^zenOS ", r.stdout, re.M):
        problems.append(f"zen version läuft nicht (Exit {r.returncode}{': ' + first_line(r.stderr) if r.stderr else ''})")
    rc = quickshell_exit()
    if rc not in (None, 0) and baseline.get("quickshell_exit") in (None, 0):
        problems.append(f"quickshell --version endet mit Exit {rc}")
    if greetd_failed() and not baseline.get("greetd_ausgefallen"):
        problems.append("greetd ist ausgefallen")
    if not os.path.isfile(INSTALLED_PROGRAM):
        problems.append(f"{INSTALLED_PROGRAM} fehlt: Ohne ihn kommt kein Update mehr")
    else:
        argv = [PYTHON, "-I", INSTALLED_PROGRAM, "selbsttest"] + (["--anker"] if anchor_ok else [])
        if tag_check and wants_dry_run(baseline):
            argv.append("--probelauf")
            if notes is not None:
                notes.append("Neuer zenos-kanal: Selbsttest mit Probelauf")
        if tag_check and entry.get("signiert"):
            argv += ["--tag", entry["tag"], entry["objekt"], entry["pfad"]]
        r = run(argv, env=env, timeout=CHECK_TIMEOUT)
        if r.returncode != 0:
            problems.append(f"Selbsttest des neuen zenos-kanal: {first_line(r.stdout + r.stderr) or r.returncode}")
    return problems


def clear_git_locks():
    """Entfernt Sperrdateien von git, die ein Abbruch (Strom weg, kill) in /opt/zenos/.git hinterliess (index.lock,
    HEAD.lock, refs/…/*.lock): Sonst scheiterten jedes install.sh, der Rückweg und der Notweg daran. Nur unter der
    Kanal-Sperre und ohne Lauf von Hand aufrufen, dann arbeitet kein anderes git in /opt/zenos. Liste der entfernten."""
    if DRY_RUN:
        return []
    gitdir = os.path.join(CODE_DIR, ".git")
    try:
        paths = [os.path.join(gitdir, n) for n in os.listdir(gitdir) if n.endswith(".lock")]
    except OSError:
        return []
    for root, _dirs, files in os.walk(os.path.join(gitdir, "refs")):
        paths += [os.path.join(root, n) for n in files if n.endswith(".lock")]
    removed = []
    for path in sorted(paths):
        with contextlib.suppress(OSError):
            if stat.S_ISREG(os.lstat(path).st_mode):
                os.unlink(path)
                removed.append(os.path.relpath(path, CODE_DIR))
    return removed


class Busy(Exception):
    """install.sh kam nicht an seine Sperre: Es lief nichts, der Versuch zählt nicht."""


class Installation:
    """Ein Lauf von «installieren»: ein bereitgestelltes Ziel (auftrag.json) installieren oder einen unterbrochenen
    Lauf (laeuft.json) fortsetzen, mit Gesundheitsprüfung und Rückweg. Schreibt letzte.json, wenn der Lauf eine
    Installation betraf (nicht bei abgelehnt, wartet, nichts: die überschrieben sonst ein «kaputt»)."""

    def __init__(self):
        self.t = now()
        self.stop_requested = False
        self.touched = False
        self.result = {"version": 1, "ergebnis": None, "grund": "", "beginn": iso(self.t), "ende": None, "ziel": None,
                       "rueckweg": None, "versuche": None, "hinweise": []}

    def finish(self, result, reason, code):
        self.result.update(ergebnis=result, grund=reason, ende=iso(now()))
        return code

    def save(self, running):
        write_json(state_path("laeuft.json"), running)

    def run(self):
        os.makedirs(STATE_DIR, mode=0o755, exist_ok=True)
        problem = path_problem(STATE_DIR)
        if problem:
            raise Failure(f"Zustand unsicher: {problem}")
        running = load_json(state_path("laeuft.json"), trusted=True)
        resumed = running is not None
        if resumed:
            self.touched = True
            problem = (entry_problem(running.get("ziel")) or (running.get("rueckweg") is not None and
                                                               entry_problem(running.get("rueckweg"))))
            if problem or running.get("phase") not in ("ziel", "rueckweg") or not isinstance(running.get("versuche"),
                                                                                            dict):
                os.replace(state_path("laeuft.json"), state_path("laeuft.kaputt.json"))
                return self.finish("kaputt", f"laeuft.json ist unbrauchbar ({problem or 'Form'}); beiseite gelegt als "
                                   "laeuft.kaputt.json.", EXIT_BROKEN)
            print(f"Setze die unterbrochene Installation fort: {target_label(running[running['phase']])} "
                  f"(bisher {running['versuche'].get(running['phase'], 0)} Versuche).")
        else:
            running = self.new_run()
            if not isinstance(running, dict):
                return running
        self.result.update(ziel=running["ziel"], rueckweg=running["rueckweg"])
        anchor_ok = self.anchor_ok()
        removed = clear_git_locks()
        if removed:
            self.result["hinweise"].append(f"Zurückgebliebene Sperren von git entfernt: {', '.join(removed[:5])}")
        if not DRY_RUN:
            dpkg_repair()
        failure = running.get("grund")
        # Weg zurück auf den guten Stand, weil nach einem automatischen Update der Login fehlte (zenos-kanal
        # bestaetigen): ohne Rückweg auf den Stand ohne Login, und der gute Stand wird nie gesperrt. Scheitert er,
        # ist das «kaputt» (dringend), und beim nächsten Start versucht es die Bestätigung noch einmal.
        way_back = running["ziel"].get("art") == "bestaetigung"
        while True:
            phase = running["phase"]
            entry = running[phase]
            done = running["versuche"].get(phase, 0)
            self.result["versuche"] = dict(running["versuche"])
            if done >= MAX_ATTEMPTS:
                reason = f"{target_label(entry)} wurde {done}-mal unterbrochen"
                if phase == "rueckweg":
                    return self.broken(running, f"{failure or '?'}; Rückweg: {reason}")
                if way_back:
                    return self.broken(running, f"Weg zurück auf den guten Stand: {reason}")
                lock_target(entry, reason)
                failure = reason
                if not running["rueckweg"]:
                    return self.broken(running, f"{reason}; kein Rückweg")
                running.update(phase="rueckweg", grund=reason)
                self.save(running)
                continue
            if self.stop_requested:
                # Ausschalten, bevor install.sh begann: nicht mehr anfangen
                what = ("zen update setzt fort" if os.path.lexists(state_path("laeuft.json"))
                        else "nichts geändert")
                return self.finish("wartet", f"Stopp verlangt (Ausschalten?), bevor install.sh begann; {what}.",
                                   EXIT_WAIT)
            self.touched = True
            running["versuche"][phase] = done + 1
            self.result["versuche"] = dict(running["versuche"])
            self.save(running)
            try:
                problems = self.attempt(entry, anchor_ok, phase)
            except Busy as e:
                running["versuche"][phase] = done
                self.result["versuche"] = dict(running["versuche"])
                if not resumed and phase == "ziel" and done == 0:
                    self.remove_running()
                    self.touched = False
                else:
                    self.save(running)
                return self.finish("wartet", f"{e}. Der Versuch zählt nicht; später noch einmal: zen update.",
                                   EXIT_BUSY)
            if not problems:
                return self.success(running, phase, failure)
            reason = "; ".join(problems)
            print(f"{NAME}: {target_label(entry)} ist nicht gesund: {reason}", file=sys.stderr)
            if phase == "rueckweg":
                return self.broken(running, f"{failure}; Rückweg: {reason}")
            if way_back:
                return self.broken(running, f"Weg zurück auf den guten Stand {target_label(entry)} gescheitert: "
                                   f"{reason}. Beim nächsten Start versucht es zenOS noch einmal")
            if not running["rueckweg"]:
                self.remove_running()
                if running["ziel"]["commit"] == installed_commit():
                    return self.finish("gescheitert", f"{target_label(entry)}: {reason}. Es läuft derselbe Stand wie "
                                       "vorher.", EXIT_FAILED)
                return self.broken(running, f"{reason}; kein Rückweg")
            locked = lock_target(entry, reason)
            print(f"{locked} ist gesperrt. Rückweg auf {target_label(running['rueckweg'])} …")
            failure = f"{target_label(entry)}: {reason}"
            running.update(phase="rueckweg", grund=failure)
            self.save(running)

    def anchor_ok(self):
        try:
            load_device_anchor()
            return True
        except AnchorError:
            return False

    def new_run(self):
        order = load_json(state_path("auftrag.json"), trusted=True)
        if order is None:
            return self.finish("nichts", "Kein Auftrag: zen update stellt einen bereit.", EXIT_OK)
        os.unlink(state_path("auftrag.json"))
        problem = entry_problem(order)
        if not problem and not fresh(order, self.t):
            problem = "älter als eine Stunde"
        if problem:
            return self.finish("abgelehnt", f"Auftrag unbrauchbar: {problem}. Noch einmal: zen update.", EXIT_BLOCKED)
        if order.get("art") == "automatik" and hand_held_summary():
            # Ein install.sh von Hand wurde fertig, nachdem die Automatik geprüft hatte
            return self.finish("abgelehnt", f"{target_label(order)}: {HAND_HELD_TEXT}", EXIT_BLOCKED)
        try:
            self.verify(order)
        except Failure as e:
            return self.finish("abgelehnt", f"{target_label(order)}: {e}", EXIT_BLOCKED)
        problem = free_space_problem(install_space_paths())
        if problem:
            return self.finish("wartet", problem, EXIT_WAIT)
        target = {k: order.get(k) for k in ENTRY_KEYS}
        try:
            fallback = self.prepare_fallback(target)
        except Waiting as e:
            return self.finish("wartet", str(e), EXIT_WAIT)
        except Failure as e:
            return self.finish("abgelehnt", f"Rückweg nicht bereitzustellen: {e}. Nichts geändert.", EXIT_ERROR)
        return {"version": 1, "ziel": target, "rueckweg": fallback, "phase": "ziel",
                "versuche": {"ziel": 0, "rueckweg": 0}, "beginn": iso(self.t), "grund": None}

    def verify(self, entry):
        """Prüft die Bereitstellung vor der Benutzung noch einmal: Ort, Commit, sauber; signiert gegen den Anker von
        jetzt, sonst nur mit «ja»."""
        folder = entry["pfad"]
        if not repo_intact(folder, entry["commit"]):
            raise Failure("Bereitstellung fehlt, ist verändert oder nicht root-eigen")
        if entry.get("art") == "bestaetigung":
            # Zurück auf den guten Stand, weil nach einem automatischen Update der Login fehlte: Er lief schon gesund
            # und bestätigt (wie der Rückweg ohne neue Signaturprüfung; sein Schlüssel kann inzwischen widerrufen sein)
            gut = load_json(state_path("gut.json"), trusted=True) or {}
            if gut.get("commit") != entry["commit"]:
                raise Failure("der gute Stand hat sich geändert")
            return
        if entry.get("signiert"):
            try:
                anchor = load_device_anchor()
            except AnchorError as e:
                raise Failure(f"Anker: {e.reason}") from e
            with tempfile.TemporaryDirectory(prefix="zenos-kanal.") as work:
                files = signer_files(anchor, os.path.join(work, "anker"))
                r = git(folder, "rev-parse", "--verify", "--quiet", f"refs/tags/{entry['tag']}")
                if r.stdout.strip() != entry["objekt"]:
                    raise Failure(f"Tag {entry['tag']} fehlt in der Bereitstellung")
                kind = git(folder, "cat-file", "-t", entry["objekt"]).stdout.strip()
                result = check_tag(folder, entry["tag"], entry["objekt"], kind, anchor, files, RELEASE_PRINCIPAL)
            if not result.ok or result.commit != entry["commit"]:
                raise Failure(f"Signatur gilt nicht mehr ({result.reason or 'anderer Commit'})")
        elif entry.get("freigabe") == "ja":
            return
        elif entry.get("bereich_von"):
            self.verify_range(entry)
        else:
            raise Failure("weder gültig signiert noch mit «ja» freigegeben")

    def verify_range(self, entry):
        """dev ohne «ja»: Der installierte Stand ist noch derselbe, liegt im Verlauf des Ziels, und jeder Commit dazwischen
        ist gegen den Anker von jetzt gültig signiert (%G? gleich G)."""
        base, folder = entry["bereich_von"], entry["pfad"]
        if installed_commit() != base:
            raise Failure("der installierte Stand hat sich seit der Prüfung geändert")
        if is_ancestor(folder, base, entry["commit"]) is not True:
            raise Failure("der installierte Stand liegt nicht im Verlauf des Ziels")
        try:
            anchor = load_device_anchor()
        except AnchorError as e:
            raise Failure(f"Anker: {e.reason}") from e
        count = git(folder, "rev-list", "--count", f"{base}..{entry['commit']}").stdout.strip()
        with tempfile.TemporaryDirectory(prefix="zenos-kanal.") as work:
            files = signer_files(anchor, os.path.join(work, "anker"))
            r = git(folder, "-c", f"gpg.ssh.allowedSignersFile={files['release']}",
                    "-c", f"gpg.ssh.revocationFile={files['widerrufen']}", "log", "--format=%G?",
                    f"{base}..{entry['commit']}")
        marks = [z for z in r.stdout.split("\n") if z]
        if r.returncode != 0 or not count.isdigit() or len(marks) != int(count) or any(m != "G" for m in marks):
            raise Failure("nicht mehr jeder neue Commit ist gültig signiert")

    def prepare_fallback(self, target):
        """Rückweg: der laufende Stand von /opt/zenos als Bereitstellung (vom guten Stand, sonst frisch aus /opt/zenos).
        None, wenn es keinen gibt oder das Ziel derselbe Commit ist."""
        head = installed_commit()
        if not head:
            self.result["hinweise"].append(f"Kein Rückweg: {CODE_DIR} hat keinen Stand.")
            return None
        if head == target["commit"]:
            return None
        if target.get("art") == "bestaetigung":
            # Zurück auf den guten Stand, weil der laufende keinen Login brachte: kein Rückweg auf ihn
            return None
        gut = load_json(state_path("gut.json"), trusted=True) or {}
        pending = load_json(state_path(UNCONFIRMED), trusted=True) or {}
        folder = state_path("bereit", head)
        if gut.get("commit") == head and repo_intact(folder, head):
            return {**{k: gut.get(k) for k in ENTRY_KEYS}, "pfad": folder, "quelle": "gut"}
        if pending.get("commit") == head and repo_intact(folder, head):
            return {**{k: pending.get(k) for k in ENTRY_KEYS}, "pfad": folder, "quelle": "unbestaetigt"}
        if os.path.lexists(state_path("angehalten")) or git(CODE_DIR, "status", "--porcelain").stdout.strip():
            self.result["hinweise"].append(f"Rückweg ist der Commit {head[:12]} ohne die Änderungen, die von Hand in "
                                           f"{CODE_DIR} kamen.")
        branch = git(CODE_DIR, "symbolic-ref", "--quiet", "--short", "HEAD").stdout.strip()
        branch = branch if BRANCH_RE.fullmatch(branch) and ".." not in branch else None
        try:
            origin = origin_url()
        except Failure:
            origin = None
        stage(CODE_DIR, [f"+HEAD:refs/heads/{branch or 'zenos-vorher'}"], head, branch, origin)
        return {"commit": head, "zweig": branch, "tag": None, "objekt": None, "version": None, "signiert": False,
                "freigabe": None, "hoechste": False, "pfad": folder, "art": "rueckweg", "kanal": None,
                "von_hand": target.get("von_hand"), "quelle": "vorher"}

    def attempt(self, entry, anchor_ok, phase):
        """Ein Lauf von install.sh aus der Bereitstellung, dann die Gesundheitsprüfung. Liste der Probleme. Busy, wenn
        install.sh nur an seiner Sperre scheiterte (Exit 75 ohne «== Beginn» im Log)."""
        if not repo_intact(entry["pfad"], entry["commit"]):
            return ["Bereitstellung fehlt oder ist verändert"]
        if DRY_RUN:
            raise Failure("Ein Probelauf installiert nichts")
        baseline = health_baseline()
        script = os.path.join(entry["pfad"], "scripts", "install.sh")
        argv = [script] + ([] if entry.get("von_hand") else ["--ruhig"])
        print(f"install.sh aus {entry['pfad']} ({target_label(entry)}) …")
        offset = log_size()
        with inhibitor(f"zenOS wird aktualisiert ({target_label(entry)})"), takeover_flag(entry):
            rc = run_visible(argv, install_env())
        if rc == EXIT_BUSY and not any(z.startswith("== Beginn ") for z in install_log_marks(offset)):
            raise Busy("install.sh kam nicht an seine Sperre, eine andere Installation lief")
        if self.stop_requested:
            self.result["hinweise"].append("Während install.sh kam ein Stopp (Ausschalten?); install.sh lief zu Ende.")
        problems = [] if rc == 0 else [f"install.sh endete mit Exit {rc}"]
        problems += healthy(entry, offset, anchor_ok, baseline, tag_check=phase == "ziel",
                            notes=self.result["hinweise"])
        if baseline["greetd_ausgefallen"] and greetd_failed():
            self.result["hinweise"].append("greetd war schon vor dem Update ausgefallen und ist es noch "
                                           "(journalctl -u greetd)")
        return problems

    def remove_running(self):
        with contextlib.suppress(FileNotFoundError):
            os.unlink(state_path("laeuft.json"))

    def success(self, running, phase, failure):
        entry = running[phase]
        done = {k: entry.get(k) for k in ENTRY_KEYS}
        done["zeit"] = iso(now())
        pending = load_json(state_path(UNCONFIRMED), trusted=True) or {}
        gut = load_json(state_path("gut.json"), trusted=True) or {}
        keep = {entry["commit"]}
        automatic = phase == "ziel" and entry.get("art") == "automatik"
        if automatic:
            # Erst wenn nach einem Neustart der Login kommt (zenos-kanal bestaetigen), gilt der Stand als gut. Bis dahin
            # bleibt gut.json beim guten Stand, und seine Bereitstellung bleibt für den Weg zurück.
            greetd = unit_value(["is-enabled", "greetd.service"]) if os.path.isdir(SYSTEMD_RUN_DIR) else ""
            write_json(state_path(UNCONFIRMED), {**done, "start": start_id(), "fehlstarts": [],
                                                 "guter_stand": gut.get("commit"), "greetd": greetd})
            if OID_RE.fullmatch(str(gut.get("commit"))):
                keep.add(gut["commit"])
        elif phase == "rueckweg" and pending.get("commit") == entry["commit"]:
            # Zurück auf einen automatisch installierten, noch unbestätigten Stand: Er bleibt unbestätigt
            if OID_RE.fullmatch(str(gut.get("commit"))):
                keep.add(gut["commit"])
        else:
            write_json(state_path("gut.json"), done)
            with contextlib.suppress(FileNotFoundError):
                os.unlink(state_path(UNCONFIRMED))
        if phase == "ziel" and entry.get("signiert") and entry.get("hoechste") and version_key(entry.get("version")):
            raise_floor(entry["version"])
        if phase == "ziel":
            self.hold_after(running, entry)
        self.remove_running()
        with contextlib.suppress(FileNotFoundError):
            os.unlink(state_path("angehalten"))
        cleanup_staged(keep)
        reload_user_managers()
        if phase == "ziel" and entry.get("art") == "bestaetigung":
            return self.finish("zurueck", "Nach dem automatischen Update kam nach dem Neustart kein Login. Zurück auf "
                               f"dem guten Stand {target_label(entry)}, gesund.", EXIT_OK)
        if phase == "ziel":
            what = " (automatisch; gilt als gut, sobald nach einem Neustart der Login kommt)" if automatic else ""
            return self.finish("installiert", f"{target_label(entry)} ist installiert und gesund{what}.", EXIT_OK)
        return self.finish("zurueck", f"{failure}. Zurück auf {target_label(entry)}, gesund.", EXIT_FAILED)

    def hold_after(self, running, entry):
        """Nach einem gelungenen «zen rollback» auf eine ältere Version: Die verlassene Version ist für die Automatik
        zurückgestellt (sie käme sonst gleich wieder). Ein gelungenes Update von Hand (zen update, «Jetzt
        installieren») oder eine neuere Version hebt das auf."""
        left = (running.get("rueckweg") or {}).get("version")
        if entry.get("art") == "rollback":
            target = entry.get("version")
            if version_key(left) and (not version_key(target) or version_key(left) > version_key(target)):
                write_json(state_path(HOLD), {"version": 1, "zurueckgestellt": left, "nach": target or entry["commit"],
                                              "zeit": iso(now())})
                self.result["hinweise"].append(f"{left} ist für die Automatik zurückgestellt; zen update holt es")
            return
        if entry.get("art") == "bestaetigung":
            return
        held = held_version()
        newer = version_key(entry.get("version")) and version_key(entry["version"]) > version_key(held or "v0.0.0")
        if held and (entry.get("von_hand") or newer):
            with contextlib.suppress(FileNotFoundError):
                os.unlink(state_path(HOLD))

    def broken(self, running, reason):
        self.remove_running()
        return self.finish("kaputt", f"{reason}. Zuerst den Grund beheben (Platz, Netz, Sperre), dann zen update; "
                           "mehr in ANLEITUNG.md, Abschnitt F («Kaputt»).", EXIT_BROKEN)


def cmd_install(argv):
    if argv:
        print(f"{NAME} installieren: keine Argumente erwartet", file=sys.stderr)
        return EXIT_USAGE
    if os.geteuid() not in TRUSTED_UIDS:
        print(f"{NAME} installieren: nur als root (zen update)", file=sys.stderr)
        return EXIT_USAGE
    os.umask(0o022)
    lock = lock_or_exit()
    if not isinstance(lock, Locked):
        return lock
    pid = hand_run()
    if pid:
        lock.release()
        print(f"{NAME}: {hand_text(pid)}", file=sys.stderr)
        return EXIT_BUSY
    run_ = Installation()

    def stop(_signum, _frame):
        # KillMode=mixed: Das Signal kommt nur hierher. install.sh läuft weiter (dpkg nie mittendrin abbrechen),
        # bis es fertig ist oder systemd nach TimeoutStopSec alles beendet. Vor install.sh beginnt keiner mehr.
        run_.stop_requested = True
        print(f"{NAME}: Stopp verlangt, warte auf das Ende von install.sh …", file=sys.stderr)

    old_term = signal.signal(signal.SIGTERM, stop)
    old_hup = signal.signal(signal.SIGHUP, signal.SIG_IGN)
    try:
        try:
            code = run_.run()
        except Failure as e:
            code = run_.finish("fehler", f"Installation abgebrochen: {e}", EXIT_ERROR)
        except Exception as e:  # noqa: BLE001 – laeuft.json bleibt, nachstart und zen update setzen fort
            if DRY_RUN and not isinstance(e, OSError):
                raise
            traceback.print_exc()
            code = run_.finish("fehler", f"Installation abgebrochen: {type(e).__name__}: {short(e, 120)}", EXIT_ERROR)
        if run_.touched and os.path.isdir(STATE_DIR) and not path_problem(STATE_DIR):
            write_json(state_path("letzte.json"), run_.result)
    finally:
        signal.signal(signal.SIGTERM, old_term)
        signal.signal(signal.SIGHUP, old_hup)
        lock.release()
    print(f"Ergebnis: {RESULT_TEXT.get(run_.result['ergebnis'], run_.result['ergebnis'])} – {run_.result['grund']}")
    for note in run_.result["hinweise"]:
        print(f"  Hinweis: {note}")
    return code


# --- Nach dem Start (vor dem Login, ohne Netz) ---------------------------------------------------------------------


def cmd_after_boot(argv):
    """Ein Lauf wurde unterbrochen (laeuft.json): die Übernahme des Codes vollenden (install.sh --nur-code), damit der
    Login keinen Mischstand sieht. Den Rest (Pakete, Units) holt «zen update» nach. Nach MAX_ATTEMPTS unterbrochenen
    Versuchen ist das der Code des Rückwegs."""
    if argv:
        print(f"{NAME} nachstart: keine Argumente erwartet", file=sys.stderr)
        return EXIT_USAGE
    if os.geteuid() not in TRUSTED_UIDS:
        print(f"{NAME} nachstart: nur als root", file=sys.stderr)
        return EXIT_USAGE
    os.umask(0o022)
    lock = lock_or_exit(quiet=True)
    if not isinstance(lock, Locked):
        return lock
    try:
        running = load_json(state_path("laeuft.json"), trusted=True)
        if running is None:
            print("Keine unterbrochene Installation.")
            return EXIT_OK
        if (running.get("phase") not in ("ziel", "rueckweg") or entry_problem(running.get(running.get("phase")))
                or not isinstance(running.get("versuche"), dict)):
            print(f"{NAME}: laeuft.json ist unbrauchbar; zen update meldet es.", file=sys.stderr)
            return EXIT_ERROR
        for path in clear_git_locks():
            print(f"Zurückgebliebene Sperre von git entfernt: {path}")
        if (running["phase"] == "ziel" and running["versuche"].get("ziel", 0) >= MAX_ATTEMPTS
                and running.get("rueckweg") and not entry_problem(running["rueckweg"])):
            reason = f"{target_label(running['ziel'])} wurde {running['versuche']['ziel']}-mal unterbrochen"
            lock_target(running["ziel"], reason)
            running.update(phase="rueckweg", grund=reason)
            write_json(state_path("laeuft.json"), running)
            print(f"{reason}: gesperrt, Rückweg auf {target_label(running['rueckweg'])}.")
        entry = running[running["phase"]]
        if not repo_intact(entry["pfad"], entry["commit"]):
            print(f"{NAME}: Bereitstellung von {target_label(entry)} fehlt oder ist verändert.", file=sys.stderr)
            return EXIT_ERROR
        script = os.path.join(entry["pfad"], "scripts", "install.sh")
        try:
            with open(script, "rb") as f:
                supported = b"--nur-code" in f.read(1 << 20)
        except OSError:
            supported = False
        if not supported:
            print(f"install.sh von {target_label(entry)} kennt --nur-code nicht; die Übernahme vollendet zen update.")
            return EXIT_OK
        if installed_commit() == entry["commit"] and not git(CODE_DIR, "status", "--porcelain").stdout.strip():
            print(f"Code von {target_label(entry)} ist schon vollständig; den Rest holt zen update nach.")
            return EXIT_OK
        if DRY_RUN:
            return EXIT_OK
        print(f"Vollende die Übernahme des Codes von {target_label(entry)} …")
        rc = run_visible([script, "--nur-code"], install_env())
        done = installed_commit() == entry["commit"] and not git(CODE_DIR, "status", "--porcelain").stdout.strip()
        print("Code vollständig; den Rest holt zen update nach." if rc == 0 and done
              else f"{NAME}: Übernahme nicht vollständig (Exit {rc}).")
        return EXIT_OK if rc == 0 and done else EXIT_ERROR
    finally:
        lock.release()


# --- Selbsttest (der eben installierte zenos-kanal) ----------------------------------------------------------------

# Was der Probelauf im Selbsttest umbiegt (und danach zurückstellt)
SELFTEST_GLOBALS = ("STATE_DIR", "ANCHOR_DIR", "LOCK_FILE", "UI_LOCK_FILE", "HAND_MARK", "RUNTIME_DIR", "DRY_RUN",
                    "start_unit", "interactive")
SELFTEST_COPY = ("gesehen.json", "hoechste", "gut.json", "letzte.json", "stand.json", "angehalten", UNCONFIRMED, HOLD,
                 AUTO_LOG)


def cmd_selftest(argv):
    want_anchor = argv[:1] == ["--anker"]
    rest = argv[1:] if want_anchor else argv
    dry = rest[:1] == ["--probelauf"]
    rest = rest[1:] if dry else rest
    if rest and (len(rest) != 4 or rest[0] != "--tag"):
        print(f"{NAME} selbsttest [--anker] [--probelauf] [--tag NAME OBJEKT REPO]", file=sys.stderr)
        return EXIT_USAGE
    try:
        anchor = load_device_anchor()
    except AnchorError as e:
        if want_anchor or rest:
            print(f"selbsttest: Anker nicht lesbar: {e.reason}")
            return EXIT_BLOCKED
        anchor = None
    if rest:
        name, oid, repo = rest[1:]
        if not TAG_NAME_RE.fullmatch(name) or not OID_RE.fullmatch(oid):
            print("selbsttest: ungültiger Tag", file=sys.stderr)
            return EXIT_USAGE
        with tempfile.TemporaryDirectory(prefix="zenos-kanal.") as work:
            files = signer_files(anchor, os.path.join(work, "anker"))
            kind = git(repo, "cat-file", "-t", oid).stdout.strip()
            result = check_tag(repo, name, oid, kind, anchor, files, RELEASE_PRINCIPAL)
        if not result.ok:
            print(f"selbsttest: {name} gilt nicht: {result.reason}")
            return EXIT_BLOCKED
    if dry and os.geteuid() in TRUSTED_UIDS and os.path.isdir(STATE_DIR):
        problem = selftest_dry_run()
        if problem:
            print(f"selbsttest: {problem}")
            return EXIT_ERROR
    print("selbsttest ok")
    return EXIT_OK


def dry_unit(key, follow=False):
    """Ersatz für start_unit im Probelauf: prüfen läuft im Prozess, holen und installieren fallen aus."""
    del follow
    return cmd_check([]) if key == "pruefen" else EXIT_OK


def selftest_dry_run():
    """Probelauf des eben installierten Programms in einem Wegwerf-Zustand (STATE_DIR/selbsttest): status in allen
    Formen und zeitpunkt (nur lesend), zen update, zen rollback, jetzt und zustimmen bis zur Frage oder Bereitstellung
    (holen fällt aus, prüfen läuft im Prozess auf dem zuletzt geholten Bundle, ohne Netz), installieren und nachstart,
    ohne etwas bereitzustellen oder zu installieren. Der echte Zustand, der Anker, /opt/zenos und dpkg bleiben
    unberührt. So fällt ein Laufzeitfehler im neuen Programm auf, bevor er zen update aussperrt. Gibt einen Fehlertext
    zurück, sonst None. Fehler der Umgebung
    (Failure, OSError, etwa kein Platz) gelten nicht als Fehler des Programms."""
    g = globals()
    saved = {n: g[n] for n in SELFTEST_GLOBALS}
    base = state_path("selbsttest")
    shutil.rmtree(base, ignore_errors=True)
    try:
        os.makedirs(base, mode=0o700)
        state = os.path.join(base, "zustand")
        os.makedirs(state, mode=0o755)
        for name in SELFTEST_COPY:
            if os.path.isfile(state_path(name)) and not os.path.islink(state_path(name)):
                shutil.copyfile(state_path(name), os.path.join(state, name))
        if os.path.isdir(state_path("gesperrt")):
            shutil.copytree(state_path("gesperrt"), os.path.join(state, "gesperrt"), symlinks=True)
        anchor = os.path.join(base, "vertrauen")
        if os.path.isdir(ANCHOR_DIR) and not os.path.islink(ANCHOR_DIR):
            shutil.copytree(ANCHOR_DIR, anchor, symlinks=True)
        gut = load_json(state_path("gut.json")) or {}
        tag = gut["tag"] if isinstance(gut.get("tag"), str) and TAG_NAME_RE.fullmatch(gut["tag"]) else "v0.0.0"
        g.update(STATE_DIR=state, ANCHOR_DIR=anchor, LOCK_FILE=os.path.join(base, "sperre", "kanal.lock"),
                 UI_LOCK_FILE=os.path.join(base, "sperre", "bedienung.lock"),
                 HAND_MARK=os.path.join(base, "sperre", "hand"), RUNTIME_DIR=os.path.join(base, "laufzeit"),
                 DRY_RUN=True, start_unit=dry_unit, interactive=lambda: False)
        steps = (("status", ["status"]), ("status --json", ["status", "--json"]),
                 ("status --kurz", ["status", "--kurz"]), ("status --installation", ["status", "--installation"]),
                 ("anker", ["anker"]), ("zeitpunkt", ["zeitpunkt"]), ("automatik", ["automatik"]), ("update", ["update"]),
                 ("rollback", ["rollback", tag]), ("jetzt", ["jetzt", "0" * 40]),
                 ("zustimmen", ["zustimmen", "0" * 40]),
                 ("installieren", ["installieren"]), ("nachstart", ["nachstart"]))
        with open(os.devnull, "w", encoding="utf-8") as null, contextlib.redirect_stdout(null), \
                contextlib.redirect_stderr(null):
            for label, argv in steps:
                try:
                    main(argv)
                except (Failure, OSError):
                    continue
                except Exception as e:  # noqa: BLE001 – genau das soll der Probelauf finden
                    return f"Probelauf «{label}»: {type(e).__name__}: {short(e, 120)}"
    except OSError:
        return None
    finally:
        g.update(saved)
        shutil.rmtree(base, ignore_errors=True)
    return None


# --- Automatik (Timer, Zeitpunkt, Bestätigung nach dem Start) ------------------------------------------------------


def automatic_off():
    """Ist der Notschalter gesetzt (sudo zen kanal automatik aus)?"""
    return os.path.lexists(AUTOMATIC_OFF_FILE)


def valid_start_stamp(data):
    """Ist DATA ein Start-Stempel {start, seit_start} wie von boot_clock()?"""
    return (isinstance(data, dict) and isinstance(data.get("start"), str)
            and re.fullmatch(r"[0-9a-f-]{16,40}", data["start"]) is not None
            and isinstance(data.get("seit_start"), (int, float)) and not isinstance(data.get("seit_start"), bool))


def held_version():
    """Version, die nach «zen rollback» für die Automatik zurückgestellt ist (zurueckgestellt.json), sonst None."""
    held = (load_json(state_path(HOLD), trusted=True) or {}).get("zurueckgestellt")
    return held if isinstance(held, str) and version_key(held) else None


HAND_HELD_TEXT = (f"Von Hand angehalten: {CODE_DIR} kam mit install.sh aus einem Arbeitsstand, die Automatik ruht. "
                  "Zurück zum Kanal: zen update.")


def hand_held_summary():
    """Stand von Hand («angehalten», gesetzt von 10-code bei install.sh aus einem Arbeits-Checkout): {commit, seit},
    sonst None. Solange es ihn gibt, installiert die Automatik nichts; ein gelungenes zen update hebt ihn auf."""
    path = state_path(HAND_HELD)
    if not os.path.lexists(path):
        return None
    data = load_json(path) or {}
    return {"commit": data.get("commit") if OID_RE.fullmatch(str(data.get("commit"))) else None,
            "seit": data.get("zeit") if parse_iso(data.get("zeit")) else None}


def installation_state():
    """installation_summary als {schluessel, text} für stand.json."""
    key, text = installation_summary()
    return {"schluessel": key, "text": short(text, 400)}


def hold_summary():
    held = held_version()
    if not held:
        return None
    data = load_json(state_path(HOLD), trusted=True) or {}
    return {"version": held, "seit": data.get("zeit") if parse_iso(data.get("zeit")) else None}


def unconfirmed_summary():
    """Automatisch installierter Stand, der noch auf die Bestätigung nach einem Neustart wartet, sonst None."""
    data = load_json(state_path(UNCONFIRMED), trusted=True) or {}
    if not OID_RE.fullmatch(str(data.get("commit"))):
        return None
    fails = data.get("fehlstarts") if isinstance(data.get("fehlstarts"), list) else []
    return {"commit": data["commit"], "version": data.get("version") if version_key(data.get("version")) else None,
            "tag": data.get("tag") if TAG_NAME_RE.fullmatch(str(data.get("tag"))) else None,
            "seit": data.get("zeit") if parse_iso(data.get("zeit")) else None, "fehlstarts": len(fails)}


def systemd_env():
    return {"PATH": SYSTEM_PATH, "LANG": "C.UTF-8", "SYSTEMD_PAGER": "", "SYSTEMD_COLORS": "0"}


def logind_sessions():
    """Alle Sitzungen, die nicht gerade schliessen, als [{id, uid, user, seat, klasse, art, fern}] (art: logind Type,
    etwa wayland oder tty; fern: Remote, etwa SSH). None, wenn logind nicht antwortet oder eine Angabe fehlt bzw.
    seltsam ist (dann gilt nichts als ruhig); ohne systemd keine."""
    if not os.path.isdir(SYSTEMD_RUN_DIR):
        return []
    r = run([LOGINCTL, "list-sessions", "--json=short", "--no-pager"], env=systemd_env(), timeout=CHECK_TIMEOUT)
    try:
        items = json.loads(r.stdout) if r.returncode == 0 else None
    except ValueError:
        items = None
    if not isinstance(items, list):
        return None
    found = []
    for item in items:
        if not isinstance(item, dict):
            return None
        sid = str(item.get("session"))
        if not re.fullmatch(r"[A-Za-z0-9_-]{1,64}", sid):
            return None
        r = run([LOGINCTL, "show-session", sid, "--property=State", "--property=Type", "--property=Remote",
                 "--property=Class", "--property=Seat"], env=systemd_env(), timeout=CHECK_TIMEOUT)
        if r.returncode != 0:
            continue  # inzwischen beendet
        props = dict(z.split("=", 1) for z in r.stdout.split("\n") if "=" in z)
        if props.get("State") == "closing":
            continue
        # Fehlt eine Angabe in der Liste (andere Fassung von systemd), zählt die von show-session; fehlt beides, ist
        # die Lage nicht prüfbar (nie «niemand angemeldet»)
        klasse = item["class"] if "class" in item else props.get("Class")
        seat = item["seat"] if "seat" in item else (props.get("Seat") or None)
        if not isinstance(klasse, str) or klasse == "":
            return None
        if not klasse.startswith("user"):
            continue  # Greeter, Sperre, Hintergrund und Benutzerdienste
        uid, name = item.get("uid"), str(item.get("user"))
        if not isinstance(uid, int) or isinstance(uid, bool) or not USER_RE.fullmatch(name):
            return None
        found.append({"id": sid, "uid": uid, "user": name, "seat": seat, "klasse": klasse,
                      "art": props.get("Type") or "", "fern": props.get("Remote") == "yes"})
    return found


def seat_sessions(sessions=None):
    """Sitzungen von Menschen auf seat0 (Klasse user…, nicht beim Schliessen) als [(id, uid, name, art)]. Greeter,
    Sperre, Hintergrund und Benutzerdienste zählen nicht, Fern-Sitzungen (SSH) haben keinen Sitz. None, wenn logind
    nicht antwortet; ohne systemd keine."""
    sessions = logind_sessions() if sessions is None else sessions
    if sessions is None:
        return None
    return [(s["id"], s["uid"], s["user"], s["art"]) for s in sessions if s["seat"] == "seat0"]


def lock_start(path_stat):
    """Beginn einer Sperre aus dem Marker (UTC). Liegt er vor dem ersten Abgleich der Uhr (timesyncd), zählt der
    Abgleich: Davor stand die Uhr womöglich Stunden falsch (der Pi hat keine Uhr mit Batterie), und eine eben gesetzte
    Sperre wirkte sonst sofort alt."""
    since = path_stat.st_mtime
    with contextlib.suppress(OSError):
        since = max(since, os.stat(TIMESYNC_FLAG).st_mtime)
    return datetime.datetime.fromtimestamp(since, datetime.timezone.utc)


def session_locked(uid, name, t):
    """(gesperrt, Grund) für die Sitzung des Benutzers UID: Der Marker der Oberfläche (/run/user/<uid>/zenos/gesperrt,
    entsteht vor der Sperre, geht erst nach dem Entsperren) ist mindestens MIN_LOCKED alt, und die Oberfläche bestätigt
    die Sperre selbst: «zenos-ipc sperre status» als dieser Benutzer antwortet «gesperrt» (ext-session-lock, vom
    Compositor bestätigt). Antwortet sie nicht, gilt die Sitzung als nicht gesperrt."""
    runtime = os.path.join(RUN_USER, str(uid))
    try:
        st = os.lstat(os.path.join(runtime, "zenos", "gesperrt"))
    except OSError:
        return False, f"{name} ist angemeldet, nicht gesperrt"
    if not stat.S_ISREG(st.st_mode) or st.st_uid != uid:
        return False, f"Sperr-Marker von {name} ist ungültig"
    if t - lock_start(st) < MIN_LOCKED:
        return False, f"{name} ist erst seit Kurzem gesperrt (mindestens {MIN_LOCKED.seconds // 60} Min.)"
    try:
        account = pwd.getpwuid(uid)
    except KeyError:
        return False, f"Benutzer {uid} ist unbekannt"
    ipc = os.path.join(CODE_DIR, "scripts", "bin", "zenos-ipc")
    if not os.access(SETPRIV, os.X_OK) or not os.path.isfile(ipc):
        return False, "Sperre nicht prüfbar (setpriv oder zenos-ipc fehlt)"
    r = run([SETPRIV, f"--reuid={uid}", f"--regid={account.pw_gid}", "--init-groups", "--no-new-privs", "--", ipc,
             "sperre", "status"], env={"PATH": USER_PATH, "HOME": account.pw_dir, "XDG_RUNTIME_DIR": runtime,
                                        "LANG": "C.UTF-8"}, timeout=30)
    lines = [z.strip() for z in r.stdout.split("\n") if z.strip()]
    if r.returncode == 0 and lines and lines[-1] == "gesperrt":
        return True, ""
    return False, f"die Oberfläche von {name} bestätigt keine Sperre"


def local_now():
    return datetime.datetime.now()


def in_window(schedule, moment):
    """Liegt MOMENT (Ortszeit) im Zeitfenster [von, bis)? Über Mitternacht (22:00–04:00) gehört beides dazu."""
    a, b = clock_minutes(schedule.get("von")), clock_minutes(schedule.get("bis"))
    if a is None or b is None or a == b:
        return False
    m = moment.hour * 60 + moment.minute
    return a <= m < b if a < b else (m >= a or m < b)


def uptime():
    """Sekunden seit dem Start (/proc/uptime), None wenn unlesbar."""
    try:
        with open(os.path.join(PROC, "uptime"), encoding="ascii") as f:
            return float(f.read(64).split()[0])
    except (OSError, ValueError, IndexError):
        return None


def login_screen_quiet():
    """(ruhig, Grund) ohne Sitzung auf seat0: Erst wenn der Login-Bildschirm seit MIN_LOCKED läuft, wie bei der Sperre.
    Sonst träfe ein Lauf, den der Timer beim Start nachholt (Persistent), oder einer kurz nach dem Abmelden jemanden,
    der gerade das Passwort tippt. Gemessen an der Zeit seit dem Start (springt nicht mit der Uhr)."""
    if not os.path.isdir(SYSTEMD_RUN_DIR):
        return True, "niemand angemeldet"
    minutes = MIN_LOCKED.seconds // 60
    age = greeter_age()
    if age is not None:
        if age >= MIN_LOCKED.total_seconds():
            return True, f"niemand angemeldet (Login-Bildschirm seit {int(age // 60)} Min.)"
        return False, f"der Login-Bildschirm läuft erst seit Kurzem (mindestens {minutes} Min.)"
    if unit_value(["is-enabled", "greetd.service"]) in GREETD_ON:
        return False, "niemand angemeldet, aber der Login-Bildschirm läuft nicht (eben gestartet oder abgestürzt?)"
    # Gerät ohne Login-Bildschirm (greetd aus): die Zeit seit dem Start
    up = uptime()
    if up is not None and up >= MIN_LOCKED.total_seconds():
        return True, "niemand angemeldet"
    return False, f"eben gestartet (mindestens {minutes} Min.)"


def quiet_now(schedule):
    """(ruhig, Grund): Darf die Automatik jetzt installieren, nach dem Zeitpunkt des Geräts?"""
    art = schedule.get("art")
    if art == "hand":
        return False, "Zeitpunkt «von Hand»: automatisch wird nichts installiert"
    if art == "jederzeit":
        return True, "Zeitpunkt «jederzeit»"
    if art == "fenster":
        if not clock_synced():
            return False, f"Zeitfenster {schedule['von']}–{schedule['bis']}, aber die Uhr ist nicht synchronisiert"
        moment = local_now()
        if in_window(schedule, moment):
            return True, f"im Zeitfenster {schedule['von']}–{schedule['bis']}"
        return False, f"ausserhalb des Zeitfensters {schedule['von']}–{schedule['bis']} (jetzt {moment:%H:%M})"
    sessions = logind_sessions()
    if sessions is None:
        return False, "Sitzungen nicht prüfbar (loginctl)"
    # Wer per SSH angemeldet ist, arbeitet (etwa Claude Code im Terminal): «bei Sperre» heisst, niemand arbeitet.
    # Ein tmux-Server ohne offene Verbindung zählt nicht (er läuft oft tagelang weiter); was von Hand installiert
    # wurde, schützt «angehalten».
    remote = [s for s in sessions if s["fern"]]
    if remote:
        return False, f"{remote[0]['user']} ist per SSH angemeldet"
    seat = seat_sessions(sessions)
    if not seat:
        return login_screen_quiet()
    t = now()
    for _sid, uid, name, kind in seat:
        if kind == "tty":
            # Auf der Textkonsole (Ctrl+Alt+F3) gibt es keine Sperre der Oberfläche; Marker und Bestätigung gehören
            # zur grafischen Sitzung desselben Benutzers
            return False, f"{name} ist auf einer Textkonsole angemeldet"
        locked, why = session_locked(uid, name, t)
        if not locked:
            return False, why
    return True, "gesperrt"


def power_state():
    """(im Akkubetrieb, Prozent): True nur sicher im Akkubetrieb (Messwert in Ordnung, entlädt), False am Netzteil, None
    unbekannt (gilt wie in der Oberfläche als Netzteil). Zuerst die Statusdatei von zenos-argon (höchstens 5 Min.
    alt), sonst /sys/class/power_supply."""
    data = load_json(POWER_STATUS)
    when = None
    if isinstance(data, dict) and isinstance(data.get("zeit"), str):
        with contextlib.suppress(ValueError):
            when = datetime.datetime.fromisoformat(data["zeit"].replace("Z", "+00:00"))
    if when is not None and when.tzinfo is not None and abs(now() - when) <= POWER_STATUS_MAX_AGE:
        battery = data.get("akku") if isinstance(data.get("akku"), dict) else {}
        percent = battery.get("prozent")
        percent = percent if isinstance(percent, int) and not isinstance(percent, bool) else None
        if battery.get("vorhanden") is True and battery.get("zustand") == "ok":
            if battery.get("laedt") is False:
                return True, percent
            if battery.get("laedt") is True:
                return False, percent
    try:
        names = sorted(os.listdir(POWER_SUPPLY_DIR))
    except OSError:
        return None, None
    discharging, mains = None, False

    def value(name, key):
        with contextlib.suppress(OSError):
            with open(os.path.join(POWER_SUPPLY_DIR, name, key), encoding="ascii", errors="replace") as f:
                return f.read(64).strip()
        return ""

    for name in names:
        kind = value(name, "type")
        if kind in ("Mains", "USB") and value(name, "online") == "1":
            mains = True
        elif kind == "Battery" and value(name, "scope") != "Device" and value(name, "status") == "Discharging":
            capacity = value(name, "capacity")
            discharging = int(capacity) if capacity.isdigit() else -1
    if mains:
        return False, None
    if discharging is not None:
        return True, discharging if discharging >= 0 else None
    return None, None


def power_problem():
    """Grund, warum im Akkubetrieb gerade nicht automatisch installiert wird, sonst None. Am Netzteil, ab MIN_BATTERY
    Prozent oder unbekannt: None. Eine Installation, der mittendrin der Akku ausgeht (zenos-argon schaltet bei 3 % aus),
    hinterliesse einen halben Stand."""
    battery, percent = power_state()
    if not battery or (percent is not None and percent >= MIN_BATTERY):
        return None
    shown = f"{percent} %" if percent is not None else "unbekanntem Ladestand"
    return f"im Akkubetrieb mit {shown} (automatisch erst am Netzteil oder ab {MIN_BATTERY} %)"


def wait_for_clock():
    """Wartet bis CLOCK_WAIT Sekunden auf eine synchronisierte Uhr. True, wenn sie es ist."""
    end = time.monotonic() + CLOCK_WAIT
    while not clock_synced():
        if time.monotonic() >= end:
            return False
        time.sleep(CLOCK_POLL)
    return True


def reset_failed(*units):
    """«wartet», «Anker fehlt» oder «blockiert» lassen holen und prüfen mit Exit ungleich 0 enden: Das sind Zustände des
    Kanals (stand.json), keine Ausfälle des Systems. Ohne systemd nichts."""
    if not DRY_RUN and os.path.isdir(SYSTEMD_RUN_DIR):
        run([SYSTEMCTL, "reset-failed", "--", *units], env=systemd_env(), timeout=CHECK_TIMEOUT)


class AutoRun:
    """Ein Lauf der Automatik: «lauf» (zenos-kanal.timer, mit Holen) oder «gelegenheit» (alle 15 Min., ohne Holen).
    Hält die Sperre der Bedienung (wie zen update), die Arbeit machen die Units."""

    def __init__(self, fetch):
        self.fetch = fetch
        self.log = {"version": 1, "art": "lauf" if fetch else "gelegenheit", "beginn": iso(now()), "ende": None,
                    "ergebnis": None, "grund": "", "zeitpunkt": None, "ziel": None}

    def done(self, result, reason, code):
        self.log.update(ergebnis=result, grund=short(reason, 300), ende=iso(now()))
        print(f"Automatik: {reason}")
        return code

    def refresh(self):
        """Nach dem Holen den Stand neu prüfen (ohne Wunsch), damit stand.json und die Oberfläche ihn kennen."""
        if self.fetch:
            start_unit("pruefen")

    def may_install(self, schedule):
        """(ja, Grund): Zeitpunkt (quiet_now) und Akku. Wird unmittelbar vor dem Installieren wiederholt."""
        quiet, why = quiet_now(schedule)
        if not quiet:
            return False, why
        problem = power_problem()
        if problem:
            return False, problem
        return True, why

    def installed_result(self, code, begin):
        if code == EXIT_BLOCKED and hand_held_summary():
            # Ein install.sh von Hand wurde inzwischen fertig: Der Auftrag galt nicht mehr (letzte.json bleibt)
            return self.done("wartet", HAND_HELD_TEXT, EXIT_OK)
        last = load_json(state_path("letzte.json")) or {}
        ended = parse_iso(last.get("ende"))
        if ended and ended >= begin - datetime.timedelta(seconds=2):
            self.log["ziel"] = target_label(last.get("ziel")) if last.get("ziel") else None
            return self.done(last.get("ergebnis") or "fehler", last.get("grund") or f"Exit {code}", code)
        return self.done("fehler" if code not in (EXIT_OK, EXIT_BUSY) else "nichts",
                         f"Installieren endete mit Exit {code} (journalctl -u {UNITS['installieren']})", code)

    def resume(self, schedule, channel):
        """Eine unterbrochene Installation (laeuft.json, Strom oder kill) setzt die Automatik nur fort, wenn sie selbst
        sie begann (art «automatik» auf stabil oder vorschau) oder es der Weg zurück auf den guten Stand ist
        (art «bestaetigung»): Ihr Ziel wurde schon bereitgestellt und geprüft. Eine Installation von Hand (zen update,
        «Jetzt installieren», ein «ja», jeder Lauf auf dev) setzt nur zen update fort."""
        running = load_json(state_path("laeuft.json"), trusted=True) or {}
        target = running.get("ziel") if isinstance(running.get("ziel"), dict) else {}
        art = target.get("art")
        if not (art == "bestaetigung" or (art == "automatik" and channel in ("stabil", "vorschau"))):
            self.refresh()
            return self.done("wartet", f"Die Installation von {target_label(target)} von Hand wurde unterbrochen; "
                             "automatisch geht sie nicht weiter, fortsetzen: zen update.", EXIT_OK)
        ok, why = self.may_install(schedule)
        if not ok:
            self.refresh()
            return self.done("wartet", f"Eine Installation ist unterbrochen, fortgesetzt wird sie später ({why}).",
                             EXIT_OK)
        print(f"Setze die unterbrochene Installation fort ({why}) …")
        begin = now()
        code = start_unit("installieren")
        start_unit("pruefen")
        return self.installed_result(code, begin)

    def run(self):
        if automatic_off():
            return self.done("aus", f"aus ({AUTOMATIC_OFF_FILE}; einschalten: sudo zen kanal automatik an)", EXIT_OK)
        if not installed_commit():
            return self.done("nichts", f"{CODE_DIR} ist nicht installiert", EXIT_OK)
        pid = hand_run()
        if pid:
            return self.done("wartet", hand_text(pid), EXIT_BUSY)
        schedule, note = read_schedule()
        self.log["zeitpunkt"] = schedule.get("art")
        if note:
            print(f"Hinweis: {note}")
        try:
            channel, _ = read_channel()
        except Failure as e:
            channel = None
            print(f"Hinweis: {e}")
        if self.fetch:
            if not wait_for_clock():
                print(f"Die Uhr ist nach {CLOCK_WAIT} s nicht synchronisiert: Neue Versionen gelten erst als gesehen, "
                      "wenn sie es ist (Wartezeit auf stabil).")
            print("Hole von origin (ohne Rechte) …")
            if start_unit("holen") != EXIT_OK:
                print(f"Holen ist gescheitert (journalctl -u {UNITS['holen']}); geprüft wird der letzte Stand.")

        if os.path.lexists(state_path("laeuft.json")):
            return self.resume(schedule, channel)

        if channel == "dev":
            self.refresh()
            return self.done("nichts", "Kanal dev: Automatisch kommt nie etwas (zen update von Hand).", EXIT_OK)
        if channel not in ("stabil", "vorschau"):
            self.refresh()
            return self.done("nichts", "Kanal unbekannt: nichts automatisch.", EXIT_OK)
        if hand_held_summary():
            self.refresh()
            return self.done("wartet", HAND_HELD_TEXT, EXIT_OK)
        pending = load_json(state_path(UNCONFIRMED), trusted=True)
        if pending and pending.get("start") != start_id():
            # Erst muss der automatisch installierte Stand nach dem Neustart bestätigt sein (zenos-kanal bestaetigen):
            # Sonst begänne mit einer neuen Version die Zählung der Starts ohne Login von vorn
            self.refresh()
            return self.done("wartet", f"{target_label(pending)} wartet auf die Bestätigung nach dem Neustart; erst "
                             "danach kommt das nächste automatische Update.", EXIT_OK)
        ok, why = self.may_install(schedule)
        if not ok:
            self.refresh()
            return self.done("wartet", f"Nicht jetzt: {why}.", EXIT_OK)

        # Prüfen mit dem Wunsch der Automatik: Nur ein bereiter Stand nach der Wartezeit, ohne «ja», wird bereitgestellt
        wish_id = write_wish("automatik")
        code = start_unit("pruefen")
        with contextlib.suppress(FileNotFoundError):
            os.unlink(state_path("wunsch.json"))
        answer = (read_stand() or {}).get("wunsch") or {}
        if answer.get("id") != wish_id:
            if code == EXIT_BUSY:
                return self.done("wartet", "Eine Prüfung oder Installation lief gerade; beim nächsten Mal.", EXIT_BUSY)
            return self.done("fehler", f"Die Prüfung hat nicht geantwortet (Exit {code}; journalctl -u "
                             f"{UNITS['pruefen']}).", EXIT_ERROR)
        if answer.get("ergebnis") != "bereitgestellt":
            # «aktuell» heisst hier auch: bereit, aber noch in der Wartezeit oder wartet auf Zustimmung
            idle = answer.get("ergebnis") == "aktuell" and (read_stand() or {}).get("zustand") == "aktuell"
            return self.done("nichts" if idle else "wartet", answer.get("grund") or "Nichts bereit.", EXIT_OK)
        order = answer.get("auftrag") or {}
        self.log["ziel"] = target_label(order)
        # Unmittelbar davor noch einmal, mit dem Zeitpunkt von jetzt: Wurde er inzwischen geändert (etwa auf «von
        # Hand»), ist es inzwischen entsperrt, das Fenster vorbei oder der Akku zu leer?
        again, _ = read_schedule()
        ok, why = (False, f"der Zeitpunkt ist inzwischen «{schedule_text(again)}»") if again != schedule \
            else self.may_install(again)
        if not ok:
            with contextlib.suppress(FileNotFoundError):
                os.unlink(state_path("auftrag.json"))
            return self.done("wartet", f"{target_label(order)} war bereit, aber jetzt nicht mehr: {why}.", EXIT_OK)
        print(f"Installiere {target_label(order)} ({why}) …")
        begin = now()
        code = start_unit("installieren")
        start_unit("pruefen")
        return self.installed_result(code, begin)


def automatic_switch(on):
    """Notschalter: Timer ein- bzw. ausschalten und den Vermerk setzen bzw. entfernen (install.sh hält sich daran)."""
    if os.geteuid() not in TRUSTED_UIDS:
        print(f"{NAME} automatik: nur als root (sudo zen kanal automatik {'an' if on else 'aus'})", file=sys.stderr)
        return EXIT_USAGE
    os.umask(0o022)
    folder = os.path.dirname(AUTOMATIC_OFF_FILE)
    os.makedirs(folder, mode=0o755, exist_ok=True)
    problem = path_problem(folder)
    if problem:
        print(f"{NAME} automatik: {problem}. Nichts geändert.", file=sys.stderr)
        return EXIT_BLOCKED
    if on:
        with contextlib.suppress(FileNotFoundError):
            os.unlink(AUTOMATIC_OFF_FILE)
    else:
        write_atomic(AUTOMATIC_OFF_FILE, "# zenOS: Automatik des Kanals aus (sudo zen kanal automatik aus). Die Timer "
                                         "laufen nicht, install.sh schaltet sie nicht ein.\n# Einschalten: sudo zen "
                                         f"kanal automatik an\nseit={iso(now())}\n")
    code = EXIT_OK
    if os.path.isdir(SYSTEMD_RUN_DIR):
        r = run([SYSTEMCTL, "enable" if on else "disable", "--now", "--quiet", "--", *TIMERS], env=systemd_env(),
                timeout=CHECK_TIMEOUT)
        if r.returncode != 0:
            print(f"{NAME} automatik: systemctl: {first_line(r.stderr) or r.returncode} (Timer fehlen? install.sh)",
                  file=sys.stderr)
            code = EXIT_ERROR
    via = caller_text()
    journal(f"Automatik {'an' if on else 'aus'} ({via})")
    print("Automatik an: holt alle 6 h, installiert nach dem Zeitpunkt (zen kanal zeitpunkt)." if on else
          "Automatik aus: nichts wird mehr automatisch geholt oder installiert. zen update geht weiter; einschalten: "
          "sudo zen kanal automatik an")
    return code


def timer_next(timer):
    """Nächster Lauf eines Timers als Text, sonst ""."""
    if not os.path.isdir(SYSTEMD_RUN_DIR):
        return ""
    r = run([SYSTEMCTL, "show", "--property=NextElapseUSecRealtime", "--value", "--", timer], env=systemd_env(),
            timeout=CHECK_TIMEOUT)
    value = r.stdout.strip()
    return short(value, 40) if r.returncode == 0 and value and value not in ("n/a", "0") else ""


def timer_active(timer):
    if not os.path.isdir(SYSTEMD_RUN_DIR):
        return None
    return run([SYSTEMCTL, "is-active", "--quiet", "--", timer], env=systemd_env(),
               timeout=CHECK_TIMEOUT).returncode == 0


def automatic_lines(with_pending=True):
    """Zeilen zur Automatik für status und «zenos-kanal automatik» (with_pending: auch den unbestätigten Stand; status
    zeigt ihn schon unter «Update»)."""
    lines = []
    if automatic_off():
        lines.append(f"{'Automatik':<12}aus (sudo zen kanal automatik an)")
    else:
        active = timer_active(TIMERS[0])
        nxt = timer_next(TIMERS[0])
        state = "an" if active in (True, None) else "an, aber zenos-kanal.timer läuft nicht (install.sh)"
        lines.append(f"{'Automatik':<12}{state}" + (f" · nächstes Holen {nxt}" if nxt else ""))
    log = load_json(state_path(AUTO_LOG)) or {}
    if parse_iso(log.get("ende")):
        lines.append(f"{'':<12}zuletzt {local_time(log['ende'])} ({log.get('art')}): {short(log.get('grund'), 160)}")
    pending = unconfirmed_summary() if with_pending else None
    if pending:
        label = pending["tag"] or pending["commit"][:12]
        more = f", {pending['fehlstarts']} Start ohne Login" if pending["fehlstarts"] else ""
        lines.append(f"{'Bestätigung':<12}{label} automatisch installiert am {local_time(pending['seit'])}: gilt als "
                     f"gut, sobald nach einem Neustart der Login kommt{more}")
    hold = hold_summary()
    if hold:
        lines.append(f"{'Zurückgest.':<12}{hold['version']} (seit {local_time(hold['seit'])} nach zen rollback; die "
                     "Automatik bringt es nicht wieder, zen update schon)")
    return lines


def cmd_automatic(argv):
    usage = f"{NAME} automatik [an|aus|lauf|gelegenheit]"
    if not argv:
        schedule, note = read_schedule()
        print("\n".join(automatic_lines()))
        print(f"{'Zeitpunkt':<12}{schedule_text(schedule)}" + (f" ({note})" if note else ""))
        return EXIT_OK
    if argv in (["an"], ["aus"]):
        return automatic_switch(argv[0] == "an")
    if argv not in (["lauf"], ["gelegenheit"]):
        print(usage, file=sys.stderr)
        return EXIT_USAGE
    if os.geteuid() not in TRUSTED_UIDS:
        print(f"{NAME} automatik {argv[0]}: nur als root (zenos-kanal.timer)", file=sys.stderr)
        return EXIT_USAGE
    os.umask(0o022)
    try:
        lock = take_lock(UI_LOCK_FILE)
    except Failure as e:
        print(f"{NAME}: {e}", file=sys.stderr)
        return EXIT_ERROR
    if lock is None:
        holder = lock_holder(UI_LOCK_FILE)
        print(f"Automatik: Ein zen update, zen rollback oder ein Knopf der Einstellungen läuft gerade"
              f"{f' ({holder})' if holder else ''}; beim nächsten Mal.")
        return EXIT_BUSY
    auto = AutoRun(fetch=argv[0] == "lauf")
    try:
        try:
            code = auto.run()
        except Failure as e:
            code = auto.done("fehler", str(e), EXIT_ERROR)
    finally:
        os.close(lock)
        reset_failed(UNITS["holen"], UNITS["pruefen"])
    with contextlib.suppress(OSError):
        if os.path.isdir(STATE_DIR) and not path_problem(STATE_DIR):
            write_json(state_path(AUTO_LOG), auto.log)
    return code


# --- Bestätigung nach dem Start (ein automatisch installierter Stand) ------------------------------------------


def unit_value(args):
    r = run([SYSTEMCTL, *args], env=systemd_env(), timeout=CHECK_TIMEOUT)
    return r.stdout.strip().split("\n")[0] if r.stdout.strip() else ""


def greeter_age():
    """Sekunden, seit der Login-Bildschirm läuft: Alter des ältesten Prozesses «quickshell» des Benutzers _greetd,
    gemessen an der Zeit seit dem Start (springt nicht mit der Uhr). None, wenn keiner läuft."""
    try:
        uid = pwd.getpwnam(GREETER_USER).pw_uid
        tick = os.sysconf("SC_CLK_TCK")
        pids = [p for p in os.listdir(PROC) if p.isdigit()]
    except (KeyError, OSError, ValueError):
        return None
    up = uptime()
    if up is None:
        return None
    oldest = None
    for pid in pids:
        try:
            if os.stat(os.path.join(PROC, pid)).st_uid != uid:
                continue
            with open(os.path.join(PROC, pid, "stat"), encoding="utf-8", errors="replace") as f:
                raw = f.read(4096)
            comm = raw[raw.index("(") + 1:raw.rindex(")")]
            started = int(raw.rsplit(")", 1)[1].split()[19]) / tick
        except (OSError, ValueError, IndexError):
            continue
        if comm == GREETER_COMM:
            age = max(0.0, up - started)
            oldest = age if oldest is None else max(oldest, age)
    return oldest


def greeter_running():
    """Läuft der Login-Bildschirm seit mindestens GREETER_MIN_AGE Sekunden (ein Greeter, den greetd immer wieder neu
    startet, zählt so nicht)?"""
    age = greeter_age()
    return age is not None and age >= GREETER_MIN_AGE


GREETD_ON = ("enabled", "enabled-runtime", "static", "alias", "indirect", "generated")


def login_state(need_greetd):
    """(gut, Grund): Kommt der Login? greetd läuft, und ein Greeter läuft oder eine grafische Sitzung auf seat0 ist
    offen (logind Type wayland oder x11). Eine Anmeldung auf der Textkonsole zählt nicht: Genau dorthin weicht man aus,
    wenn der grafische Login kaputt ist. Ohne need_greetd (greetd war bei der Installation nicht aktiviert) und ohne
    aktiviertes greetd gibt es keinen Login zu prüfen."""
    if not os.path.isdir(SYSTEMD_RUN_DIR):
        return True, "ohne systemd"
    enabled = unit_value(["is-enabled", "greetd.service"])
    if enabled not in GREETD_ON and not need_greetd:
        return True, f"greetd ist nicht aktiviert ({enabled or '?'}), kein Login zu prüfen"
    active = unit_value(["is-active", "greetd.service"])
    if active != "active":
        return False, f"greetd läuft nicht ({active or '?'})"
    sessions = seat_sessions() or []
    if any(kind in GRAPHICAL_TYPES for _sid, _uid, _name, kind in sessions):
        return True, "eine grafische Sitzung ist offen"
    if greeter_running():
        return True, "der Login-Bildschirm läuft"
    if sessions:
        return False, "nur eine Anmeldung ohne grafische Sitzung (Textkonsole), kein Login-Bildschirm"
    return False, "greetd läuft, aber weder Login-Bildschirm noch Sitzung"


def wait_for_login(need_greetd):
    end = time.monotonic() + CONFIRM_WAIT
    while True:
        ok, why = login_state(need_greetd)
        if ok or time.monotonic() >= end:
            return ok, why
        time.sleep(CONFIRM_POLL)


def broken_note(pending, reason):
    """letzte.json «kaputt», wenn es nach fehlender Bestätigung keinen Weg zurück gibt."""
    write_json(state_path("letzte.json"), {"version": 1, "ergebnis": "kaputt", "grund": short(reason, 600),
                                           "beginn": iso(now()), "ende": iso(now()),
                                           "ziel": {k: pending.get(k) for k in ENTRY_KEYS}, "rueckweg": None,
                                           "versuche": None, "hinweise": []})


def back_to_good(pending, why):
    """Zweimal kein Login nach dem Start: die Version sperren und den guten Stand (gut.json) über
    zenos-kanal-installieren.service wieder installieren. unbestaetigt.json bleibt, bis das gelingt (dann schreibt die
    Installation gut.json und entfernt es): Scheitert der Weg zurück, versucht ihn der nächste Start noch einmal."""
    label = target_label(pending)
    reason = f"Nach dem automatischen Update auf {label} kam bei {MAX_UNCONFIRMED} Starts kein Login ({why})"
    locked = lock_target(pending, reason)
    pending["zurueck"] = iso(now())
    write_json(state_path(UNCONFIRMED), pending)
    journal(f"{reason}: {locked} gesperrt, zurück auf den guten Stand")
    gut = load_json(state_path("gut.json"), trusted=True) or {}
    commit = gut.get("commit")
    if not OID_RE.fullmatch(str(commit)) or commit == pending["commit"]:
        with contextlib.suppress(FileNotFoundError):
            os.unlink(state_path(UNCONFIRMED))
        broken_note(pending, f"{reason}; einen guten Stand für den Weg zurück gibt es nicht. ANLEITUNG.md, Abschnitt F.")
        print(f"{reason}. Kein guter Stand für den Weg zurück.", file=sys.stderr)
        return EXIT_BROKEN
    folder = state_path("bereit", commit)
    if not repo_intact(folder, commit):
        branch = gut.get("zweig") if BRANCH_RE.fullmatch(str(gut.get("zweig"))) else None
        try:
            origin = origin_url()
        except Failure:
            origin = None
        try:
            folder = stage(CODE_DIR, [f"+{commit}:refs/heads/{branch or 'zenos-gut'}"], commit, branch, origin)
        except (Waiting, Failure) as e:
            broken_note(pending, f"{reason}; der gute Stand {target_label(gut)} liess sich nicht bereitstellen ({e}). "
                        "Beim nächsten Start versucht es zenOS noch einmal.")
            print(f"{reason}. Guter Stand nicht bereitzustellen: {e}", file=sys.stderr)
            return EXIT_BROKEN
    order = {"version": 1, **{k: gut.get(k) for k in ENTRY_KEYS}, "pfad": folder, "art": "bestaetigung",
             "von_hand": False, "hoechste": False, "quelle": "gut", **stamp()}
    write_json(state_path("auftrag.json"), order)
    print(f"{reason}. Zurück auf den guten Stand {target_label(gut)} …")
    code = start_unit("installieren")
    if (code == EXIT_OK and not DRY_RUN and os.path.isdir(SYSTEMD_RUN_DIR) and seat_sessions() == []
            and unit_value(["is-enabled", "greetd.service"]) in GREETD_ON):
        # Niemand ist angemeldet: den Login gleich neu starten, nicht erst beim nächsten Start
        run([SYSTEMCTL, "restart", "greetd.service"], env=systemd_env(), timeout=CHECK_TIMEOUT)
    start_unit("pruefen")
    return code


def cmd_confirm(argv):
    """bestaetigen (zenos-kanal-bestaetigen.timer, 2 Min. nach dem Start): Kommt nach einem automatischen Update der
    Login, gilt der Stand als gut (gut.json). Sonst zählt dieser Start; beim zweiten geht es zurück. Läuft gerade eine
    Automatik oder ein zen update, wartet es bis CONFIRM_LOCK_WAIT auf die Sperre der Bedienung (der Timer feuert nur
    einmal je Start)."""
    if argv:
        print(f"{NAME} bestaetigen: keine Argumente erwartet", file=sys.stderr)
        return EXIT_USAGE
    if os.geteuid() not in TRUSTED_UIDS:
        print(f"{NAME} bestaetigen: nur als root", file=sys.stderr)
        return EXIT_USAGE
    os.umask(0o022)
    end = time.monotonic() + CONFIRM_LOCK_WAIT
    said = False
    while True:
        try:
            lock = take_lock(UI_LOCK_FILE)
        except Failure as e:
            print(f"{NAME}: {e}", file=sys.stderr)
            return EXIT_ERROR
        if lock is not None:
            break
        if time.monotonic() >= end:
            print("Ein zen update, zen rollback oder die Automatik läuft noch immer; bestätigt wird beim nächsten "
                  "Start.")
            return EXIT_BUSY
        if not said:
            holder = lock_holder(UI_LOCK_FILE)
            print(f"Ein zen update, zen rollback oder die Automatik läuft gerade{f' ({holder})' if holder else ''}; "
                  "die Bestätigung wartet darauf.")
            said = True
        time.sleep(CONFIRM_POLL)
    try:
        return confirm_locked()
    finally:
        os.close(lock)


def confirm_locked():
    pending = load_json(state_path(UNCONFIRMED), trusted=True)
    if not pending:
        print("Nichts zu bestätigen.")
        return EXIT_OK
    problem = entry_problem(pending)
    if problem:
        os.replace(state_path(UNCONFIRMED), state_path("unbestaetigt.kaputt.json"))
        print(f"{NAME}: {UNCONFIRMED} ist unbrauchbar ({problem}); beiseite gelegt.", file=sys.stderr)
        return EXIT_ERROR
    label = target_label(pending)
    if installed_commit() != pending["commit"]:
        with contextlib.suppress(FileNotFoundError):
            os.unlink(state_path(UNCONFIRMED))
        print(f"{label} ist nicht mehr installiert; nichts zu bestätigen.")
        return EXIT_OK
    sid = start_id()
    if not sid or sid == pending.get("start"):
        print(f"{label}: Seit der automatischen Installation kein Neustart; bestätigt wird nach dem nächsten Start.")
        return EXIT_OK
    ok, why = wait_for_login(pending.get("greetd") in GREETD_ON)
    if ok:
        gut = {k: pending.get(k) for k in ENTRY_KEYS}
        gut.update(zeit=pending.get("zeit") if parse_iso(pending.get("zeit")) else iso(now()), bestaetigt=iso(now()))
        write_json(state_path("gut.json"), gut)
        with contextlib.suppress(FileNotFoundError):
            os.unlink(state_path(UNCONFIRMED))
        if pending.get("zurueck"):
            # Der Weg zurück scheiterte, und jetzt kommt der Login doch: Die Sperre aus back_to_good gilt nicht mehr
            name = pending.get("version") if version_key(pending.get("version") or "") else pending["commit"]
            with contextlib.suppress(FileNotFoundError):
                os.unlink(state_path("gesperrt", name))
        cleanup_staged({pending["commit"]})
        journal(f"Bestätigt nach dem Neustart: {label} ({why})")
        print(f"Bestätigt: {label} ist der gute Stand ({why}).")
        return EXIT_OK
    fails = [x for x in pending.get("fehlstarts") or [] if isinstance(x, str)]
    if sid not in fails:
        fails.append(sid)
    pending["fehlstarts"] = fails[-10:]
    write_json(state_path(UNCONFIRMED), pending)
    journal(f"Nach dem Neustart kein Login für {label} ({why}), {len(fails)}. Start")
    if len(fails) < MAX_UNCONFIRMED:
        print(f"Nach dem Neustart kein Login ({why}). Fehlt er auch beim nächsten Start, geht es zurück auf den guten "
              "Stand.")
        return EXIT_WAIT
    return back_to_good(pending, why)


# --- zen update und zen rollback (root, im Terminal) ---------------------------------------------------------------


def start_unit(key, follow=False):
    """Startet eine der Units und wartet, bis sie fertig ist. follow: ihr Journal läuft mit. Exit-Code des Programms."""
    unit = UNITS[key]
    env = {"PATH": SYSTEM_PATH, "LANG": "C.UTF-8", "SYSTEMD_PAGER": "", "SYSTEMD_COLORS": "0"}
    journal = None
    sys.stdout.flush()
    if follow:
        since = f"@{int(time.time())}"
        journal = subprocess.Popen([JOURNALCTL, "--follow", "--output=cat", "--no-pager", f"--since={since}",
                                    f"--unit={unit}"], stdin=subprocess.DEVNULL, env=env)
    try:
        r = run([SYSTEMCTL, "start", unit], env=env, timeout=None)
    finally:
        if journal:
            time.sleep(1)
            journal.terminate()
            with contextlib.suppress(subprocess.TimeoutExpired):
                journal.wait(5)
    status = run([SYSTEMCTL, "show", "--property=ExecMainStatus", "--value", unit], env=env).stdout.strip()
    if r.returncode != 0 and (not status.isdigit() or int(status) == 0):
        # Die Unit lief gar nicht (fehlt, Abhängigkeit gescheitert): ExecMainStatus wäre der eines früheren Laufs
        print(f"{NAME}: {unit}: {first_line(r.stderr) or 'Start gescheitert'}", file=sys.stderr)
        return EXIT_ERROR
    if status.isdigit():
        return int(status)
    return EXIT_OK if r.returncode == 0 else EXIT_ERROR


class Operator:
    """«zen update» und «zen rollback»: Wunsch schreiben, holen, prüfen, nach Bedarf «ja» fragen, installieren. Alles
    mit Gewicht läuft in den Units; dieses Programm zeigt nur und fragt. terminal=False («jetzt» und «zustimmen» aus
    den Einstellungen, als Unit): nie fragen, dem Journal der Installation nicht folgen (es steht schon im Journal)."""

    def __init__(self, terminal=True):
        self.terminal = terminal

    def run(self, wish):
        if os.geteuid() not in TRUSTED_UIDS:
            print(f"{NAME}: nur als root (zen update, zen rollback)", file=sys.stderr)
            return EXIT_USAGE
        os.umask(0o022)
        try:
            lock = take_lock(UI_LOCK_FILE)
        except Failure as e:
            print(f"{NAME}: {e}", file=sys.stderr)
            return EXIT_ERROR
        if lock is None:
            holder = lock_holder(UI_LOCK_FILE)
            print(f"{NAME}: Ein anderes zen update oder zen rollback läuft gerade{f' ({holder})' if holder else ''}.",
                  file=sys.stderr)
            return EXIT_BUSY
        try:
            return self.steps(wish)
        except KeyboardInterrupt:
            print("\nAbgebrochen. Eine laufende Installation läuft im Hintergrund weiter "
                  "(journalctl -fu zenos-kanal-installieren.service).", file=sys.stderr)
            return 130
        finally:
            os.close(lock)

    def steps(self, wish):
        if not installed_commit():
            print(f"{NAME}: {CODE_DIR} ist nicht installiert. Zuerst im Repo ./scripts/install.sh ausführen.",
                  file=sys.stderr)
            return EXIT_ERROR
        pid = hand_run()
        if pid:
            print(f"{NAME}: {hand_text(pid)}", file=sys.stderr)
            return EXIT_BUSY
        running = load_json(state_path("laeuft.json"), trusted=True)
        if running is not None:
            entry = running.get(running.get("phase")) if isinstance(running.get("phase"), str) else None
            print(f"Eine Installation wurde unterbrochen ({target_label(entry)}). Sie wird zuerst fortgesetzt.")
            if wish["art"] == "rollback":
                print(f"Danach noch einmal: zen rollback {wish['tag']}")
            return self.install()
        stand, code = self.check(wish, fetch=wish.get("holen", True))
        if stand is None:
            return code
        answer = stand["wunsch"]
        if answer["ergebnis"] == "zustimmung":
            question = answer.get("frage") or {}
            if wish.get("ja"):
                # «Zustimmen …» galt einem anderen Stand als dem, den die Prüfung jetzt nennt: nichts installieren
                print(f"{question.get('ziel')} braucht eine neue Zustimmung: Die gegebene galt "
                      f"{str(wish['ja'])[:12]}, die Prüfung nennt jetzt {str(question.get('id'))[:12]}. "
                      "Nichts geändert.")
                return EXIT_WAIT
            if not self.agree(question):
                return EXIT_WAIT
            stand, code = self.check({**wish, "ja": question["id"]}, fetch=False)
            if stand is None:
                return code
            answer = stand["wunsch"]
        result = answer["ergebnis"]
        print(answer.get("grund") or "")
        if result == "bereitgestellt":
            return self.install()
        return {"aktuell": EXIT_OK, "wartet": EXIT_WAIT, "zustimmung": EXIT_WAIT}.get(result, EXIT_BLOCKED)

    def check(self, wish, fetch=True):
        """(stand.json mit der Antwort auf den Wunsch, Exit) oder (None, Exit): 75, wenn gerade etwas anderes läuft."""
        sys.stdout.flush()
        wish_id = write_wish(wish["art"], wish.get("tag"), wish.get("ja"), wish.get("nur_signiert", False),
                             wish.get("ziel"))
        if fetch:
            print("Hole von origin (ohne Rechte) …")
            if start_unit("holen") != EXIT_OK:
                contact = read_fetch_status()
                print(f"Warnung: Holen ist gescheitert ({contact['fehler'] or 'journalctl -u zenos-kanal-holen'}). "
                      f"Es gilt der Stand vom {local_time(contact['letzter_kontakt'])}.", file=sys.stderr)
        print("Prüfe (ohne Netz) …")
        code = start_unit("pruefen")
        with contextlib.suppress(FileNotFoundError):
            os.unlink(state_path("wunsch.json"))
        stand = read_stand()
        if not stand or not isinstance(stand.get("wunsch"), dict) or stand["wunsch"].get("id") != wish_id:
            if code == EXIT_BUSY:
                print(f"{NAME}: {busy_text(LOCK_FILE)}", file=sys.stderr)
                return None, EXIT_BUSY
            print(f"{NAME}: Die Prüfung hat nicht geantwortet (Exit {code}; journalctl -u zenos-kanal-pruefen).",
                  file=sys.stderr)
            return None, EXIT_ERROR
        for note in stand.get("hinweise") or []:
            print(f"  Hinweis: {note}")
        return stand, code

    def agree(self, question):
        print(f"\n{question.get('ziel')} braucht deine Zustimmung:")
        for reason in question.get("gruende") or []:
            print(f"  – {reason}")
        commits = question.get("commits")
        if commits:
            print("Neue Commits (G = gültig signiert):")
            for c in commits:
                if "weitere" in c:
                    print(f"  … und {c['weitere']} weitere")
                else:
                    print(f"  {c.get('zeichen')} {str(c.get('commit'))[:12]} {c.get('titel')}")
        if not self.terminal:
            print("Das braucht deine Zustimmung: in den Einstellungen (System › Updates, mit Passwort; nur für gültig "
                  "signierte Versionen) oder im Terminal mit zen update. Nichts geändert.")
            return False
        if not interactive():
            print("Zustimmen geht nur im Terminal: zen update bzw. zen rollback dort ausführen. Nichts geändert.")
            return False
        typed = ask(f"Genau diesen Stand ({str(question.get('id'))[:12]}) installieren? Tippe «ja»: ").strip()
        if typed != "ja":
            print("Nichts geändert.")
            return False
        return True

    def install(self):
        print("Installiere als zenos-kanal-installieren.service (läuft auch ohne dieses Terminal zu Ende) …")
        begin = now()
        code = start_unit("installieren", follow=self.terminal)
        last = load_json(state_path("letzte.json")) or {}
        ended = parse_iso(last.get("ende"))
        if ended and ended >= begin - datetime.timedelta(seconds=2):
            print(f"\n{RESULT_TEXT.get(last.get('ergebnis'), last.get('ergebnis'))}: {last.get('grund')}")
        if not DRY_RUN:
            # Den Stand danach neu prüfen (ohne Netz, ohne Wunsch): Sonst zeigten zen kanal status und zen doctor die
            # Lage vor der Installation («neue Version bereit», «von Hand geändert?»)
            start_unit("pruefen")
        return code


def cmd_update(argv):
    if argv:
        print(f"{NAME} update: keine Argumente erwartet", file=sys.stderr)
        return EXIT_USAGE
    return Operator().run({"art": "update", "tag": None})


def cmd_rollback(argv):
    if len(argv) != 1 or not TAG_NAME_RE.fullmatch(argv[0]):
        print(f"{NAME} rollback TAG (etwa v0.1.0-rc3)", file=sys.stderr)
        return EXIT_USAGE
    return Operator().run({"art": "rollback", "tag": argv[0]})


def cmd_now(argv):
    """«Jetzt installieren» (zenos-kanal-jetzt@ZIEL.service, gestartet von zenos-kanal-bedienen über polkit ohne
    Passwort): wie zen update, aber ohne Terminal und ohne neues Holen, nur für genau den Stand, den die Einstellungen
    zeigten (ZIEL: sein Tag-Objekt, auf dev der Commit) und den die letzte Prüfung schon geprüft hat. Nennt die Prüfung
    ein anderes Ziel, geschieht nichts (Exit 10). Was ein «ja» bräuchte (unsigniert, Firewall, Netz, Boot, gesperrt,
    Rückschritt), bleibt liegen (Exit 10)."""
    if len(argv) != 1 or not OID_RE.fullmatch(argv[0]):
        print(f"{NAME} jetzt ZIEL (40 Zeichen 0-9a-f: Tag-Objekt bzw. auf dev der Commit aus stand.json)",
              file=sys.stderr)
        return EXIT_USAGE
    return Operator(terminal=False).run({"art": "update", "tag": None, "ziel": argv[0], "holen": False})


def cmd_consent(argv):
    """«Zustimmen …» (zenos-kanal-zustimmen@OBJEKT.service, gestartet von zenos-kanal-bedienen über polkit mit
    Passwort): wie zen update ohne neues Holen, mit dem «ja» für genau dieses Tag-Objekt (das die Einstellungen
    zeigten). Nur für gültig signierte Ziele; nennt die Prüfung ein anderes Objekt, geschieht nichts (Exit 10)."""
    if len(argv) != 1 or not OID_RE.fullmatch(argv[0]):
        print(f"{NAME} zustimmen OBJEKT (40 Zeichen 0-9a-f, das Tag-Objekt aus stand.json)", file=sys.stderr)
        return EXIT_USAGE
    return Operator(terminal=False).run({"art": "update", "tag": None, "ja": argv[0], "nur_signiert": True,
                                         "holen": False})


# --- Status ----------------------------------------------------------------------------------------------------

STATE_TEXT = {
    "aktuell": "aktuell",
    "bereit": "neue Version bereit",
    "zustimmung": "wartet auf Zustimmung",
    "dev": "dev, nur von Hand",
    "anker_fehlt": "Anker fehlt",
    "blockiert": "blockiert",
    "kein_kontakt": "kein Kontakt",
    "fehler": "Fehler",
}

RESULT_TEXT = {
    "installiert": "Installiert",
    "zurueck": "Gescheitert, zurück auf dem Stand davor",
    "gescheitert": "Gescheitert",
    "kaputt": "Kaputt",
    "unterbrochen": "Unterbrochen",
    "abgelehnt": "Abgelehnt",
    "wartet": "Wartet",
    "fehler": "Fehler",
    "nichts": "Nichts zu tun",
}


def anchor_lines():
    """Zeilen zum Anker des Geräts mit Fingerabdrücken."""
    try:
        anchor = load_device_anchor()
    except AnchorError as e:
        hint = " (kommt mit install.sh, sobald system/vertrauen Schlüssel hat)" if e.empty else ""
        return [f"{'Anker':<12}{ANCHOR_DIR} · fehlt: {e.reason}{hint}"], False
    lines = [f"{'Anker':<12}{ANCHOR_DIR} · Serie {anchor.series} (Fingerabdrücke mit 1Password vergleichen)",
             f"{'  Wurzel':<14}{fingerprint(anchor.root)}"]
    for i, key in enumerate(anchor.release):
        lines.append(f"{'  Release' if i == 0 else '':<14}{fingerprint(key)}")
    if anchor.revoked:
        for i, key in enumerate(anchor.revoked):
            lines.append(f"{'  Widerrufen' if i == 0 else '':<14}{fingerprint(key)}")
    else:
        lines.append(f"{'  Widerrufen':<14}keine")
    return lines, True


def read_stand():
    stand = load_json(os.path.join(STATE_DIR, "stand.json"))
    return stand if stand and stand.get("version") == 1 else None


def stand_outdated(stand):
    """Grund, warum der Stand nicht mehr zur Lage passt (der Anker hat sich seit der letzten Prüfung geändert, oder
    seither wurde installiert), sonst None."""
    try:
        live = load_device_anchor().summary()
    except AnchorError:
        live = None
    if stand.get("anker") != live and not (live is None and stand.get("zustand") == "anker_fehlt"):
        return "Der Anker hat sich seit der letzten Prüfung geändert"
    if stand.get("installation") != installation_marks():
        return "Seit der letzten Prüfung wurde installiert"
    return None


def installation_marks():
    """Prüfsumme von letzte.json und gut.json: stand.json merkt sie sich, status sieht so, ob seither installiert
    wurde."""
    digest = hashlib.sha256()
    for name in ("letzte.json", "gut.json"):
        try:
            digest.update(read_small(state_path(name), limit=4 << 20).encode("utf-8"))
        except (FileNotFoundError, Failure):
            pass
        digest.update(b"\0")
    return digest.hexdigest()[:16]


def installation_summary():
    """(Schlüssel, Text) zur Installation über den Kanal, für status, zen doctor und zen version. Schlüssel:
    unterbrochen, kaputt, angehalten, zurueck, gescheitert, fehler, unbestaetigt, gut, keine."""
    running = load_json(state_path("laeuft.json"))
    if running:
        phase = running.get("phase") if running.get("phase") in ("ziel", "rueckweg") else "ziel"
        tries = (running.get("versuche") or {}).get(phase, "?")
        what = "Rückweg auf" if phase == "rueckweg" else "Installation von"
        return "unterbrochen", (f"{what} {target_label(running.get(phase))} unterbrochen (Versuch {tries}); zen update "
                                "setzt sie fort")
    last = load_json(state_path("letzte.json")) or {}
    problem = last.get("ergebnis") in ("kaputt", "zurueck", "gescheitert", "fehler")
    if os.path.lexists(state_path("angehalten")):
        data = load_json(state_path("angehalten")) or {}
        # Was zuletzt geschah, zählt: Ein Lauf von Hand nach einem «kaputt» (Notweg) löst es ab, und umgekehrt
        held, ended = parse_iso(data.get("zeit")), parse_iso(last.get("ende"))
        if not problem or (held and ended and held > ended):
            return "angehalten", (f"{CODE_DIR} kam am {local_time(data.get('zeit'))} von Hand aus einem Arbeitsstand "
                                  f"({str(data.get('commit') or '?')[:12]}); zen update kehrt zum Kanal zurück")
    if problem:
        return last["ergebnis"], f"am {local_time(last.get('ende'))}: {last.get('grund')}"
    pending = unconfirmed_summary()
    if pending:
        return "unbestaetigt", (f"{pending['tag'] or pending['commit'][:12]} automatisch installiert am "
                                f"{local_time(pending['seit'])}, gilt als gut nach einem Neustart mit Login")
    gut = load_json(state_path("gut.json")) or {}
    if gut.get("commit"):
        return "gut", f"{target_label(gut)}, installiert am {local_time(gut.get('zeit'))}"
    return "keine", "noch nichts über den Kanal installiert"


def cmd_status(argv):
    if argv not in ([], ["--json"], ["--kurz"], ["--installation"]):
        print(f"{NAME} status [--json|--kurz|--installation]", file=sys.stderr)
        return EXIT_USAGE
    if argv == ["--installation"]:
        key, text = installation_summary()
        print(f"{key} {text}")
        return EXIT_OK
    stand = read_stand()
    if argv == ["--json"]:
        print(json.dumps(stand or {}, ensure_ascii=False, indent=1))
        return EXIT_OK
    if argv == ["--kurz"]:
        if not stand:
            print("ungeprueft noch nie geprüft")
        elif stand_outdated(stand):
            print(f"veraltet {stand_outdated(stand)} (sudo zen kanal pruefen)")
        else:
            print(f"{stand.get('zustand')} {first_line(stand.get('grund', ''))}")
        return EXIT_OK

    lines = []
    if stand:
        lines.append(f"{'Kanal':<12}{stand.get('kanal') or '?'}")
        lines.append(f"{'Zustand':<12}{STATE_TEXT.get(stand.get('zustand'), stand.get('zustand'))}: "
                     f"{stand.get('grund')}")
    else:
        lines.append(f"{'Zustand':<12}noch nie geprüft (sudo zen kanal pruefen)")
    lines += anchor_lines()[0]
    outdated = stand_outdated(stand) if stand else None
    if outdated:
        lines.append(f"{'':<12}{outdated}: sudo zen kanal pruefen")
    if stand:
        installed = stand.get("installiert") or {}
        if installed.get("commit"):
            version = installed.get("version") or "keine signierte Version"
            lines.append(f"{'Installiert':<12}{installed['commit'][:12]} ({version})")
        lines.append(f"{'Höchste':<12}{stand.get('hoechste') or '–'}")
        ready = stand.get("bereit")
        if ready:
            lines.append(f"{'Bereit':<12}{ready.get('version')} ({str(ready.get('commit'))[:12]}), "
                         f"automatisch ab {local_time(ready.get('frei_ab'))}")
        dev = stand.get("dev")
        if dev and stand.get("kanal") == "dev":
            if not dev.get("neu"):
                detail = "installiert"
            elif dev.get("vorfahre") is None:
                detail = "der installierte Stand ist auf origin unbekannt"
            elif not dev.get("vorfahre"):
                detail = "der installierte Stand liegt nicht darin"
            else:
                signed = "alle signiert" if dev.get("signiert") else "nicht alle signiert"
                detail = f"{dev.get('commits')} Commits neuer, {signed}"
            lines.append(f"{'origin/dev':<12}{str(dev.get('commit'))[:12]} ({detail})")
        valid = stand.get("gueltig") or []
        lines.append(f"{'Gültig':<12}{', '.join(valid[-5:]) if valid else 'keine'}")
        contact = local_time(stand.get("letzter_kontakt")) if stand.get("letzter_kontakt") else "nie"
        lines.append(f"{'Geprüft':<12}{local_time(stand.get('geprueft'))} · letzter Kontakt mit origin {contact}")
        if stand.get("holen_fehler"):
            lines.append(f"{'':<12}letzter Versuch: {stand['holen_fehler']}")
        for i, entry in enumerate(stand.get("abgelehnt") or []):
            lines.append(f"{'Abgelehnt' if i == 0 else '':<12}{entry.get('tag')}: {entry.get('grund')}")
        for i, note in enumerate(stand.get("hinweise") or []):
            lines.append(f"{'Hinweise' if i == 0 else '':<12}{note}")
    schedule, note = read_schedule()
    lines.append(f"{'Zeitpunkt':<12}{schedule_text(schedule)}" + (f" ({note})" if note else ""))
    lines += automatic_lines(with_pending=False)
    key, text = installation_summary()
    lines.append(f"{'Update':<12}{text}")
    gut = load_json(state_path("gut.json")) or {}
    pending = unconfirmed_summary() or {}
    if key not in ("gut", "keine") and gut.get("commit"):
        lines.append(f"{'Guter Stand':<12}{target_label(gut)}, installiert am {local_time(gut.get('zeit'))}")
    if (stand and not outdated and gut.get("commit")
            and (stand.get("installiert") or {}).get("commit") not in (None, gut["commit"], pending.get("commit"))):
        lines.append(f"{'':<12}{CODE_DIR} steht nicht auf dem guten Stand (von Hand geändert?)")
    locked = locked_entries()
    for i, (name, entry) in enumerate(sorted(locked.items())):
        lines.append(f"{'Gesperrt' if i == 0 else '':<12}{name[:20]}: {short(entry.get('grund') or '?', 100)}")
    print("\n".join(lines))
    return EXIT_OK


# --- Anker von Hand --------------------------------------------------------------------------------------------


def interactive():
    return sys.stdin.isatty()


def ask(prompt):
    try:
        return input(prompt)
    except EOFError:
        return ""


def cmd_anchor(argv):
    if not argv:
        lines, _ = anchor_lines()
        print("\n".join(lines))
        return EXIT_OK
    if len(argv) == 2 and argv[0] == "--pruefen":
        try:
            anchor = parse_anchor(read_anchor_dir(argv[1], trusted=False))
        except AnchorError as e:
            print(f"leer: {e.reason}" if e.empty else f"ungültig: {e.reason}")
            return 1 if e.empty else EXIT_BLOCKED
        print(f"vollständig: Serie {anchor.series}, Wurzel {fingerprint(anchor.root)}, "
              f"{len(anchor.release)} Release-Schlüssel, {len(anchor.revoked)} widerrufen")
        return EXIT_OK
    if len(argv) != 1 or argv[0].startswith("-"):
        print(f"{NAME} anker [ORDNER | --pruefen ORDNER]", file=sys.stderr)
        return EXIT_USAGE
    return anchor_set(argv[0])


def anchor_set(folder):
    if os.geteuid() not in TRUSTED_UIDS:
        print(f"{NAME} anker: nur als root (sudo zen kanal anker {folder})", file=sys.stderr)
        return EXIT_USAGE
    if not interactive():
        print(f"{NAME} anker: nur im Terminal (der Fingerabdruck wird eingetippt)", file=sys.stderr)
        return EXIT_USAGE
    try:
        new = parse_anchor(read_anchor_dir(folder, trusted=False))
    except AnchorError as e:
        print(f"{NAME} anker: {folder}: {e.reason}", file=sys.stderr)
        return EXIT_BLOCKED
    try:
        old = load_device_anchor()
    except AnchorError:
        old = None
    if old and old.root == new.root and new.series < old.series:
        print(f"{NAME} anker: Serie {new.series} ist kleiner als die des Geräts ({old.series}) bei gleicher Wurzel. "
              "Ältere Tags vertrauen/NNNN würden den Anker sonst zurückdrehen.", file=sys.stderr)
        return EXIT_BLOCKED
    if old and old.root == new.root:
        revoked = sorted(set(old.revoked) | set(new.revoked))
        if set(new.release) & set(revoked):
            print(f"{NAME} anker: ein Release-Schlüssel ist auf dem Gerät widerrufen", file=sys.stderr)
            return EXIT_BLOCKED
        new = Anchor(new.release, new.root, revoked, new.series)

    # Verglichen wird mit 1Password, nicht mit dem Bildschirm: Die Fingerabdrücke aus dem Ordner zeigt es erst nach der
    # Eingabe (sonst tippte man ab, was dasteht, und ein untergeschobener Anker ginge durch)
    print(f"Neuer Vertrauensanker aus {folder}: Serie {new.series}, {len(new.release)} Release-Schlüssel, "
          f"{len(new.revoked)} widerrufen.")
    if old:
        print(f"Bisher: Serie {old.series}.")
    typed = ask("Fingerabdruck der Wurzel aus 1Password («zenOS Wurzel», SHA256:…) eintippen: ").strip()
    if typed != fingerprint(new.root):
        # Den richtigen Wert zeigt es auch jetzt nicht: Ein zweiter Versuch soll wieder aus 1Password kommen
        print(f"{NAME} anker: Der Fingerabdruck stimmt nicht mit der Wurzel in {folder} überein. Nichts geändert.",
              file=sys.stderr)
        return EXIT_BLOCKED
    expected = {fingerprint(k)[7:15] for k in new.release}
    print(f"Jetzt die Release-Schlüssel ({len(expected)}): von jedem die ersten 8 Zeichen nach «SHA256:» aus 1Password "
          "(«zenOS Release»).")
    got = set()
    for i in range(len(expected)):
        got.add(ask(f"  Release-Schlüssel {i + 1} von {len(expected)}: ").strip())
    if got != expected:
        print(f"{NAME} anker: Die Release-Schlüssel in {folder} stimmen nicht mit der Eingabe überein. Nichts "
              "geändert.", file=sys.stderr)
        return EXIT_BLOCKED
    lock = lock_or_exit()
    if not isinstance(lock, Locked):
        return lock
    try:
        problem = path_problem(os.path.dirname(ANCHOR_DIR))
        if problem:
            print(f"{NAME} anker: {problem}", file=sys.stderr)
            return EXIT_BLOCKED
        write_device_anchor(new, f"von Hand am {iso(now())}", with_root=True)
    finally:
        lock.release()
    print(f"Wurzel      {fingerprint(new.root)}")
    for key in new.release:
        print(f"Release     {fingerprint(key)}")
    for key in new.revoked:
        print(f"Widerrufen  {fingerprint(key)}")
    print(f"Anker gesetzt: Serie {new.series}. Prüfen mit: sudo zen kanal pruefen")
    return EXIT_OK


# --- Image -----------------------------------------------------------------------------------------------------

IMAGE_FRESH = ("gut.json", "hoechste", "gesehen.json", "laeuft.json", "letzte.json", "auftrag.json", "stand.json",
               "angehalten", UNCONFIRMED)


def cmd_image(argv):
    """Zustand ab Werk für ein Image (image/bauen.sh im chroot, nach install.sh --image): Der ausgelieferte Stand ist
    der signierte Tag NAME. Geprüft wie auf dem Gerät (Anker /etc/zenos/vertrauen, Prinzipal zenos-release, /opt/zenos
    sauber auf genau seinem Commit, Kanal stabil oder vorschau und der Tag darin). Dann gesehen.json (der Tag als
    gültig gesehen: Zeigt er auf origin später gültig signiert auf einen anderen Commit, ist das schon beim ersten
    Kontakt ALARM), hoechste (seine Version, darunter geht es nie) und zuletzt gut.json (der Tag als guter Stand, auch
    für den Rückweg). Nur in einem neuen Zustand: Liegt dort schon etwas, ändert es nichts."""
    if len(argv) != 1 or not VERSION_RE.fullmatch(argv[0]):
        print(f"{NAME} image vX.Y.Z[-rcN]", file=sys.stderr)
        return EXIT_USAGE
    name = argv[0]
    if os.geteuid() not in TRUSTED_UIDS:
        print(f"{NAME} image: nur als root (image/bauen.sh im chroot)", file=sys.stderr)
        return EXIT_USAGE
    there = [n for n in IMAGE_FRESH if os.path.lexists(state_path(n))]
    if there:
        print(f"{NAME} image: nur für ein neues Image, in {STATE_DIR} gibt es schon {', '.join(there)}",
              file=sys.stderr)
        return EXIT_BLOCKED
    try:
        anchor = load_device_anchor()
    except AnchorError as e:
        print(f"{NAME} image: Anker {ANCHOR_DIR}: {e.reason}", file=sys.stderr)
        return EXIT_BLOCKED
    try:
        channel, _ = read_channel()
    except Failure as e:
        print(f"{NAME} image: {e}", file=sys.stderr)
        return EXIT_BLOCKED
    if channel not in ("stabil", "vorschau") or not in_channel(name, channel):
        print(f"{NAME} image: {name} gehört nicht zum Kanal {channel} (Image: vX.Y.Z → stabil, vX.Y.Z-rcN → "
              "vorschau)", file=sys.stderr)
        return EXIT_BLOCKED
    installed = installed_commit()
    r = git(CODE_DIR, "for-each-ref", "--format=%(objectname) %(objecttype)", f"refs/tags/{name}")
    parts = r.stdout.split()
    if r.returncode != 0 or len(parts) != 2 or not OID_RE.fullmatch(parts[0]):
        print(f"{NAME} image: den Tag {name} gibt es in {CODE_DIR} nicht", file=sys.stderr)
        return EXIT_BLOCKED
    oid, kind = parts
    with tempfile.TemporaryDirectory(prefix="zenos-kanal.") as work:
        files = signer_files(anchor, os.path.join(work, "anker"))
        result = check_tag(CODE_DIR, name, oid, kind, anchor, files, RELEASE_PRINCIPAL)
    if not result.ok:
        print(f"{NAME} image: {name} gilt nicht: {result.reason}", file=sys.stderr)
        return EXIT_BLOCKED
    if result.commit != installed:
        print(f"{NAME} image: {CODE_DIR} steht auf {str(installed)[:12]}, nicht auf {name} ({result.commit[:12]})",
              file=sys.stderr)
        return EXIT_BLOCKED
    r = git(CODE_DIR, "status", "--porcelain")
    if r.returncode != 0 or r.stdout.strip():
        print(f"{NAME} image: {CODE_DIR} ist nicht sauber", file=sys.stderr)
        return EXIT_BLOCKED
    lock = lock_or_exit()
    if not isinstance(lock, Locked):
        return lock
    try:
        os.makedirs(STATE_DIR, mode=0o755, exist_ok=True)
        problem = path_problem(STATE_DIR)
        if problem:
            print(f"{NAME} image: Zustand unsicher: {problem}", file=sys.stderr)
            return EXIT_BLOCKED
        write_json(state_path("gesehen.json"), {"version": 1, "tags": {name: {
            "objekt": oid, "gueltig": True, "erstmals": None, "erstmals_start": None, "commit": result.commit}}})
        write_atomic(state_path("hoechste"), name + "\n")
        write_json(state_path("gut.json"), {
            "commit": result.commit, "zweig": None, "tag": name, "objekt": oid, "version": name, "signiert": True,
            "bereich_von": None, "freigabe": None, "hoechste": True, "pfad": state_path("bereit", result.commit),
            "art": "image", "kanal": channel, "von_hand": False, "quelle": None, "zeit": iso(now())})
    finally:
        lock.release()
    print(f"Ab Werk: {name} ({result.commit[:12]}) gültig signiert mit {fingerprint(result.key)}, Kanal {channel}; "
          "gut.json, hoechste und gesehen.json angelegt")
    return EXIT_OK


# --- Start -----------------------------------------------------------------------------------------------------


def main(argv):
    sys.dont_write_bytecode = True
    if not argv or argv[0] in ("-h", "--hilfe", "--help"):
        print(__doc__.strip())
        return EXIT_OK if argv else EXIT_USAGE
    commands = {"status": cmd_status, "pruefen": cmd_check, "anker": cmd_anchor, "holen-intern": cmd_fetch_internal,
                "update": cmd_update, "rollback": cmd_rollback, "jetzt": cmd_now, "zustimmen": cmd_consent,
                "zeitpunkt": cmd_schedule, "installieren": cmd_install, "nachstart": cmd_after_boot,
                "selbsttest": cmd_selftest, "automatik": cmd_automatic, "bestaetigen": cmd_confirm,
                "image": cmd_image}
    command = commands.get(argv[0])
    if not command:
        print(f"{NAME}: unbekannter Befehl «{short(argv[0], 30)}» (--hilfe)", file=sys.stderr)
        return EXIT_USAGE
    return command(argv[1:])


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
