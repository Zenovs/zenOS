#!/bin/sh
# zenOS: Live-Sitzung des Installer-Sticks im Look von zenOS (startet über /etc/xdg/autostart/zenos-live-look.desktop).
# Nur im Live-System (Schicht minimal.standard.live.zenos.squashfs, image/x86-stick.sh), nie im installierten System:
# dunkles Farbschema (der Installer folgt ihm, wie der Login von zenOS) und ein ruhiger, einfarbiger Hintergrund in der
# Grundfarbe aus shell/theme/tokens.json statt des Bildes von Ubuntu. Die Farbe setzt x86-stick.sh beim Bauen ein.

gsettings set org.gnome.desktop.interface color-scheme prefer-dark
gsettings set org.gnome.desktop.background picture-uri ''
gsettings set org.gnome.desktop.background picture-uri-dark ''
gsettings set org.gnome.desktop.background color-shading-type solid
gsettings set org.gnome.desktop.background primary-color '@GRUND@'
exit 0
