# zenOS: Startmenü des Installations-ISO (GRUB von Ubuntu, signiert, hinter shim). image/x86/bauen.sh setzt die
# Platzhalter @…@ ein. casper startet das Live-System aus den Schichten zenos.squashfs (System) und
# zenos.live.squashfs (Installer); «layerfs-path» nennt die oberste.
set default=0
set timeout=5
set timeout_style=menu
set menu_color_normal=white/black
set menu_color_highlight=black/light-gray

menuentry "zenOS @VERSION@ installieren" {
	set gfxpayload=keep
	linux /casper/vmlinuz boot=casper layerfs-path=zenos.live.squashfs quiet splash @ZUSATZ@ ---
	initrd /casper/initrd
}

menuentry "zenOS @VERSION@ installieren (einfache Grafik)" {
	set gfxpayload=keep
	linux /casper/vmlinuz boot=casper layerfs-path=zenos.live.squashfs nomodeset quiet splash @ZUSATZ@ ---
	initrd /casper/initrd
}

menuentry "UEFI-Einstellungen" {
	fwsetup
}
