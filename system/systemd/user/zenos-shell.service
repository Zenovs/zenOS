# zenOS-Oberfläche: Quickshell mit ~/.config/quickshell/shell.qml (→ /opt/zenos/shell).
# Startet mit zenos-sitzung.target und neu, falls es abstürzt: Die Sperre (ext-session-lock) hält den
# Bildschirm solange gesperrt und sperrt nach dem Neustart wieder (Marker gesperrt).
[Unit]
Description=zenOS-Oberfläche (Quickshell)
Documentation=file:///opt/zenos/docs/architektur.md
PartOf=zenos-sitzung.target graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
Slice=session.slice
ExecStart=/usr/local/bin/quickshell --no-color
Environment=QT_QPA_PLATFORM=wayland
# Qt meldet bei jeder neuen Fläche mit Texteingabe (Befehlsfeld, Sperre) «Try to enable surface … with
# focusing …» als Warnung; harmlos. Nur diese Kategorie, alle anderen Warnungen bleiben im Journal.
Environment=QT_LOGGING_RULES=qt.qpa.wayland.textinput.warning=false
Restart=always
RestartSec=1
# 255: Wayland-Verbindung weg (labwc beendet die Clients vor dem shutdown-Skript) – beim Abmelden normal
SuccessExitStatus=255
TimeoutStopSec=5
