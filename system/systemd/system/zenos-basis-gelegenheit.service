# zenOS: Gelegenheit der Automatik der Basis-Updates (zenos-basis automatik gelegenheit), gestartet von
# zenos-basis-gelegenheit.timer. Wie zenos-basis-automatik.service, aber ohne apt-get update: Liegt eine bereite Liste
# vor (automatik-bereit, nur ohne Kernel, Firmware, Bootloader und Entfernungen), installiert es genau diese, wenn
# «zenos-kanal automatik darf --ohne-ssh» ja sagt. Hat sich die Liste inzwischen geändert (etwa durch
# unattended-upgrades), lehnt das Installieren ab und stand.json zeigt die neue. Sandbox wie
# zenos-basis-automatik.service.
[Unit]
Description=zenOS: Ubuntu-Basis-Automatik, bereite Liste installieren, wenn der Zeitpunkt passt
Documentation=file:///opt/zenos/docs/image-und-releases.md
ConditionPathExists=/usr/local/libexec/zenos/zenos-basis
ConditionPathExists=!/etc/xdg/zenos/kanal-automatik-aus
ConditionPathExists=/var/lib/zenos/basis/automatik-bereit

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I /usr/local/libexec/zenos/zenos-basis automatik gelegenheit
Environment=LANG=C.UTF-8
StateDirectory=zenos/basis
StateDirectoryMode=0755
RuntimeDirectory=zenos-sperre
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
UMask=0022
SuccessExitStatus=10 75
TimeoutStartSec=4h
Nice=10
SyslogIdentifier=zenos-basis

PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
