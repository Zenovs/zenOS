# zenOS: «Jetzt installieren» in den Einstellungen (zenos-kanal jetzt %i). Die Instanz ist das Ziel, das die
# Einstellungen zeigten (40 Zeichen 0-9a-f: das Tag-Objekt der bereiten Version, auf dev der Commit). Wie «zen update»,
# aber ohne Terminal, ohne Frage und ohne neues Holen: nur der Stand, den die letzte Prüfung schon geprüft hat, über
# dieselben Units. Nennt die Prüfung ein anderes Ziel, oder bräuchte es ein «ja» (unsigniert, dev mit unsignierten
# Commits, Firewall, Netz oder Boot, gesperrt, Rückschritt), bleibt es liegen (Exit 10).
# Gestartet nur von scripts/bin/zenos-kanal-bedienen (pkexec, polkit-Aktion org.zenos.kanal.installieren: ohne
# Passwort, nur in der aktiven Sitzung am Gerät). Als eigene Unit, damit ein Neuladen oder Neustart der Oberfläche
# die Installation nicht mitten im Lauf abbricht.
[Unit]
Description=zenOS: Kanal jetzt installieren (aus den Einstellungen, %i)
Documentation=file:///opt/zenos/docs/image-und-releases.md
ConditionPathExists=/usr/local/libexec/zenos/zenos-kanal

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I /usr/local/libexec/zenos/zenos-kanal jetzt %i
Environment=LANG=C.UTF-8
StateDirectory=zenos/kanal
StateDirectoryMode=0755
RuntimeDirectory=zenos-sperre
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
UMask=0022
# Kein SuccessExitStatus: Eine erfolgreich beendete statische Unit räumt systemd weg (ExecMainStatus wäre 0).
# So bleibt der Exit (3, 4, 5, 10, 75) lesbar; zenos-kanal-bedienen liest ihn und setzt «failed» zurück.
TimeoutStartSec=4h
SyslogIdentifier=zenos-kanal

# Das Programm schreibt nur den Wunsch und startet die Units; das Gewicht tragen sie
PrivateNetwork=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
