# zenOS: zen Installer – ein Paket installieren (zenos-installer installieren %i). Die Instanz ist die SHA-256 der
# Datei, die der zen Installer zeigte; zenos-installer-bedienen (pkexec mit Passwort, polkit-Aktion
# org.zenos.installer.installieren, oder sudo) hat sie als der aufrufende Benutzer gelesen und nach
# /var/lib/zenos/installer/ablage/%i.deb kopiert, dazu %i.json mit dem angezeigten Plan.
#
# Läuft als root ohne Sandbox: apt-get install führt die Skripte des Pakets aus (Dienste, Gruppen, Dateien in /etc).
# Unter der gemeinsamen Sperre mit Kanal und Basis (/run/zenos-sperre/kanal.lock; wartet höchstens 20 Minuten auf sie
# und auf andere Paketvorgänge) und der Sperre der Paketlisten wertet es die Datei noch einmal aus und installiert nur,
# wenn sie «bereit» ist und der Plan gleich blieb. Während apt hält es einen Block-Inhibitor für Ausschalten und
# Ruhezustand. KillMode=mixed: Ein Stopp schickt SIGTERM nur an zenos-installer; vor apt endet es dann sofort (Exit
# 10), ein laufendes apt läuft zu Ende. Danach ist die Ablage leer.
[Unit]
Description=zenOS: zen Installer installiert ein Paket (%i)
Documentation=file:///opt/zenos/docs/sicherheit.md
ConditionPathExists=/usr/local/libexec/zenos/zenos-installer

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I /usr/local/libexec/zenos/zenos-installer installieren %i
Environment=HOME=/root LANG=C.UTF-8
StateDirectory=zenos/installer
StateDirectoryMode=0755
UMask=0022
KillMode=mixed
# Kein SuccessExitStatus: Den Exit (3, 10, 75) liest zenos-installer auftrag-installieren über ExecMainStatus und
# setzt «failed» danach zurück; das Ergebnis steht in /var/lib/zenos/installer/letzte.json
TimeoutStartSec=2h
TimeoutStopSec=20min
SyslogIdentifier=zenos-installer
