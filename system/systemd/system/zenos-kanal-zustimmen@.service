# zenOS: «Zustimmen …» in den Einstellungen (zenos-kanal zustimmen %i). Die Instanz ist das Tag-Objekt (40 Zeichen
# 0-9a-f), das die Einstellungen zeigten. Wie «zen update» mit dem getippten «ja», aber ohne neues Holen und nur für
# einen gültig signierten Stand (Firewall, Netz oder Boot geändert). Nennt die Prüfung ein anderes Objekt, geschieht
# nichts (Exit 10); Unsigniertes, dev und Rollbacks bleiben beim Terminal (Exit 3).
# Gestartet nur von scripts/bin/zenos-kanal-bedienen (pkexec, polkit-Aktion org.zenos.kanal.zustimmen: jedes Mal mit
# Passwort, nur in der aktiven Sitzung am Gerät).
[Unit]
Description=zenOS: Kanal mit Zustimmung installieren (%i)
Documentation=file:///opt/zenos/docs/image-und-releases.md
ConditionPathExists=/usr/local/libexec/zenos/zenos-kanal

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I /usr/local/libexec/zenos/zenos-kanal zustimmen %i
Environment=LANG=C.UTF-8
StateDirectory=zenos/kanal
StateDirectoryMode=0755
RuntimeDirectory=zenos-sperre
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
UMask=0022
# Kein SuccessExitStatus: Eine erfolgreich beendete statische Unit räumt systemd weg (ExecMainStatus wäre 0).
# So bleibt der Exit (3, 4, 5, 10, 75) lesbar; zenos-kanal-bedienen liest ihn und setzt «failed» zurück.
TimeoutStartSec=4h
SyslogIdentifier=zenos-kanal

PrivateNetwork=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
