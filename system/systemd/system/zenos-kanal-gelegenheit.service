# zenOS: Gelegenheit der Automatik (zenos-kanal automatik gelegenheit), gestartet von zenos-kanal-gelegenheit.timer.
# Wie zenos-kanal-automatik.service, aber ohne Holen: Liegt ein bereiter Stand vor (automatik-bereit, geschrieben vom
# Prüfen) oder ist eine Installation unterbrochen, prüft es ohne Netz neu und installiert, wenn der Zeitpunkt passt.
# Sandbox wie zenos-kanal-automatik.service.
[Unit]
Description=zenOS: Kanal-Automatik, bereiten Stand installieren, wenn der Zeitpunkt passt
Documentation=file:///opt/zenos/docs/image-und-releases.md
ConditionPathExists=/usr/local/libexec/zenos/zenos-kanal
ConditionPathExists=!/etc/xdg/zenos/kanal-automatik-aus
ConditionPathExists=|/var/lib/zenos/kanal/automatik-bereit
ConditionPathExists=|/var/lib/zenos/kanal/laeuft.json

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I /usr/local/libexec/zenos/zenos-kanal automatik gelegenheit
Environment=LANG=C.UTF-8
StateDirectory=zenos/kanal
StateDirectoryMode=0755
RuntimeDirectory=zenos-sperre
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
UMask=0022
SuccessExitStatus=10 75
TimeoutStartSec=4h
Nice=10
SyslogIdentifier=zenos-kanal

PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
