# zenOS: Standard-Apps der labwc-Sitzung (XDG_CURRENT_DESKTOP=labwc:wlroots).
# Installiert nach /etc/xdg/labwc-mimeapps.list (48-ablage). Gilt nur in der zenOS-Sitzung, nicht in einer anderen
# (etwa GNOME). Deine Wahl in ~/.config/mimeapps.list geht immer vor.
# Ordner öffnet Thunar, auch wenn später eine andere App sie annimmt (VS Code meldet inode/directory an).
# .deb-Pakete öffnet der zen Installer (zenos-installer.desktop aus 76-installer), auch aus Chrome und Firefox.
[Default Applications]
inode/directory=thunar.desktop
application/vnd.debian.binary-package=zenos-installer.desktop
application/x-deb=zenos-installer.desktop
