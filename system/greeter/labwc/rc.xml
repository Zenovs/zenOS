<?xml version="1.0" encoding="UTF-8"?>
<!--
  zenOS: labwc für den Login (zenos-greeter startet labwc -C mit diesem Ordner).
  Nur die Oberfläche des Greeters läuft hier. Ohne eigene Tasten- und Mausbelegung lädt labwc
  seine Vorgaben (u. a. ein Terminal auf Super+Enter und ein Menü mit «Beenden») – deshalb steht
  hier je eine harmlose Belegung, damit keine Vorgabe greift.
-->
<labwc_config>
  <core>
    <decoration>server</decoration>
  </core>

  <theme>
    <cornerRadius>0</cornerRadius>
  </theme>

  <keyboard>
    <numlock>on</numlock>
    <keybind key="W-F24">
      <action name="Reconfigure" />
    </keybind>
  </keyboard>

  <mouse>
    <context name="Frame">
      <mousebind button="Left" action="Press">
        <action name="Focus" />
      </mousebind>
    </context>
  </mouse>

</labwc_config>
