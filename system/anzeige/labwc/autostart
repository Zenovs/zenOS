#!/bin/sh
# zenOS: Start der Anzeige-Sitzung (labwc führt es mit sh aus). Gibt die Umgebung an systemd und D-Bus weiter (wie
# system/labwc/autostart) und startet zenos-anzeige.target: Es hängt an graphical-session.target, so starten auch
# Benutzerdienste der App mit WantedBy=graphical-session.target von selbst. Keine Oberfläche, keine Sperre.

dbus-update-activation-environment --systemd \
  WAYLAND_DISPLAY DISPLAY LABWC_PID \
  XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE XDG_SESSION_ID \
  QT_QPA_PLATFORM QT_WAYLAND_DISABLE_WINDOWDECORATION MOZ_ENABLE_WAYLAND ELECTRON_OZONE_PLATFORM_HINT \
  XCURSOR_THEME XCURSOR_SIZE

systemctl --user start --no-block zenos-anzeige.target
