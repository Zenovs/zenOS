#!/usr/bin/env bash
# Letzter Schritt vor dem fertigen Image (mkosi.finalize, läuft in der Bauumgebung mit $BUILDROOT).
#
# 1. /var vorbereiten: Das System ist schreibgeschützt, /var bekommt beim ersten Start eine eigene, verschlüsselte
#    Partition. Was die Pakete unter /var mitbringen, wandert nach /usr/share/factory/var; systemd-tmpfiles legt es
#    bei jedem Start dort an, wo es fehlt.
# 2. Erhöhte Rechte prüfen: setuid und setgid nur für Programme auf der Liste unten. Steht etwas anderes im Image,
#    bricht der Bau ab (Leitplanke: Jede Regel hat einen Test).
# 3. Verbotenes prüfen: kein SSH-Server, kein sudo, kein Paketmanager, kein Compiler.
set -euo pipefail
R="$BUILDROOT"

fehler() { echo "zenOS-Prüfung: $*" >&2; exit 1; }

# --- 1. /var ---------------------------------------------------------------------------------------------------
# Paketdatenbank und Caches gehören nicht aufs Gerät.
rm -rf "${R:?}/var/cache/"* "$R/var/log/"* "$R/var/tmp/"* "$R/var/lib/dpkg" "$R/var/lib/apt"
rm -rf "$R/usr/share/factory/var"
mkdir -p "$R/usr/share/factory"
cp -a "$R/var" "$R/usr/share/factory/var"

tmpfiles="$R/usr/lib/tmpfiles.d/zenos-var.conf"
{
	echo "# Erzeugt von mkosi/mkosi.finalize: Inhalte aus den Paketen auf der verschlüsselten /var-Partition anlegen."
	(cd "$R/usr/share/factory" && find var -mindepth 1 -maxdepth 1 | sort) | while read -r eintrag; do
		quelle="$R/usr/share/factory/$eintrag"
		if [[ -L "$quelle" ]]; then
			echo "L /$eintrag - - - - $(readlink "$quelle")"
		elif [[ -d "$quelle" ]]; then
			echo "d /$eintrag $(stat -c '%a %u %g' "$quelle") -"
			(cd "$R/usr/share/factory" && find "$eintrag" -mindepth 1 -maxdepth 1 | sort) | while read -r kind; do
				echo "C /$kind - - - -"
			done
		else
			echo "C /$eintrag - - - -"
		fi
	done
} > "$tmpfiles"

# Im System bleiben nur die leeren Grundverzeichnisse von /var. Dienste, die vor dem Entsperren der Daten starten
# (systemd-resolved mit PrivateTmp=disconnected), brauchen /var/tmp als Einhängepunkt.
find "$R/var" -mindepth 1 -delete
install -d -m 0755 "$R/var/lib" "$R/var/cache" "$R/var/log" "$R/var/spool" "$R/var/lib/systemd"
install -d -m 1777 "$R/var/tmp"

# --- 2. Erhöhte Rechte ------------------------------------------------------------------------------------------
# Niemand mountet von Hand, niemand wechselt den Benutzer, Passwörter verwaltet systemd-homed. Chromium nimmt für
# seine Sandbox die User-Namespaces des Kernels, nicht das setuid-Hilfsprogramm. fusermount3 (vom Desktop-Portal)
# hängt FUSE-Dateisysteme für Flatpak-Apps ein; Flatpak gibt es nicht, also braucht es kein setuid.
for datei in usr/bin/su usr/bin/mount usr/bin/umount usr/bin/passwd usr/bin/chsh usr/bin/chfn usr/bin/gpasswd \
	usr/bin/newgrp usr/bin/chage usr/bin/expiry usr/lib/chromium/chrome-sandbox usr/bin/fusermount3; do
	[[ -e "$R/$datei" ]] && chmod ug-s "$R/$datei"
done

# Erlaubt: polkit fragt über dieses Hilfsprogramm nach dem Passwort; unix_chkpwd prüft es für die Sperre (PAM).
erlaubt=(
	usr/lib/polkit-1/polkit-agent-helper-1
	usr/sbin/unix_chkpwd
)
unbekannt=()
while read -r datei; do
	bekannt=0
	for e in "${erlaubt[@]}"; do [[ "$datei" == "$e" ]] && bekannt=1; done
	((bekannt)) || unbekannt+=("$datei")
done < <(cd "$R" && find . -xdev -type f \( -perm -4000 -o -perm -2000 \) | sed 's|^\./||' | sort)
((${#unbekannt[@]} == 0)) || fehler "setuid oder setgid ohne Eintrag in der Liste: ${unbekannt[*]}"

# Leere machine-id: systemd erzeugt bei jedem Start eine flüchtige. «uninitialized» liesse jeden Start als ersten
# Start gelten, weil /etc schreibgeschützt ist und die ID nie gespeichert würde.
: > "$R/etc/machine-id"

# root ist gesperrt: kein Passwort, also auch keine Notfall-Shell.
root_pw=$(awk -F: '$1 == "root" { print $2 }' "$R/etc/shadow")
[[ "$root_pw" == "*" || "$root_pw" == "!"* ]] || fehler "root hat ein Passwort (${root_pw:0:3}…)"

# --- 3. Verbotenes ----------------------------------------------------------------------------------------------
for verboten in usr/sbin/sshd usr/bin/ssh usr/bin/scp usr/bin/sftp usr/bin/ssh-agent usr/lib/openssh/ssh-keysign \
	usr/bin/sudo usr/bin/apt usr/bin/apt-get usr/bin/dpkg usr/bin/gcc usr/bin/cc usr/bin/make usr/bin/pkexec \
	usr/sbin/avahi-daemon usr/bin/Xwayland usr/lib/udisks2/udisksd; do
	[[ ! -e "$R/$verboten" ]] || fehler "darf nicht ins Image: /$verboten"
done

echo "zenOS-Prüfung: setuid, root, verbotene Programme in Ordnung"

# --- 3a. Notfall-Passwort (BAUAUFTRAG.md, Bauauftrag 2) ----------------------------------------------------------
# Die Daten öffnet nur zenos-entsperren: Ein Eintrag in /etc/crypttab wäre ein zweiter Weg, an dem das
# Notfall-Passwort nicht wirkt. /var muss auf den Dienst warten, und seine Werkzeuge müssen im Image sein.
! grep -Eqv '^[[:space:]]*(#|$)' "$R/etc/crypttab" ||
	fehler "/etc/crypttab hat einen Eintrag; die Daten öffnet nur zenos-entsperren"
grep -Eq '^/dev/mapper/daten[[:space:]]+/var[[:space:]].*x-systemd\.requires=zenos-entsperren\.service' \
	"$R/etc/fstab" || fehler "/var wartet nicht auf zenos-entsperren.service (/etc/fstab)"
for noetig in usr/sbin/cryptsetup usr/bin/keyctl usr/bin/varlinkctl usr/sbin/zramctl usr/sbin/mkfs.ext4 \
	usr/lib/zenos/entsperren usr/lib/zenos/notfall-dienst usr/lib/zenos/attrappe; do
	[[ -x "$R/$noetig" ]] || fehler "fehlt im Image: /$noetig (Notfall-Passwort)"
done
[[ ! -e "$R/usr/sbin/request-key" ]] || fehler "request-key darf nicht ins Image (keyutils, nur keyctl)"
echo "zenOS-Prüfung: Notfall-Passwort: eigene Passwortabfrage und Werkzeuge in Ordnung"

# --- 3b. Quickshell vollständig ----------------------------------------------------------------------------------
# Quickshell kommt aus dem Quellbau, nicht aus einem Paket: Seine Bibliotheken stehen von Hand in Packages=. Fehlt
# eine im Image, startete die Oberfläche nicht, auch die Sperre nicht. Der Bau bricht dann hier ab.
[[ -x "$R/usr/bin/quickshell" ]] || fehler "Quickshell fehlt (mkosi.build.chroot)"
fehlend=$(cd "$R" && find usr/bin/quickshell usr/lib/*/qt6/qml/Quickshell -type f \( -name quickshell -o -name '*.so*' \) \
	-exec mkosi-chroot ldd /{} \; 2>&1 | awk '/not found/ { print $1 }' | sort -u | paste -sd ' ' -)
[[ -z "$fehlend" ]] || fehler "Quickshell braucht Bibliotheken, die im Image fehlen: $fehlend"
echo "zenOS-Prüfung: Quickshell und seine Bibliotheken vollständig"

# --- 3c. Updates: nur mit Zenos Signatur -----------------------------------------------------------------------
# Leitplanke: Ein Gerät installiert nur, was zenOS signiert hat. /usr/lib/zenos/update lädt den Stand, prüft die
# SSH-Signatur von SHA256SUMS gegen /usr/lib/zenos/update-signierer (mit Berührung und PIN des FIDO2-Schlüssels) und
# jede Prüfsumme; sysupdate schreibt nur diese geprüfte Kopie. Hier wird geprüft, dass es keinen anderen Weg gibt und
# wem das Gerät traut:
#   - Jede Transfer-Datei liest nur aus /var/lib/zenos/update/quelle, keine aus dem Netz (systemd-pull ist entfernt).
#   - argon: Quelle nur GitHub über https. update-signierer kommt aus mkosi/schluessel/argon-allowed-signers und enthält nur
#     FIDO2-Schlüssel (sk-ssh-ed25519) für den Namespace argon-update. Fehlt die Datei, bricht der Bau ab; nur mit
#     ZENOS_SCHLUESSEL_FEHLT_OK=1 (Entwicklungsbau, nie auf ein Gerät) entsteht ein Image, das keine Updates annimmt.
#   - qemu: nur der Wegwerf-Schlüssel des Tests (ZENOS_TEST_SIGNIERER von mkosi/bauen.sh), gilt nur in diesem Image.
abschnitt() { # DATEI ABSCHNITT SCHLUESSEL
	awk -v a="[$2]" -v k="$3=" '$0 == a { s = 1; next } /^\[/ { s = 0 } s && index($0, k) == 1 { print substr($0, length(k) + 1) }' "$1"
}
for transfer in "$R"/usr/lib/sysupdate.d/*.transfer; do
	[[ "$(abschnitt "$transfer" Source Type) $(abschnitt "$transfer" Source Path)" == "regular-file /var/lib/zenos/update/quelle" ]] ||
		fehler "$(basename "$transfer"): Quelle muss die geprüfte Kopie sein (regular-file, /var/lib/zenos/update/quelle)"
done
[[ -x "$R/usr/bin/ssh-keygen" && -x "$R/usr/bin/curl" ]] || fehler "ssh-keygen oder curl fehlt (Updates)"
signierer="$R/usr/lib/zenos/update-signierer"
update_quelle=$(cat "$R/usr/lib/zenos/update-quelle" 2>/dev/null || true)
if [[ ",${PROFILES:-}," == *",argon,"* ]]; then
	[[ "$update_quelle" == "https://github.com/Zenovs/zenOS/releases/latest/download/" ]] ||
		fehler "Update-Quelle auf dem Gerät nur GitHub über https (ist: $update_quelle)"
	schluessel="$SRCDIR/mkosi/schluessel/argon-allowed-signers"
	if [[ -f "$schluessel" ]]; then
		zeilen=$(grep -Ev '^[[:space:]]*(#|$)' "$schluessel" || true)
		[[ -n "$zeilen" ]] || fehler "mkosi/schluessel/argon-allowed-signers enthält keinen Schlüssel"
		muster='^argon-update namespaces="argon-update" sk-ssh-ed25519@openssh\.com AAAA[A-Za-z0-9+/]+=*( [^[:space:]].*)?$'
		while IFS= read -r zeile; do
			[[ "$zeile" =~ $muster ]] ||
				fehler "mkosi/schluessel/argon-allowed-signers: nur FIDO2-Schlüssel (sk-ssh-ed25519) für argon-update: ${zeile:0:50}…"
		done <<<"$zeilen"
		printf '%s\n' "$zeilen" >"$signierer"
		chmod 0644 "$signierer"
		fingerabdruecke=$(awk '{ print $3, $4 }' "$signierer" | ssh-keygen -lf -) ||
			fehler "mkosi/schluessel/argon-allowed-signers: ein Schlüssel lässt sich nicht lesen"
		echo "zenOS-Prüfung: Updates nur mit Zenos FIDO2-Schlüsseln (Berührung und PIN), $(wc -l <"$signierer") Stück:"
		sed 's/^/  /' <<<"$fingerabdruecke"
	elif [[ "${ZENOS_SCHLUESSEL_FEHLT_OK:-}" == 1 ]]; then
		: >"$signierer"
		chmod 0644 "$signierer"
		echo "zenOS-Prüfung: WARNUNG: kein Schlüssel für Updates. Dieses Image nimmt keine Updates an und gehört auf kein Gerät." >&2
	else
		fehler "mkosi/schluessel/argon-allowed-signers fehlt: Ohne Zenos öffentliche Schlüssel kann das Gerät keine Updates prüfen"
	fi
else
	# Nur der Base64-Teil eines ssh-ed25519-Schlüssels (mkosi trennt --environment an Leerzeichen)
	[[ "${ZENOS_TEST_SIGNIERER:-}" =~ ^AAAA[A-Za-z0-9+/]+=*$ ]] ||
		fehler "ZENOS_TEST_SIGNIERER fehlt oder ist unplausibel (Wegwerf-Schlüssel des Tests, kommt von mkosi/bauen.sh qemu)"
	printf 'argon-update namespaces="argon-update" ssh-ed25519 %s zenOS-Test\n' "$ZENOS_TEST_SIGNIERER" >"$signierer"
	chmod 0644 "$signierer"
	echo "zenOS-Prüfung: Updates im Test-Image nur mit dem Wegwerf-Schlüssel des Tests"
fi
for verboten in usr/lib/systemd/import-pubring.gpg etc/systemd/import-pubring.gpg usr/lib/systemd/systemd-pull; do
	[[ ! -e "$R/$verboten" ]] || fehler "darf nicht ins Image: /$verboten (Updates nur über /usr/lib/zenos/update)"
done

# --- 3d. Paketstand ----------------------------------------------------------------------------------------------
# Der feste Stand von snapshot.debian.org, aus dem das Image gebaut ist. Daran misst /usr/lib/zenos/erinnerung, wie alt
# die Pakete sind (Mitteilung ab 14 Tagen), und zen status zeigt ihn. Alle Quellen müssen denselben Stand haben.
quellen="$SRCDIR/mkosi/mkosi.sandbox/etc/apt/sources.list.d/mkosi.sources"
staende=$(grep -oE 'snapshot\.debian\.org/archive/[a-z-]+/[0-9]{8}T[0-9]{6}Z/' "$quellen" | cut -d/ -f4 | sort -u)
[[ "$staende" =~ ^[0-9]{8}T[0-9]{6}Z$ ]] || fehler "Paketquellen ohne einheitlichen Stand von snapshot.debian.org: ${staende//$'\n'/ }"
printf '%s-%s-%sT%s:%s:%sZ\n' "${staende:0:4}" "${staende:4:2}" "${staende:6:2}" "${staende:9:2}" "${staende:11:2}" \
	"${staende:13:2}" >"$R/usr/lib/zenos/paketstand"
chmod 0644 "$R/usr/lib/zenos/paketstand"
echo "zenOS-Prüfung: Paketstand $(cat "$R/usr/lib/zenos/paketstand")"

# --- 3e. Ausschalten nach langer Sperre (BAUAUFTRAG.md, Bauauftrag 3) --------------------------------------------
# Leitplanke: fest 30 Minuten im Image für den Argon. Nur das Test-Image für QEMU darf eine kürzere Zeit haben
# (/usr/lib/zenos/ausschalten-test-nach), und der Dienst muss eingeschaltet sein.
grep -qx 'grenze=1800' "$R/usr/lib/zenos/ausschalten-waechter" || fehler "ausschalten-waechter: nicht fest 30 Minuten"
# Das Konto des Wächters (/usr/lib/sysusers.d/zenos.conf) entsteht hier im Bau: /etc ist im fertigen Image
# schreibgeschützt, systemd-sysusers könnte es beim Start nicht mehr anlegen, und der Dienst liefe nie.
mkosi-chroot systemd-sysusers /usr/lib/sysusers.d/zenos.conf ||
	fehler "Systemkonten aus /usr/lib/sysusers.d/zenos.conf liessen sich nicht anlegen"
grep -q '^zenos-ausschalten:' "$R/etc/passwd" || fehler "Konto zenos-ausschalten fehlt in /etc/passwd"
grep -qx 'enable zenos-ausschalten.service' "$R/usr/lib/systemd/system-preset/10-zenos.preset" ||
	fehler "zenos-ausschalten.service ist nicht eingeschaltet (10-zenos.preset)"
[[ -f "$R/etc/polkit-1/rules.d/50-zenos-ausschalten.rules" ]] || fehler "polkit-Regel für zenos-ausschalten fehlt"
if [[ ",${PROFILES:-}," == *",argon,"* ]]; then
	[[ ! -e "$R/usr/lib/zenos/ausschalten-test-nach" ]] ||
		fehler "ausschalten-test-nach darf nur ins Test-Image für QEMU (der Argon schaltet fest nach 30 Minuten aus)"
	echo "zenOS-Prüfung: Ausschalten nach 30 Minuten ohne entsperrte Sitzung (fest)"
else
	nach=$(cat "$R/usr/lib/zenos/ausschalten-test-nach" 2>/dev/null || echo 1800)
	echo "zenOS-Prüfung: Ausschalten nach langer Sperre, im Test-Image nach $nach s"
fi

# --- 3f. Hardware-Schlüssel (BAUAUFTRAG.md, Bauauftrag 4) --------------------------------------------------------
# Anmelden, Entsperren und die Notfall-Sperre verlangen nach dem Passwort den Schlüssel (/etc/pam.d/zenos-schluessel),
# und die Werkzeuge für den Start sind da. Im Image für den Argon gibt es keinen Weg ohne Schlüssel: kein «nouserok»
# für pam_u2f und keine Datei test-ohne-schluessel (die das Test-Image für QEMU braucht, weil es dort keinen gibt).
for noetig in usr/bin/fido2-token usr/bin/fido2-cred usr/bin/fido2-assert usr/bin/pamu2fcfg usr/bin/basenc \
	usr/lib/zenos/schluessel-gemeinsam usr/lib/zenos/schluessel-konto usr/lib/zenos/schluessel-beruehren; do
	[[ -e "$R/$noetig" ]] || fehler "fehlt im Image: /$noetig (Hardware-Schlüssel)"
done
[[ -n "$(find "$R/usr/lib" -name pam_u2f.so -print -quit)" ]] || fehler "pam_u2f.so fehlt im Image"
grep -Eq '^auth[[:space:]]+required[[:space:]]+pam_u2f\.so[[:space:]]' "$R/etc/pam.d/zenos-schluessel" ||
	fehler "/etc/pam.d/zenos-schluessel verlangt pam_u2f nicht"
for dienst in greetd zenos-sperre swaylock; do
	grep -Eq '^auth[[:space:]]+include[[:space:]]+zenos-schluessel$' "$R/etc/pam.d/$dienst" ||
		fehler "/etc/pam.d/$dienst bindet zenos-schluessel nicht ein (Anmelden ohne Schlüssel)"
done
if [[ ",${PROFILES:-}," == *",argon,"* ]]; then
	! grep -q nouserok "$R/etc/pam.d/zenos-schluessel" || fehler "pam_u2f mit nouserok im Image für den Argon"
	[[ ! -e "$R/usr/lib/zenos/test-ohne-schluessel" ]] || fehler "test-ohne-schluessel gehört nur ins Test-Image für QEMU"
fi
echo "zenOS-Prüfung: Hardware-Schlüssel für Start, Anmeldung, Sperre und Notfall-Sperre"

# --- 4. Bootpartition (nur Profil argon) ------------------------------------------------------------------------
# Gerätebäume und Overlays des Kernels von Raspberry Pi und config.txt für mkosi.postoutput bereitlegen.
if [[ ",${PROFILES:-}," == *",argon,"* ]]; then
	start="$OUTPUTDIR/zenos-start"
	rm -rf "$start"
	mkdir -p "$start/overlays"
	mapfile -t baeume < <(find "$R/usr/lib" "$R/boot" -name 'bcm2712*.dtb' 2>/dev/null | sort)
	((${#baeume[@]} > 0)) || fehler "keine Gerätebäume für den BCM2712 gefunden"
	cp "${baeume[@]}" "$start/"
	overlays=$(dirname "$(find "$R/usr/lib" "$R/boot" -name 'dwc2.dtbo' 2>/dev/null | head -1)")
	[[ -d "$overlays" && "$overlays" != "." ]] || fehler "Overlays (dwc2.dtbo) nicht gefunden"
	cp -r "$overlays/." "$start/overlays/"
	cp "$SRCDIR/mkosi/start/config.txt" "$start/config.txt"
	echo "zenOS-Prüfung: ${#baeume[@]} Gerätebäume und Overlays aus $overlays bereitgelegt"

	# Eigenes Overlay für den Deckel des Argon ONE UP (SW_LID an GPIO27, siehe mkosi/start/zenos-deckel.dts).
	# Vor dem Ablegen auf den Gerätebaum des CM5 Lite anwenden: Passt es nicht (etwa weil Raspberry Pi die Bezeichnung
	# rp1_gpio ändert), bricht der Bau hier ab statt erst auf dem Laptop, wo der Deckel dann still nicht sperren würde.
	deckel="$start/overlays/zenos-deckel.dtbo"
	dtc -q -@ -I dts -O dtb -o "$deckel" "$SRCDIR/mkosi/start/zenos-deckel.dts" ||
		fehler "Overlay des Deckels lässt sich nicht übersetzen (mkosi/start/zenos-deckel.dts)"
	cm5="$start/bcm2712-rpi-cm5l-cm5io.dtb"
	[[ -f "$cm5" ]] || fehler "Gerätebaum des CM5 Lite fehlt ($(basename "$cm5"))"
	probe=$(mktemp)
	fdtoverlay -i "$cm5" -o "$probe" "$deckel" || fehler "Overlay des Deckels passt nicht auf $(basename "$cm5")"
	[[ "$(fdtget "$probe" /zenos_deckel/deckel linux,code)" == 0 &&
		"$(fdtget "$probe" /zenos_deckel/deckel linux,input-type)" == 5 ]] ||
		fehler "Overlay des Deckels: kein Schalter SW_LID im Gerätebaum"
	rm -f "$probe"
	grep -qx 'dtoverlay=zenos-deckel' "$start/config.txt" || fehler "config.txt lädt das Overlay des Deckels nicht"
	echo "zenOS-Prüfung: Overlay des Deckels passt auf den CM5 (SW_LID an GPIO27)"
fi
