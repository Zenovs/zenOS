# zenOS: Start der Sitzung (labwc führt diese Datei mit sh aus). Gibt die Umgebung an den systemd-Benutzerdienst
# weiter (die Oberfläche und die Sperre brauchen WAYLAND_DISPLAY) und startet zenos-sitzung.target: die Oberfläche
# (zenos-shell.service) und die automatische Sperre (zenos-idle.service, Leitplanke, nicht abschaltbar).
systemctl --user import-environment WAYLAND_DISPLAY LABWC_PID XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP \
	XDG_SESSION_TYPE XDG_SESSION_ID QT_QPA_PLATFORM QT_WAYLAND_DISABLE_WINDOWDECORATION XCURSOR_THEME XCURSOR_SIZE \
	XKB_DEFAULT_LAYOUT XKB_DEFAULT_VARIANT
systemctl --user start --no-block zenos-sitzung.target
