# Dateisysteme von zenOS 1.0. Das System selbst (/) ist schreibgeschützt und geprüft (dm-verity, Kernel-Befehlszeile).
# /var liegt auf der verschlüsselten Datenpartition, /home darin. Nichts auf ihr ist ausführbar. Geöffnet wird sie von
# zenos-entsperren.service; bis dahin wartet /var ohne Zeitlimit (die Passwortabfrage wartet auf einen Menschen).
/dev/mapper/daten	/var	ext4	nosuid,nodev,noexec,x-systemd.requires=zenos-entsperren.service,x-systemd.device-timeout=0	0	2
/var/home	/home	none	bind,nosuid,nodev,noexec,x-systemd.requires-mounts-for=/var	0	0
