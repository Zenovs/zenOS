# zenOS 1.0: Prüfsummen (dm-verity) des nächsten Stands in die freie Hälfte. Die Partitions-UUID steht im Dateinamen
# (@u) und ist die zweite Hälfte des Wurzel-Hashs; cmdline.txt des Stands findet die Partition so wieder.
# Quelle ist nie das Netz: /usr/lib/zenos/update lädt den Stand, prüft Zenos Signatur (SSH, FIDO2) und jede
# Prüfsumme und legt erst dann die Dateien nach /var/lib/zenos/update/quelle (nur root). mkosi.finalize lässt keine
# Quelle aus dem Netz zu.
[Transfer]
ProtectVersion=%A

[Source]
Type=regular-file
Path=/var/lib/zenos/update/quelle
MatchPattern=zenos_@v_@u.root-verity.raw.xz

[Target]
Type=partition
Path=auto
MatchPattern=zenos_@v_verity
MatchPartitionType=root-verity
PartitionFlags=0
ReadOnly=1
