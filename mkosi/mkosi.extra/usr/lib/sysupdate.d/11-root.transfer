# zenOS 1.0: das System (erofs) des nächsten Stands in die freie Hälfte. Partitions-UUID im Dateinamen (@u, erste
# Hälfte des Wurzel-Hashs). Quelle wie in 10-root-verity.transfer: nur die geprüfte Kopie, nie das Netz.
[Transfer]
ProtectVersion=%A

[Source]
Type=regular-file
Path=/var/lib/zenos/update/quelle
MatchPattern=zenos_@v_@u.root.raw.xz

[Target]
Type=partition
Path=auto
MatchPattern=zenos_@v
MatchPartitionType=root
PartitionFlags=0
ReadOnly=1
