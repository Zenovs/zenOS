#!/bin/sh
# LockedHint der eigenen Sitzung bei logind setzen (ja) oder löschen (nein). Die Sperre (Sperre.qml) und die
# Notfall-Sperre (/usr/lib/zenos/sperren) melden so, ob gesperrt ist; zenos-ausschalten.service zählt danach die Zeit
# ohne entsperrte Sitzung (BAUAUFTRAG.md, Bauauftrag 3). «auto» ist die Sitzung des Aufrufers, für Dienste der
# Benutzerinstanz (die Oberfläche) die grafische Sitzung des Kontos.
case "${1:-}" in
ja) wert=true ;;
nein) wert=false ;;
*)
	echo "Aufruf: gesperrt-melden ja|nein" >&2
	exit 64
	;;
esac
exec busctl call org.freedesktop.login1 /org/freedesktop/login1/session/auto org.freedesktop.login1.Session \
	SetLockedHint b "$wert"
