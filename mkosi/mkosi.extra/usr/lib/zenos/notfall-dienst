#!/bin/bash
# zen notfall und zen schluessel, die Seite von root (zenos-notfall@.service, eine Instanz pro Anfrage an
# /run/zenos/notfall.socket). BAUAUFTRAG.md, Bauauftrag 2, Punkt 6, und Bauauftrag 4, Punkt 5: ohne Admin und ohne
# pkexec, ein Dienst hinter einem Socket, der sonst nichts kann, und kein zweiter Weg zu root.
#
# Liest genau eine varlink-Anfrage (JSON mit einem Nullbyte am Ende, von varlinkctl) und antwortet mit einer:
#   io.zenos.Notfall.Status                         → {"gesetzt": true|false}
#   io.zenos.Notfall.Setzen       {daten, neu}      neues Notfall-Passwort, nur wenn noch keins gesetzt ist
#   io.zenos.Notfall.Aendern      {daten, neu}      ersetzt das Notfall-Passwort
#   io.zenos.Notfall.Entfernen    {daten}           nullt die Notfall-Partition
#   io.zenos.Schluessel.Status                      → {"daten": n, "anmeldung": n, "steckt": [Nummern]}
#   io.zenos.Schluessel.Hinzufuegen {daten}         neuen Schlüssel für Daten und Anmeldung eintragen
#   io.zenos.Schluessel.Entfernen {daten, nummer}   Schlüssel Nummer n entfernen (nie den letzten)
# Fehler: io.zenos.<Schnittstelle>.<Grund> (Abgelehnt, Ungueltig, DatenPasswortFalsch, OeffnetDaten, SchonGesetzt,
# NichtGesetzt, KeinNeuerSchluessel, GleicherSchluessel, LetzterSchluessel, Fehlgeschlagen).
#
# Die Passwörter kommen hex-kodiert (zen kodiert sie). So prüft ein strenges Muster die ganze Anfrage, ohne JSON-Parser
# mit root-Rechten; alles andere ist «Ungueltig». Sie bleiben im Arbeitsspeicher und gehen über Pipes an cryptsetup,
# nie in eine Befehlszeile, Datei oder ins Journal. Jede Änderung verlangt das Passwort der Daten und die Berührung
# eines eingetragenen Schlüssels (schluessel-gemeinsam; ohne Schlüsselplätze nur im Test-Image für QEMU).
#
# Angenommen wird nur, wer an diesem Gerät sitzt: systemd gibt im Namen der Instanz Nummer, PID und UID des Aufrufers
# mit (SO_PEERCRED). Dessen Sitzung muss aktiv sein, an seat0 und nicht entfernt, wie polkit es bei «zen update»
# verlangt: die eigene Sitzung des Prozesses, oder für Programme der Benutzerinstanz (das Terminal) die grafische
# Sitzung des Kontos. Die serielle Konsole oder eine Sitzung ohne Sitz wird abgelehnt.
set -uo pipefail

# shellcheck source=notfall-gemeinsam
. /usr/lib/zenos/notfall-gemeinsam
# shellcheck source=schluessel-gemeinsam
. /usr/lib/zenos/schluessel-gemeinsam

liste=/var/lib/zenos/schluessel/u2f
zuordnung=/var/lib/zenos/schluessel/zuordnung
schnittstelle=Notfall

antworten() { printf '%s\0' "$1"; }
ablehnen() {
	unset daten neu schluessel_passphrase
	antworten "{\"error\":\"io.zenos.$schnittstelle.$1\",\"parameters\":{}}"
	exit 0
}

# Sitzung des Aufrufers: die des Prozesses selbst (session-<ID>.scope) oder, wenn er in der Benutzerinstanz läuft, die
# grafische Sitzung des Kontos (Display, wie polkit)
sitzung_von() { # PID UID
	local cgruppe anzeige
	cgruppe=$(cat "/proc/$1/cgroup" 2>/dev/null) || return 1
	if [[ "$cgruppe" =~ /session-([A-Za-z0-9]+)\.scope ]]; then
		printf '%s' "${BASH_REMATCH[1]}"
		return 0
	fi
	[[ "$cgruppe" == *"/user@$2.service/"* ]] || return 1
	anzeige=$(loginctl show-user "$2" -p Display --value 2>/dev/null) || return 1
	[[ "$anzeige" =~ ^[A-Za-z0-9]+$ ]] || return 1
	printf '%s' "$anzeige"
}

am_geraet() { # PID UID
	local sitzung zeilen
	sitzung=$(sitzung_von "$1" "$2") || return 1
	zeilen=$(loginctl show-session "$sitzung" -p User -p Active -p Remote -p Seat -p Class 2>/dev/null) || return 1
	grep -qx "User=$2" <<<"$zeilen" && grep -qx 'Active=yes' <<<"$zeilen" && grep -qx 'Remote=no' <<<"$zeilen" &&
		grep -qx 'Seat=seat0' <<<"$zeilen" && grep -qx 'Class=user' <<<"$zeilen"
}

# Einträge der Anmeldung (pam_u2f) für das Konto zählen
anmeldung_zaehlen() { # KONTO
	awk -F: -v k="$1" '$1 == k { print NF - 1; f = 1 } END { if (!f) print 0 }' "$liste" 2>/dev/null || echo 0
}

# Eintrag der Anmeldung mit diesem Credential (keyHandle) aus der Zeile des Kontos entfernen
anmeldung_entfernen() { # KONTO KEYHANDLE
	[[ -r "$liste" ]] || return 0
	awk -F: -v k="$1" -v h="$2" 'BEGIN { OFS = ":" }
		$1 == k { z = $1; for (i = 2; i <= NF; i++) { split($i, t, ","); if (t[1] != h) z = z ":" $i }; print z; next }
		{ print }' "$liste" >"$liste.neu" && chmod 0644 "$liste.neu" && mv -f "$liste.neu" "$liste"
}

# --- Wer fragt? ----------------------------------------------------------------------------------------------------
[[ "${1:-}" =~ ^[0-9]+-([0-9]+)-([0-9]+)$ ]] || ablehnen Abgelehnt
pid=${BASH_REMATCH[1]}
uid=${BASH_REMATCH[2]}
((uid >= 1000)) || ablehnen Abgelehnt
[[ "$(stat -c %u "/proc/$pid" 2>/dev/null)" == "$uid" ]] || ablehnen Abgelehnt
am_geraet "$pid" "$uid" || ablehnen Abgelehnt
konto=$(id -nu "$uid" 2>/dev/null) || ablehnen Abgelehnt
name_gueltig "$konto" || ablehnen Abgelehnt

# --- Was wird gefragt? ---------------------------------------------------------------------------------------------
IFS= read -r -d '' -t 120 anfrage || ablehnen Ungueltig
if ! anfrage_lesen "$anfrage"; then
	unset anfrage
	schnittstelle=${schnittstelle:-Notfall}
	ablehnen Ungueltig
fi
unset anfrage

# Eine Änderung nach der anderen
exec 9>/run/zenos/notfall.lock
flock -w 60 9 || ablehnen Fehlgeschlagen

if [[ "$methode" == Status ]]; then
	if [[ "$schnittstelle" == Notfall ]]; then
		if notfall_gesetzt; then antworten '{"parameters":{"gesetzt":true}}'; else antworten '{"parameters":{"gesetzt":false}}'; fi
	else
		# Nummern der Schlüssel, die gerade stecken (stille Abfrage, ohne Berührung), damit man weiss, welcher welcher ist
		anzahl=0 steckt=""
		while read -r token _; do
			anzahl=$((anzahl + 1))
			credential=$(schluessel_feld "$token" zenos-credential) || continue
			for geraet in $(schluessel_geraete); do
				if schluessel_kennt_sicher "$geraet" "$credential"; then
					steckt+="${steckt:+,}$anzahl"
					break
				fi
			done
		done < <(schluessel_plaetze)
		antworten "{\"parameters\":{\"daten\":$anzahl,\"anmeldung\":$(anmeldung_zaehlen "$konto"),\"steckt\":[$steckt]}}"
	fi
	exit 0
fi

# Jede Änderung verlangt das Passwort der Daten (mit Schlüsseln: und die Berührung eines eingetragenen)
daten_passwort_pruefen "$daten" || ablehnen DatenPasswortFalsch

case "$schnittstelle.$methode" in
Notfall.Setzen | Notfall.Aendern)
	if [[ "$methode" == Setzen ]] && notfall_gesetzt; then ablehnen SchonGesetzt; fi
	if [[ "$methode" == Aendern ]] && ! notfall_gesetzt; then ablehnen NichtGesetzt; fi
	if [[ "$neu" == "$daten" ]] || passwort_oeffnet_daten "$neu"; then ablehnen OeffnetDaten; fi
	unset daten schluessel_passphrase
	if ! notfall_anlegen "$neu" zenos-notfall-neu; then
		cryptsetup close zenos-notfall-neu >/dev/null 2>&1 || true
		notfall_nullen >/dev/null 2>&1 || true
		ablehnen Fehlgeschlagen
	fi
	unset neu
	if ! notfall_name_schreiben zenos-notfall-neu "$konto"; then
		notfall_nullen >/dev/null 2>&1 || true
		ablehnen Fehlgeschlagen
	fi
	antworten '{"parameters":{"gesetzt":true}}'
	;;
Notfall.Entfernen)
	unset daten schluessel_passphrase
	notfall_gesetzt || ablehnen NichtGesetzt
	notfall_nullen >/dev/null 2>&1 || ablehnen Fehlgeschlagen
	antworten '{"parameters":{"gesetzt":false}}'
	;;
Schluessel.Hinzufuegen)
	# Der eingetragene Schlüssel ist eben berührt worden. Jetzt einen neuen abwarten: einer, den die Daten nicht kennen.
	daten_hat_schluessel || ablehnen Fehlgeschlagen
	neuer=""
	ende=$((SECONDS + 120))
	while [[ -z "$neuer" ]] && ((SECONDS < ende)); do
		for geraet in $(schluessel_geraete); do
			schluessel_schon_eingetragen "$geraet" || {
				neuer=$geraet
				break
			}
		done
		[[ -n "$neuer" ]] || sleep 0.5
	done
	[[ -n "$neuer" ]] || ablehnen KeinNeuerSchluessel
	schluessel_eintragen "$neuer" "$daten" <(printf '%s' "$schluessel_passphrase") || ablehnen Fehlgeschlagen
	unset daten schluessel_passphrase
	# Für die Anmeldung: pamu2fcfg nimmt den ersten Schlüssel, also warten, bis nur noch der neue steckt
	credential=$schluessel_neues_credential
	ende=$((SECONDS + 120))
	while ((SECONDS < ende)); do
		geraete=$(schluessel_geraete)
		if [[ -n "$geraete" && "$(wc -l <<<"$geraete")" == 1 ]] && schluessel_kennt_sicher "$geraete" "$credential"; then
			break
		fi
		sleep 0.5
	done
	teil=$(pamu2fcfg -n -o pam://zenos -i pam://zenos </dev/null 2>/dev/null) || teil=""
	[[ "$teil" == :* ]] || ablehnen Fehlgeschlagen
	install -d -m 0755 "$(dirname "$liste")"
	if grep -q "^$konto:" "$liste" 2>/dev/null; then
		awk -v k="$konto" -v t="$teil" '$0 ~ "^" k ":" { $0 = $0 t } { print }' "$liste" >"$liste.neu"
	else
		{ cat "$liste" 2>/dev/null; printf '%s%s\n' "$konto" "$teil"; } >"$liste.neu"
	fi
	chmod 0644 "$liste.neu" && mv -f "$liste.neu" "$liste"
	teil=${teil#:}
	printf '%s %s\n' "$credential" "${teil%%,*}" >>"$zuordnung"
	chmod 0600 "$zuordnung"
	antworten "{\"parameters\":{\"daten\":$(schluessel_plaetze | wc -l),\"anmeldung\":$(anmeldung_zaehlen "$konto")}}"
	;;
Schluessel.Entfernen)
	unset daten
	ziel=$(schluessel_plaetze | sed -n "${nummer}p")
	[[ -n "$ziel" ]] || ablehnen Ungueltig
	read -r ziel_token ziel_platz <<<"$ziel"
	# Den, der weg soll, darf man nicht als Beweis nehmen: Berührt war ein anderer (so geht es auch mit verlorenem)
	[[ "$schluessel_platz" != "$ziel_platz" ]] || ablehnen GleicherSchluessel
	(($(schluessel_plaetze | wc -l) >= 2)) || ablehnen LetzterSchluessel
	unset schluessel_passphrase
	credential=$(schluessel_feld "$ziel_token" zenos-credential) || credential=""
	schluessel_platz_entfernen "$ziel_platz" || ablehnen Fehlgeschlagen
	if [[ -n "$credential" && -r "$zuordnung" ]]; then
		handle=$(awk -v c="$credential" '$1 == c { print $2; exit }' "$zuordnung")
		if [[ -n "$handle" ]]; then
			anmeldung_entfernen "$konto" "$handle"
			awk -v c="$credential" '$1 != c' "$zuordnung" >"$zuordnung.neu" && chmod 0600 "$zuordnung.neu" &&
				mv -f "$zuordnung.neu" "$zuordnung"
		fi
	fi
	antworten "{\"parameters\":{\"daten\":$(schluessel_plaetze | wc -l),\"anmeldung\":$(anmeldung_zaehlen "$konto")}}"
	;;
*)
	ablehnen Ungueltig
	;;
esac
