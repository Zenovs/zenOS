#!/usr/bin/env python3
"""thema: Erscheinungsbild von zenOS 1.0 auf GTK, kitty und labwc übertragen (aus zenos-thema von zenOS 0.1).

Aufruf:
  thema anwenden [--modus hell|dunkel] [--akzent NAME] [--melden]
  thema setzen hell|dunkel|tageszeit|wechseln
  thema status

anwenden   Überträgt Erscheinungsbild und Akzent. Ohne --modus gelten die Einstellungen
           (~/.config/zenos/einstellungen.json), ohne --akzent der zuletzt übertragene
           Akzent (~/.local/state/zenos/thema.json), sonst der des aktiven Modus, sonst
           standardAkzent. Schreibt nur bei Änderungen, still ausser bei Fehlern.
           --melden gibt pro Änderung eine Zeile aus (für install.sh).
setzen     Schreibt das Erscheinungsbild in die Einstellungen. Läuft die Shell, übernimmt
           sie es; sonst wird es direkt angewendet.
status     Zeigt gewähltes und wirksames Erscheinungsbild.

Alle Farben kommen aus /usr/share/zenos/shell/theme/tokens.json. zenOS 1.0 hat kein Desktop-Portal: kitty
nimmt die Farben aus no-preference-theme.auto.conf (das Erscheinungsbild, das gerade gilt), GTK-Programme wie
Chromium lesen ~/.config/gtk-3.0/settings.ini beim Start. labwc liest sein Thema aus dem Laufzeitordner der
Sitzung ($XDG_RUNTIME_DIR/zenos/labwc, angelegt von /usr/lib/zenos/sitzung).
"""

import datetime
import json
import os
import re
import signal
import sys
import tempfile

TOKENS = "/usr/share/zenos/shell/theme/tokens.json"
HOME = os.path.expanduser("~")
CONFIG_DIR = os.path.join(HOME, ".config", "zenos")
SETTINGS = os.path.join(CONFIG_DIR, "einstellungen.json")
RUNTIME_STATE = os.path.join(HOME, ".local", "state", "zenos", "laufzeit.json")
# Zuletzt von der Shell übertragener Akzent, für Aufrufe ohne --akzent (z. B. install.sh)
THEME_STATE = os.path.join(HOME, ".local", "state", "zenos", "thema.json")
KITTY = os.path.join(HOME, ".config", "kitty")
LABWC = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}", "zenos", "labwc")
HEADER = "Erzeugt von /usr/lib/zenos/thema aus den Design-Tokens. Nicht von Hand ändern."

MODES = ("hell", "dunkel", "tageszeit")


class ThemeError(Exception):
    pass


def warn(text):
    print(f"thema: {text}", file=sys.stderr)


# ---------------------------------------------------------------- Hilfen

def read_json(path, default=None):
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except FileNotFoundError:
        return default
    except (OSError, ValueError) as e:
        raise ThemeError(f"{path} nicht lesbar: {e}") from e


def write_if_changed(path, content, mode=0o644):
    """Schreibt atomar, nur wenn sich der Inhalt ändert. Gibt True bei Änderung zurück."""
    # Verknüpfungen (z. B. aus Dotfiles) bleiben erhalten: das Ziel wird geschrieben
    if os.path.islink(path):
        path = os.path.realpath(path)
    try:
        with open(path, encoding="utf-8") as f:
            if f.read() == content:
                return False
    except FileNotFoundError:
        pass
    except (OSError, ValueError) as e:
        raise ThemeError(f"{path} nicht lesbar: {e}") from e
    folder = os.path.dirname(path)
    tmp = None
    try:
        os.makedirs(folder, exist_ok=True)
        try:
            mode = os.stat(path).st_mode & 0o777
        except FileNotFoundError:
            pass
        fd, tmp = tempfile.mkstemp(prefix=".thema-", dir=folder)
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(content)
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    except OSError as e:
        if tmp:
            try:
                os.unlink(tmp)
            except OSError:
                pass
        raise ThemeError(f"{path} nicht schreibbar: {e}") from e
    return True


def own_processes(names):
    """PIDs eigener Prozesse mit einem der Namen (comm)."""
    uid = os.getuid()
    pids = []
    for entry in os.listdir("/proc"):
        if not entry.isdigit():
            continue
        try:
            if os.stat(f"/proc/{entry}").st_uid != uid:
                continue
            with open(f"/proc/{entry}/comm", encoding="utf-8") as f:
                if f.read().strip() in names:
                    pids.append(int(entry))
        except OSError:
            continue
    return pids


def session_labwc():
    """labwc dieser Sitzung, ohne gültige Angabe alle eigenen.

    labwc gibt LABWC_PID an seine Kindprozesse weiter, autostart auch an die Benutzerdienste (die Shell).
    Ohne sie (z. B. install.sh per SSH) gelten alle eigenen labwc. So lässt eine Testsitzung mit eigenem
    labwc (scripts/pruefen.sh) das labwc der echten Sitzung nicht neu laden.
    """
    pids = own_processes({"labwc"})
    wanted = os.environ.get("LABWC_PID", "")
    if wanted.isdigit() and int(wanted) in pids:
        return [int(wanted)]
    return pids


def same_home_processes(names):
    """Eigene Prozesse mit einem der Namen und demselben HOME wie dieser Aufruf.

    Nur sie lesen, was hier unter ~/.config geschrieben wird; eine Testsitzung mit eigenem HOME erreicht so
    keine kitty der echten Sitzung. Ist die Umgebung eines Prozesses nicht lesbar, zählt er mit.
    """
    home = os.path.realpath(HOME)
    pids = []
    for pid in own_processes(names):
        try:
            with open(f"/proc/{pid}/environ", "rb") as f:
                env = f.read().split(b"\0")
        except OSError:
            pids.append(pid)
            continue
        value = next((e[5:] for e in env if e.startswith(b"HOME=")), None)
        if value is None or os.path.realpath(os.fsdecode(value)) == home:
            pids.append(pid)
    return pids


def send_signal(pids, sig):
    for pid in pids:
        try:
            os.kill(pid, sig)
        except OSError:
            pass


def hex_rgb(value):
    """'#RRGGBB' oder 'rgba(r, g, b, a)' → (r, g, b, a)."""
    s = str(value).strip()
    m = re.fullmatch(r"#([0-9a-fA-F]{2})([0-9a-fA-F]{2})([0-9a-fA-F]{2})([0-9a-fA-F]{2})?", s)
    if m:
        a = int(m.group(4), 16) / 255 if m.group(4) else 1.0
        return int(m.group(1), 16), int(m.group(2), 16), int(m.group(3), 16), a
    m = re.fullmatch(r"rgba?\(\s*(\d+)\s*,\s*(\d+)\s*,\s*(\d+)\s*(?:,\s*([\d.]+)\s*)?\)", s)
    if m:
        return int(m.group(1)), int(m.group(2)), int(m.group(3)), float(m.group(4) or 1)
    raise ThemeError(f"ungültige Farbe in tokens.json: {value!r}")


def hex6(value):
    r, g, b, _ = hex_rgb(value)
    return f"#{r:02x}{g:02x}{b:02x}"


def hex8(value, alpha):
    r, g, b, _ = hex_rgb(value)
    return f"#{r:02x}{g:02x}{b:02x}{round(alpha * 255):02x}"


# ---------------------------------------------------------------- Tokens und Einstellungen

def load_tokens():
    t = read_json(TOKENS)
    if not isinstance(t, dict):
        raise ThemeError(f"{TOKENS} fehlt")
    try:
        colors = t["farben"]
        for variant in ("hell", "dunkel"):
            if not isinstance(colors[variant], dict):
                raise KeyError(variant)
        if not colors["akzente"]:
            raise KeyError("akzente")
    except (KeyError, TypeError) as e:
        raise ThemeError(f"tokens.json unvollständig: {e}") from e
    return t


def palette(tokens, mode, accent):
    """Farben eines Erscheinungsbilds als Wörterbuch (Hex-Werte)."""
    colors = tokens["farben"]
    p = {k: v for k, v in colors[mode].items()}
    for name, pair in colors["akzente"].items():
        p["akzent:" + name] = pair[mode]
    for name, pair in colors.get("signal", {}).items():
        p[name] = pair[mode]
    p["akzent"] = colors["akzente"][accent][mode]
    return p


def minutes(hhmm, fallback):
    m = re.fullmatch(r"(\d{1,2}):(\d{2})", str(hhmm or ""))
    if not m or int(m.group(1)) > 23 or int(m.group(2)) > 59:
        return fallback
    return int(m.group(1)) * 60 + int(m.group(2))


def effective_mode(settings):
    chosen = settings.get("erscheinungsbild", "hell")
    if chosen not in MODES:
        chosen = "hell"
    if chosen != "tageszeit":
        return chosen
    now_dt = datetime.datetime.now()
    now = now_dt.hour * 60 + now_dt.minute
    day = minutes(settings.get("tagAb"), 7 * 60)
    night = minutes(settings.get("nachtAb"), 19 * 60)
    if day == night:
        return "hell"
    if day < night:
        return "dunkel" if (now < day or now >= night) else "hell"
    return "dunkel" if (night <= now < day) else "hell"


def load_settings():
    try:
        s = read_json(SETTINGS, {})
    except ThemeError as e:
        warn(f"{e}; es gelten die Standardwerte")
        s = {}
    return s if isinstance(s, dict) else {}


def active_accent(tokens):
    """Zuletzt übertragener Akzent, sonst der des aktiven Modus (Laufzeitzustand), sonst standardAkzent."""
    accents = tokens["farben"]["akzente"]
    default = tokens["farben"].get("standardAkzent")
    if default not in accents:
        default = next(iter(accents))
    try:
        state = read_json(THEME_STATE, {}) or {}
        if state.get("akzent") in accents:
            return state["akzent"]
    except (ThemeError, AttributeError):
        pass
    try:
        runtime = read_json(RUNTIME_STATE, {}) or {}
        mode_id = runtime.get("modus") or runtime.get("aktiverModus") or ""
        if isinstance(mode_id, str) and re.fullmatch(r"[A-Za-z0-9_-]+", mode_id):
            mode = read_json(os.path.join(CONFIG_DIR, "modi", mode_id + ".json"), {}) or {}
            if mode.get("akzent") in accents:
                return mode["akzent"]
    except (ThemeError, AttributeError):
        pass
    return default


# ---------------------------------------------------------------- GTK (settings.ini)

def apply_gtk(mode, changes):
    """GTK 3 und 4 (Chromium, Dialoge): dunkel oder hell, Schrift und Symbole wie die Oberfläche.

    zenOS 1.0 hat kein dconf und kein Settings-Portal. GTK liest settings.ini beim Start eines Programms; ein
    laufendes Chromium übernimmt den Wechsel beim nächsten Start.
    """
    dark = "1" if mode == "dunkel" else "0"
    content = "\n".join([
        f"# {HEADER}",
        "[Settings]",
        f"gtk-application-prefer-dark-theme={dark}",
        "gtk-icon-theme-name=Adwaita",
        "gtk-cursor-theme-name=Adwaita",
        "gtk-cursor-theme-size=24",
        "gtk-font-name=Geist 10",
        "",
    ])
    for version in ("gtk-3.0", "gtk-4.0"):
        if write_if_changed(os.path.join(HOME, ".config", version, "settings.ini"), content):
            changes.append(f"{version} settings.ini")


# ---------------------------------------------------------------- kitty

def kitty_palette_accents(tokens, accent):
    """Blau, Magenta, Cyan aus den übrigen Akzenten (ohne den aktiven)."""
    names = list(tokens["farben"]["akzente"].keys())
    preference = {
        "blau": ["blau", "graphit", "salbei", "ton", "sand"],
        "magenta": ["ton", "sand", "graphit", "blau", "salbei"],
        "cyan": ["salbei", "graphit", "blau", "sand", "ton"],
    }
    used = {accent}
    result = {}
    for slot, order in preference.items():
        choice = next((n for n in order + names if n in names and n not in used), accent)
        used.add(choice)
        result[slot] = choice
    return result


def kitty_conf(tokens, mode, accent):
    p = palette(tokens, mode, accent)
    others = kitty_palette_accents(tokens, accent)
    blue, magenta, cyan = (p["akzent:" + others[k]] for k in ("blau", "magenta", "cyan"))
    if mode == "dunkel":
        black, white, bright_white = p["flaeche2"], p["text2"], p["text"]
    else:
        black, white, bright_white = p["text"], p["flaeche2"], p["grund"]
    values = [
        ("foreground", p["text"]),
        ("background", p["fenster"]),
        ("selection_foreground", "none"),
        ("selection_background", p["eingabeRand"]),
        ("cursor", p["text"]),
        ("cursor_text_color", p["fenster"]),
        ("url_color", p["akzent"]),
        ("active_border_color", p["akzent"]),
        ("inactive_border_color", p["linie"]),
        ("bell_border_color", p["warnung"]),
        ("active_tab_foreground", p["text"]),
        ("active_tab_background", p["flaeche2"]),
        ("inactive_tab_foreground", p["gedaempft"]),
        # Tab-Leiste im Hintergrund des Terminals (Entwurf 2)
        ("inactive_tab_background", p["fenster"]),
        ("tab_bar_background", p["fenster"]),
        ("tab_bar_margin_color", p["fenster"]),
        ("color0", black),
        ("color8", p["gedaempft"]),
        ("color1", p["fehler"]),
        ("color9", p["fehler"]),
        ("color2", p["akzent"]),
        ("color10", p["akzent"]),
        ("color3", p["warnung"]),
        ("color11", p["warnung"]),
        ("color4", blue),
        ("color12", blue),
        ("color5", magenta),
        ("color13", magenta),
        ("color6", cyan),
        ("color14", cyan),
        ("color7", white),
        ("color15", bright_white),
    ]
    lines = [f"# {HEADER}", f"# Erscheinungsbild {mode}, Akzent {accent}"]
    for key, value in values:
        lines.append(f"{key} {value if value == 'none' else hex6(value)}")
    return "\n".join(lines) + "\n"


KITTY_EINBINDUNG = """# zenOS 1.0: die Konfiguration des Systems (schreibgeschützt). Eigene Einstellungen darunter.
include /etc/xdg/kitty/kitty.conf
"""


def apply_kitty(tokens, mode, accent, changes):
    changed = False
    # kitty liest ~/.config/kitty/kitty.conf; sie bindet die Konfiguration des Systems ein (nur anlegen, nie ändern)
    if not os.path.lexists(os.path.join(KITTY, "kitty.conf")):
        write_if_changed(os.path.join(KITTY, "kitty.conf"), KITTY_EINBINDUNG)
        changes.append("kitty kitty.conf")
        changed = True
    # Ohne Portal meldet niemand ein Farbschema: kitty nimmt no-preference-theme.auto.conf, also das, was gilt
    for name, content in (("dark-theme.auto.conf", kitty_conf(tokens, "dunkel", accent)),
                          ("light-theme.auto.conf", kitty_conf(tokens, "hell", accent)),
                          ("no-preference-theme.auto.conf", kitty_conf(tokens, mode, accent))):
        if write_if_changed(os.path.join(KITTY, name), content):
            changes.append(f"kitty {name}")
            changed = True
    if changed:
        send_signal(same_home_processes({"kitty"}), signal.SIGUSR1)


# ---------------------------------------------------------------- labwc

def switcher_sizes(tokens):
    """Grössen des Fensterwechslers (Alt+Tab, Stil «classic») aus den Tokens.

    So breit wie das Befehlsfeld, Abstände aus der Abstandsreihe, App-Symbol 40 px wie in der App-Übersicht und
    der App-Leiste. Der aktive Eintrag bekommt den 2-px-Rahmen des Tastaturfokus.
    """
    spacing = tokens.get("abstand")
    if not (isinstance(spacing, list) and len(spacing) == 7 and all(isinstance(a, int) for a in spacing)):
        spacing = [4, 8, 12, 16, 24, 32, 48]
    command_field = tokens.get("befehlsfeld") if isinstance(tokens.get("befehlsfeld"), dict) else {}
    width = command_field.get("breite", 720)
    if not isinstance(width, int) or width <= 0:
        width = 720
    return [
        ("osd.window-switcher.style-classic.width", str(width)),
        ("osd.window-switcher.style-classic.padding", str(spacing[1])),
        ("osd.window-switcher.style-classic.item.padding.x", str(spacing[2])),
        ("osd.window-switcher.style-classic.item.padding.y", str(spacing[1])),
        ("osd.window-switcher.style-classic.item.icon.size", "40"),
        ("osd.window-switcher.style-classic.item.active.border.width", "2"),
    ]


