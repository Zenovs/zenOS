# Feste Liste der Systemdienste von zenOS 1.0 (docs/neubau.md, 4.3). Nur diese laufen; alles andere ist aus,
# auch was ein Paket beim Installieren eingeschaltet hätte. mkosi wendet die Liste beim Bau an.

enable dbus-broker.service
enable systemd-resolved.service
enable systemd-homed.service
enable systemd-homed-activate.service
enable systemd-homed-firstboot.service
enable systemd-userdbd.socket
enable NetworkManager.service
enable nftables.service
enable chrony.service
enable greetd.service
enable apparmor.service
enable zenos-tastatur.service
enable zenos-daten-schuetzen.service
enable zenos-konto.service
# Notfall-Passwort (BAUAUFTRAG.md, Bauauftrag 2): Kontoname beim ersten Start, Attrappe, zen notfall.
# zenos-entsperren.service holt /etc/fstab selbst herein (x-systemd.requires).
enable zenos-notfall-name.service
enable zenos-attrappe.service
enable zenos-notfall.socket
# Leitplanke: nach 30 Minuten ohne entsperrte Sitzung ausschalten (Bauauftrag 3)
enable zenos-ausschalten.service
enable zenos-update-pruefen.service

disable *
