#!/bin/bash
# zen – zenOS 1.0 im Terminal.
#
#   zen update     neuen Stand laden, Signatur und Prüfsummen prüfen und in die freie Hälfte schreiben. Er startet
#                  beim nächsten Neustart einmal zur Probe; läuft er, wird er fest, sonst startet wieder der alte.
#   zen neustart   neu starten (mit dem Probestart, wenn ein Update bereitliegt)
#   zen status     laufende Version und Stand der Updates
#   zen notfall    Notfall-Passwort: status, setzen, aendern, entfernen (verlangt das Passwort der Daten)
#   zen schluessel Hardware-Schlüssel: status, hinzufuegen, entfernen <nummer>
#   zen hilfe      diese Hilfe
#
# Kein Admin nötig: «zen update» startet nur den Dienst zenos-update.service (polkit erlaubt das der Person, die am
# Gerät angemeldet ist). Installiert wird nur, was mit Zenos Schlüssel signiert ist. «zen notfall» fragt den Dienst
# hinter /run/zenos/notfall.socket, ebenso «zen schluessel»; er nimmt nur eine Sitzung am Gerät an.
set -uo pipefail

laufzeit=/run/zenos/update

version() { (. /usr/lib/os-release && printf '%s' "${IMAGE_VERSION:-unbekannt}"); }

hilfe() { sed -n '4,12p' "$0" | sed 's/^# \{0,1\}//'; }

update() {
	# Nach dem Notfall-Passwort (Attrappe) lädt zenOS nichts und schreibt nichts mehr auf die SSD.
	if [[ -e /run/zenos/attrappe ]]; then
		echo "zenOS $(version) ist aktuell."
		return 0
	fi
	if [[ -e "$laufzeit/neustart" ]]; then
		echo "Nichts geladen: Ein neuer Stand ist schon installiert und wartet auf den Neustart."
		cat "$laufzeit/hinweis" 2>/dev/null || true
		echo "Neu starten: zen neustart"
		return 0
	fi
	# Ohne Passwortfrage: zenOS hat keinen Admin. polkit erlaubt den Start nur aus einer Sitzung am Gerät; von
	# anderswo (etwa der seriellen Konsole) lehnt es sofort ab, statt nach einem Root-Passwort zu fragen, das es nicht gibt.
	if ! systemctl --no-ask-password start --no-block zenos-update.service; then
		echo "zen update: der Update-Dienst liess sich nicht starten" >&2
		return 1
	fi
	# Fortschritt aus dem Protokoll des Dienstes, bis er fertig ist
	local gelesen=0 zeilen zustand
	sleep 1
	while :; do
		zustand=$(systemctl show -P ActiveState zenos-update.service)
		if [[ -r "$laufzeit/protokoll" ]]; then
			zeilen=$(wc -l <"$laufzeit/protokoll")
			if ((zeilen > gelesen)); then
				sed -n "$((gelesen + 1)),${zeilen}p" "$laufzeit/protokoll" | grep -v '^\[' || true
				gelesen=$zeilen
			elif ((zeilen < gelesen)); then
				gelesen=0
			fi
		fi
		[[ "$zustand" == activating || "$zustand" == active || "$zustand" == reloading ]] || break
		sleep 1
	done
	if [[ "$(systemctl show -P Result zenos-update.service)" != success ]]; then
		echo
		cat "$laufzeit/hinweis" 2>/dev/null || echo "zen update: fehlgeschlagen"
		return 1
	fi
	if [[ -e "$laufzeit/neustart" ]]; then
		echo
		echo "Neu starten: zen neustart"
	fi
}

status() {
	echo "zenOS $(version)"
	# Alter der Pakete; ab 14 Tagen erinnert die Oberfläche an ein Update (/usr/lib/zenos/erinnerung)
	/usr/lib/zenos/erinnerung stand 2>/dev/null || true
	if [[ -e "$laufzeit/laeuft" ]]; then
		echo "Ein Update läuft gerade."
	elif [[ -e "$laufzeit/neustart" ]]; then
		echo "Ein neuer Stand wartet auf den Neustart (zen neustart)."
	fi
	[[ -r "$laufzeit/hinweis" ]] && cat "$laufzeit/hinweis"
	return 0
}

# --- zen notfall (BAUAUFTRAG.md, Bauauftrag 2) ----------------------------------------------------------------------
# Die Passwörter liest zen hier ohne Echo, kodiert sie hex (od über eine Pipe) und gibt sie über stdin an varlinkctl;
# sie stehen nie in einer Befehlszeile, Datei oder im Journal. Der Dienst prüft das Passwort der Daten.
notfall_adresse=unix:/run/zenos/notfall.socket

passwort_lesen() { # FRAGE → Variable «eingabe»
	IFS= read -r -s -p "$1" eingabe || eingabe=""
	echo >&2
}

hex() { printf '%s' "$1" | od -An -v -tx1 | tr -d ' \n'; }

notfall_fehler() { # AUSGABE VON VARLINKCTL
	case "$1" in
	*io.zenos.Notfall.Abgelehnt*) echo "zen notfall: geht nur an diesem Gerät, in deiner Sitzung (nicht über die serielle Konsole)." >&2 ;;
	*io.zenos.Notfall.DatenPasswortFalsch*) echo "zen notfall: Das Passwort deiner Daten stimmt nicht." >&2 ;;
	*io.zenos.Notfall.OeffnetDaten*) echo "zen notfall: Das neue Notfall-Passwort öffnet deine Daten. Nimm ein anderes." >&2 ;;
	*io.zenos.Notfall.SchonGesetzt*) echo "zen notfall: Es ist schon eines gesetzt. Ändern: zen notfall aendern" >&2 ;;
	*io.zenos.Notfall.NichtGesetzt*) echo "zen notfall: Es ist keines gesetzt. Setzen: zen notfall setzen" >&2 ;;
	*io.zenos.Schluessel.Abgelehnt*) echo "zen schluessel: geht nur an diesem Gerät, in deiner Sitzung." >&2 ;;
	*io.zenos.Schluessel.DatenPasswortFalsch*) echo "zen schluessel: Passwort oder Schlüssel stimmen nicht." >&2 ;;
	*io.zenos.Schluessel.KeinNeuerSchluessel*) echo "zen schluessel: Kein neuer Schlüssel gefunden." >&2 ;;
	*io.zenos.Schluessel.GleicherSchluessel*) echo "zen schluessel: Berühre einen anderen Schlüssel als den, der weg soll." >&2 ;;
	*io.zenos.Schluessel.LetzterSchluessel*) echo "zen schluessel: Der letzte Schlüssel bleibt." >&2 ;;
	*) echo "zen: Das hat nicht geklappt." >&2 ;;
	esac
	return 1
}

notfall() {
	local aktion=${1:-status} methode antwort eingabe daten neu
	case "$aktion" in
	status)
		antwort=$(varlinkctl call --json=short --timeout=60 "$notfall_adresse" io.zenos.Notfall.Status </dev/null 2>&1) ||
			notfall_fehler "$antwort" || return 1
		if [[ "$antwort" == *'"gesetzt":true'* ]]; then
			echo "Ein Notfall-Passwort ist gesetzt."
		else
			echo "Kein Notfall-Passwort gesetzt."
		fi
		return 0
		;;
	setzen) methode=Setzen ;;
	aendern) methode=Aendern ;;
	entfernen) methode=Entfernen ;;
	*)
		echo "zen notfall: status, setzen, aendern oder entfernen" >&2
		return 64
		;;
	esac
	if [[ "$methode" != Entfernen ]]; then
		cat <<'TEXT'
Tippst du beim Start statt deines Passworts das Notfall-Passwort, sind deine Daten in Sekunden endgültig unlesbar,
und zenOS startet leer, als wäre nichts. Das lässt sich nicht rückgängig machen.
TEXT
	fi
	passwort_lesen "Passwort deiner Daten: "
	daten=$(hex "$eingabe")
	if [[ "$methode" == Entfernen ]]; then
		unset eingabe
		antwort=$(printf '{"daten":"%s"}' "$daten" |
			varlinkctl call --json=short --timeout=300 "$notfall_adresse" io.zenos.Notfall.Entfernen 2>&1) ||
			{ unset daten; notfall_fehler "$antwort"; return 1; }
		unset daten
		echo "Notfall-Passwort entfernt."
		return 0
	fi
	passwort_lesen "Neues Notfall-Passwort: "
	neu=$eingabe
	passwort_lesen "Noch einmal: "
	if [[ -z "$neu" || "$neu" != "$eingabe" ]]; then
		unset eingabe neu daten
		echo "zen notfall: Die beiden sind leer oder nicht gleich. Nichts geändert." >&2
		return 1
	fi
	unset eingabe
	neu=$(hex "$neu")
	antwort=$(printf '{"daten":"%s","neu":"%s"}' "$daten" "$neu" |
		varlinkctl call --json=short --timeout=300 "$notfall_adresse" "io.zenos.Notfall.$methode" 2>&1) ||
		{ unset daten neu; notfall_fehler "$antwort"; return 1; }
	unset daten neu
	echo "Notfall-Passwort gesetzt."
}

# --- zen schluessel (BAUAUFTRAG.md, Bauauftrag 4) -------------------------------------------------------------------
schluessel() {
	local aktion=${1:-status} antwort eingabe daten
	case "$aktion" in
	status)
		antwort=$(varlinkctl call --json=short --timeout=60 "$notfall_adresse" io.zenos.Schluessel.Status </dev/null 2>&1) ||
			notfall_fehler "$antwort" || return 1
		[[ "$antwort" =~ \"daten\":([0-9]+),\"anmeldung\":([0-9]+),\"steckt\":\[([0-9,]*)\] ]] || return 1
		local anzahl=${BASH_REMATCH[1]} anmeldung=${BASH_REMATCH[2]} steckt=",${BASH_REMATCH[3]}," nummer
		echo "Hardware-Schlüssel für die Daten: $anzahl, für die Anmeldung: $anmeldung"
		for ((nummer = 1; nummer <= anzahl; nummer++)); do
			if [[ "$steckt" == *",$nummer,"* ]]; then echo "  Schlüssel $nummer (steckt gerade)"; else echo "  Schlüssel $nummer"; fi
		done
		((anzahl >= 2)) || echo "Trag einen zweiten als Ersatz ein: zen schluessel hinzufuegen"
		return 0
		;;
	hinzufuegen)
		echo "Steck einen schon eingetragenen Schlüssel ein. Berühre ihn, wenn er blinkt; dann zieh ihn ab, steck den"
		echo "neuen ein und berühre ihn jedes Mal, wenn er blinkt (dreimal)."
		passwort_lesen "Passwort deiner Daten: "
		daten=$(hex "$eingabe")
		unset eingabe
		antwort=$(printf '{"daten":"%s"}' "$daten" |
			varlinkctl call --json=short --timeout=300 "$notfall_adresse" io.zenos.Schluessel.Hinzufuegen 2>&1) ||
			{ unset daten; notfall_fehler "$antwort"; return 1; }
		unset daten
		echo "Neuer Schlüssel eingetragen, für die Daten und die Anmeldung."
		;;
	entfernen)
		[[ "${2:-}" =~ ^[1-9]$ ]] || {
			echo "zen schluessel entfernen <nummer>: die Nummer aus zen schluessel status (1, 2, …)" >&2
			return 64
		}
		echo "Berühre einen anderen eingetragenen Schlüssel als Nummer $2, wenn er blinkt."
		passwort_lesen "Passwort deiner Daten: "
		daten=$(hex "$eingabe")
		unset eingabe
		antwort=$(printf '{"daten":"%s","nummer":"%s"}' "$daten" "$2" |
			varlinkctl call --json=short --timeout=300 "$notfall_adresse" io.zenos.Schluessel.Entfernen 2>&1) ||
			{ unset daten; notfall_fehler "$antwort"; return 1; }
		unset daten
		echo "Schlüssel $2 entfernt."
		;;
	*)
		echo "zen schluessel: status, hinzufuegen oder entfernen <nummer>" >&2
		return 64
		;;
	esac
}

case "${1:-hilfe}" in
update) update ;;
notfall)
	shift
	notfall "$@"
	;;
schluessel)
	shift
	schluessel "$@"
	;;
neustart) exec systemctl reboot ;;
status) status ;;
hilfe | -h | --hilfe | --help) hilfe ;;
*)
	echo "zen: unbekannter Befehl «$1»" >&2
	hilfe >&2
	exit 64
	;;
esac
