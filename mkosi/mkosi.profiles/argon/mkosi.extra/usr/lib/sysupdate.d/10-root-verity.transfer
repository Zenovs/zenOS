# zenOS 1.0: Prüfsummen (dm-verity) des nächsten Stands in die freie Hälfte. Die Partitions-UUID steht im Dateinamen
# (@u) und ist die zweite Hälfte des Wurzel-Hashs; cmdline.txt des Stands findet die Partition so wieder.
# Quelle: die neueste Veröffentlichung auf GitHub. Geprüft wird immer: SHA256SUMS muss von Zeno signiert sein
# (SHA256SUMS.gpg, Schlüssel in /etc/systemd/import-pubring.gpg), jede Datei muss ihre Prüfsumme haben.
[Transfer]
ProtectVersion=%A
Verify=yes

[Source]
Type=url-file
Path=https://github.com/Zenovs/zenOS/releases/latest/download/
MatchPattern=zenos_@v_@u.root-verity.raw.xz

[Target]
Type=partition
Path=auto
MatchPattern=zenos_@v_verity
MatchPartitionType=root-verity
PartitionFlags=0
ReadOnly=1
